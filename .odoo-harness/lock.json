  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash|mcp__.*github.*",
      "hook": {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/.odoo-harness/guard.py\""
      }
    },
    {
      "event": "PostToolUse",
      "matcher": "Edit|Write|MultiEdit",
      "hook": {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/.odoo-harness/oh\" check --hook",
        "timeout": 30
      }
    },
    {
      "event": "Stop",
      "matcher": null,
      "hook": {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/.odoo-harness/guard.py\" --stop",
        "timeout": 30
      }
    },
    {
      "event": "SessionStart",
      "matcher": "startup|resume",
      "hook": {
        "type": "command",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/.odoo-harness/oh\" env --background --if-remote",
        "async": true
      }
    }
  ],
