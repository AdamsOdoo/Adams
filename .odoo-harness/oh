class OhError(Exception):
    def __init__(self, message, code=SETUP):
        super().__init__(message)
        self.code = code


def run(cmd, *, check=True, env=None, cwd=None, timeout=None, input=None):
    """Run a command, returning its combined output; raise OhError with the tail on failure."""
    env = dict(env or os.environ, GIT_TERMINAL_PROMPT="0")  # never hang on a credential prompt
    result = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env, input=input, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    if check and result.returncode:
        tail = "\n".join(result.stdout.splitlines()[-15:])
        raise OhError(f"command failed ({result.returncode}): {shlex.join(map(str, cmd))}\n{tail}")
    return result


def git(path, *args, check=True):
    result = run(["git", "-C", path, *args], check=check)
    return result.stdout.strip() if result.returncode == 0 else ""


def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def sha_bytes(data):
    return hashlib.sha256(data).hexdigest()


def slug(text):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-") or "x"


def now_iso(ts=None):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def port_free(port):
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", port)) != 0


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


def junk(path):
    return "__pycache__/" in path or path.endswith((".pyc", ".pyo"))


def norm_url(url):
    return re.sub(r"(\.git)?/*$", "", (url or "").strip())


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True, default=str) + "\n", encoding="utf-8")
    tmp.replace(path)


