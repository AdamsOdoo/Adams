def ensure_playwright(env):
    """Python of a small venv with Playwright, kept apart so the Odoo venv stays as its requirements made it."""
    venv = env.cache / "venvs" / f"playwright-py{env.python_version}"
    python = venv / "bin" / "python"
    with env.lock(f"venv-{venv.name}"):
        ready = python.exists() and not subprocess.run([str(python), "-c", "import playwright"],
                                                       capture_output=True).returncode
        if not ready:
            env.say("installing playwright into its own venv (browsers are not downloaded) ...")
            shutil.rmtree(venv, ignore_errors=True)
            run([env.base_python, "-m", "venv", venv])
            run([python, "-m", "pip", "install", "-q", "--disable-pip-version-check", "playwright"],
                env=dict(os.environ, PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD="1"), timeout=900)
    return python


def provenance_problems(env, db, project):
    """Why screens of `db` would not show this project's current source and environment ([] when they do)."""
    built = (env.state().get("dbs") or {}).get(db)
    if not built:
        return [f"database {db} was not built by `oh test --keep` in this project, so the source it runs is unknown"]
    if built.get("format") != FINGERPRINT_FORMAT or not built.get("environment"):
        return [f"database {db} was built by an older odoo-harness version: rebuild it with `oh test <module> --keep`"]
    problems = []
    modules = built.get("modules") or {}
    current = module_ids(env.root, {m: project[m] for m in modules if m in project})
    stale = sorted(m for m, ident in modules.items() if not ident or current.get(m) != ident)
    if stale:
        problems.append(f"database {db} was built before the latest changes to {', '.join(stale)}: "
                        f"re-run `oh test {' '.join(built.get('targets') or stale)} --keep`")
    then, now = built["environment"], env.runtime_key()
    moved = sorted(k for k in now if then.get(k) != now[k])
    if moved:
        problems.append(f"database {db} was built with another {' and '.join(moved)} than the current one: "
                        f"rebuild it with `oh test {' '.join(built.get('targets') or [])} --keep`")
    if built.get("seed_failed"):
        problems.append(f"database {db} is not seeded: its seed script failed ({built['seed_failed'][:120]}); "
                        f"re-run `oh test {' '.join(built.get('targets') or [])} --keep --seed <script>`")
    return problems


def cmd_shot(args):
    started = time.time()
    root = project_root()
    config = load_config(root)
    env = Env(root, config, quiet=True)
    env.ensure()
    db = env.resolve_db(args.db)
    roots, project = discover_project(root, config)
    reasons = provenance_problems(env, db, project)
    if reasons and args.update:
        if not all("built before the latest changes" in r for r in reasons):
            raise OhError("--update only brings the kept database's project modules to the current source; "
                          + "; ".join(r for r in reasons if "built before the latest changes" not in r), FAILED)
        built = (env.state().get("dbs") or {}).get(db) or {}
        static, _ = split_problems(check_modules(root, [m for m in built.get("modules") or {} if m in project], project))
        if static:
            raise OhError("static problems (oh check) must be fixed before the update: " + "; ".join(static[:3]), FAILED)
        stop_server(env)  # it would serve the old code
        updated = env.update_kept(db, roots, project)
        print(f"oh shot: updated {', '.join(updated)} on {db} to the current source (seeded data kept)", file=sys.stderr)
        reasons = provenance_problems(env, db, project)
    entry = start_server(env, db, None)
    python = ensure_playwright(env)
    capture = env.home / "shots" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    langs = args.langs.split(",") if args.langs else list(config["languages"])
    names = [re.sub(r"[^A-Za-z0-9]+", "-", path).strip("-") or "home" for path in args.paths]
    payload = {
        "url": f"http://127.0.0.1:{entry['port']}", "db": db, "login": args.login, "password": args.password,
        "paths": args.paths, "names": names, "langs": langs, "dir": str(capture), "browser": env.browser_bin(),
        "mobile": args.mobile, "expect": args.expect or [], "rtl_langs": list(RTL_LANGS),
        "viewport": {"width": 390, "height": 844} if args.mobile else {"width": 1440, "height": 900},
    }
    result = subprocess.run([str(python), "-c", SHOT_SCRIPT], input=json.dumps(payload), capture_output=True,
                            text=True, timeout=900, env=env.runtime_env())
    try:
        data = json.loads(result.stdout.strip().splitlines()[-1])
    except (IndexError, ValueError):
        print("\n".join((result.stderr or result.stdout).splitlines()[-15:]), file=sys.stderr)
        return FAILED
    if data.get("fatal"):
        print(f"oh shot: FAILED - {data['fatal']}", file=sys.stderr)
        return FAILED
    name = evidence_name("shot", [slug(p) for p in args.paths])
    out = Path(args.out).resolve() if args.out else None
    shots, retained, files, removed = data["results"], [], [], []
    # Smaller files in git and one overview image: a palette PNG keeps text crisp at a fraction of the size,
    # and the contact sheet lets a reviewer scan every screen before opening the ones that changed.
    sheet = capture / "contact-sheet.jpg"
    post = subprocess.run([str(env.python), "-c", POST_SCRIPT, str(capture), str(sheet)],  # Odoo's venv has Pillow
                          input=json.dumps([[s["captured"], "DIAG" if (reasons or s["reasons"]) else "ok"]
                                            for s in shots if s.get("captured")]),
                          capture_output=True, text=True, timeout=600)
    if post.returncode:
        print("note: screenshot post-processing skipped: " + (post.stderr.strip().splitlines() or ["?"])[-1][:160],
              file=sys.stderr)
    if sheet.is_file():
        retained.append((sheet, "contact-sheet.jpg", "contact sheet", False))
    for shot, page in zip(shots, [n for _ in langs for n in names]):
        shot["reasons"] = reasons + shot["reasons"]
        shot["accepted"] = not shot["reasons"]
        captured = Path(shot.pop("captured"))
        rel = f"{shot['lang']}/{page}.png"
        if not captured.is_file():
            shot["file"] = None
            continue
        shot["sha256"] = sha_bytes(captured.read_bytes())
        if shot["accepted"] and out:
