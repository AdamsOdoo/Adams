    argv = env.odoo("shell", "-c", env.conf, "-d", db, f"--addons-path={env.addons_path(roots)}", "--no-http",
                    "--log-level=warn")
    result = subprocess.run([str(a) for a in argv], input=code, text=True, capture_output=True,
                            env=env.runtime_env(), timeout=args.timeout)
    lines = result.stdout.splitlines()
    print("\n".join(lines[:args.max_lines]))
    if len(lines) > args.max_lines:
        print(f"... {len(lines) - args.max_lines} more lines")
    if result.returncode or "Traceback" in result.stderr:
        print("\n".join(result.stderr.splitlines()[-20:]), file=sys.stderr)
        return FAILED
    return PASSED


