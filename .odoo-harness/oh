def cmd_clean(args):
    root = project_root()
    env = Env(root, load_config(root), quiet=True)
    env.ensure_postgres()
    if args.all_projects:
        stopped = 0
        for path in (env.cache / "projects").glob("*/state.json"):
            state = read_json(path, {}) or {}
            if server_alive(state.get("serve")):
                with contextlib.suppress(OSError):
                    os.killpg(state["serve"]["pid"], signal.SIGTERM)
                stopped += 1
            for key in ("serve", "kept", "last_db", "dbs"):
                state.pop(key, None)
            write_json(path, state)
        dropped = env.list_dbs("oh_")
        for name in dropped:
            env.drop_db(name, any_project=True)
        write_json(env.cache / "templates.json", {})
        print(f"all projects: stopped {stopped} server(s), dropped {len(dropped)} database(s) including templates")
        return PASSED
    stop_server(env)
    dropped = env.list_dbs(env.prefix)
    for name in dropped:
        env.drop_db(name)
    env.update_state(lambda state: [state.pop(key, None) for key in ("serve", "kept", "last_db", "dbs")])
    templates = []
    if args.templates:
        path = env.cache / "templates.json"
        with env.lock("templates"):
            registry = read_json(path, {}) or {}
        for name, entry in registry.items():
            if entry.get("projects") == [env.key]:  # shared templates stay for the other projects
                with env.lock(f"tpl-{name}", wait=False) as acquired:
                    if acquired:
                        env.drop_db(name)
                        templates.append(name)
        with env.lock("templates"):
            registry = read_json(path, {}) or {}
            for name in templates:
                registry.pop(name, None)
            write_json(path, registry)
    print(f"dropped {len(dropped)} database(s) of this project"
          + (f" and {len(templates)} template(s) only it used" if args.templates else "")
          + "; other projects were not touched")
    return PASSED


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
