def cmd_status(args):
    """Count the rows of the status file's tables by status and, with --html, render the file as one page."""
    root = project_root()
    config = load_config(root)
    name = args.file or config.get("status_file")
    if not name:
        raise OhError("no status file: set status_file in .odoo-harness/project.json (the one file that tracks what "
                      "is done and what is left) or pass FILE")
    path = (root / name).resolve()
    if not path.is_file():
        raise OhError(f"{name} does not exist")
    text = path.read_text(encoding="utf-8")
    items = status_items(text)
    counts = {kind: sum(1 for item in items if item[2] == kind) for kind in STATUS_LABELS}
    rel = path.relative_to(root).as_posix() if path.is_relative_to(root) else str(path)
    print(f"{rel}: {len(items)} item(s) " + " · ".join(f"{STATUS_LABELS[k].lower()} {n}" for k, n in counts.items() if n))
    for item, phrase, kind in items:
        if kind == "other":
            print(f"  unrecognized status: {item}: {phrase}")
    if not args.html:
        return PASSED
    commit = subprocess.run(["git", "-C", str(root), "rev-parse", "--short", "HEAD"], text=True, capture_output=True).stdout.strip()
    remote = subprocess.run(["git", "-C", str(root), "remote", "get-url", "origin"], text=True, capture_output=True).stdout.strip()
    match = re.search(r"github\.com[:/]+([^/]+/[^/]+?)(?:\.git)?/*$", remote)
    ref = args.ref or config.get("base_branch") or commit

    def link(target):
        if re.match(r"^[a-z]+:|^#", target) or not match:
            return target
        file, _, anchor = target.partition("#")
        resolved = os.path.normpath(os.path.join(os.path.dirname(rel), file)).replace(os.sep, "/")
        resolved += "/" if file.endswith("/") else ""
        return f"https://github.com/{match.group(1)}/blob/{ref}/{resolved}" + (f"#{anchor}" if anchor else "")
    title, body = md_html(text, link)
    title = title or path.stem.replace("-", " ").capitalize()
    total = len(items) or 1
    bar = "".join(f'<span style="width:{100 * n / total:.3f}%;background:var(--{k})" title="{STATUS_LABELS[k]} {n}"></span>'
                  for k, n in counts.items() if n)
    legend = "".join(f'<span><i class="dot" style="background:var(--{k})"></i>{STATUS_LABELS[k]} <b>{n}</b></span>'
                     for k, n in counts.items() if n)
    summary = (f'<section class="summary" aria-label="Summary"><div class="bar">{bar}</div>'
               f'<div class="legend"><span><b>{len(items)}</b> items</span>{legend}</div></section>') if items else ""
    colors = "\n".join(f".badge.{k} {{ color: var(--{k}); }}" for k in STATUS_LABELS)
    page = STATUS_PAGE.format(title=html.escape(title), source=html.escape(rel), commit=html.escape(commit or "?"),
                              date=time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime()), summary=summary, body=body,
                              colors=colors)
    out = Path(args.html)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page, encoding="utf-8")
    print(f"page: {out}")
    return PASSED


