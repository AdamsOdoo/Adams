    langs = args.lang.split(",") if args.lang else [l for l in config["languages"] if l != "en_US"]
    if args.pot:
        langs.append("pot")
    conf = env.home / "i18n.conf"
    conf.write_text(env.conf.read_text() + f"addons_path = {env.addons_path(roots)}\n")
    conf.chmod(0o600)
    before = {p: p.stat().st_mtime for m in args.modules for p in (project[m] / "i18n").glob("*.po*")}
    previous = {p: p.read_bytes() for p in before if p.suffix == ".po"}  # the export drops code terms' translations
    result = run(env.odoo("i18n", "export", "-c", conf, "-d", db, *args.modules, "-l", *langs),
                 check=False, env=env.runtime_env(), timeout=900)
    written = [p for m in args.modules for p in sorted((project[m] / "i18n").glob("*.po*"))
               if before.get(p) != p.stat().st_mtime]
    if result.returncode or not written:
        print("\n".join(result.stdout.splitlines()[-15:]), file=sys.stderr)
        raise OhError("translation export failed", FAILED)
    for path in written:
        restored = 0
        if path in previous:
            old = env.home / f"i18n.previous.{os.getpid()}.po"
            old.write_bytes(previous[path])
            merge = subprocess.run([str(env.python), "-c", MERGE_PO_SCRIPT, str(old), str(path)],
                                   capture_output=True, text=True, timeout=120)
            old.unlink(missing_ok=True)
            restored = int(merge.stdout.strip() or 0) if merge.returncode == 0 else 0
            if merge.returncode:
                print(f"note: could not merge the previous translations of {path.name}: "
                      f"{(merge.stderr.strip().splitlines() or ['?'])[-1][:160]}", file=sys.stderr)
        empty = len(re.findall(r'^msgstr ""\n\n', path.read_text(encoding="utf-8") + "\n", re.M))
        print(f"{path.relative_to(root)}" + (f"  ({empty} untranslated"
                                            + (f"; {restored} kept from the previous file" if restored else "") + ")"
                                            if not path.name.endswith(".pot") else ""))
    return PASSED


MERGE_PO_SCRIPT = r"""
import sys, polib
old, new = polib.pofile(sys.argv[1]), polib.pofile(sys.argv[2])
translated = lambda e: bool(e.msgstr) or any(e.msgstr_plural.values())
known = {(e.msgctxt, e.msgid, e.msgid_plural): e for e in old if translated(e) and not e.obsolete}
restored = 0
for entry in new:
    before = known.get((entry.msgctxt, entry.msgid, entry.msgid_plural))
    if not before or translated(entry):
        continue
    if entry.msgid_plural:
        entry.msgstr_plural = dict(before.msgstr_plural)
    else:
        entry.msgstr = before.msgstr
    if "fuzzy" in before.flags and "fuzzy" not in entry.flags:
        entry.flags.append("fuzzy")  # a fuzzy translation stays fuzzy: Odoo doesn't load it until it is checked
    restored += 1
if restored:
    new.save(sys.argv[2])
print(restored)
"""


def check_record(root, path, record):
    """(problems, notes) for one record: a problem is a missing or changed file, or a claim its files contradict."""
    if "files" not in record:
        return [], ["made by an older odoo-harness (no retained files): run it again"]
    folder = path.with_suffix("")
    problems = file_problems(record, folder, root)
    kind, status = record.get("kind"), record.get("status")
    logs = [f for f in record["files"] if f.get("role") == "log" and f.get("name")]
    if kind in ("test", "upgrade") and status == "passed" and not logs:
        problems.append("a passed test record without its Odoo log")
    for entry in logs:
        data = (folder / entry["name"]).read_bytes() if (folder / entry["name"]).is_file() else b""
        if sha_bytes(data) != entry.get("sha256"):
            continue  # reported as missing or changed
        summary = parse_run_log(gzip.decompress(data).decode("utf-8", "replace"))
        _, total = test_counts(summary)
        claimed = record.get("tests") or {}
        differ = [f"{k} {claimed.get(k)} vs {total[k]}" for k in ("executed", "skipped", "failed", "errors")
                  if claimed.get(k) != total[k]]
        if differ:
            problems.append("its test counts differ from its log (record vs log): " + ", ".join(differ))
        selection = record.get("selection") or {}
        again, _ = verdict(summary, record.get("odoo_exit_code") or 0, set(selection.get("required") or []),
                           [(spec, tuple(parsed)) for spec, parsed in zip(selection.get("require") or [],
                                                                          selection.get("require_parsed") or [])],
                           {m: set(c) for m, c in (record.get("upgrade_checks") or {}).items()},
                           set(record.get("need_checks") or []))
        if again == PASSED and record.get("extra_reasons"):
            again = UNVERIFIED
        if LABELS[again].lower() != status:
            problems.append(f"it says {status}, but its log gives {LABELS[again].lower()}")
    if kind == "shot":
        listed = {f.get("name") or f.get("path") for f in record["files"]}
        shots = record.get("shots") or []
        missing = [s.get("file") for s in shots if s.get("accepted") and s.get("file") not in listed]
        if missing:
            problems.append(f"accepted screenshots not among its files: {', '.join(map(str, missing))}")
        if status == "passed" and (not shots or any(not s.get("accepted") for s in shots)):
            problems.append("it says passed, but not every screenshot passed its checks")
    return problems, []


def record_entry(root, path, record, current, committed, odoo_now):
    """What `oh evidence` says about one record, with what `--prune` needs: whether it is stale (a tested module
    changed since) and the claim it makes (its kind, and the modules, or pages per language and user, it covers)."""
    problems, notes = check_record(root, path, record)
    source = record.get("project") or {}
    modules = source.get("modules") or {}
    current_ok = stale = False
    if source.get("format") != FINGERPRINT_FORMAT:
        where = "source ids from an older odoo-harness: run it again"
    elif not modules:
        where = "no module source recorded"
    else:
        changed = sorted(m for m, ident in modules.items() if not ident or current.get(m) != ident)
        if changed:
            stale, where = True, f"STALE: {', '.join(changed)} changed since"
        else:
            current_ok = True
            where = "matches the working tree" + (" and HEAD" if all(committed.get(m) for m in modules)
                                                  else " (not committed yet)")
    tests, shots = record.get("tests") or {}, record.get("shots") or []
    if tests:
        detail = (f"{tests.get('executed', 0)} executed, {tests.get('skipped', 0)} skipped, "
                  f"{tests.get('failed', 0)} failed, {tests.get('errors', 0)} errors")
    elif shots:
        detail = f"{sum(1 for s in shots if s.get('accepted'))}/{len(shots)} screens verified"
    else:
        detail = "-"
    odoo = ((record.get("environment") or {}).get("odoo") or {}).get("commit") or ""
    env_note = "" if not odoo_now or odoo == odoo_now else f" | odoo {odoo[:8]} (now {odoo_now[:8]})"
    kept = len(record.get("files") or [])
    line = (f"{path.name}: {str(record.get('status', '?')).upper()} {str(record.get('finished', ''))[:16]} | "
            f"{detail} | {where}{env_note}" + (f" | {kept} file(s) " + ("PROBLEM" if problems else "intact") if kept else "")
            + (" | reused" if record.get("reused_from") else ""))
    kind, selection = record.get("kind"), record.get("selection") or {}
    if kind == "shot":
        claim = ("shot",)
        covers = {(s.get("path"), s.get("lang"), record.get("login")) for s in shots if s.get("accepted")}
    else:
        claim = (kind, (selection.get("upgrade_from") or {}).get("ref")) if kind == "upgrade" else (kind,)
        covers = set(selection.get("modules") or [])
    partial = bool(selection.get("partial"))
    if partial:
        line += f" | PARTIAL: only {selection.get('tags')}"
        named = {m for spec in str(selection.get("tags") or "").split(",") if spec and not spec.startswith("-")
                 for m in re.findall(r"/(\w+)", spec)}
        covers = named or covers  # the modules the tags name, not the ones installed for them
    return {"path": path, "record": record, "problems": problems, "notes": notes, "line": line, "stale": stale,
            "current": current_ok, "status": record.get("status"), "finished_ts": record.get("finished_ts") or 0,
            "claim": claim, "covers": covers, "partial": partial}


def prune_plan(entries, every_stale=False):
    """[(entry, superseder)]: the stale records that a newer passed, intact, whole record of the same claim covers (every
    module, or every page, language and user, of the stale record is in it), and the partial records (a --tags run)
    that such a record covers, stale or not: a partial record proves only the tests it ran and never supersedes
    anything itself. Nothing else is ever pruned: a stale record nothing newer covers, a failed or not verified record
    that is still the latest word on its modules, a current whole record, a record with a problem to look at (fix or
    remove it by hand), or one from an older harness.
    With `every_stale` (--prune-stale, the delivery step), every stale record without a problem is in the plan, with
    None as the superseder when nothing newer covers it: a record whose modules changed since proves nothing about
    the source any more, and git history keeps it."""
    plan = []
    for entry in entries:
        if entry["problems"] or not (entry["stale"] or entry["partial"]):
            continue
        newer = [e for e in entries if e is not entry and e["claim"] == entry["claim"] and e["status"] == "passed"
                 and not e["problems"] and not e["partial"] and e["finished_ts"] > entry["finished_ts"]
                 and entry["covers"] and entry["covers"] <= e["covers"]]
        if newer:
            plan.append((entry, max(newer, key=lambda e: e["finished_ts"])))
        elif every_stale and entry["stale"]:
            plan.append((entry, None))
    return plan


