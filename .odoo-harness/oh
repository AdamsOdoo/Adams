# Status words, first match wins: live, done, active, partial, waiting, todo. Anything else is "other".
STATUS_KINDS = [
    ("live", re.compile(r"\b(in production|deployed|live|released)\b")),
    ("done", re.compile(r"\b(merged|done|completed?|built|delivered)\b")),
    ("active", re.compile(r"\b(in progress|in review|design approved|questions asked|building)\b")),
    ("partial", re.compile(r"\b(partly|partial)")),
    ("waiting", re.compile(r"\b(deferred|blocked|on hold|waiting|not needed|cancell?ed)\b")),
    ("todo", re.compile(r"\b(not started|planned|to do|todo|open)\b")),
]
STATUS_LABELS = {"live": "In production", "done": "Built, not in production", "active": "Active", "partial": "Partly covered", "waiting": "Deferred or not needed",
                 "todo": "Not started", "other": "Other"}
MD_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def plain(text):
    """Markdown cell text without links, emphasis or code marks."""
    return re.sub(r"[*_`]", "", MD_LINK.sub(r"\1", text)).strip()


def table_rows(lines):
    """[(header, rows)] for each markdown table in `lines`."""
    tables, i = [], 0
    split = lambda line: [c.strip() for c in line.strip().strip("|").split("|")]
    while i < len(lines):
        if lines[i].lstrip().startswith("|") and i + 1 < len(lines) and re.match(r"^\s*\|[\s:|-]+\|\s*$", lines[i + 1]):
            header, rows, i = split(lines[i]), [], i + 2
            while i < len(lines) and lines[i].lstrip().startswith("|"):
                rows.append(split(lines[i]))
                i += 1
            tables.append((header, rows))
        else:
            i += 1
    return tables


def status_phrase(cell):
    """The leading status of a cell: '**in production** (`x` 1.0): ...' -> 'in production'."""
    text = plain(cell).lower()
    return re.split(r"[.(:;,]| - | — ", text, maxsplit=1)[0].strip() or "?"


def status_kind(phrase):
    return next((kind for kind, pattern in STATUS_KINDS if pattern.search(phrase)), "other")


def status_items(text):
    """(item, phrase, kind) for each row of every table with a Status column."""
    items = []
    for header, rows in table_rows(text.splitlines()):
        names = [plain(h).lower() for h in header]
        if "status" not in names:
            continue
        col = names.index("status")
        label = next((i for i, n in enumerate(names) if i != col and n not in ("#", "id", "")), 0)
        for row in rows:
            if col < len(row):
                phrase = status_phrase(row[col])
                items.append((plain(row[label]) if label < len(row) else "?", phrase, status_kind(phrase)))
    return items


def md_inline(text, link):
    """Escaped HTML of one line of markdown: code, links, bold, italic."""
    held = []

    def hold(fragment):
        held.append(fragment)
        return f"\x00{len(held) - 1}\x00"
    text = re.sub(r"`([^`]+)`", lambda m: hold(f"<code>{html.escape(m.group(1))}</code>"), text)
    text = MD_LINK.sub(lambda m: hold(f'<a href="{html.escape(link(m.group(2)), quote=True)}">'
                                      f'{md_inline(m.group(1), link)}</a>'), text)
    text = html.escape(text, quote=False)
    text = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)
    text = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", text)
    while "\x00" in text:
        text = re.sub(r"\x00(\d+)\x00", lambda m: held[int(m.group(1))], text)
    return text


def md_html(text, link):
    """A small markdown renderer for status files: headings, paragraphs, lists, tables (Status cells get a badge)."""
    lines, out, i = text.splitlines(), [], 0
    para, title = [], None

    def flush():
        if para:
            out.append(f"<p>{md_inline(' '.join(para), link)}</p>")
            para.clear()
    while i < len(lines):
        line = lines[i]
        heading = re.match(r"^(#{1,4})\s+(.*)$", line)
        if not line.strip():
            flush()
            i += 1
        elif heading:
            flush()
            level = len(heading.group(1))
            if level == 1 and title is None:
                title = plain(heading.group(2))
            else:
                out.append(f"<h{level + 1}>{md_inline(heading.group(2), link)}</h{level + 1}>")
            i += 1
        elif line.lstrip().startswith("|") and table_rows(lines[i:i + 2]):
            flush()
            header, rows = table_rows(lines[i:])[0]
            i += 2 + len(rows)
            col = [plain(h).lower() for h in header].index("status") if "status" in [plain(h).lower() for h in header] else -1
            cells = "".join(f"<th>{md_inline(h, link)}</th>" for h in header)
            body = []
            for row in rows:
                tds = []
                for n, cell in enumerate(row):
                    inner = md_inline(cell, link)
                    if n == col:
                        phrase = status_phrase(cell)
                        rest = re.sub(r"^\*\*([^*]+)\*\*", lambda m: "" if plain(m.group(1)).lower().strip(" .:;,") == phrase else m.group(0), cell.strip())
                        if rest[:len(phrase)].lower() == phrase:
                            rest = rest[len(phrase):]
                        rest = rest.lstrip(" .:;,")
                        inner = f'<span class="badge {status_kind(phrase)}">{html.escape(phrase)}</span> {md_inline(rest, link)}'
                    tds.append(f'<td class="{"status" if n == col else ""}">{inner}</td>')
                body.append("<tr>" + "".join(tds) + "</tr>")
            out.append(f'<div class="table"><table><thead><tr>{cells}</tr></thead><tbody>{"".join(body)}</tbody></table></div>')
        elif re.match(r"^\s*([-*]|\d+\.)\s+", line):
            flush()
            tag = "ol" if re.match(r"^\s*\d+\.", line) else "ul"
            items = []
            while i < len(lines) and re.match(r"^\s*([-*]|\d+\.)\s+", lines[i]):
                items.append(re.sub(r"^\s*([-*]|\d+\.)\s+", "", lines[i]))
                i += 1
                while i < len(lines) and lines[i].startswith("  ") and lines[i].strip():
                    items[-1] += " " + lines[i].strip()
                    i += 1
            out.append(f"<{tag}>" + "".join(f"<li>{md_inline(item, link)}</li>" for item in items) + f"</{tag}>")
        else:
            para.append(line.strip())
            i += 1
    flush()
    return title, "\n".join(out)


