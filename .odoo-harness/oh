    p = sub.add_parser("serve", help="run this project's Odoo server on a kept database")
    p.add_argument("--db")
    p.add_argument("--port", type=int)
    sub.add_parser("stop", help="stop this project's server")
    p = sub.add_parser("shot", help="checked screenshots of Odoo pages in each configured language")
    p.add_argument("paths", nargs="+", help="URL paths such as /odoo/action-sale.action_orders")
    p.add_argument("--db", help="kept database to show (default: the last one kept by oh test --keep)")
    p.add_argument("--langs", help="comma-separated language codes (default: project languages)")
    p.add_argument("--out", help="directory for verified screenshots (default: the oh cache)")
    p.add_argument("--expect", action="append", metavar="CSS", help="element that must be on every page (repeatable)")
    p.add_argument("--mobile", action="store_true", help="390x844 mobile viewport")
    p.add_argument("--login", default="admin", help="user to log in as, to check a role's view")
    p.add_argument("--password", default="admin")
    p.add_argument("--update", action="store_true", help="first update the kept database's project modules to the "
                                                         "current source (-u), keeping its seeded data")
    p.add_argument("--no-record", action="store_true", help="don't write the result to .odoo-harness/evidence")
