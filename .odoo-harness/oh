def ensure_playwright(env):
    """Python of a small venv with Playwright, kept apart so the Odoo venv stays as its requirements made it."""
    venv = env.cache / "venvs" / f"playwright-py{env.python_version}"
    python = venv / "bin" / "python"
    with env.lock(f"venv-{venv.name}"):
        ready = python.exists() and not subprocess.run([str(python), "-c", "import playwright"],
                                                       capture_output=True).returncode
        if not ready:
            env.say("installing playwright into its own venv (browsers are not downloaded) ...")
            shutil.rmtree(venv, ignore_errors=True)
            run([env.base_python, "-m", "venv", venv])
            run([python, "-m", "pip", "install", "-q", "--disable-pip-version-check", "playwright"],
                env=dict(os.environ, PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD="1"), timeout=900)
    return python


def provenance_problems(env, db, project):
    """Why screens of `db` would not show this project's current source and environment ([] when they do)."""
    built = (env.state().get("dbs") or {}).get(db)
    if not built:
        return [f"database {db} was not built by `oh test --keep` in this project, so the source it runs is unknown"]
    if built.get("format") != FINGERPRINT_FORMAT or not built.get("environment"):
        return [f"database {db} was built by an older odoo-harness version: rebuild it with `oh test <module> --keep`"]
    problems = []
    modules = built.get("modules") or {}
    current = module_ids(env.root, {m: project[m] for m in modules if m in project})
    stale = sorted(m for m, ident in modules.items() if not ident or current.get(m) != ident)
    if stale:
        problems.append(f"database {db} was built before the latest changes to {', '.join(stale)}: "
                        f"re-run `oh test {' '.join(built.get('targets') or stale)} --keep`")
    then, now = built["environment"], env.runtime_key()
    moved = sorted(k for k in now if then.get(k) != now[k])
    if moved:
        problems.append(f"database {db} was built with another {' and '.join(moved)} than the current one: "
                        f"rebuild it with `oh test {' '.join(built.get('targets') or [])} --keep`")
    return problems


