def load_config(root):
    config = dict(DEFAULTS)
    path = root / ".odoo-harness" / "project.json"
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as exc:
            raise OhError(f"{path} is not valid JSON ({exc})") from None
        if not isinstance(data, dict):
            raise OhError(f"{path} must contain a JSON object")
        config.update({k: v for k, v in data.items() if not k.startswith("_")})
    for key, var in (("enterprise_path", "OH_ENTERPRISE_PATH"), ("enterprise_repo", "OH_ENTERPRISE_REPO"),
                     ("odoo_ref", "OH_ODOO_REF")):
        if os.environ.get(var):
            config[key] = os.environ[var]
    return config


def config_problems(config):
    problems = []
    for key in ("odoo_ref", "production_branch", "base_branch", "enterprise_path", "enterprise_repo",
                "enterprise_ref", "python", "status_file"):
        if config.get(key) is not None and not isinstance(config.get(key), str):
            problems.append(f"{key} must be a string")
    for key in ("staging_branches", "protected_branches", "languages", "addons_paths"):
        value = config.get(key)
        if value is not None and not (isinstance(value, list) and all(isinstance(v, str) for v in value)):
            problems.append(f"{key} must be a list of strings")
    for key in ("odoo_commit", "enterprise_commit"):
        if config.get(key) and not SHA40.match(str(config[key])):
            problems.append(f"{key} must be a full 40-character commit SHA")
    if not config.get("production_branch"):
        problems.append("production_branch is not set, so the guard only protects main/master/production/prod/staging")
    if config.get("enterprise_path") and config.get("enterprise_repo"):
        problems.append("set enterprise_path or enterprise_repo, not both")
    return problems


