def project_root():
    if os.environ.get("OH_PROJECT"):
        return Path(os.environ["OH_PROJECT"]).resolve()
    here = Path(__file__).resolve().parent
    if here.name == ".odoo-harness":  # the installed copy belongs to its project, whatever the cwd
        return here.parent
    start = Path(os.getcwd()).resolve()
    result = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"], text=True, capture_output=True)
    return Path(result.stdout.strip()) if result.returncode == 0 else start


def project_key(root):
    """Directory name of this project's state in the shared cache."""
    return f"{slug(Path(root).name).lower()[:24]}-{sha(str(root))[:8]}"


def db_prefix(root):
    """Every database this project creates starts with this prefix; other projects' ones are left alone."""
    return f"oh_{sha(str(root))[:8]}_"


def load_config(root):
    config = dict(DEFAULTS)
    path = root / ".odoo-harness" / "project.json"
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as exc:
            raise OhError(f"{path} is not valid JSON ({exc})") from None
        if not isinstance(data, dict):
            raise OhError(f"{path} must contain a JSON object")
        config.update({k: v for k, v in data.items() if not k.startswith("_")})
    for key, var in (("enterprise_path", "OH_ENTERPRISE_PATH"), ("enterprise_repo", "OH_ENTERPRISE_REPO"),
                     ("odoo_ref", "OH_ODOO_REF")):
        if os.environ.get(var):
            config[key] = os.environ[var]
    return config


def config_problems(config):
    problems = []
    for key in ("odoo_ref", "production_branch", "base_branch", "enterprise_path", "enterprise_repo",
                "enterprise_ref", "python"):
        if config.get(key) is not None and not isinstance(config.get(key), str):
            problems.append(f"{key} must be a string")
    for key in ("staging_branches", "protected_branches", "languages", "addons_paths"):
        value = config.get(key)
        if value is not None and not (isinstance(value, list) and all(isinstance(v, str) for v in value)):
            problems.append(f"{key} must be a list of strings")
    for key in ("odoo_commit", "enterprise_commit"):
        if config.get(key) and not SHA40.match(str(config[key])):
            problems.append(f"{key} must be a full 40-character commit SHA")
    if not config.get("production_branch"):
        problems.append("production_branch is not set, so the guard only protects main/master/production/prod/staging")
    if config.get("enterprise_path") and config.get("enterprise_repo"):
        problems.append("set enterprise_path or enterprise_repo, not both")
    return problems


def protected_names(config):
    names = {config.get("production_branch")} | set(config.get("staging_branches") or [])
    names |= set(config.get("protected_branches") or [])
    return sorted(n for n in names if n)


_manifests = {}


def read_manifest(module_dir):
    module_dir = Path(module_dir)
    if module_dir not in _manifests:
        _manifests[module_dir] = ast.literal_eval((module_dir / "__manifest__.py").read_text(encoding="utf-8"))
    return _manifests[module_dir]


def scan_modules(roots):
    """Map module name -> directory for each addons root; the first root wins, like Odoo's addons path."""
    index = {}
    for root in roots:
        try:
            entries = sorted(os.scandir(root), key=lambda e: e.name)
        except OSError:
            continue
        for entry in entries:
            if (entry.is_dir() and not entry.name.startswith(".")
                    and os.path.isfile(os.path.join(entry.path, "__manifest__.py"))):
                index.setdefault(entry.name, Path(entry.path))
    return index


def discover_project(root, config):
    """Return (addons roots, {module: dir}) for the project: configured paths or auto-detected ones."""
    if config.get("addons_paths"):
        roots = [(root / p).resolve() for p in config["addons_paths"]]
    else:
        roots = []

        def walk(directory, depth):
            try:
                entries = sorted(os.scandir(directory), key=lambda e: e.name)
            except OSError:
                return
            has_module = False
            for entry in entries:
                if not entry.is_dir() or entry.name in SKIP_DIRS or entry.name.startswith("."):
                    continue
                if os.path.isfile(os.path.join(entry.path, "__manifest__.py")):
                    has_module = True
                elif depth < 3:
                    walk(entry.path, depth + 1)
            if has_module:
                roots.append(Path(directory))

        walk(root, 0)
    return roots, scan_modules(roots)


def closure(names, index):
    """Dependencies of `names` (inclusive) resolved in `index`; returns (found, missing)."""
    found, missing, stack = set(), set(), list(names)
    while stack:
        name = stack.pop()
        if name in found or name in missing:
            continue
        if name not in index:
            missing.add(name)
            continue
        found.add(name)
        stack.extend(read_manifest(index[name]).get("depends", []))
    return found, missing


def dependents(targets, project):
    """Project modules that depend, directly or not, on any of `targets` (excluding the targets)."""
    targets = set(targets)
    return {name for name in project if name not in targets and closure([name], project)[0] & targets}


def resolve_base(root, config):
    for branch in (config.get("base_branch"), config.get("production_branch")):
        if not branch:
            continue
        for ref in (f"origin/{branch}", branch):
            probe = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "-q", ref + "^{commit}"],
                                   capture_output=True)
            if probe.returncode == 0:
                return ref
    return None


def changed_files(root, base):
    """Files changed since `base` (committed or not) and untracked files; a changed submodule shows as its path."""
    files = set()
    if base:
        files.update(git(root, "diff", "--name-only", "--ignore-submodules=none", f"{base}...HEAD", check=False).splitlines())
    files.update(git(root, "diff", "--name-only", "--ignore-submodules=none", "HEAD", check=False).splitlines())
    files.update(git(root, "ls-files", "--others", "--exclude-standard", check=False).splitlines())
    return {f for f in files if f and not junk(f)}


def modules_for_files(root, files, index):
    """Modules that contain a changed file, or that live in a changed submodule."""
    touched = set()
    for name, path in index.items():
        try:
            rel = Path(path).relative_to(root).as_posix()
        except ValueError:
            continue
        if any(f.startswith(rel + "/") or rel.startswith(f.rstrip("/") + "/") for f in files):
            touched.add(name)
    return touched


def version_key(version):
    """Comparable form of a manifest version such as '19.0.1.2.0' (non-numeric parts compare as 0)."""
    return tuple(int(part) if part.isdigit() else 0 for part in str(version or "").split("."))


def version_notes(root, ref, modules, index, files):
    """Modules changed since `ref` whose manifest version did not increase (Odoo.sh won't update them)."""
    notes = []
    for name in sorted(modules):
        try:
            rel = index[name].relative_to(root).as_posix()
        except ValueError:
            continue
        old = subprocess.run(["git", "-C", str(root), "show", f"{ref}:{rel}/__manifest__.py"],
                             capture_output=True, text=True)
        if old.returncode:
            continue  # new module: Odoo.sh installs it, no update needed
        try:
            old_version = ast.literal_eval(old.stdout).get("version")
        except (ValueError, SyntaxError):
            continue
        new_version = read_manifest(index[name]).get("version")
        relevant = [f for f in files if (f.startswith(rel + "/") and "/tests/" not in f[len(rel):]
                                         and not f.endswith((".md", ".rst", ".txt")))
                    or rel.startswith(f.rstrip("/") + "/")]
        if relevant and version_key(new_version) <= version_key(old_version):
            notes.append(f"{name}: changed since {ref} but its manifest version {new_version!r} is not higher than "
                         f"{old_version!r}; Odoo.sh updates it on staging/production only when the version increases.")
    return notes


def file_digest(path):
    """sha256 of a file's content; for a symlink that points nowhere, of its target text."""
    path = Path(path)
    if path.is_symlink() and not path.exists():
        return sha("symlink:" + os.readlink(path))
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def git_paths(repo, *args):
    """Paths printed (NUL-separated) by a git command in `repo`; raises OhError when git fails."""
    out = subprocess.run(["git", "-C", str(repo), *args], capture_output=True)
    if out.returncode:
        raise OhError(f"`git {' '.join(args[:3])}` failed in {repo}: "
                      f"{out.stderr.decode(errors='replace').strip()[:200]}")
    return [p for p in out.stdout.decode("utf-8", "surrogateescape").split("\0") if p]


def repo_top(directory, cache):
    """Top of the git repository holding `directory` (a submodule is a repository of its own), or None."""
    directory = Path(directory)
    if directory not in cache:
        out = subprocess.run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
        top = out.stdout.strip()
        cache[directory] = Path(top).resolve() if out.returncode == 0 and top else None
    return cache[directory]


def fingerprint(root, modules, use_git=True):
    """Content ids of `modules` ({name: directory}) and what they can be trusted for.

    A module's files are listed by the git repository that holds them: the project, a submodule (nested
    ones too) or a checkout outside the project. Tracked and untracked files count, ignored ones don't,
    like the source Odoo.sh deploys; a module outside git is hashed file by file. An id is None when the
    module's files can't all be listed and read; `problems` then says why, and results are not reused.
    `use_git=False` hashes every file (an exported tree, such as a prior version for --upgrade-from).
    """
    root = Path(root).resolve()
    tops, groups = {}, {}
    for name, directory in sorted(modules.items()):
        directory = Path(directory).resolve()
        if not use_git:
            top = None
        elif (directory / ".git").exists():
            top = directory
        else:
            top = repo_top(directory.parent, tops)
        groups.setdefault(top, []).append((name, directory))
    ids, problems, ignored, repos = {}, [], {}, {}
    for top, members in groups.items():
        files = {name: [] for name, _ in members}
        skipped = {name: [] for name, _ in members}
        rels = {name: (directory.relative_to(top).as_posix() if top else None) for name, directory in members}
        try:
            if top:
                specs = sorted(set(rels.values()))
                listed = git_paths(top, "--literal-pathspecs", "ls-files", "-z", "-c", "-o", "--exclude-standard",
                                   "--", *specs)
                hidden = git_paths(top, "--literal-pathspecs", "ls-files", "-z", "-o", "-i", "--exclude-standard",
                                   "--", *specs)
                for bucket, paths in ((files, listed), (skipped, hidden)):
                    for path in paths:
                        owner = next((n for n, rel in rels.items() if rel == "." or path.startswith(rel + "/")), None)
                        if owner and not junk(path):
                            prefix = rels[owner]
                            bucket[owner].append(path if prefix == "." else path[len(prefix) + 1:])
                if top != root:
                    label = top.relative_to(root).as_posix() if top.is_relative_to(root) else str(top)
                    status = git(top, "status", "--porcelain", "--ignore-submodules=none", check=False)
                    repos[label] = {"head": git(top, "rev-parse", "HEAD", check=False) or None,
                                    "dirty": any(l and not junk(l) for l in status.splitlines())}
            else:
                for name, directory in members:
                    for folder, dirnames, filenames in os.walk(directory):
                        dirnames[:] = [d for d in dirnames if d != "__pycache__"]
                        for filename in filenames:
                            rel = os.path.relpath(os.path.join(folder, filename), directory).replace(os.sep, "/")
                            if not junk(rel):
                                files[name].append(rel)
                repos["(not in git)"] = {"head": None, "dirty": None}
        except OhError as exc:
            for name, _ in members:
                ids[name] = None
            problems.append(f"{', '.join(n for n, _ in members)}: {exc}")
            continue
        for name, directory in members:
            if skipped[name]:
                ignored[name] = sorted(skipped[name])[:5]
            if not files[name]:
                ids[name] = None
                problems.append(f"{name}: no files found in {directory} (ignored by .gitignore?)")
                continue
            lines = []
            try:
                for rel in sorted(files[name]):
                    path = directory / rel
                    if path.is_dir() and not path.is_symlink():
                        raise OhError(f"{rel} is a git submodule inside the module (not supported)")
                    if path.exists() or path.is_symlink():  # a deleted file simply isn't there any more
                        lines.append(f"{rel} {file_digest(path)}")
                if not any(line.startswith("__manifest__.py ") for line in lines):
                    raise OhError("its __manifest__.py is missing")
            except (OSError, OhError) as exc:
                ids[name] = None
                problems.append(f"{name}: cannot read its files ({exc})")
                continue
            ids[name] = sha("\n".join(lines))[:16]
    return {"modules": ids, "repos": repos, "problems": problems, "ignored": ignored}


def module_ids(root, modules, use_git=True):
    """{module: content id or None}: see fingerprint()."""
    return fingerprint(root, modules, use_git)["modules"]


def committed_modules(root, modules):
    """{module: True when its files match the project's HEAD (submodule commits included), False when
    they differ, None when the module is outside this repository}."""
    root = Path(root).resolve()
    if not git(root, "rev-parse", "--git-dir", check=False):
        return dict.fromkeys(modules)  # not a git repository: nothing is committed
    gitlinks = [line.split("\t", 1)[1] for line in git(root, "ls-files", "-s", check=False).splitlines()
                if line.startswith("160000 ")]
    bounds = {}
    for name, directory in modules.items():
        try:
            rel = Path(directory).resolve().relative_to(root).as_posix()
        except ValueError:
            bounds[name] = None
            continue
        bounds[name] = next((g for g in gitlinks if rel == g or rel.startswith(g + "/")), rel)
    specs = sorted({b for b in bounds.values() if b})
    changed = []
    if specs:
        entries = git_paths(root, "--literal-pathspecs", "status", "--porcelain", "-z", "--ignore-submodules=none",
                            "--", *specs)
        skip = False
        for entry in entries:
            if skip:  # the original path of a rename
                skip = False
                continue
            if len(entry) > 3 and not junk(entry[3:]):
                changed.append(entry[3:].rstrip("/"))
            skip = entry[:1] in ("R", "C")
    return {name: (None if bound is None else not any(c == bound or c.startswith(bound + "/")
                                                      or bound.startswith(c + "/") for c in changed))
            for name, bound in bounds.items()}


def source_identity(root, modules):
    found = fingerprint(root, modules)
    status = git(root, "status", "--porcelain", check=False)
    return {
        "format": FINGERPRINT_FORMAT,
        "head": git(root, "rev-parse", "HEAD", check=False) or None,
        "branch": git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or None,
        "dirty": any(line and not junk(line) for line in status.splitlines()),
        **found,
    }


def candidate(root, project):
    """What a review or record refers to: branch, commit and a digest of everything uncommitted
    (tracked changes, untracked files, and the module contents, submodules included)."""
    root = Path(root)
    head = git(root, "rev-parse", "HEAD", check=False) or None
    digest = hashlib.sha256((head or "-").encode())
    diff = subprocess.run(["git", "-C", str(root), "diff", "HEAD", "--binary", "--no-ext-diff", "--no-textconv",
                           "--ignore-submodules=none", "--submodule=short"], capture_output=True)
    digest.update(diff.stdout if diff.returncode == 0 else b"?")
    try:
        untracked = [p for p in git_paths(root, "ls-files", "-z", "-o", "--exclude-standard") if not junk(p)]
    except OhError:
        untracked = []
    for path in sorted(untracked):
        full = root / path
        digest.update(f"\n{path} {file_digest(full) if full.is_file() else '-'}".encode("utf-8", "surrogateescape"))
    ids = module_ids(root, project)
    digest.update(json.dumps(ids, sort_keys=True).encode())
    return {"branch": git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or None, "commit": head,
            "uncommitted": bool(diff.stdout.strip() or untracked), "digest": digest.hexdigest()[:16],
            "complete": all(ids.values())}


def head_info(root):
    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or "?"
    commit = git(root, "rev-parse", "--short", "HEAD", check=False) or "?"
    dirty = any(not junk(line) for line in git(root, "status", "--porcelain", check=False).splitlines())
    return f"{branch}@{commit}" + (" +uncommitted" if dirty else "")


def harness_identity(root):
    info = {"oh_sha256": sha_bytes(Path(__file__).read_bytes())[:16], "version": None, "commit": None}
    lock = read_json(Path(root) / ".odoo-harness" / "lock.json")
    if isinstance(lock, dict) and isinstance(lock.get("harness"), dict):
        info["version"] = lock["harness"].get("version")
        info["commit"] = (lock["harness"].get("commit") or "")[:12] or None
    return info


