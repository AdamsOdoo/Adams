                  + (" | partial" if entry["partial"] else ""))
            if not dry:
                entry["path"].unlink()
                shutil.rmtree(folder, ignore_errors=True)
        if not dry and plan:
            entries = [e for e in entries if not any(e is p for p, _ in plan)]
            print(f"  {len(entries)} record(s) remain: commit the deletions with the evidence")
        elif dry and plan:
            print(f"  oh evidence {'--prune-stale' if every_stale else '--prune'} deletes them")
    if prune and plan and not entries:
        print("no record remains" + (f" ({bad} unreadable file(s) aside)" if bad else "")
              + ": nothing proves the source until oh test or oh shot writes a record")
        return FAILED if bad else UNVERIFIED
    bad += sum(1 for e in entries if e["problems"])
    doubtful = sum(1 for e in entries if not e["problems"] and (e["status"] != "passed" or not e["current"] or e["notes"]))
    good = len(entries) - sum(1 for e in entries if e["problems"]) - doubtful
    partial = sum(1 for e in entries if e["partial"])
    print(f"{len(entries)} record(s): {good} passed, intact and current" + (f" ({partial} partial)" if partial else "")
          + f"; {doubtful} not verified, stale or older; {bad} with problems")
    return FAILED if bad else UNVERIFIED if doubtful else PASSED


def github_protection(root, branches, api=None):
    """How GitHub protects each deploy branch from the identity of the token used here.

    Returns (identity, [(branch, verdict, detail)]); verdict "enforced" means a ruleset restricts updates
    (pushes and merges) and that identity cannot bypass it; "not enforced" and "unknown" say why not.
    """
    remote = git(root, "remote", "get-url", "origin", check=False)
    # github.com URLs, and the Claude Code cloud git proxy (http://…@127.0.0.1:<port>/git/<owner>/<repo>)
    match = re.search(r"(?:github\.com[:/]|/git/)([^/:]+)/([^/]+?)(?:\.git)?/?$", remote or "")
    if not match:
        return None, [(None, "unknown", "not checked: origin is not a GitHub repository" if remote
                       else "not checked: no origin remote")]
    owner, repo = match.groups()
    if api is None:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if not token and shutil.which("gh"):
            token = run(["gh", "auth", "token"], check=False).stdout.strip()
        if not token:
            return None, [(None, "unknown", f"not checked: no GH_TOKEN/GITHUB_TOKEN or gh login; check {owner}/{repo} "
                                            "Settings > Rules on GitHub, or run oh doctor where a token is available")]

        def api(path):
            request = urllib.request.Request(f"https://api.github.com{path}", headers={
                "Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28"})
            with urllib.request.urlopen(request, timeout=20) as response:
                return json.loads(response.read().decode())

    try:
        identity = api("/user").get("login")
    except (urllib.error.HTTPError, OSError, ValueError, AttributeError):
        identity = None  # an app installation token has no user
    who = identity or "this token's identity"
    base = f"/repos/{owner}/{repo}"
    results = []
    for branch in branches:
        try:
            rules = api(f"{base}/rules/branches/{branch}")
            bypass = {}
            for ruleset_id in sorted({r.get("ruleset_id") for r in rules if r.get("type") == "update"} - {None}):
                ruleset = api(f"{base}/rulesets/{ruleset_id}?includes_parents=true")
                bypass[ruleset.get("name") or str(ruleset_id)] = ruleset.get("current_user_can_bypass")
            classic = False if bypass else bool(api(f"{base}/branches/{branch}").get("protected"))
        except urllib.error.HTTPError as exc:
            why = (" (the token can't read this repository's rules, or the network blocks api.github.com)"
                   if exc.code in (401, 403, 404) else "")
            results.append((branch, "unknown", f"not checked: GitHub answered {exc.code}{why}"))
            continue
        except (OSError, ValueError, AttributeError) as exc:
            results.append((branch, "unknown", f"not checked: {exc}"))
            continue
        types = sorted({r.get("type") for r in rules} - {None})
        blocking = [name for name, mode in bypass.items() if mode == "never"]
        if blocking:
            results.append((branch, "enforced", f"ruleset {blocking[0]!r} restricts updates and {who} cannot bypass it"))
        elif bypass and all(mode in ("always", "pull_requests_only", "exempt") for mode in bypass.values()):
            modes = ", ".join(f"{name!r}: {mode}" for name, mode in bypass.items())
            results.append((branch, "not enforced", f"{who} can bypass the update restriction ({modes})"))
        elif bypass:
            results.append((branch, "unknown", f"GitHub did not say whether {who} can bypass "
                                               f"{', '.join(map(repr, bypass))} (the token may not read rulesets)"))
        elif "pull_request" in types:
            results.append((branch, "not enforced", "pull requests are required, but anyone with write access, agents "
                                                    "included, can still merge one; add \"Restrict updates\" (oh protect)"))
        elif classic:
            results.append((branch, "unknown", "classic branch protection is on; whether it stops agents from pushing "
                                               "or merging needs admin access to read: use the ruleset from oh protect"))
        else:
            results.append((branch, "not enforced", f"nothing restricts updates ({', '.join(types) or 'no rules'}): "
                                                    "agents and people with write access can push to it"))
    return identity, results


def enterprise_status(env, config, sources):
    """One line on the Enterprise source: configured or not, and whether it is usable in this environment."""
    repo, path = config.get("enterprise_repo"), config.get("enterprise_path")
    if path:
        return f"configured: local checkout {path}"
    if not repo:
        return "not configured (Enterprise-dependent modules are verified on Odoo.sh)"
    info = sources.get("enterprise") or {}
    tree = env.cache / "src" / f"enterprise-{str(info.get('commit', ''))[:12]}"
    if info.get("commit") and tree.is_dir():
        return f"configured: {repo} @ {info['commit'][:12]}, source ready"
    ref = config.get("enterprise_ref") or config.get("odoo_ref") or "19.0"
    access = ("" if os.environ.get(ENTERPRISE_TOKEN) else
              f" and {ENTERPRISE_TOKEN} is not in the environment (add a GitHub token that can read it as a secret)")
    return (f"configured: {repo} @ {ref}, source not fetched yet{access}; until then Enterprise-dependent "
            "modules are BLOCKED locally and verified on Odoo.sh")


def harness_update(lock, probe=None, timeout=15):
    """One line on whether the harness repository recorded in lock.json has moved past the installed commit.
    `probe(url, branch)` returns the commit at the tip of that branch (None when unreachable); the default asks
    git ls-remote. A note, never a problem: the project runs the harness it installed until install.py is re-run."""
    harness = (lock or {}).get("harness") or {}
    url, branch, commit = harness.get("repository"), harness.get("branch") or "HEAD", harness.get("commit")
    if not url or not commit:
        return "harness repository not recorded in lock.json (installed by odoo-harness 1.3.1 or older): re-run install.py"

    def ls_remote(url, branch):
        ref = "HEAD" if branch == "HEAD" else f"refs/heads/{branch}"
        try:
            result = subprocess.run(["git", "ls-remote", "--exit-code", url, ref], capture_output=True, text=True,
                                    timeout=timeout, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
        except (subprocess.TimeoutExpired, OSError):
            return None
        return result.stdout.split()[0] if result.returncode == 0 and result.stdout.split() else None

    tip = (probe or ls_remote)(url, branch)
    where = f"{url}" + (f" branch {branch}" if branch != "HEAD" else "")
    if not tip:
        return f"harness repository {where}: not reachable from here, so a newer harness was not checked"
    if tip == commit:
        return f"harness repository {where}: the installed commit {commit[:12]} is its latest"
    return (f"harness repository {where} is at {tip[:12]}, newer than the installed {commit[:12]}: "
            "re-run install.py from it to update (CHANGELOG.md there says what changed)")


def cmd_deps(args):
    """The changed modules (or the given ones) with the project modules they depend on, as paths relative to the
    repository, one per line: `git diff --quiet A B -- $(oh deps)` says whether A and B differ in any of them."""
    root = project_root()
    config = load_config(root)
    _, project = discover_project(root, config)
    unknown = [m for m in args.modules if m not in project]
    if unknown:
        raise OhError(f"not modules of this project: {', '.join(unknown)} (known: {', '.join(sorted(project))})")
    if args.modules:
        targets = set(args.modules)
    else:
        targets = modules_for_files(root, changed_files(root, resolve_base(root, config)), project)
    found, _ = closure(sorted(targets), project)
    if not found:
        print("oh deps: no changed module (a branch that changes no module needs no upgrade run)", file=sys.stderr)
    for name in sorted(found):
        print(Path(project[name]).relative_to(root).as_posix())
    return PASSED


