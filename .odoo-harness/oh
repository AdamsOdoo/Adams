def github_protection(root, branches, api=None):
    """How GitHub protects each deploy branch from the identity of the token used here.

    Returns (identity, [(branch, verdict, detail)]); verdict "enforced" means a ruleset restricts updates
    (pushes and merges) and that identity cannot bypass it; "not enforced" and "unknown" say why not.
    """
    remote = git(root, "remote", "get-url", "origin", check=False)
    # github.com URLs, and the Claude Code cloud git proxy (http://…@127.0.0.1:<port>/git/<owner>/<repo>)
    match = re.search(r"(?:github\.com[:/]|/git/)([^/:]+)/([^/]+?)(?:\.git)?/?$", remote or "")
    if not match:
        return None, [(None, "unknown", "not checked: origin is not a GitHub repository" if remote
                       else "not checked: no origin remote")]
    owner, repo = match.groups()
    if api is None:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if not token and shutil.which("gh"):
            token = run(["gh", "auth", "token"], check=False).stdout.strip()
        if not token:
            return None, [(None, "unknown", f"not checked: no GH_TOKEN/GITHUB_TOKEN or gh login; check {owner}/{repo} "
                                            "Settings > Rules on GitHub, or run oh doctor where a token is available")]

        def api(path):
            request = urllib.request.Request(f"https://api.github.com{path}", headers={
                "Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28"})
            with urllib.request.urlopen(request, timeout=20) as response:
                return json.loads(response.read().decode())

    try:
        identity = api("/user").get("login")
    except (urllib.error.HTTPError, OSError, ValueError, AttributeError):
        identity = None  # an app installation token has no user
    who = identity or "this token's identity"
    base = f"/repos/{owner}/{repo}"
    results = []
    for branch in branches:
        try:
            rules = api(f"{base}/rules/branches/{branch}")
            bypass = {}
            for ruleset_id in sorted({r.get("ruleset_id") for r in rules if r.get("type") == "update"} - {None}):
                ruleset = api(f"{base}/rulesets/{ruleset_id}?includes_parents=true")
                bypass[ruleset.get("name") or str(ruleset_id)] = ruleset.get("current_user_can_bypass")
            classic = False if bypass else bool(api(f"{base}/branches/{branch}").get("protected"))
        except urllib.error.HTTPError as exc:
            why = (" (the token can't read this repository's rules, or the network blocks api.github.com)"
                   if exc.code in (401, 403, 404) else "")
            results.append((branch, "unknown", f"not checked: GitHub answered {exc.code}{why}"))
            continue
        except (OSError, ValueError, AttributeError) as exc:
            results.append((branch, "unknown", f"not checked: {exc}"))
            continue
        types = sorted({r.get("type") for r in rules} - {None})
        blocking = [name for name, mode in bypass.items() if mode == "never"]
        if blocking:
            results.append((branch, "enforced", f"ruleset {blocking[0]!r} restricts updates and {who} cannot bypass it"))
        elif bypass and all(mode in ("always", "pull_requests_only", "exempt") for mode in bypass.values()):
            modes = ", ".join(f"{name!r}: {mode}" for name, mode in bypass.items())
            results.append((branch, "not enforced", f"{who} can bypass the update restriction ({modes})"))
        elif bypass:
            results.append((branch, "unknown", f"GitHub did not say whether {who} can bypass "
                                               f"{', '.join(map(repr, bypass))} (the token may not read rulesets)"))
        elif "pull_request" in types:
            results.append((branch, "not enforced", "pull requests are required, but anyone with write access, agents "
                                                    "included, can still merge one; add \"Restrict updates\" (oh protect)"))
        elif classic:
            results.append((branch, "unknown", "classic branch protection is on; whether it stops agents from pushing "
                                               "or merging needs admin access to read: use the ruleset from oh protect"))
        else:
            results.append((branch, "not enforced", f"nothing restricts updates ({', '.join(types) or 'no rules'}): "
                                                    "agents and people with write access can push to it"))
    return identity, results


def cmd_doctor(args):
    root = project_root()
    problems, notes = verify_install(root)
    print("installation")
    for note in notes:
        print(f"  {note}")
    print("  " + ("files, AGENTS.md block, CLAUDE.md import, hooks and project.json ok" if not problems else
                  f"{len(problems)} problem(s):"))
    for problem in problems:
        print(f"    - {problem}")
    try:
        config = load_config(root)
    except OhError:
        return FAILED
    env = Env(root, config, quiet=True)
    state = env.state()
    sources = state.get("sources") or {}
    odoo = sources.get("odoo") or {}
    print("runtime")
    try:
        pg_ok = env.psql("SELECT 1", check=False).returncode == 0
    except OhError:
        pg_ok = False
    tree = env.cache / "src" / f"odoo-{str(odoo.get('commit', ''))[:12]}"
    print(f"  postgres    {'reachable' if pg_ok else 'not reachable (oh env starts it when run as root)'}")
    print("  odoo        " + (f"{odoo.get('ref')} @ {odoo['commit'][:12]} ({'pinned' if odoo.get('pinned') else 'resolved'}), "
                              + ("source ready" if tree.is_dir() else "source not fetched") if odoo.get("commit")
                              else "not prepared: run oh env"))
    print(f"  enterprise  " + ("configured" if config.get("enterprise_path") or config.get("enterprise_repo")
                               else "not configured (Enterprise-dependent modules are verified on Odoo.sh)"))
    print(f"  venvs       {len(list((env.cache / 'venvs').glob('*/.oh-ready.json')))} ready in {env.cache / 'venvs'}")
    print(f"  browser     {env.browser_bin() or 'none: screenshots and tours unavailable'}")
    print(f"  pdf         {'wkhtmltopdf ok' if shutil.which('wkhtmltopdf') else 'wkhtmltopdf missing: PDF output only on Odoo.sh'}")
    branches = protected_names(config)
    hook_ok = not any("hook" in p or "guard" in p or "disableAllHooks" in p for p in problems)
    print("deployment boundaries (three separate claims)")
    print("  1 hook       " + ("configured: guard.py checks Bash and GitHub MCP calls in Claude Code (with hooks enabled, "
                             "in a trusted workspace); a second line of defence, not the boundary" if hook_ok
                             else "NOT configured: see the installation problems above"))
    identity, results = github_protection(root, branches) if branches else (None, [(None, "unknown", "no branches")])
    print(f"  2 github     branch rules" + (f", as seen by {identity}" if identity else ""))
    for branch, verdict_, detail in results:
        print(f"    {branch}: {verdict_.upper()} - {detail}" if branch else f"    {detail}")
    verdicts = {v for _, v, _ in results}
    if verdicts == {"enforced"}:
        claim = (f"prevented for {identity or 'this token'} and any identity without bypass rights; an agent acting "
                 "as another identity (a GitHub app, a deploy key) is covered only if that identity is not on the "
                 "bypass list: check with that identity's token")
    elif "not enforced" in verdicts:
        claim = "NOT prevented: an agent with write access can push to or merge into an unprotected branch"
    else:
        claim = "unknown until the GitHub rules are checked with a token that can read them"
    print(f"  3 agents     {claim}")
    if "not enforced" in verdicts:
        print("  fix: oh protect prints the ruleset to import (GitHub > Settings > Rules > Rulesets)")
    records = sorted((root / EVIDENCE).glob("*.json"))
    print(f"evidence      {len(records)} record(s) in {EVIDENCE}/ (check them: oh evidence)")
    if problems or "not enforced" in verdicts:
        return FAILED
    return PASSED if verdicts == {"enforced"} else UNVERIFIED


PROTECT_HELP = """\
How to apply it (a repository admin, once per repository):
  GitHub > the repository > Settings > Rules > Rulesets > New ruleset > Import a ruleset, choose a file
  with the JSON above, review, Create. Or create a branch ruleset by hand with: target branches {branches};
  rules "Restrict updates", "Restrict deletions", "Block force pushes"; bypass list "Repository admin".
What it does: only repository admins (the people who promote releases) can push to or merge into those
branches; agents and everyone else work on feature branches and open pull requests.
Keep agent identities out of the bypass list: the Claude and ChatGPT GitHub apps, deploy keys, and any
token an agent uses. Give agents a token or app installation without admin rights.
Rulesets on private repositories need GitHub Pro, Team or Enterprise.
Odoo.sh: its merges from the Odoo.sh interface use the GitHub account that authorized Odoo.sh. After
enabling the ruleset, promote once from Odoo.sh; if GitHub rejects it, add that user to the bypass list.
Check the result with `oh doctor` wherever a GitHub token (GH_TOKEN) is available."""


def cmd_protect(args):
    root = project_root()
    config = load_config(root)
    if not config.get("production_branch"):
        raise OhError("set production_branch (and staging_branches) in .odoo-harness/project.json first")
    branches = protected_names(config)
    ruleset = {
        "name": "odoo-harness: Odoo.sh deploy branches",
        "target": "branch",
        "enforcement": "active",
        "conditions": {"ref_name": {"include": [f"refs/heads/{b}" for b in branches], "exclude": []}},
        "rules": [{"type": "deletion"}, {"type": "non_fast_forward"},
                  {"type": "update", "parameters": {"update_allows_fetch_and_merge": False}}],
        "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
    }
    print(json.dumps(ruleset, indent=2))
    print("\n" + PROTECT_HELP.format(branches=", ".join(branches)), file=sys.stderr)
    return PASSED


def cmd_clean(args):
    root = project_root()
    env = Env(root, load_config(root), quiet=True)
    env.ensure_postgres()
    if args.all_projects:
        stopped = 0
        for path in (env.cache / "projects").glob("*/state.json"):
            state = read_json(path, {}) or {}
            if server_alive(state.get("serve")):
                with contextlib.suppress(OSError):
                    os.killpg(state["serve"]["pid"], signal.SIGTERM)
                stopped += 1
            for key in ("serve", "kept", "last_db", "dbs"):
                state.pop(key, None)
            write_json(path, state)
        dropped = env.list_dbs("oh_")
        for name in dropped:
            env.drop_db(name, any_project=True)
        write_json(env.cache / "templates.json", {})
        print(f"all projects: stopped {stopped} server(s), dropped {len(dropped)} database(s) including templates")
        return PASSED
    stop_server(env)
    dropped = env.list_dbs(env.prefix)
    for name in dropped:
        env.drop_db(name)
    env.update_state(lambda state: [state.pop(key, None) for key in ("serve", "kept", "last_db", "dbs")])
    templates = []
    if args.templates:
        path = env.cache / "templates.json"
        with env.lock("templates"):
            registry = read_json(path, {}) or {}
        for name, entry in registry.items():
            if entry.get("projects") == [env.key]:  # shared templates stay for the other projects
                with env.lock(f"tpl-{name}", wait=False) as acquired:
                    if acquired:
                        env.drop_db(name)
                        templates.append(name)
        with env.lock("templates"):
            registry = read_json(path, {}) or {}
            for name in templates:
                registry.pop(name, None)
            write_json(path, registry)
    print(f"dropped {len(dropped)} database(s) of this project"
          + (f" and {len(templates)} template(s) only it used" if args.templates else "")
          + "; other projects were not touched")
    return PASSED


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(prog="oh", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("env", help="prepare PostgreSQL, the pinned Odoo source and the venv")
    p.add_argument("--update", action="store_true", help="move unpinned sources to the latest commit of their ref")
    p.add_argument("--prebuild", action="store_true", help="also build the template database for all project modules")
    p.add_argument("--background", action="store_true", help="run `env --prebuild` detached and return at once")
    p.add_argument("--if-remote", action="store_true", help="do nothing unless in a Claude Code cloud session")
    p = sub.add_parser("test", help="install modules in a disposable database and run their tests")
    p.add_argument("modules", nargs="*", help="project modules (default: modules changed vs the base branch)")
    p.add_argument("--all", action="store_true", help="install and test every project module, like an Odoo.sh build")
    p.add_argument("--tags", help="Odoo --test-tags spec (default: /<module> for each target); no evidence record")
    p.add_argument("--require", action="append", metavar="TEST",
                   help="a test that must run and pass: module:Class.method, Class.method or Class (repeatable)")
    p.add_argument("--with-dependents", action="store_true", help="also test project modules that depend on the targets")
    p.add_argument("--upgrade-from", metavar="REF", help="install the modules from a git ref first, then update to HEAD")
    p.add_argument("--fresh", action="store_true", help="no template: install everything in one run (slower)")
    p.add_argument("--no-demo", action="store_true", help="without demo data (Odoo.sh development builds load it)")
    p.add_argument("--keep", action="store_true", help="keep the database for oh serve / oh shell / oh shot")
    p.add_argument("--rerun", action="store_true", help="run even if the same source and environment already passed")
    p.add_argument("--no-record", action="store_true", help="don't write the result to .odoo-harness/evidence")
    p.add_argument("--timeout", type=int, default=3600)
    p = sub.add_parser("shell", help="run Python in odoo-bin shell on a kept database (changes are rolled back)")
    p.add_argument("-c", "--code", help="code to run (default: stdin)")
    p.add_argument("--db")
    p.add_argument("--timeout", type=int, default=600)
    p.add_argument("--max-lines", type=int, default=200)
    p = sub.add_parser("serve", help="run this project's Odoo server on a kept database")
    p.add_argument("--db")
    p.add_argument("--port", type=int)
    sub.add_parser("stop", help="stop this project's server")
    p = sub.add_parser("shot", help="checked screenshots of Odoo pages in each configured language")
    p.add_argument("paths", nargs="+", help="URL paths such as /odoo/action-sale.action_orders")
    p.add_argument("--db", help="kept database to show (default: the last one kept by oh test --keep)")
    p.add_argument("--langs", help="comma-separated language codes (default: project languages)")
    p.add_argument("--out", help="directory for verified screenshots (default: the oh cache)")
    p.add_argument("--expect", action="append", metavar="CSS", help="element that must be on every page (repeatable)")
    p.add_argument("--mobile", action="store_true", help="390x844 mobile viewport")
    p.add_argument("--login", default="admin", help="user to log in as, to check a role's view")
    p.add_argument("--password", default="admin")
    p.add_argument("--no-record", action="store_true", help="don't write the result to .odoo-harness/evidence")
    p = sub.add_parser("src", help="search the standard Odoo / Enterprise source")
    p.add_argument("pattern", nargs="?")
    p.add_argument("--module", action="append", help="limit to a standard module (repeatable)")
    p.add_argument("--glob", help="file glob, e.g. '*.py' or '*.xml'")
    p.add_argument("--where", metavar="MODULE", help="print where a standard module lives")
    p.add_argument("--max", type=int, default=40)
    p = sub.add_parser("i18n", help="export translation files (i18n/<lang>.po) from a kept database")
    p.add_argument("modules", nargs="+")
    p.add_argument("--lang", help="comma-separated language codes (default: project languages except en_US)")
    p.add_argument("--pot", action="store_true", help="also write the .pot template")
    p.add_argument("--db")
    sub.add_parser("evidence", help="list result records and whether they still match the source")
    sub.add_parser("doctor", help="check installation, settings, runtime and GitHub branch protection")
    sub.add_parser("protect", help="print a GitHub ruleset for the production and staging branches")
    p = sub.add_parser("clean", help="drop this project's databases")
    p.add_argument("--templates", action="store_true", help="also drop template databases only this project used")
    p.add_argument("--all-projects", action="store_true", help="drop every project's databases and templates")
    args = parser.parse_args(argv)
    args.argv = argv
    handler = {"env": cmd_env, "test": cmd_test, "shell": cmd_shell, "serve": cmd_serve, "stop": cmd_stop,
               "shot": cmd_shot, "src": cmd_src, "i18n": cmd_i18n, "evidence": cmd_evidence, "doctor": cmd_doctor,
               "protect": cmd_protect, "clean": cmd_clean}[args.command]
    try:
        return handler(args)
    except OhError as exc:
        print(f"oh {args.command}: {LABELS.get(exc.code, 'ERROR')} - {exc}", file=sys.stderr)
        return exc.code
    except subprocess.TimeoutExpired as exc:
        print(f"oh {args.command}: timed out: {exc}", file=sys.stderr)
        return SETUP
    except BrokenPipeError:  # the reader stopped early (`oh evidence | head -1`): not an error of oh
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 128 + signal.SIGPIPE


if __name__ == "__main__":
    sys.exit(main())
