def expected_segments(page, wanted):
    # /odoo/<part>/...: `action-<id or xmlid>` is shown as action-<id> or as the action's path; model names,
    # action paths, record ids and "new" are shown as requested (web/static/src/core/browser/router.js).
    accepted, reasons = [], []
    for part in wanted[1:]:
        if part.startswith("action-"):
            found = page.evaluate(ACTION, part[len("action-"):])
            if found.get("error"):
                reasons.append("requested action not found: " + str(found["error"])[:160])
                accepted.append({part})
            else:
                accepted.append({"action-%s" % found["id"], found.get("path")} - {None})
        else:
            accepted.append({part})
    return accepted, reasons


