                             "in a trusted workspace); a second line of defence, not the boundary" if hook_ok
                             else "NOT configured: see the installation problems above"))
    identity, results = github_protection(root, branches) if branches else (None, [(None, "unknown", "no branches")])
    print(f"  2 github     branch rules" + (f", as seen by {identity}" if identity else ""))
    for branch, verdict_, detail in results:
        print(f"    {branch}: {verdict_.upper()} - {detail}" if branch else f"    {detail}")
    verdicts = {v for _, v, _ in results}
    if verdicts == {"enforced"}:
        claim = (f"prevented for {identity or 'this token'} and any identity without bypass rights; an agent acting "
                 "as another identity (a GitHub app, a deploy key) is covered only if that identity is not on the "
                 "bypass list: check with that identity's token")
    elif "not enforced" in verdicts:
        claim = "NOT prevented: an agent with write access can push to or merge into an unprotected branch"
    else:
        claim = "unknown until the GitHub rules are checked with a token that can read them"
    print(f"  3 agents     {claim}")
    if "not enforced" in verdicts:
        print("  fix: oh protect prints the ruleset to import (GitHub > Settings > Rules > Rulesets)")
    records = sorted((root / EVIDENCE).glob("*.json"))
    print(f"evidence      {len(records)} record(s) in {EVIDENCE}/ (check them: oh evidence)")
    handoff = root / ".odoo-harness" / "HANDOFF.md"
    if handoff.is_file():
        text = handoff.read_text(encoding="utf-8")
        lines, size = len(text.splitlines()), len(text.encode())
        over = lines > HANDOFF_LINES or size > HANDOFF_BYTES
        print(f"handoff       {lines} lines, {size} bytes" + (
            f": over {HANDOFF_LINES} lines or {HANDOFF_BYTES} bytes; keep only the active track and the next action, "
            "move durable notes to the feature notes and status to the status file" if over else ""))
    if config.get("status_file"):
        status = root / config["status_file"]
        print(f"status file   {config['status_file']}" + ("" if status.is_file() else ": missing"))
    if problems or "not enforced" in verdicts:
        return FAILED
    return PASSED if verdicts == {"enforced"} else UNVERIFIED


