@contextlib.contextmanager
def git_credentials(url):
    """While active, git sends the token in OH_ENTERPRISE_TOKEN for `url` (an https URL) through git's
    environment configuration, so the token appears in no command line and no stored remote URL."""
    token = os.environ.get(ENTERPRISE_TOKEN)
    if not token or not str(url).startswith("https://"):
        yield
        return
    origin = "/".join(str(url).split("/", 3)[:3]) + "/"
    count = int(os.environ.get("GIT_CONFIG_COUNT") or 0)
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    added = {"GIT_CONFIG_COUNT": str(count + 1), f"GIT_CONFIG_KEY_{count}": f"http.{origin}.extraheader",
             f"GIT_CONFIG_VALUE_{count}": f"Authorization: basic {basic}"}
    saved = {key: os.environ.get(key) for key in added}
    os.environ.update(added)
    try:
        yield
    finally:
        for key, value in saved.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value


