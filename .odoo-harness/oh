            files.append({"path": shot["file"], "role": "screenshot", "sha256": shot["sha256"],
                          "bytes": target.stat().st_size})
        else:
            shot["file"] = rel if shot["accepted"] else f"diagnostic/{rel}"
            retained.append((captured, shot["file"], "screenshot" if shot["accepted"] else "diagnostic screenshot", False))
            if not shot["accepted"] and out and (out / rel).is_file():
                (out / rel).unlink()  # an earlier accepted image of this screen would now be misleading
                removed.append(str(out / rel))
    bad = [s for s in shots if not s["accepted"]]
    status = UNVERIFIED if bad or not shots else PASSED
    modules = (env.state().get("dbs") or {}).get(db, {}).get("modules") or {}
    record = {"kind": "shot", "command": command_line(args.argv), "harness": harness_identity(root),
              "environment": environment_record(env), "status": LABELS[status].lower(), "exit_code": status,
              "project": dict(source_identity(root, {m: project[m] for m in modules if m in project}), database_modules=modules),
              "database": db, "server": {k: entry.get(k) for k in ("started", "identity")}, "login": args.login,
              "kept": {k: v for k, v in ((env.state().get("dbs") or {}).get(db) or {}).items()
                       if k in ("created", "updated", "seed", "seed_failed", "languages")},
              "languages": langs, "shots": shots, "files": files, "finished": now_iso(), "finished_ts": time.time(),
              "seconds": {"total": round(time.time() - started)}}
    saved = save_record(env, name, record, not args.no_record, retained)
    shutil.rmtree(capture, ignore_errors=True)
    where = saved.with_suffix("") if saved else None
    print(f"oh shot: {LABELS[status]} - {len(shots) - len(bad)} of {len(shots)} screenshots verified | "
          f"db {db} | user {args.login} | languages {', '.join(langs)}")
    for shot in shots:
        folder = where or env.last_run.with_suffix("")
        location = shot["file"] if out and shot["accepted"] else f"{folder}/{shot['file']}"
        print(("  ok    " if shot["accepted"] else "  DIAG  ") + str(location)
              + ("" if shot["accepted"] else "  <- " + "; ".join(shot["reasons"])))
    if not saved:
        print(f"  record and images kept in the cache: {env.last_run} (--no-record)")
    for path in removed:
        print(f"  removed {path}: the new capture of that screen did not pass the checks")
    if bad:
        print("  DIAG images show what went wrong; they are not evidence of a working screen.")
    if len(shots) > len(bad):
