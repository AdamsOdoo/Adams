def cmd_env(args):
    root = project_root()
    config = load_config(root)
    if args.if_remote and os.environ.get("CLAUDE_CODE_REMOTE") != "true" and os.environ.get("OH_PREWARM") != "1":
        return PASSED
    if args.background:
        env = Env(root, config, quiet=True)
        env.logs.mkdir(parents=True, exist_ok=True)
        with open(env.logs / "prewarm.log", "w") as log:
            subprocess.Popen([sys.executable, __file__, "env", "--prebuild"], stdout=log, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True, cwd=str(root))
        return PASSED
    env = Env(root, config)
    env.ensure(update=args.update)
    roots, project = discover_project(root, config)
    std_index = scan_modules(env.standard_roots())
    sources = env.state().get("sources") or {}

    def how(kind):
        info = sources.get(kind) or {}
        return "pinned" if info.get("pinned") else f"resolved {str(info.get('resolved', '?'))[:10]}; `oh env --update` moves it"

    if not env.enterprise:
        enterprise = "not configured: modules that need Enterprise are verified on Odoo.sh builds"
    elif config.get("enterprise_repo"):
        enterprise = f"{env.enterprise_commit[:12]} ({how('enterprise')})"
    else:
        enterprise = f"{(env.enterprise_commit or 'unversioned')[:12]} at {env.enterprise}"
    lines = ["oh env: ready",
             f"  project     {root.name}: databases {env.prefix}*, state {env.home}",
             f"  postgres    {env.db['user']}@{env.db['host']}:{env.db['port']}",
             f"  odoo        {config['odoo_ref']} @ {env.odoo_commit[:12]} ({how('odoo')})",
             f"  enterprise  {enterprise}",
             f"  python    {env.python_version}, venv {env.venv_key} (packages {env.packages})",
             f"  browser     {env.browser_bin() or 'none (tours and screenshots unavailable)'}",
             f"  rtlcss      {'ok' if (env.rtlcss_dir or shutil.which('rtlcss')) else 'missing'}",
             f"  pdf         {'wkhtmltopdf ok' if shutil.which('wkhtmltopdf') else 'wkhtmltopdf missing: PDF output only on Odoo.sh'}",
             f"  modules     {len(project)} in {len(roots)} addons root(s)"
             + (f": {', '.join(str(r.relative_to(root)) or '.' for r in roots)}" if roots else "")]
    need, missing = closure(project, {**std_index, **project})
    if missing:
        lines.append(f"  missing     {', '.join(sorted(missing))} (not in local source; Enterprise or submodule?)")
    print("\n".join(lines))
    if args.prebuild and project and not missing:
        std, demo = need - set(project), bool(config["with_demo"])
        name, addons = env.template(std, roots, demo, bool(set(project) & set(std_index)))
        with env.lock(f"tpl-{name}"):
            env.build_template(name, std, addons, demo)
        env.touch_template(name)
        print(f"  template    {name} ready")
    return PASSED


def cmd_test(args):
    started = time.time()
    root = project_root()
    config = load_config(root)
    roots, project = discover_project(root, config)
    if not project:
        raise OhError("no Odoo modules found in this repository (looked for __manifest__.py up to 3 levels deep)")
    unknown = [m for m in args.modules if m not in project]
    if unknown:
        raise OhError(f"not modules of this project: {', '.join(unknown)} (known: {', '.join(sorted(project))})")
    base = resolve_base(root, config)
    files = changed_files(root, base)
    changed = modules_for_files(root, files, project)
    tag_modules = {m for spec in (args.tags or "").split(",") if spec and not spec.startswith("-")
                   for m in re.findall(r"/(\w+)", spec) if m in project}
    if args.modules:
        targets = required = set(args.modules)
    elif args.all:
        targets, required = set(project), set(tag_modules or changed)
    elif tag_modules:
        targets = required = set(tag_modules)
    else:
        targets = required = set(changed or project)
    if args.with_dependents:
        targets = targets | dependents(targets, project)
    targets, required = sorted(targets), set(required)
    requires = [(spec, parse_require(spec, project)) for spec in args.require or []]
    demo = bool(config["with_demo"]) and not args.no_demo
    kind = "upgrade" if args.upgrade_from else "test"
    name = evidence_name(kind, targets)
    to_project = not args.no_record and not args.tags

    env = Env(root, config)
    env.ensure()
    setup_done = time.time()
    env.cleanup_runs()
    std_index = scan_modules(env.standard_roots())
    index = {**std_index, **project}
    needed, missing = closure(project if args.all else targets, index)
    selection = {"modules": targets, "required": sorted(required), "tags": args.tags, "require": args.require or [],
                 "require_parsed": [list(parsed) for _, parsed in requires], "all": args.all,
                 "with_dependents": args.with_dependents, "demo": demo, "fresh": args.fresh, "upgrade_from": None}
    record = {"kind": kind, "command": command_line(args.argv), "harness": harness_identity(root),
              "environment": environment_record(env), "selection": selection, "identity": None}
    if missing:
        print(f"oh test: BLOCKED - modules not available locally: {', '.join(sorted(missing))}")
        print("  These are usually Odoo Enterprise (or submodule) modules. Either set enterprise_path/enterprise_repo")
        print("  in .odoo-harness/project.json, or push the branch and verify on an Odoo.sh development build.")
        record.update(status="blocked", exit_code=BLOCKED, reasons=[f"missing locally: {', '.join(sorted(missing))}"],
                      project=source_identity(root, {m: project[m] for m in sorted(needed & set(project))}),
                      finished=now_iso(), finished_ts=time.time())
        save_record(env, name, record, to_project)
        return BLOCKED
    project_needed = sorted(needed & set(project))
    all_needed, all_missing = closure(project, index)
    std = (all_needed if not all_missing else needed) - set(project)
    shadowed = bool(set(project) & set(std_index))
    tags = args.tags or ",".join(f"/{t}" for t in targets)
    upgrade = None
    if args.upgrade_from:
        old_root, old_commit = env.export_ref(args.upgrade_from)
        old_roots, old_project = discover_project(old_root, config)
        present = [t for t in targets if t in old_project]
        upgrade = {"ref": args.upgrade_from, "commit": old_commit, "present": present}
        selection["upgrade_from"] = {"ref": args.upgrade_from, "commit": old_commit}
        if present and not args.tags:
            tags += "," + ",".join(f"{UPGRADE_TAG}/{m}" for m in present)
    selection["tags"] = tags
    source = source_identity(root, {m: project[m] for m in project_needed})
    record["project"] = source
    notes = []
    doubts = source["problems"] + env.identity_problems + [
        f"{m} has files ignored by git ({', '.join(f)}): Odoo loads them locally, Odoo.sh never sees them"
        for m, f in sorted(source["ignored"].items())]
    if doubts:
        notes += [f"this result can't be matched exactly to its source, so it won't be reused: {d}" for d in doubts]
    else:
        record["identity"] = sha(json.dumps([selection, source["modules"], source["repos"], record["environment"],
                                             record["harness"]["oh_sha256"]], sort_keys=True, default=str))[:16]
    if env.packages_changed:
        notes.append("the venv's packages changed after it was created (installed by hand?); add what the "
                     "modules need to requirements.txt, or Odoo.sh won't have it")
    extra_reasons = []
    if upgrade:
        old_ids = module_ids(old_root, {m: old_project[m] for m in upgrade["present"]}, use_git=False)
        for module in upgrade["present"]:
            old_version = read_manifest(old_project[module]).get("version")
            new_version = read_manifest(project[module]).get("version")
            if old_ids.get(module) != source["modules"].get(module) and version_key(new_version) <= version_key(old_version):
                extra_reasons.append(f"{module} changed since {args.upgrade_from} but its version {new_version!r} is not "
                                     f"higher than {old_version!r}, so Odoo.sh will not update it on staging or production")
    if not (args.rerun or args.keep):
        found = find_reusable(env, record["identity"])
        if found:
            previous, folder = found
            reused = dict(previous, reused_from=previous.get("finished"), command=record["command"])
            saved = save_record(env, name, reused, to_project, reuse_folder=folder)
            minutes = round((time.time() - previous.get("finished_ts", time.time())) / 60)
            tests = previous.get("tests") or {}
            print(f"oh test: PASSED (reused) modules: {', '.join(targets)}")
            print(f"  the same source, environment and selection passed {minutes} min ago and its log is intact; "
                  "--rerun runs it again")
            print(f"  tests: {tests.get('executed', 0)} executed, {tests.get('skipped', 0)} skipped, "
                  f"{tests.get('failed', 0)} failed, {tests.get('errors', 0)} errors")
            if saved:
                print(f"evidence: {saved} (log: {saved.with_suffix('')}/odoo.log.gz)")
            return PASSED

    db = f"{env.prefix}run_{os.getpid()}_{int(time.time())}"
    log = env.log_file("test")
    mode, prepares, retained = "template", [], []
    demo_flag = ["--with-demo"] if demo else []
    template = None
    if args.fresh:
        mode = "fresh"
        extra = ["-i", ",".join(project_needed), *demo_flag, "--load-language", ",".join(env.load_languages())]
    else:
        template = env.clone_template(std, roots, demo, shadowed, db)
        extra = ["-i", ",".join(project_needed), *demo_flag]
    template_done = time.time()
    if upgrade:
        mode += f"+upgrade-from {args.upgrade_from}"
        present = upgrade["present"]
        if not present:
            notes.append(f"none of {', '.join(targets)} exists at {args.upgrade_from}: this is a first installation")
        else:
            old_needed, old_missing = closure(present, {**std_index, **old_project})
            if old_missing:
                env.drop_db(db)
                in_submodule = sorted(m for m in old_missing if m in project)
                raise OhError(f"prior version needs modules missing locally: {', '.join(sorted(old_missing))}"
                              + (" (modules in git submodules are not part of `git archive`, so --upgrade-from can't "
                                 "install their prior version)" if in_submodule else ""), BLOCKED)
            if args.fresh:
                env.psql(f'CREATE DATABASE "{db}"')
            prior = sorted(old_needed & set(old_project))
            prior_log = env.log_file("prior")
            rc = env.run_logged(env.odoo_server(db, env.addons_path(old_roots), "-i", ",".join(prior),
                                                "--stop-after-init", *demo_flag), prior_log, timeout=args.timeout)
            retained.append((prior_log, "prior.log.gz", "prior version log", True))
            prior_summary = parse_log(prior_log.read_text(errors="replace"))
            if rc or prior_summary["errors"]:
                env.drop_db(db)
                raise OhError(f"the prior version ({args.upgrade_from}) failed to install; log: {prior_log}")
            prepares = find_prepares(project, present)
            if prepares:
                shell = subprocess.run([str(a) for a in env.odoo("shell", "-c", env.conf, "-d", db,
                                                                 f"--addons-path={env.addons_path(old_roots)}",
                                                                 "--no-http", "--log-level=warn")],
                                       input=prepare_script(prepares), text=True, capture_output=True,
                                       env=env.runtime_env(), timeout=args.timeout)
                prepare_log = env.log_file("prepare")
                prepare_log.write_text(shell.stdout + shell.stderr)
                retained.append((prepare_log, "prepare.log.gz", "prepare_upgrade output", True))
                if shell.returncode or "OH_PREPARE_DONE" not in shell.stdout:
                    env.drop_db(db)
                    tail = (shell.stderr or shell.stdout).splitlines()[-12:]
                    print(f"oh test: FAILED - prepare_upgrade() failed on the prior version ({args.upgrade_from})")
                    print("\n".join("  | " + line[:220] for line in tail))
                    record.update(status="failed", exit_code=FAILED, finished=now_iso(), finished_ts=time.time(),
                                  reasons=["prepare_upgrade() failed on the prior version"], failures=tail[-3:])
                    save_record(env, name, record, to_project, retained)
                    return FAILED
                notes.append("prepared data on the prior version: "
                             + ", ".join(f"{m} ({p.name})" for m, p, _ in prepares))
            new_only = [m for m in project_needed if m not in old_project]
            extra = ["-u", ",".join(present), *(["-i", ",".join(new_only)] if new_only else []), *demo_flag]
    elif base:
        notes += version_notes(root, base, targets, project, files)
    argv = env.odoo_server(db, env.addons_path(roots), *extra, "--test-enable", f"--test-tags={tags}",
                           "--log-level=test", "--stop-after-init")
    odoo_started = time.time()
    try:
        rc = env.run_logged(argv, log, timeout=args.timeout)
    except subprocess.TimeoutExpired:
        rc = -1
        notes.append(f"timed out after {args.timeout}s")
    summary = parse_log(log.read_text(errors="replace"))
    need_checks, classes = set(), {}
    if upgrade and upgrade["present"]:
        classes = {m: upgrade_classes(project[m]) for m in upgrade["present"]}
        need_checks = {m for m, _ in summary["migrations"] if m in upgrade["present"]} | {m for m, _, _ in prepares}
    status, reasons = verdict(summary, rc, required, requires, classes, need_checks)
    reasons += extra_reasons
    if status == PASSED and extra_reasons:
        status = UNVERIFIED
    if rc and not summary["failures"] and not summary["errors"]:
        notes.append(f"odoo exited with code {rc}; see the log")
    finished = time.time()
    if args.keep:
        dropped = env.keep_db(db, source["modules"], targets)
        if dropped:
            notes.append(f"dropped older kept databases: {', '.join(dropped)}")
    else:
        env.drop_db(db)
    per, total = test_counts(summary)
    record.update(
        status=LABELS[status].lower(), exit_code=status, reasons=reasons, notes=notes,
        tests=dict(total, by_module=per), migrations=[f"module {m}: {t}" for m, t in summary["migrations"]],
        failures=[message.splitlines()[0][:200] for message, _ in summary["failures"][:10]]
        + [f"{logger}: {message.splitlines()[0][:200]}" for logger, message, _ in summary["errors"][:5]],
        upgrade_checks=({m: sorted(c) for m, c in classes.items()} if upgrade else None),
        need_checks=sorted(need_checks), extra_reasons=extra_reasons, odoo_exit_code=rc,
        database=(db if args.keep else "dropped"), template=template, finished=now_iso(finished), finished_ts=finished,
        seconds={"total": round(finished - started), "setup": round(setup_done - started),
                 "database": round(template_done - setup_done), "prior_version": round(odoo_started - template_done),
                 "odoo": round(finished - odoo_started)},
    )
    saved = save_record(env, name, record, to_project, [(log, "odoo.log.gz", "log", True)] + retained)
    markers = [str(p) for p in roots] + ["/tests/"]
    print(f"oh test: {LABELS[status]} ({round(finished - started)}s) modules: {', '.join(targets)}"
          + (f" (+{len(project_needed) - len(targets)} project deps)" if len(project_needed) > len(targets) else ""))
    print(f"  mode: {mode}{' +demo' if demo else ''} | tags: {tags} | project: {head_info(root)}")
    print(f"  odoo {config['odoo_ref']}@{env.odoo_commit[:8]} | enterprise: "
          + (str(env.enterprise_commit or 'local')[:8] if env.enterprise else "none") + f" | log: {log}")
    print(f"  db: {db} kept (oh serve / oh shell / oh shot use it)" if args.keep else "  db: dropped (--keep to inspect)")
    for line in report(summary, status, reasons, markers):
        print(line)
    for note in notes:
        print(f"note: {note}")
    if saved:
        print(f"evidence: {saved} (with its log in {saved.with_suffix('')}/)")
    return status


