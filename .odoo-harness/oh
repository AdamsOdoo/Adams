_manifests = {}


def read_manifest(module_dir):
    module_dir = Path(module_dir)
    if module_dir not in _manifests:
        _manifests[module_dir] = ast.literal_eval((module_dir / "__manifest__.py").read_text(encoding="utf-8"))
    return _manifests[module_dir]


def scan_modules(roots):
    """Map module name -> directory for each addons root; the first root wins, like Odoo's addons path."""
    index = {}
    for root in roots:
        try:
            entries = sorted(os.scandir(root), key=lambda e: e.name)
        except OSError:
            continue
        for entry in entries:
            if (entry.is_dir() and not entry.name.startswith(".")
                    and os.path.isfile(os.path.join(entry.path, "__manifest__.py"))):
                index.setdefault(entry.name, Path(entry.path))
    return index


def discover_project(root, config):
    """Return (addons roots, {module: dir}) for the project: configured paths or auto-detected ones."""
    if config.get("addons_paths"):
        roots = [(root / p).resolve() for p in config["addons_paths"]]
    else:
        roots = []

        def walk(directory, depth):
            try:
                entries = sorted(os.scandir(directory), key=lambda e: e.name)
            except OSError:
                return
            has_module = False
            for entry in entries:
                if not entry.is_dir() or entry.name in SKIP_DIRS or entry.name.startswith("."):
                    continue
                if os.path.isfile(os.path.join(entry.path, "__manifest__.py")):
                    has_module = True
                elif depth < 3:
                    walk(entry.path, depth + 1)
            if has_module:
                roots.append(Path(directory))

        walk(root, 0)
    return roots, scan_modules(roots)


def closure(names, index):
    """Dependencies of `names` (inclusive) resolved in `index`; returns (found, missing)."""
    found, missing, stack = set(), set(), list(names)
    while stack:
        name = stack.pop()
        if name in found or name in missing:
            continue
        if name not in index:
            missing.add(name)
            continue
        found.add(name)
        stack.extend(read_manifest(index[name]).get("depends", []))
    return found, missing


def dependents(targets, project):
    """Project modules that depend, directly or not, on any of `targets` (excluding the targets)."""
    targets = set(targets)
    return {name for name in project if name not in targets and closure([name], project)[0] & targets}


def resolve_base(root, config):
    for branch in (config.get("base_branch"), config.get("production_branch")):
        if not branch:
            continue
        for ref in (f"origin/{branch}", branch):
            probe = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "-q", ref + "^{commit}"],
                                   capture_output=True)
            if probe.returncode == 0:
                return ref
    return None


def changed_files(root, base):
    """Files changed since `base` (committed or not) and untracked files; a changed submodule shows as its path."""
    files = set()
    if base:
        files.update(git(root, "diff", "--name-only", "--ignore-submodules=none", f"{base}...HEAD", check=False).splitlines())
    files.update(git(root, "diff", "--name-only", "--ignore-submodules=none", "HEAD", check=False).splitlines())
    files.update(git(root, "ls-files", "--others", "--exclude-standard", check=False).splitlines())
    return {f for f in files if f and not junk(f)}


def modules_for_files(root, files, index):
    """Modules that contain a changed file, or that live in a changed submodule."""
    touched = set()
    for name, path in index.items():
        try:
            rel = Path(path).relative_to(root).as_posix()
        except ValueError:
            continue
        if any(f.startswith(rel + "/") or rel.startswith(f.rstrip("/") + "/") for f in files):
            touched.add(name)
    return touched


def version_key(version):
    """Comparable form of a manifest version such as '19.0.1.2.0' (non-numeric parts compare as 0)."""
    return tuple(int(part) if part.isdigit() else 0 for part in str(version or "").split("."))


def version_notes(root, ref, modules, index, files):
    """Modules changed since `ref` whose manifest version did not increase (Odoo.sh won't update them)."""
    notes = []
    for name in sorted(modules):
        try:
            rel = index[name].relative_to(root).as_posix()
        except ValueError:
            continue
        old = subprocess.run(["git", "-C", str(root), "show", f"{ref}:{rel}/__manifest__.py"],
                             capture_output=True, text=True)
        if old.returncode:
            continue  # new module: Odoo.sh installs it, no update needed
        try:
            old_version = ast.literal_eval(old.stdout).get("version")
        except (ValueError, SyntaxError):
            continue
        new_version = read_manifest(index[name]).get("version")
        relevant = [f for f in files if (f.startswith(rel + "/") and "/tests/" not in f[len(rel):]
                                         and not f.endswith((".md", ".rst", ".txt")))
                    or rel.startswith(f.rstrip("/") + "/")]
        if relevant and version_key(new_version) <= version_key(old_version):
            notes.append(f"{name}: changed since {ref} but its manifest version {new_version!r} is not higher than "
                         f"{old_version!r}; Odoo.sh updates it on staging/production only when the version increases.")
    return notes


def file_digest(path):
    """sha256 of a file's content; for a symlink that points nowhere, of its target text."""
    path = Path(path)
    if path.is_symlink() and not path.exists():
        return sha("symlink:" + os.readlink(path))
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def git_paths(repo, *args):
    """Paths printed (NUL-separated) by a git command in `repo`; raises OhError when git fails."""
    out = subprocess.run(["git", "-C", str(repo), *args], capture_output=True)
    if out.returncode:
        raise OhError(f"`git {' '.join(args[:3])}` failed in {repo}: "
                      f"{out.stderr.decode(errors='replace').strip()[:200]}")
    return [p for p in out.stdout.decode("utf-8", "surrogateescape").split("\0") if p]


def repo_top(directory, cache):
    """Top of the git repository holding `directory` (a submodule is a repository of its own), or None."""
    directory = Path(directory)
    if directory not in cache:
        out = subprocess.run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
        top = out.stdout.strip()
        cache[directory] = Path(top).resolve() if out.returncode == 0 and top else None
    return cache[directory]


def fingerprint(root, modules, use_git=True):
    """Content ids of `modules` ({name: directory}) and what they can be trusted for.

    A module's files are listed by the git repository that holds them: the project, a submodule (nested
    ones too) or a checkout outside the project. Tracked and untracked files count, ignored ones don't,
    like the source Odoo.sh deploys; a module outside git is hashed file by file. An id is None when the
    module's files can't all be listed and read; `problems` then says why, and results are not reused.
    `use_git=False` hashes every file (an exported tree, such as a prior version for --upgrade-from).
    """
    root = Path(root).resolve()
    tops, groups = {}, {}
    for name, directory in sorted(modules.items()):
        directory = Path(directory).resolve()
        if not use_git:
            top = None
        elif (directory / ".git").exists():
            top = directory
        else:
            top = repo_top(directory.parent, tops)
        groups.setdefault(top, []).append((name, directory))
    ids, problems, ignored, repos = {}, [], {}, {}
    for top, members in groups.items():
        files = {name: [] for name, _ in members}
        skipped = {name: [] for name, _ in members}
        rels = {name: (directory.relative_to(top).as_posix() if top else None) for name, directory in members}
        try:
            if top:
                specs = sorted(set(rels.values()))
                listed = git_paths(top, "--literal-pathspecs", "ls-files", "-z", "-c", "-o", "--exclude-standard",
                                   "--", *specs)
                hidden = git_paths(top, "--literal-pathspecs", "ls-files", "-z", "-o", "-i", "--exclude-standard",
                                   "--", *specs)
                for bucket, paths in ((files, listed), (skipped, hidden)):
                    for path in paths:
                        owner = next((n for n, rel in rels.items() if rel == "." or path.startswith(rel + "/")), None)
                        if owner and not junk(path):
                            prefix = rels[owner]
                            bucket[owner].append(path if prefix == "." else path[len(prefix) + 1:])
                if top != root:
                    label = top.relative_to(root).as_posix() if top.is_relative_to(root) else str(top)
                    status = git(top, "status", "--porcelain", "--ignore-submodules=none", check=False)
                    repos[label] = {"head": git(top, "rev-parse", "HEAD", check=False) or None,
                                    "dirty": any(l and not junk(l) for l in status.splitlines())}
            else:
                for name, directory in members:
                    for folder, dirnames, filenames in os.walk(directory):
                        dirnames[:] = [d for d in dirnames if d != "__pycache__"]
                        for filename in filenames:
                            rel = os.path.relpath(os.path.join(folder, filename), directory).replace(os.sep, "/")
                            if not junk(rel):
                                files[name].append(rel)
                repos["(not in git)"] = {"head": None, "dirty": None}
        except OhError as exc:
            for name, _ in members:
                ids[name] = None
            problems.append(f"{', '.join(n for n, _ in members)}: {exc}")
            continue
        for name, directory in members:
            if skipped[name]:
                ignored[name] = sorted(skipped[name])[:5]
            if not files[name]:
                ids[name] = None
                problems.append(f"{name}: no files found in {directory} (ignored by .gitignore?)")
                continue
            lines = []
            try:
                for rel in sorted(files[name]):
                    path = directory / rel
                    if path.is_dir() and not path.is_symlink():
                        raise OhError(f"{rel} is a git submodule inside the module (not supported)")
                    if path.exists() or path.is_symlink():  # a deleted file simply isn't there any more
                        lines.append(f"{rel} {file_digest(path)}")
                if not any(line.startswith("__manifest__.py ") for line in lines):
                    raise OhError("its __manifest__.py is missing")
            except (OSError, OhError) as exc:
                ids[name] = None
                problems.append(f"{name}: cannot read its files ({exc})")
                continue
            ids[name] = sha("\n".join(lines))[:16]
    return {"modules": ids, "repos": repos, "problems": problems, "ignored": ignored}


def module_ids(root, modules, use_git=True):
    """{module: content id or None}: see fingerprint()."""
    return fingerprint(root, modules, use_git)["modules"]


def committed_modules(root, modules):
    """{module: True when its files match the project's HEAD (submodule commits included), False when
    they differ, None when the module is outside this repository}."""
    root = Path(root).resolve()
    if not git(root, "rev-parse", "--git-dir", check=False):
        return dict.fromkeys(modules)  # not a git repository: nothing is committed
    gitlinks = [line.split("\t", 1)[1] for line in git(root, "ls-files", "-s", check=False).splitlines()
                if line.startswith("160000 ")]
    bounds = {}
    for name, directory in modules.items():
        try:
            rel = Path(directory).resolve().relative_to(root).as_posix()
        except ValueError:
            bounds[name] = None
            continue
        bounds[name] = next((g for g in gitlinks if rel == g or rel.startswith(g + "/")), rel)
    specs = sorted({b for b in bounds.values() if b})
    changed = []
    if specs:
        entries = git_paths(root, "--literal-pathspecs", "status", "--porcelain", "-z", "--ignore-submodules=none",
                            "--", *specs)
        skip = False
        for entry in entries:
            if skip:  # the original path of a rename
                skip = False
                continue
            if len(entry) > 3 and not junk(entry[3:]):
                changed.append(entry[3:].rstrip("/"))
            skip = entry[:1] in ("R", "C")
    return {name: (None if bound is None else not any(c == bound or c.startswith(bound + "/")
                                                      or bound.startswith(c + "/") for c in changed))
            for name, bound in bounds.items()}


def source_identity(root, modules):
    found = fingerprint(root, modules)
    status = git(root, "status", "--porcelain", check=False)
    return {
        "format": FINGERPRINT_FORMAT,
        "head": git(root, "rev-parse", "HEAD", check=False) or None,
        "branch": git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or None,
        "dirty": any(line and not junk(line) for line in status.splitlines()),
        **found,
    }


def candidate(root, project):
    """What a review or record refers to: branch, commit and a digest of everything uncommitted
    (tracked changes, untracked files, and the module contents, submodules included)."""
    root = Path(root)
    head = git(root, "rev-parse", "HEAD", check=False) or None
    digest = hashlib.sha256((head or "-").encode())
    diff = subprocess.run(["git", "-C", str(root), "diff", "HEAD", "--binary", "--no-ext-diff", "--no-textconv",
                           "--ignore-submodules=none", "--submodule=short"], capture_output=True)
    digest.update(diff.stdout if diff.returncode == 0 else b"?")
    try:
        untracked = [p for p in git_paths(root, "ls-files", "-z", "-o", "--exclude-standard") if not junk(p)]
    except OhError:
        untracked = []
    for path in sorted(untracked):
        full = root / path
        digest.update(f"\n{path} {file_digest(full) if full.is_file() else '-'}".encode("utf-8", "surrogateescape"))
    ids = module_ids(root, project)
    digest.update(json.dumps(ids, sort_keys=True).encode())
    return {"branch": git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or None, "commit": head,
            "uncommitted": bool(diff.stdout.strip() or untracked), "digest": digest.hexdigest()[:16],
            "complete": all(ids.values())}


def head_info(root):
    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or "?"
    commit = git(root, "rev-parse", "--short", "HEAD", check=False) or "?"
    dirty = any(not junk(line) for line in git(root, "status", "--porcelain", check=False).splitlines())
    return f"{branch}@{commit}" + (" +uncommitted" if dirty else "")


def harness_identity(root):
    info = {"oh_sha256": sha_bytes(Path(__file__).read_bytes())[:16], "version": None, "commit": None}
    lock = read_json(Path(root) / ".odoo-harness" / "lock.json")
    if isinstance(lock, dict) and isinstance(lock.get("harness"), dict):
        info["version"] = lock["harness"].get("version")
        info["commit"] = (lock["harness"].get("commit") or "")[:12] or None
    return info


# --------------------------------------------------------------------------- installation checks

def extract_block(text):
    """Return (block, count): the managed block of AGENTS.md, or None when it is missing or damaged."""
    starts, ends = text.count(BLOCK_START), text.count(BLOCK_END)
    if not starts and not ends:
        return None, 0
    if starts != 1 or ends != 1 or text.index(BLOCK_END) < text.index(BLOCK_START):
        return None, max(starts, ends, 2)
    start = text.index(BLOCK_START)
    return text[start:text.index(BLOCK_END) + len(BLOCK_END)], 1


def hook_present(settings, entry):
    for group in (settings.get("hooks") or {}).get(entry["event"]) or []:
        if group.get("matcher") == entry.get("matcher") and entry["hook"] in (group.get("hooks") or []):
            return True
    return False


def legacy_files(root):
    """Files of the v0.2 harness overlay; they describe a different workflow and must not be mixed in."""
    root = Path(root)
    found = []
    skills = root / ".agents" / "skills"
    if skills.is_dir():
        found += [f".agents/skills/{p.name}" for p in sorted(skills.iterdir()) if p.name.startswith("odoo19-")]
    if (root / "HARNESS_SETUP.md").is_file():
        found.append("HARNESS_SETUP.md")
    data = read_json(root / ".odoo-harness" / "project.json")
    if isinstance(data, dict) and ("schema_version" in data or "project_id" in data):
        found.append(".odoo-harness/project.json (v0.2 format)")
    return found


def verify_install(root):
    """Check an installed project against its lock.json. Returns (problems, notes)."""
    root = Path(root)
    problems, notes = [], []
    lock = read_json(root / ".odoo-harness" / "lock.json")
    if not isinstance(lock, dict):
        return ["not installed: .odoo-harness/lock.json is missing or unreadable (run install.py)"], notes
    harness = lock.get("harness") or {}
    notes.append(f"odoo-harness {harness.get('version')} @ {str(harness.get('commit'))[:12]}"
                 + (" (installed from uncommitted harness files)" if harness.get("dirty") else ""))
    for rel, digest in sorted((lock.get("files") or {}).items()):
        target = root / rel
        if not target.is_file():
            problems.append(f"missing {rel}")
        elif sha_bytes(target.read_bytes()) != digest:
            problems.append(f"changed {rel}")
        elif rel in (".odoo-harness/oh", ".odoo-harness/guard.py") and not os.access(target, os.X_OK):
            problems.append(f"{rel} is not executable")
        if rel.startswith(".claude/skills/"):  # both clients must read the same skill, whatever the lock says
            twin = root / ".agents" / "skills" / rel[len(".claude/skills/"):]
            if target.is_file() and twin.is_file() and target.read_bytes() != twin.read_bytes():
                problems.append(f"{rel} differs from its copy in .agents/skills (the two clients would disagree)")
    agents = root / "AGENTS.md"
    block, count = extract_block(agents.read_text(encoding="utf-8") if agents.is_file() else "")
    if count == 0:
        problems.append("AGENTS.md has no odoo-harness block")
    elif block is None:
        problems.append("AGENTS.md has a damaged or duplicated odoo-harness block")
    elif lock.get("block") and sha(block) != lock["block"]:
        problems.append("the odoo-harness block in AGENTS.md differs from the installed one")
    claude = root / "CLAUDE.md"
    if claude.is_symlink():
        if claude.resolve() != agents.resolve():
            problems.append("CLAUDE.md is a symlink that does not point to AGENTS.md")
    elif not claude.is_file() or "@AGENTS.md" not in [l.strip() for l in claude.read_text(encoding="utf-8").splitlines()]:
        problems.append("CLAUDE.md does not import @AGENTS.md (Claude Code would not read AGENTS.md)")
    for name in ("settings.json", "settings.local.json"):
        path = root / ".claude" / name
        if not path.is_file():
            if name == "settings.json":
                problems.append(".claude/settings.json is missing, so the guard hook is not configured")
            continue
        data = read_json(path)
        if not isinstance(data, dict):
            problems.append(f".claude/{name} is not valid JSON")
            continue
        if data.get("disableAllHooks"):
            problems.append(f".claude/{name} sets disableAllHooks, so the guard does not run")
        if name == "settings.json":
            for entry in lock.get("hooks") or LEGACY_HOOKS:
                if not hook_present(data, entry):
                    problems.append(f"hook missing or changed in .claude/settings.json: {entry['event']} "
                                    f"[{entry.get('matcher')}] {entry['hook'].get('command')}")
            wanted = lock.get("permissions") or []
            allow = (data.get("permissions") or {}).get("allow") or []
            absent = [p for p in wanted if p not in allow]
            if absent:  # a convenience, not a boundary: fewer permission prompts
                notes.append(f"{len(absent)} of the harness's {len(wanted)} permission allowlist entries are not in "
                             f".claude/settings.json (more permission prompts; e.g. {absent[0]})")
    user_settings = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "settings.json"
    data = read_json(user_settings)
    if isinstance(data, dict) and data.get("disableAllHooks"):
        problems.append(f"{user_settings} sets disableAllHooks, so the guard does not run for this user")
    try:
        problems += [f"project.json: {p}" for p in config_problems(load_config(root))]
    except OhError as exc:
        problems.append(str(exc))
    problems += [f"legacy v0.2 harness file present: {p}" for p in legacy_files(root)]
    if not lock.get("hooks"):
        notes.append("installed by odoo-harness 1.0.0: re-run install.py so the lock records the hooks and the block")
    return problems, notes


# --------------------------------------------------------------------------- log parsing and verdicts

def parse_log(text):
    """Summarise an Odoo log: per-module tests (started, skipped, failed, errored), other errors, warnings."""
    records = []
    for line in text.splitlines():
        match = HEADER.match(line)
        if match:
            records.append([match.group(2), match.group(4), match.group(5).rstrip(), [], match.group(1)])  # Odoo ends lines with a space
        elif records:
            records[-1][3].append(line)
    summary = {"result": None, "tests": {}, "failures": [], "errors": [], "warnings": {}, "migrations": [], "timings": [],
               "stats": {}}

    def bucket(module):
        return summary["tests"].setdefault(module, {"started": [], "skipped": [], "failed": [], "errors": []})

    def stamp(text_):
        try:
            return time.mktime(time.strptime(text_[:19], "%Y-%m-%d %H:%M:%S")) + int(text_[20:23]) / 1000
        except (ValueError, TypeError):
            return None

    running = None  # (module, test, started_at): tests run one after the other, so the next log line ends it

    def close_running(at):
        nonlocal running
        if running and at is not None and running[2] is not None:
            summary["timings"].append((running[0], running[1], round(at - running[2], 1)))
        running = None

    for level, logger, message, body, when in records:
        found = RESULT.search(message)
        if logger.startswith("odoo.tests") and found:
            close_running(stamp(when))
            summary["result"] = tuple(int(x) for x in found.groups())
            continue
        if logger == "odoo.tests.stats":
            found = STATS.match(message)  # Odoo's own per-module time: setUpClass counts for its class's module
            if found:
                summary["stats"][found.group(1)] = float(found.group(2))
            continue
        if logger == "odoo.modules.migration" and "Running upgrade" in message:
            match = re.match(r"module (\w+): Running upgrade (.*)", message)
            summary["migrations"].append((match.group(1), match.group(2)) if match else ("?", message))
            continue
        test_logger = ".tests" in logger or logger == "unittest.suite"
        where = ADDON.match(logger + ".") if logger.startswith("odoo.addons.") else ADDON.search(message)
        module = where.group(1) if (where and test_logger) else None
        if level == "INFO" and module:
            if message.startswith("Starting ") and message.endswith(" ..."):
                test = message[len("Starting "):-len(" ...")]
                bucket(module)["started"].append(test)
                close_running(stamp(when))
                running = (module, test, stamp(when))
                continue
            if message.startswith("skipped "):
                bucket(module)["skipped"].append(message[len("skipped "):].split(" : ", 1)[0])
                continue
        if running and not test_logger and logger.startswith("odoo.modules"):
            close_running(stamp(when))  # the module's tests are over (loading moved on)
        if level in ("ERROR", "CRITICAL"):
            if message.startswith(("FAIL:", "ERROR:")):
                kind, _, rest = message.partition(": ")
                if module:
                    bucket(module)["failed" if kind == "FAIL" else "errors"].append(rest.strip())
                summary["failures"].append((message, body))
            else:
                summary["errors"].append((logger, message, body))
        elif level == "WARNING":
            key = f"{logger}: {message[:220]}"
            summary["warnings"][key] = summary["warnings"].get(key, 0) + 1
    return summary


def executed_tests(summary):
    """{module: [Class.method, ...]} for the tests that ran (started and not skipped)."""
    result = {}
    for module, info in summary["tests"].items():
        skipped = list(info["skipped"])
        tests = []
        for test in info["started"]:
            if test in skipped:
                skipped.remove(test)
            else:
                tests.append(test)
        result[module] = tests
    return result


def test_counts(summary):
    executed = executed_tests(summary)
    per = {module: {"executed": len(executed[module]), "skipped": len(info["skipped"]),
                    "failed": len(info["failed"]), "errors": len(info["errors"])}
           for module, info in summary["tests"].items()}
    total = {key: sum(c[key] for c in per.values()) for key in ("executed", "skipped", "failed", "errors")}
    for module, test, seconds in summary.get("timings") or []:
        if module in per:
            per[module]["seconds"] = round(per[module].get("seconds", 0) + seconds, 1)
    # Odoo's odoo.tests.stats time is the better figure: it counts a class's setUpClass for its own module, where the
    # gap between two "Starting" lines gives it to the previous test (the client demo's 2-minute load, ADR-0005).
    for module, seconds in (summary.get("stats") or {}).items():
        if module in per:
            per[module]["seconds"] = round(seconds, 1)
    total["seconds"] = round(sum(c.get("seconds", 0) for c in per.values()), 1)
    return per, total


def merge_summaries(summaries):
    """One summary for a run split into parallel parts (each part parsed on its own log)."""
    merged = {"result": None, "tests": {}, "failures": [], "errors": [], "warnings": {}, "migrations": [], "timings": [],
              "stats": {}}
    results = [s["result"] for s in summaries if s["result"]]
    if results:
        merged["result"] = tuple(sum(r[i] for r in results) for i in range(3))
    for summary in summaries:
        for module, info in summary["tests"].items():
            into = merged["tests"].setdefault(module, {"started": [], "skipped": [], "failed": [], "errors": []})
            for key in into:
                into[key].extend(info[key])
        for key in ("failures", "migrations", "timings"):
            merged[key].extend(summary[key])
        merged["stats"].update(summary.get("stats") or {})
        # Every part installs every module, so install-time errors and warnings appear once per part: count them once.
        seen = {(logger, message) for logger, message, _ in merged["errors"]}
        merged["errors"].extend(e for e in summary["errors"] if (e[0], e[1]) not in seen)
        for key, count in summary["warnings"].items():
            merged["warnings"][key] = max(merged["warnings"].get(key, 0), count)
    if len(results) < len(summaries):
        merged["result"] = None  # a part reported no result: the run is not complete
    return merged


PART_MARK = re.compile(r"^===== oh test part \d+/\d+: .* =====$", re.M)


def parse_run_log(text):
    """parse_log for a run's log, which may hold several parallel parts (merged part by part)."""
    if not PART_MARK.search(text):
        return parse_log(text)
    return merge_summaries([parse_log(part) for part in PART_MARK.split(text) if part.strip()])


def module_seconds(root):
    """Each module's test time in its newest evidence record, to balance parallel parts. The newest record, not the
    longest time ever: a module whose tests got faster or slower keeps its old weight otherwise, and the parts end up
    unbalanced (a 422 s run whose parts took 229, 373 and 116 s, ADR-0005)."""
    seconds, when = {}, {}
    for path in (root / EVIDENCE).glob("test-*.json"):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if (record.get("selection") or {}).get("partial"):  # a --tags run: its times are not the module's
            continue
        finished = record.get("finished_ts") or 0
        for module, counts in ((record.get("tests") or {}).get("by_module") or {}).items():
            if finished >= when.get(module, -1):
                seconds[module], when[module] = counts.get("seconds") or 0, finished
    return seconds


def split_parts(targets, jobs, seconds, default=30.0):
    """Balance the target modules over `jobs` parts by their past test seconds (longest first)."""
    parts = [[] for _ in range(jobs)]
    loads = [0.0] * jobs
    def weight(module):
        return seconds[module] if seconds.get(module) is not None else default

    for module in sorted(targets, key=lambda m: -weight(m)):
        i = loads.index(min(loads))
        parts[i].append(module)
        loads[i] += weight(module)
    return [sorted(part) for part in parts if part]


def slowest_tests(summary, limit=5, floor=3.0):
    """The slowest tests, longest first, when they take at least `floor` seconds (the test budget is checkable)."""
    timings = sorted(summary.get("timings") or [], key=lambda t: -t[2])
    return [(m, t, s) for m, t, s in timings[:limit] if s >= floor]


def parse_require(spec, modules):
    """`module:Class.method`, `module:Class`, `module`, `Class.method` or `Class` -> (module, test)."""
    if ":" in spec:
        module, _, test = spec.partition(":")
        return module or None, test or None
    if spec in modules:
        return spec, None
    return None, spec


def require_matches(require, module, test):
    want_module, want_test = require
    return ((want_module is None or want_module == module)
            and (want_test is None or test == want_test or test.startswith(want_test + ".")))


def verdict(summary, returncode, required=(), requires=(), upgrade_classes=None, need_checks=()):
    """Return (status, reasons). PASSED only when every required module, test and upgrade check ran."""
    result = summary["result"]
    if summary["failures"] or summary["errors"] or (result and (result[0] or result[1])) or returncode:
        return FAILED, []
    if not result:
        return UNVERIFIED, ["Odoo reported no test result (the run stopped before the tests finished?)"]
    _, total = test_counts(summary)
    if not total["executed"]:
        return UNVERIFIED, ["all selected tests were skipped" if total["skipped"] else
                            "no test ran: check that tests/__init__.py imports the test files and that --tags matches them"]
    executed = executed_tests(summary)
    reasons = []
    for module in sorted(required):
        if not executed.get(module):
            skipped = len(summary["tests"].get(module, {}).get("skipped", []))
            reasons.append(f"{module}: " + (f"all {skipped} of its selected tests were skipped" if skipped
                                            else "none of its tests ran (it has no tests, or --tags excluded them)"))
    for spec, parsed in requires:
        if not any(require_matches(parsed, m, t) for m, tests in executed.items() for t in tests):
            reasons.append(f"required test did not run: {spec}")
    for module in sorted(need_checks):
        classes = (upgrade_classes or {}).get(module, set())
        if not any(t.split(".")[0] in classes for t in executed.get(module, [])):
            reasons.append(f"{module}: the upgrade changed data (migration script or prepare_upgrade), but no test "
                           f"tagged '{UPGRADE_TAG}' checked the result")
    return (UNVERIFIED if reasons else PASSED), reasons


def excerpt(body, markers, limit=14):
    lines = [l.rstrip() for l in body if l.strip()]
    keep = []
    for i, line in enumerate(lines):
        if any(m and m in line for m in markers):
            keep.extend(lines[i:i + 2])
    selected = list(dict.fromkeys(keep[-6:] + lines[-5:]))
    return selected[-limit:]


def report(summary, status, reasons, markers, max_items=8):
    out = []
    per, total = test_counts(summary)
    if summary["result"] or total["executed"] or total["skipped"]:
        modules = ", ".join(f"{m} {c['executed']}" + (f" (+{c['skipped']} skipped)" if c["skipped"] else "")
                            for m, c in sorted(per.items()))
        out.append(f"tests: {total['executed']} executed, {total['skipped']} skipped, {total['failed']} failed, "
                   f"{total['errors']} errors" + (f" in {total['seconds']}s" if total.get("seconds") else "")
                   + (f" | {modules}" if modules else ""))
        slow = slowest_tests(summary)
        if slow:
            out.append("slowest tests: " + ", ".join(f"{t} {s}s" for _, t, s in slow))
    for reason in reasons:
        out.append(f"not verified: {reason}")
    if summary["migrations"]:
        out.append("migrations run: " + "; ".join(f"module {m}: {text}" for m, text in summary["migrations"][:10]))
    for message, body in summary["failures"][:max_items]:
        out.append(message.splitlines()[0][:200])
        out.extend("  | " + l[:220] for l in excerpt(body, markers))
    if len(summary["failures"]) > max_items:
        out.append(f"... {len(summary['failures']) - max_items} more failing tests (see log)")
    for logger, message, body in summary["errors"][:max_items]:
        out.append(f"error {logger}: {message.splitlines()[0][:200]}")
        out.extend("  | " + l[:220] for l in excerpt(body, markers, limit=8))
    if len(summary["errors"]) > max_items:
        out.append(f"... {len(summary['errors']) - max_items} more errors (see log)")
    warnings = summary["warnings"]
    project = {k: v for k, v in warnings.items() if not ENV_WARNINGS.search(k)}
    if project:
        out.append(f"warnings ({len(project)} unique; Odoo.sh marks builds with warnings as 'almost successful'):")
        for key, count in list(project.items())[:max_items]:
            out.append(f"  - {key}" + (f" (x{count})" if count > 1 else ""))
    env_count = len(warnings) - len(project)
    if env_count:
        out.append(f"({env_count} local-environment warnings hidden, e.g. wkhtmltopdf/rtlcss; see log)")
    return out


# --------------------------------------------------------------------------- static checks

def check_xml(path, text):
    problems = []
    try:
        import xml.etree.ElementTree as ElementTree
        ElementTree.fromstring(text.encode("utf-8"))
    except Exception as exc:  # malformed XML fails the Odoo install minutes later
        return [f"{path}: XML is not well formed: {str(exc)[:160]}"]
    # Comments are blanked (keeping the line numbers) so an old form quoted in a comment doesn't count.
    visible = re.sub(r"<!--.*?-->", lambda m: re.sub(r"[^\n]", " ", m.group(0)), text, flags=re.S)
    for number, line in enumerate(visible.splitlines(), 1):
        for pattern, why in XML_REJECTED:
            if pattern.search(line):
                problems.append(f"{path}:{number}: {why}")
    return problems


def check_python(path, text):
    problems = []
    try:
        compile(text, str(path), "exec")
    except SyntaxError as exc:
        return [f"{path}:{exc.lineno}: syntax error: {exc.msg}"]
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith("#"):
            continue
        for pattern, why in PY_REJECTED:
            if pattern.search(line):
                problems.append(severity(why, f"{path}:{number}"))
    return problems


def severity(why, where):
    """Keep the warning prefix in front of the location so callers can tell failures from warnings."""
    return WARN + f"{where}: {why[len(WARN):]}" if why.startswith(WARN) else f"{where}: {why}"


def check_po(path, text):
    """A .po file Odoo can load: one msgstr per msgid (a plural entry's msgstr[n] forms count once) and closed
    quotes (no full gettext parser needed)."""
    ids = strs = 0
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        if stripped.startswith("msgid "):
            ids += 1
        elif stripped.startswith(("msgstr ", "msgstr[0]")):
            strs += 1
        unescaped = stripped.replace("\\\\", "")  # an escaped backslash is not an escape for the quote after it
        if stripped and not stripped.startswith("#") and len(re.findall(r'(?<!\\)"', unescaped)) % 2:
            return [f"{path}:{number}: unbalanced quotes"]
    return [f"{path}: {ids} msgid but {strs} msgstr entries"] if ids != strs else []


def check_manifest(module, module_dir, index):
    problems = []
    try:
        manifest = read_manifest(module_dir)
    except Exception as exc:
        return [f"{module}/__manifest__.py: cannot be read as a Python literal ({str(exc)[:120]})"]
    for key in ("author", "license"):
        if not manifest.get(key):
            problems.append(WARN + f"{module}/__manifest__.py: '{key}' is not set (Odoo.sh marks the build 'almost successful')")
    version = str(manifest.get("version") or "")
    if not re.match(r"^19\.0\.\d+\.\d+\.\d+$", version):
        problems.append(WARN + f"{module}/__manifest__.py: version {version!r} should look like 19.0.1.0.0")
    for key in ("data", "demo"):
        for rel in manifest.get(key) or []:
            if not (module_dir / rel).is_file():
                problems.append(f"{module}/__manifest__.py: {key} file {rel} does not exist")
    for dep in manifest.get("depends") or []:
        if index and dep not in index:
            problems.append(WARN + f"{module}/__manifest__.py: depends on {dep!r}, which is not available locally "
                            "(Enterprise? then oh test is blocked and the module is verified on Odoo.sh)")
    listed = set(manifest.get("data") or [])
    for sheet in sorted(module_dir.glob("security/*.csv")):
        rel = sheet.relative_to(module_dir).as_posix()
        if rel not in listed:
            problems.append(f"{module}: {rel} exists but is not in the manifest 'data' list")
        header = (sheet.read_text(encoding="utf-8").splitlines() or [""])[0].strip()
        expected = "id,name,model_id:id,group_id:id,perm_read,perm_write,perm_create,perm_unlink"
        if rel.endswith("ir.model.access.csv") and header.replace(" ", "") != expected:
            problems.append(f"{module}/{rel}: header should be {expected}")
    models = {}  # models that need access rows: regular and transient ones, not abstract ones (report helpers, mixins)
    for py in sorted(p for p in module_dir.rglob("*.py")  # models/, wizard/, report/ ...: anywhere but tests and migrations
                     if p.is_file() and not ({"tests", "migrations", "static"} & set(p.relative_to(module_dir).parts[:-1]))):
        text = py.read_text(encoding="utf-8", errors="replace")
        for block in re.finditer(r"^class\s+\w+\(([^)]*)\):(.*?)(?=^class\s|\Z)", text, re.M | re.S):
            if "AbstractModel" in block.group(1):
                continue
            inherits = re.search(r"^\s*_inherit\s*=", block.group(2), re.M)
            for match in re.finditer(r"^ {4}_name\s*=\s*[\"']([\w.]+)[\"']", block.group(2), re.M):  # class attribute only
                if not (inherits and re.search(r"^\s*_inherit\s*=\s*\[?\s*[\"']" + re.escape(match.group(1)) + r"[\"']",
                                               block.group(2), re.M)):  # `_inherit = "x"` or `_inherit = ["x", mixin]`
                    models[match.group(1)] = py.name
    access = module_dir / "security" / "ir.model.access.csv"
    if models and not access.is_file():
        problems.append(WARN + f"{module}: defines models ({', '.join(sorted(models))}) but has no security/ir.model.access.csv")
    elif models:
        cells = {row[2].strip().rsplit(".", 1)[-1] for row in csv.reader(access.read_text(encoding="utf-8").splitlines())
                 if len(row) > 2}  # whole model_id:id cells, so model_x_y doesn't stand in for model_x
        for name in sorted(models):
            if "model_" + name.replace(".", "_") not in cells:
                problems.append(WARN + f"{module}/security/ir.model.access.csv: no access row for model {name} "
                                f"(Odoo logs 'no access rules' and Odoo.sh marks the build 'almost successful')")
    tests = module_dir / "tests"
    if tests.is_dir():
        init = (tests / "__init__.py").read_text(encoding="utf-8", errors="replace") if (tests / "__init__.py").is_file() else ""
        for test_file in sorted(tests.glob("test_*.py")):
            if test_file.stem not in init:
                problems.append(f"{module}/tests/__init__.py does not import {test_file.name}: its tests never run")
    return problems


def check_files(files):
    """Static problems of the given source files ([] when none); fast enough for an edit hook."""
    problems = []
    for path in files:
        path = Path(path)
        if not path.is_file() or path.stat().st_size > 2_000_000:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            problems.append(f"{path}: cannot be read as UTF-8 ({str(exc)[:80]})")
            continue
        if path.suffix == ".xml":
            problems += check_xml(path, text)
        elif path.suffix == ".py":
            problems += check_python(path, text)
        elif path.suffix in (".po", ".pot"):
            problems += check_po(path, text)
        elif path.name.endswith(".csv") and path.parent.name == "security":
            rows = [(n, r) for n, r in enumerate(csv.reader(text.splitlines()), 1) if any(c.strip() for c in r)]
            width = len(rows[0][1]) if rows else 0
            for number, row in rows[1:]:
                if len(row) != width:
                    problems.append(f"{path}:{number}: {len(row)} columns, the header has {width}")
    return problems


def check_modules(root, modules, project, index=None):
    """Static problems of whole modules: every source file plus the manifest, access rows and test imports."""
    problems = []
    for module in sorted(modules):
        module_dir = project[module]
        files = [p for p in module_dir.rglob("*") if p.is_file() and p.suffix in (".py", ".xml", ".po", ".pot", ".csv")
                 and not any(part in SKIP_DIRS for part in p.relative_to(root).parts)]
        problems += [p.replace(str(root) + os.sep, "") for p in check_files(files)]
        problems += check_manifest(module, module_dir, index)
    return problems


def ensure_lint(env):
    """Python of the harness's own lint venv (LINT_PACKAGE), kept apart from the Odoo venv like the Playwright one;
    rebuilt when the pinned package changes."""
    exe, version = base_interpreter(env.config)
    venv = env.cache / "venvs" / f"lint-py{version}"
    python, marker = venv / "bin" / "python", venv / ".oh-ready.json"
    with env.lock(f"venv-{venv.name}"):
        info = read_json(marker, {}) or {}
        if not (python.exists() and info.get("package") == LINT_PACKAGE):
            env.say(f"installing {LINT_PACKAGE} into its own venv (once) ...")
            shutil.rmtree(venv, ignore_errors=True)
            run([exe, "-m", "venv", venv])
            run([python, "-m", "pip", "install", "-q", "--disable-pip-version-check", LINT_PACKAGE], timeout=900)
            write_json(marker, {"package": LINT_PACKAGE, "python": version, "created": now_iso()})
    return python


def lint_warnings(stdout, stderr, returncode):
    """`oh check` warnings from pylint's JSON output: one per message, sorted by file and line, or one warning
    saying why pylint could not run (exit 1 is a fatal error, 32 a usage error; 2/4/8/16 only say what it found)."""
    try:
        messages = json.loads(stdout or "[]")
    except ValueError:
        messages = None
    if not isinstance(messages, list) or returncode & 33:
        why = (stderr.strip().splitlines() or stdout.strip().splitlines() or ["no output"])[-1][:200]
        return [WARN + f"pylint-odoo could not run ({why}); the lint was skipped"]
    warnings = []
    for m in sorted(messages, key=lambda m: (str(m.get("path", "")), int(m.get("line") or 0))):
        text = re.split(r"\.? ?(?:- )?More info", str(m.get("message", "")))[0].strip()
        warnings.append(WARN + f"{m.get('path')}:{m.get('line')}: {m.get('symbol')}: {text}")
    return warnings


def lint_modules(env, root, modules, project):
    """pylint-odoo on whole modules, limited to LINT_CHECKS, as `oh check` warnings; never a failure, and never in
    the edit hook (it takes seconds and needs its venv). An unavailable lint is one warning."""
    try:
        python = ensure_lint(env)
    except (OhError, subprocess.TimeoutExpired, OSError) as exc:
        return [WARN + f"pylint-odoo is not available ({str(exc).splitlines()[0][:160]}); the lint was skipped"]
    cmd = [str(python), "-m", "pylint", "--load-plugins=pylint_odoo", "--disable=all", "--enable=" + ",".join(LINT_CHECKS),
           f"--valid-odoo-versions={env.config.get('odoo_ref') or '19.0'}", "--output-format=json", "--score=n",
           "--reports=n", "--persistent=n", *[str(project[m]) for m in sorted(modules)]]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, cwd=root, timeout=900)
    except (subprocess.TimeoutExpired, OSError) as exc:
        return [WARN + f"pylint-odoo could not run ({str(exc)[:160]}); the lint was skipped"]
    return lint_warnings(result.stdout, result.stderr, result.returncode)


def cmd_check(args):
    root = project_root()
    config = load_config(root)
    roots, project = discover_project(root, config)
    if args.hook:  # PostToolUse: the edited file comes in the hook's JSON on stdin
        try:
            event = json.load(sys.stdin)
        except ValueError:
            return PASSED
        path = (event.get("tool_input") or {}).get("file_path") or ""
        if not path or not any(Path(path).resolve().is_relative_to(r) for r in roots):
            return PASSED
        failures, warnings = split_problems(check_files([path]))
        if failures:
            print("oh check: " + "; ".join(failures), file=sys.stderr)
            return 2  # exit 2 feeds the problems back to Claude as the hook's result
        if warnings:  # advice, not a failure: shown to Claude without blocking or repeating on every later edit
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
                                                     "additionalContext": "oh check warning: " + "; ".join(warnings)}}))
        return PASSED
    return run_check(root, config, roots, project, args.targets, lint=not args.no_lint)


def split_problems(problems):
    """(failures, warnings): warnings are reported, failures fail the check."""
    return [p for p in problems if not p.startswith(WARN)], [p[len(WARN):] for p in problems if p.startswith(WARN)]


def run_check(root, config, roots, project, targets, lint=True):
    files = [a for a in targets if "/" in a or a.endswith((".py", ".xml", ".po", ".pot", ".csv"))]
    modules = [a for a in targets if a not in files]
    unknown = [m for m in modules if m not in project]
    if unknown:
        raise OhError(f"not modules of this project: {', '.join(unknown)} (known: {', '.join(sorted(project))})")
    index = env = None
    try:  # the standard index is only available once `oh env` fetched the source; checks still run without it
        env = Env(root, config)
        commit = ((env.state().get("sources") or {}).get("odoo") or {}).get("commit")
        tree = env.cache / "src" / f"odoo-{str(commit)[:12]}" if commit else None
        if tree and tree.is_dir():
            env.src, env.odoo_commit = tree, commit
            path = config.get("enterprise_path")
            env.enterprise = Path(path).expanduser().resolve() if path else None
            index = {**scan_modules(env.standard_roots()), **project}
    except OhError:
        index = None
    if not files and not modules:
        base = resolve_base(root, config)
        modules = sorted(modules_for_files(root, changed_files(root, base), project) or project) if base else sorted(project)
    failures, warnings = split_problems(check_files(files) + (check_modules(root, modules, project, index) if modules else []))
    lint_lines = []
    if modules and lint:
        lint_lines = split_problems(lint_modules(env, root, modules, project) if env else
                                    [WARN + "pylint-odoo is not available (the runtime could not be set up); the lint was skipped"])[1]
    label = ", ".join(modules + [Path(f).name for f in files])
    if failures:
        print(f"oh check: FAILED - {len(failures)} problem(s) in {label}")
    else:
        print(f"oh check: PASSED - {label}" + ("" if index else " (manifest dependencies not checked: run oh env first)"))
    for problem in failures:
        print(f"  - {problem}")
    for warning in warnings:
        print(f"  warning: {warning}")
    for warning in lint_lines:
        print(f"  lint: {warning}")
    if modules and lint:
        print(f"  lint: {LINT_PACKAGE.split('==')[0]} {LINT_PACKAGE.split('==')[1]}, {len(LINT_CHECKS)} checks on "
              f"{len(modules)} module(s): {len(lint_lines)} warning(s) (advice, never a failure; --no-lint skips it)")
    return FAILED if failures else PASSED


# --------------------------------------------------------------------------- upgrade checks

def find_prepares(project, modules):
    """[(module, file, code)] for each `prepare_upgrade(env)` defined in a module's tests/*.py."""
    found = []
    for name in sorted(modules):
        for path in sorted((project[name] / "tests").glob("*.py")):
            source = path.read_text(encoding="utf-8")
            try:
                tree = ast.parse(source)
            except SyntaxError:
                continue
            functions = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "prepare_upgrade"]
            if functions:
                imports = [ast.get_source_segment(source, n) for n in tree.body
                           if isinstance(n, (ast.Import, ast.ImportFrom)) and not getattr(n, "level", 0)]
                found.append((name, path, "\n".join(imports + [ast.get_source_segment(source, functions[0])])))
    return found


def prepare_script(prepares):
    """Code for `odoo-bin shell` on the prior version: run each prepare_upgrade(env), then commit."""
    sources = json.dumps([[module, str(path), code] for module, path, code in prepares])
    return "\n".join([
        f"__oh_sources = {sources}",
        "for __oh_module, __oh_file, __oh_code in __oh_sources:",
        "    __oh_namespace = {'__name__': 'oh_prepare_upgrade'}",
        "    exec(compile(__oh_code, __oh_file, 'exec'), __oh_namespace)",
        "    __oh_namespace['prepare_upgrade'](env)",
        "    env.flush_all()",
        "env.cr.commit()",
        "print('OH_PREPARE_DONE')",
    ]) + "\n"


def upgrade_classes(module_dir):
    """Names of the test classes decorated with @tagged(..., 'oh_upgrade', ...) in a module."""
    classes = set()
    for path in (Path(module_dir) / "tests").glob("*.py"):
        try:
            tree = ast.parse(path.read_text(encoding="utf-8"))
        except SyntaxError:
            continue
        for node in ast.walk(tree):
            if not isinstance(node, ast.ClassDef):
                continue
            for deco in node.decorator_list:
                func = getattr(deco, "func", None)
                if (getattr(func, "id", None) or getattr(func, "attr", None)) == "tagged" and any(
                        isinstance(a, ast.Constant) and a.value == UPGRADE_TAG for a in deco.args):
                    classes.add(node.name)
    return classes


# --------------------------------------------------------------------------- environment

def worktree_changes(path):
    """Digest of the uncommitted changes of a git checkout (tracked and untracked files), or None when clean."""
    diff = subprocess.run(["git", "-C", str(path), "diff", "HEAD", "--binary", "--no-ext-diff", "--no-textconv"],
                          capture_output=True)
    if diff.returncode:
        raise OhError(f"cannot read the changes of {path}: {diff.stderr.decode(errors='replace').strip()[:200]}")
    untracked = [p for p in git_paths(path, "ls-files", "-z", "-o", "--exclude-standard") if not junk(p)]
    if not diff.stdout.strip() and not untracked:
        return None
    digest = hashlib.sha256(diff.stdout)
    for rel in sorted(untracked):
        full = Path(path, rel)
        digest.update(f"\n{rel} {file_digest(full) if full.is_file() else '-'}".encode("utf-8", "surrogateescape"))
    return digest.hexdigest()[:12]


def stat_digest(path):
    """Digest of the names, sizes and modification times under `path`: notices edits in a copy outside git."""
    digest = hashlib.sha256()
    for folder, dirnames, filenames in os.walk(path):
        dirnames[:] = sorted(d for d in dirnames if d != "__pycache__")
        for name in sorted(filenames):
            full = os.path.join(folder, name)
            if not junk(full):
                with contextlib.suppress(OSError):
                    info = os.stat(full)
                    digest.update(f"{os.path.relpath(full, path)} {info.st_size} {info.st_mtime_ns}\n".encode())
    return digest.hexdigest()[:12]


def base_interpreter(config):
    """(path, version) of the Python the venvs are made from: project.json's `python`, else python3."""
    exe = shutil.which(config.get("python") or "") or shutil.which("python3") or sys.executable
    exe = os.path.realpath(exe)
    version = run([exe, "-c", "import sys; print('%d.%d.%d' % sys.version_info[:3])"]).stdout.strip()
    return exe, version


def installed_digest(venv):
    """Digest of the distributions installed in a venv right now (their dist-info names carry the versions)."""
    names = []
    for site in Path(venv).glob("lib/python*/site-packages"):
        names += [p.name for p in site.iterdir() if p.name.endswith((".dist-info", ".egg-info", ".egg-link", ".pth"))]
    return sha("\n".join(sorted(names)))[:12]


class Env:
    def __init__(self, root, config, quiet=False):
        self.root, self.config, self.quiet = root, config, quiet
        self.cache = Path(os.environ.get("OH_CACHE") or Path.home() / ".cache" / "odoo-harness")
        self.db = {
            "host": os.environ.get("OH_DB_HOST", "127.0.0.1"),
            "port": os.environ.get("OH_DB_PORT", "5432"),
            "user": os.environ.get("OH_DB_USER", "odoo"),
            "password": os.environ.get("OH_DB_PASSWORD", "odoo"),
        }
        for key in ("user", "password"):
            if not NAME.match(self.db[key]):
                raise OhError(f"OH_DB_{key.upper()} may only contain letters, digits and underscores")
        self.key, self.prefix = project_key(root), db_prefix(root)
        self.home = self.cache / "projects" / self.key
        self.data = self.cache / "data"
        self.logs = self.home / "logs"
        self.state_path = self.home / "state.json"
        self.conf = self.home / "odoo.conf"
        self.odoo_url = os.environ.get("OH_ODOO_REPO") or ODOO_REPO
        self.src = self.enterprise = self.odoo_commit = self.enterprise_commit = self.enterprise_state = None
        self.python = self.python_version = self.venv_key = self.packages = self.rtlcss_dir = None
        self.pg_version, self.packages_changed, self.base_python, self.last_run = None, False, None, None
        self.identity_problems = []  # reasons results can't be matched exactly to their inputs
        self.enterprise_problem = None  # why a configured enterprise_repo is not in use (no access): runs go on without it

    def say(self, message):
        if not self.quiet:
            print(message, file=sys.stderr, flush=True)

    @contextlib.contextmanager
    def lock(self, name, shared=False, wait=True):
        """File lock shared by every project on this machine; yields False when `wait` is off and it is busy."""
        directory = self.cache / "locks"
        directory.mkdir(parents=True, exist_ok=True)
        with open(directory / f"{name}.lock", "a") as handle:
            acquired = True
            if fcntl:
                flags = (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | (0 if wait else fcntl.LOCK_NB)
                try:
                    fcntl.flock(handle, flags)
                except BlockingIOError:
                    acquired = False
            yield acquired

    # project state ---------------------------------------------------------
    def state(self):
        data = read_json(self.state_path, {})
        return data if isinstance(data, dict) else {}

    def update_state(self, change):
        with self.lock(f"state-{self.key}"):
            state = self.state()
            change(state)
            state["root"] = str(self.root)
            write_json(self.state_path, state)
            return state

    # postgres ----------------------------------------------------------------
    def psql(self, sql, database="postgres", check=True):
        if not shutil.which("psql"):
            raise OhError("psql not found: install the PostgreSQL client (apt-get install postgresql-client)")
        env = dict(os.environ, PGPASSWORD=self.db["password"])
        return run(["psql", "-h", self.db["host"], "-p", self.db["port"], "-U", self.db["user"], "-d", database,
                    "-v", "ON_ERROR_STOP=1", "-tAc", sql], env=env, check=check)

    def ensure_postgres(self):
        if self.psql("SELECT 1", check=False).returncode == 0:
            return
        local = self.db["host"] in ("127.0.0.1", "localhost")
        if not (local and hasattr(os, "geteuid") and os.geteuid() == 0 and shutil.which("pg_lsclusters")):
            raise OhError(f"Cannot connect to PostgreSQL as {self.db['user']}@{self.db['host']}:{self.db['port']}. "
                          "Start it, or set OH_DB_HOST / OH_DB_PORT / OH_DB_USER / OH_DB_PASSWORD.")
        clusters = [l.split() for l in run(["pg_lsclusters", "--no-header"], check=False).stdout.splitlines() if l.strip()]
        if not clusters:
            versions = sorted(glob.glob("/usr/lib/postgresql/*/bin/initdb"))
            if not versions:
                raise OhError("PostgreSQL server not installed: apt-get install -y postgresql")
            run(["pg_createcluster", Path(versions[-1]).parts[4], "main", "--port", self.db["port"], "--start"])
        else:
            run(["pg_ctlcluster", clusters[0][0], clusters[0][1], "start"], check=False)
        for _ in range(30):
            if run(["pg_isready", "-h", self.db["host"], "-p", self.db["port"]], check=False).returncode == 0:
                break
            time.sleep(1)
        user, password = self.db["user"], self.db["password"]
        sql = (f"DO $$BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='{user}') THEN "
               f"CREATE ROLE \"{user}\" LOGIN SUPERUSER PASSWORD '{password}'; END IF; END$$;")
        run(["su", "postgres", "-c", f"psql -p {self.db['port']} -qc {shlex.quote(sql)}"], check=False)
        if self.psql("SELECT 1", check=False).returncode:
            raise OhError("PostgreSQL started but the odoo role cannot log in; check pg_hba.conf for 127.0.0.1")

    def db_exists(self, name):
        return self.psql(f"SELECT 1 FROM pg_database WHERE datname = '{name}'").stdout.strip() == "1"

    def list_dbs(self, prefix):
        like = prefix.replace("_", "\\_") + "%"
        out = self.psql(f"SELECT datname FROM pg_database WHERE datname LIKE '{like}'").stdout
        return sorted(l.strip() for l in out.splitlines() if l.strip())

    def drop_db(self, name, any_project=False):
        if not re.match(r"^oh_[a-z0-9_]+$", name):
            raise OhError(f"refusing to drop non-oh database {name!r}")
        if not (any_project or name.startswith(self.prefix) or name.startswith("oh_tpl_")):
            raise OhError(f"refusing to drop {name}: it belongs to another project (oh clean --all-projects)")
        self.psql(f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)', check=False)
        shutil.rmtree(self.data / "filestore" / name, ignore_errors=True)

    def clone_db(self, template, name):
        self.psql(f'CREATE DATABASE "{name}" TEMPLATE "{template}"')
        source = self.data / "filestore" / template
        if source.exists():
            shutil.copytree(source, self.data / "filestore" / name)

    def check_db(self, name):
        """Refuse databases of other projects and shared templates."""
        if name.startswith("oh_tpl_"):
            raise OhError(f"{name} is a shared template database; use a kept database (oh test <module> --keep)")
        if name.startswith("oh_") and not name.startswith(self.prefix):
            raise OhError(f"database {name} belongs to another project; this project's databases start with {self.prefix}")

    def resolve_db(self, requested):
        db = requested or self.state().get("last_db")
        if not db:
            raise OhError("no kept database: run `oh test <module> --keep` first, or pass --db")
        self.check_db(db)
        if not self.db_exists(db):
            raise OhError(f"database {db} does not exist: run `oh test <module> --keep` first")
        return db

    # sources -----------------------------------------------------------------
    def sparse_patterns(self, enterprise=False):
        codes = set()
        for lang in self.config["languages"]:
            if not lang.startswith("en"):
                codes.update({lang, lang.split("_")[0]})
        dirs = ["/*"] if enterprise else ["/addons/*", "/odoo/addons/*"]
        patterns = ["/*"] + [f"!{d}/i18n/*" for d in dirs]
        for code in sorted(codes):
            patterns += [f"{d}/i18n/{code}.po" for d in dirs]
        return patterns

    def resolve_ref(self, url, ref):
        try:
            out = run(["git", "ls-remote", url, ref], timeout=300).stdout
        except OhError as exc:
            raise OhError(f"could not read {url}: {exc}") from None
        refs = {}
        for line in out.splitlines():
            commit, _, name = line.partition("\t")
            refs[name.strip()] = commit.strip()
        for name in (f"refs/heads/{ref}", f"refs/tags/{ref}^{{}}", f"refs/tags/{ref}", ref):
            if SHA40.match(refs.get(name, "")):
                return refs[name]
        raise OhError(f"{ref!r} is not a branch or tag of {url}")

    def commit_for(self, kind, url, ref, pin, sources, update):
        """The exact commit to use: the pin, else the commit resolved earlier for this project."""
        pin = pin or (ref if SHA40.match(ref or "") else None)
        if pin:
            if not SHA40.match(pin):
                raise OhError(f"{kind}_commit must be a full 40-character commit SHA, not {pin!r}")
            sources[kind] = {"url": url, "ref": ref, "commit": pin, "pinned": True}
            return pin
        known = sources.get(kind) or {}
        if (not update and not known.get("pinned") and SHA40.match(known.get("commit") or "")
                and norm_url(known.get("url")) == norm_url(url) and known.get("ref") == ref):
            return known["commit"]
        self.say(f"resolving {kind} {ref} ...")
        commit = self.resolve_ref(url, ref)
        sources[kind] = {"url": url, "ref": ref, "commit": commit, "pinned": False, "resolved": now_iso()}
        return commit

    def ensure_tree(self, kind, url, commit):
        """A trimmed checkout of exactly `commit`, shared by every project that uses that commit."""
        dest = self.cache / "src" / f"{kind}-{commit[:12]}"
        with self.lock(f"src-{dest.name}"):
            if dest.exists():
                origin = git(dest, "config", "--get", "remote.origin.url", check=False)
                head = git(dest, "rev-parse", "HEAD", check=False)
                if norm_url(origin) != norm_url(url) or head != commit:
                    raise OhError(f"cached source {dest} is {origin or '?'} @ {head[:12] or '?'}, expected {url} @ "
                                  f"{commit[:12]}; delete that directory and run `oh env` again")
                # Same commit is not enough: a file edited in the cache would change every result.
                changes = [l for l in git(dest, "status", "--porcelain", "--untracked-files=all", check=False).splitlines()
                           if l and not junk(l)]
                if changes:
                    raise OhError(f"the cached {kind} source {dest} has local changes ({len(changes)} paths, e.g. "
                                  f"{changes[0][3:]}), so it is not {kind} {commit[:12]} any more. Restore it with "
                                  f"`git -C {dest} checkout -- . && git -C {dest} clean -fdq` (or delete it), then re-run.")
            else:
                self.fetch_tree(kind, url, commit, dest)
            os.utime(dest)
        return dest

    def fetch_tree(self, kind, url, commit, dest):
        partial = dest.with_name(dest.name + ".partial")
        shutil.rmtree(partial, ignore_errors=True)
        partial.mkdir(parents=True)
        self.say(f"fetching {kind} {commit[:12]} from {url} (trimmed checkout) ...")
        run(["git", "-C", partial, "init", "-q"])
        run(["git", "-C", partial, "remote", "add", "origin", url])
        run(["git", "-C", partial, "config", "core.sparseCheckout", "true"])
        run(["git", "-C", partial, "config", "core.sparseCheckoutCone", "false"])
        info = partial / ".git" / "info"
        info.mkdir(parents=True, exist_ok=True)
        (info / "sparse-checkout").write_text("\n".join(self.sparse_patterns(kind == "enterprise")) + "\n")
        try:
            run(["git", "-C", partial, "fetch", "-q", "--depth", "1", "--filter=blob:none", "origin", commit],
                timeout=1800)
        except OhError as exc:
            hint = (f" The Enterprise source is private: set {ENTERPRISE_TOKEN} (a GitHub token that can read it) in "
                    "the environment, attach the repository to this session, or set OH_ENTERPRISE_PATH to an existing "
                    "checkout.") if kind == "enterprise" else ""
            shutil.rmtree(partial, ignore_errors=True)
            raise OhError(f"could not fetch {url} @ {commit[:12]}.{hint}\n{exc}") from None
        run(["git", "-C", partial, "checkout", "-q", "--detach", "FETCH_HEAD"], timeout=1800)
        if git(partial, "rev-parse", "HEAD") != commit:
            raise OhError(f"{url} returned a different commit than {commit}")
        git(partial, "status", "--porcelain", check=False)  # refreshes the index so later checks are fast
        partial.rename(dest)

    def prune_trees(self):
        """Delete old source trees that no existing project uses any more."""
        referenced = set()
        for path in (self.cache / "projects").glob("*/state.json"):
            state = read_json(path, {})
            if not isinstance(state, dict) or (state.get("root") and not Path(state["root"]).exists()):
                continue
            for info in (state.get("sources") or {}).values():
                if isinstance(info, dict) and info.get("commit"):
                    referenced.add(str(info["commit"])[:12])
        for kind in ("odoo", "enterprise"):
            trees = sorted((p for p in (self.cache / "src").glob(f"{kind}-*")
                            if p.is_dir() and not p.name.endswith(".partial")),
                           key=lambda p: p.stat().st_mtime, reverse=True)
            for stale in trees[KEEP_TREES:]:
                if stale.name.split("-", 1)[1] not in referenced:
                    with self.lock(f"src-{stale.name}", wait=False) as acquired:
                        if acquired:
                            shutil.rmtree(stale, ignore_errors=True)

    def ensure_enterprise(self, sources, update):
        """Return (path, commit, cache key) of the Enterprise source, or Nones when not configured."""
        path = self.config.get("enterprise_path")
        pin = self.config.get("enterprise_commit")
        if path:
            path = Path(path).expanduser().resolve()
            if not path.is_dir():
                raise OhError(f"enterprise_path {path} does not exist")
            if not (path / "web_enterprise" / "__manifest__.py").is_file():
                raise OhError(f"enterprise_path {path} is not the Odoo Enterprise source (no web_enterprise module)")
            commit = git(path, "rev-parse", "HEAD", check=False) if (path / ".git").exists() else ""
            if pin and commit != pin:
                raise OhError(f"enterprise_path is at {commit[:12] or 'an unversioned copy'}, "
                              f"but enterprise_commit pins {pin[:12]}")
            if not commit:
                self.identity_problems.append("enterprise_path is not a git checkout, so its exact content is unknown")
                return path, None, "unversioned-" + stat_digest(path)
            changes = worktree_changes(path)
            return path, commit, commit + (f"+local-{changes}" if changes else "")
        repo = self.config.get("enterprise_repo")
        if repo:
            odoo_ref = self.config.get("odoo_ref") or ""
            ref = self.config.get("enterprise_ref") or (odoo_ref if not SHA40.match(odoo_ref) else "") or "19.0"
            try:
                with git_credentials(repo):
                    commit = self.commit_for("enterprise", repo, ref, pin, sources, update)
                    dest = self.ensure_tree("enterprise", repo, commit)
            except OhError as exc:
                # No access yet (the token is not in this environment, or the network refuses it): the run goes
                # on with Community only, and modules that need Enterprise make `oh test` BLOCKED, not an error.
                why = str(exc).splitlines()[0][:160]
                hint = "" if os.environ.get(ENTERPRISE_TOKEN) else f"; set {ENTERPRISE_TOKEN} (a GitHub token that can read it) in the environment"
                self.enterprise_problem = f"enterprise_repo {repo} @ {ref} could not be fetched ({why}){hint}"
                self.say(f"warning: {self.enterprise_problem}; continuing without Enterprise")
                sources.pop("enterprise", None)
                return None, None, None
            if not (dest / "web_enterprise" / "__manifest__.py").is_file():
                raise OhError(f"{repo} @ {commit[:12]} is not the Odoo Enterprise source (no web_enterprise module)")
            return dest, commit, commit
        sources.pop("enterprise", None)
        return None, None, None

    def ensure_sources(self, update=False):
        """Resolve and fetch the Odoo (and Enterprise) source only: enough for `oh src`."""
        sources = dict(self.state().get("sources") or {})
        ref = self.config.get("odoo_ref") or "19.0"
        self.odoo_commit = self.commit_for("odoo", self.odoo_url, ref, self.config.get("odoo_commit"), sources, update)
        self.src = self.ensure_tree("odoo", self.odoo_url, self.odoo_commit)
        release = self.src / "odoo" / "release.py"
        match = re.search(r"version_info\s*=\s*\(\s*(\d+)", release.read_text()) if release.is_file() else None
        if not match or int(match.group(1)) != 19:
            raise OhError(f"{self.odoo_url} @ {self.odoo_commit[:12]} is not Odoo 19 (see odoo/release.py); "
                          "check odoo_ref / odoo_commit in .odoo-harness/project.json")
        self.enterprise, self.enterprise_commit, self.enterprise_state = self.ensure_enterprise(sources, update)
        self.update_state(lambda state: state.__setitem__("sources", sources))
        self.prune_trees()

    def requirements(self):
        lines = []
        for line in (self.src / "requirements.txt").read_text().splitlines():
            stripped = line.strip()
            if re.match(r"(?i)python-ldap\b", stripped):
                continue  # needs system headers; only auth_ldap uses it
            lines.append(re.sub(r"(?i)^psycopg2(?=\s*==)", "psycopg2-binary", stripped))
        extras = [("project", self.root / "requirements.txt")]
        gitmodules = self.root / ".gitmodules"
        if gitmodules.is_file():  # Odoo.sh reads the requirements.txt of submodules too
            for match in re.finditer(r"^\s*path\s*=\s*(.+?)\s*$", gitmodules.read_text(), re.M):
                extras.append((f"submodule {match.group(1)}", self.root / match.group(1) / "requirements.txt"))
        if self.enterprise:
            extras.append(("enterprise", Path(self.enterprise) / "requirements.txt"))
        for label, extra in extras:
            if extra.is_file():
                lines += [f"# {label} requirements.txt"] + extra.read_text().splitlines()
        lines += ["# odoo-harness: what Odoo's tests need but its requirements.txt omits"] + HARNESS_PACKAGES
        return "\n".join(lines) + "\n"

    def ensure_venv(self):
        """A venv keyed by its inputs, so projects with different requirements never share one."""
        exe, version = base_interpreter(self.config)
        if tuple(map(int, version.split(".")[:2])) < (3, 10):
            raise OhError(f"Odoo 19 needs Python >= 3.10, found {version} at {exe}")
        requirements = self.requirements()
        self.venv_key = sha(json.dumps([VENV_FORMAT, exe, version, requirements]))[:12]
        venv = self.cache / "venvs" / f"py{version}-{self.venv_key}"
        python, marker = venv / "bin" / "python", venv / ".oh-ready.json"
        with self.lock(f"venv-{self.venv_key}"):
            if not (marker.is_file() and python.exists()):
                shutil.rmtree(venv, ignore_errors=True)
                run([exe, "-m", "venv", venv])
                req_file = venv / "requirements.oh.txt"
                req_file.write_text(requirements)
                self.say(f"installing Odoo Python requirements (python {version}) ...")
                run([python, "-m", "pip", "install", "-q", "--disable-pip-version-check", "-r", req_file], timeout=2400)
                write_json(marker, {"key": self.venv_key, "python": version, "installed": installed_digest(venv),
                                    "created": now_iso()})
            info = read_json(marker, {}) or {}
            if not info.get("installed"):  # made by an older harness: take what is there now as the baseline
                info["installed"] = installed_digest(venv)
                write_json(marker, info)
        # What is installed now, not what was installed at creation: a package added by hand changes it.
        self.python, self.python_version, self.packages = python, version, installed_digest(venv)
        self.base_python = exe
        self.packages_changed = self.packages != info.get("installed")
        return python

    def ensure_rtlcss(self):
        if not any(l.split("_")[0] in RTL_LANGS for l in self.config["languages"]) or shutil.which("rtlcss"):
            return None
        bin_dir = self.cache / "node" / "node_modules" / ".bin"
        if (bin_dir / "rtlcss").exists():
            return bin_dir
        if not shutil.which("npm"):
            self.say("note: rtlcss missing and npm unavailable; right-to-left screens will not be mirrored locally")
            return None
        run(["npm", "install", "--prefix", self.cache / "node", "rtlcss", "--no-audit", "--no-fund", "--silent"],
            check=False, timeout=600)
        return bin_dir if (bin_dir / "rtlcss").exists() else None

    @staticmethod
    def browser_bin():
        if os.environ.get("ODOO_BROWSER_BIN"):
            return os.environ["ODOO_BROWSER_BIN"]
        for name in ("google-chrome", "chromium", "chromium-browser", "google-chrome-stable"):
            if shutil.which(name):
                return shutil.which(name)
        roots = [os.environ.get("PLAYWRIGHT_BROWSERS_PATH", ""), "/opt/pw-browsers", str(Path.home() / ".cache/ms-playwright")]
        for root in roots:
            found = sorted(glob.glob(os.path.join(root, "chromium-*", "chrome-linux*", "chrome")), reverse=True) if root else []
            if found:
                return found[0]
        return None

    def ensure(self, update=False):
        with self.lock("postgres"):
            self.ensure_postgres()
        self.pg_version = self.psql("SHOW server_version_num", check=False).stdout.strip() or None
        self.ensure_sources(update)
        self.ensure_venv()
        with self.lock("node"):
            self.rtlcss_dir = self.ensure_rtlcss()
        self.write_conf()

    def write_conf(self):
        self.data.mkdir(parents=True, exist_ok=True)
        self.logs.mkdir(parents=True, exist_ok=True)
        conf = "\n".join([
            "[options]",
            f"db_host = {self.db['host']}", f"db_port = {self.db['port']}",
            f"db_user = {self.db['user']}", f"db_password = {self.db['password']}",
            f"data_dir = {self.data}", "max_cron_threads = 0", "http_interface = 127.0.0.1", "list_db = False", "",
        ])
        self.conf.write_text(conf)
        self.conf.chmod(0o600)

    def standard_roots(self):
        roots = [self.enterprise] if self.enterprise else []
        return roots + [self.src / "addons", self.src / "odoo" / "addons"]

    def addons_path(self, project_roots):
        paths = [str(p) for p in project_roots] + [str(p) for p in self.standard_roots()]
        return ",".join(dict.fromkeys(paths))

    def runtime_env(self):
        env = dict(os.environ, PYTHONUNBUFFERED="1", PYTHONDONTWRITEBYTECODE="1")  # keep the repo clean
        if self.rtlcss_dir:
            env["PATH"] = f"{self.rtlcss_dir}{os.pathsep}{env.get('PATH', '')}"
        browser = self.browser_bin()
        if browser:
            env["ODOO_BROWSER_BIN"] = browser
        return env

    def odoo(self, *args):
        return [self.python, self.src / "odoo-bin", *args]

    def odoo_server(self, db, addons, *extra, port=None):
        return self.odoo("-c", self.conf, "-d", db, f"--addons-path={addons}",
                         f"--http-port={port or free_port()}", *extra)

    def run_logged(self, argv, log_path, timeout):
        with open(log_path, "w") as handle:
            process = subprocess.run([str(a) for a in argv], stdout=handle, stderr=subprocess.STDOUT,
                                     env=self.runtime_env(), timeout=timeout)
        return process.returncode

    def log_file(self, label):
        self.logs.mkdir(parents=True, exist_ok=True)
        for stale in sorted(self.logs.glob("*.log"))[:-40]:
            stale.unlink(missing_ok=True)
        return self.logs / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-{label}.log"

    # template databases ------------------------------------------------------
    def load_languages(self, all_languages=True):
        """The languages a database gets. Odoo.sh test databases have only English, so a test run loads only
        en_US unless asked otherwise; kept databases (screens, translations) get every project language."""
        # en_US first: loading only ar_001 on a new database deactivates English and makes the admin Arabic.
        if not all_languages:
            return ["en_US"]
        return ["en_US"] + [l for l in self.config["languages"] if l != "en_US"]

    def template(self, std_modules, project_roots, demo, shadowed, languages=None):
        """Name and addons path of the template holding `std_modules`, keyed by everything that shapes it.

        Templates contain standard modules only, so projects share them safely. A project that ships its
        own copy of a standard module (`shadowed`) gets a template of its own.
        """
        key = [TEMPLATE_FORMAT, self.odoo_commit, self.enterprise_state, self.venv_key, self.packages,
               sorted(std_modules), bool(demo), languages or self.load_languages(), str(self.root) if shadowed else None]
        roots = (list(project_roots) if shadowed else []) + self.standard_roots()
        return "oh_tpl_" + sha(json.dumps(key))[:12], ",".join(dict.fromkeys(str(p) for p in roots))

    def build_template(self, name, std_modules, addons, demo, languages=None):
        """Build the template unless it exists; the caller holds its exclusive lock. True when built."""
        if self.db_exists(name):
            return False
        log = self.log_file("template")
        languages = languages or self.load_languages()
        self.say(f"building template database ({len(std_modules)} standard modules, demo={demo}, "
                 f"languages {','.join(languages)}); this happens once per dependency set ...")
        extra = ["-i", ",".join(sorted(std_modules) or ["base"]), "--stop-after-init"]
        if demo:
            extra.append("--with-demo")
        extra += ["--load-language", ",".join(languages)]
        started = time.time()
        rc = self.run_logged(self.odoo_server(name, addons, *extra), log, timeout=5400)
        summary = parse_log(log.read_text(errors="replace"))
        if rc or summary["errors"]:
            self.drop_db(name)
            first = summary["errors"][0][1] if summary["errors"] else f"exit code {rc}"
            raise OhError(f"template build failed ({first[:300]}); log: {log}")
        self.touch_template(name, seconds=round(time.time() - started))
        return True

    def touch_template(self, name, seconds=None):
        path = self.cache / "templates.json"
        with self.lock("templates"):
            registry = read_json(path, {}) or {}
            entry = registry.setdefault(name, {"built": now_iso()})
            entry["used"] = time.time()
            entry["projects"] = sorted(set(entry.get("projects", [])) | {self.key})
            if seconds is not None:
                entry["seconds"] = seconds
            write_json(path, registry)

    def evict_templates(self, keep):
        """Drop the least recently used templates beyond KEEP_TEMPLATES, skipping any that is in use."""
        path = self.cache / "templates.json"
        with self.lock("templates"):
            registry = read_json(path, {}) or {}
        others = sorted((n for n in registry if n != keep), key=lambda n: registry[n].get("used", 0), reverse=True)
        for name in others[KEEP_TEMPLATES - 1:]:
            with self.lock(f"tpl-{name}", wait=False) as acquired:
                if not acquired:
                    continue
                self.drop_db(name)
                with self.lock("templates"):
                    registry = read_json(path, {}) or {}
                    registry.pop(name, None)
                    write_json(path, registry)

    def clone_template(self, std_modules, project_roots, demo, shadowed, db, languages=None):
        name, addons = self.template(std_modules, project_roots, demo, shadowed, languages)
        for _ in range(3):
            with self.lock(f"tpl-{name}"):
                built = self.build_template(name, std_modules, addons, demo, languages)
            with self.lock(f"tpl-{name}", shared=True):  # eviction needs the exclusive lock, so it waits
                if not self.db_exists(name):
                    continue
                self.clone_db(name, db)
            self.touch_template(name)
            if built:
                self.evict_templates(keep=name)
            return name
        raise OhError(f"template {name} kept disappearing; is `oh clean --all-projects` running?")

    def export_ref(self, ref):
        commit = git(self.root, "rev-parse", "--verify", ref + "^{commit}", check=False)
        if not commit:
            raise OhError(f"{ref!r} is not a commit of this repository (git fetch it first?)")
        refs = self.cache / "refs"
        dest = refs / commit
        with self.lock(f"ref-{commit[:12]}"):
            if not dest.exists():
                partial = dest.with_name(commit + ".partial")
                shutil.rmtree(partial, ignore_errors=True)
                partial.mkdir(parents=True)
                archive = subprocess.run(["git", "-C", str(self.root), "archive", commit], capture_output=True, check=True)
                subprocess.run(["tar", "-x", "-C", str(partial)], input=archive.stdout, check=True)
                partial.rename(dest)
            os.utime(dest)
        exports = sorted((p for p in refs.iterdir() if p.is_dir() and SHA40.match(p.name)),
                         key=lambda p: p.stat().st_mtime, reverse=True)
        for stale in exports[KEEP_REFS:]:
            with self.lock(f"ref-{stale.name[:12]}", wait=False) as acquired:
                if acquired:
                    shutil.rmtree(stale, ignore_errors=True)
        return dest, commit

    def cleanup_runs(self):
        """Drop this project's leftover run databases (never another project's, never kept ones)."""
        kept = set(self.state().get("kept", []))
        for name in self.list_dbs(self.prefix + "run_"):
            match = re.match(re.escape(self.prefix) + r"run_(\d+)_", name)
            owner = int(match.group(1)) if match else None
            if name not in kept and not (owner and owner != os.getpid() and pid_alive(owner)):
                self.drop_db(name)

    def runtime_key(self):
        """What a kept database and a running server depend on besides the project source."""
        return {"odoo": self.odoo_commit, "enterprise": self.enterprise_state, "venv": self.venv_key,
                "packages": self.packages}

    def keep_db(self, db, modules, targets, languages=None):
        """Remember a kept database with the source it was built from; keep the last KEEP_KEPT_DBS."""
        dropped = []

        def change(state):
            serving = (state.get("serve") or {}).get("db")
            kept = [d for d in state.get("kept", []) if d != db and self.db_exists(d)] + [db]
            for old in kept[:-KEEP_KEPT_DBS]:
                if old != serving:
                    self.drop_db(old)
                    dropped.append(old)
            state["kept"] = [d for d in kept if d not in dropped]
            state["last_db"] = db
            dbs = {d: info for d, info in (state.get("dbs") or {}).items() if d in state["kept"]}
            dbs[db] = {"created": now_iso(), "modules": modules, "targets": targets, "format": FINGERPRINT_FORMAT,
                       "environment": self.runtime_key(), "languages": languages or self.load_languages()}
            state["dbs"] = dbs

        self.update_state(change)
        return dropped

    def update_kept(self, db, roots, project, timeout=1800):
        """Update the project modules a kept database was built with to the current source (`-u`), so screens
        show the latest code without rebuilding the database and its seeded data. Returns the updated modules."""
        built = (self.state().get("dbs") or {}).get(db) or {}
        modules = [m for m in (built.get("modules") or {}) if m in project]
        if not modules:
            raise OhError(f"database {db} was not built by `oh test --keep` in this project; nothing to update")
        log = self.log_file("update")
        argv = self.odoo_server(db, self.addons_path(roots), "-u", ",".join(sorted(modules)), "--stop-after-init")
        rc = self.run_logged(argv, log, timeout=timeout)
        summary = parse_log(log.read_text(errors="replace"))
        if rc or summary["errors"]:
            first = summary["errors"][0][1] if summary["errors"] else f"exit code {rc}"
            raise OhError(f"updating {', '.join(modules)} on {db} failed ({first[:300]}); log: {log}", FAILED)
        current = module_ids(self.root, {m: project[m] for m in modules})

        def change(state):
            info = (state.get("dbs") or {}).get(db)
            if info:  # the environment stays the one it was built with: -u updates project modules, not Odoo itself
                info["modules"] = {m: current.get(m) for m in modules}
                info["updated"] = now_iso()

        self.update_state(change)
        return sorted(modules)

    def seed(self, db, script, roots, timeout=900):
        """Run a seed script (records, users, settings for screens) on a kept database and commit it."""
        script = Path(script)
        if not script.is_file():
            raise OhError(f"seed script {script} not found")
        code = script.read_text(encoding="utf-8") + "\nenv.cr.commit()\nprint('OH_SEED_DONE')\n"
        argv = self.odoo("shell", "-c", self.conf, "-d", db, f"--addons-path={self.addons_path(roots)}", "--no-http",
                         "--log-level=warn")
        result = subprocess.run([str(a) for a in argv], input=code, text=True, capture_output=True,
                                env=self.runtime_env(), timeout=timeout)
        if result.returncode or "OH_SEED_DONE" not in result.stdout:
            tail = "\n".join((result.stderr or result.stdout).splitlines()[-12:])
            raise OhError(f"seed script {script} failed on {db}:\n{tail}", FAILED)


# --------------------------------------------------------------------------- this project's server

def server_alive(entry):
    pid = (entry or {}).get("pid")
    if not pid or not pid_alive(pid):
        return False
    cmdline = Path(f"/proc/{pid}/cmdline")
    if cmdline.exists():  # the pid may have been reused by another process
        try:
            return (entry.get("db") or "\0") in cmdline.read_bytes().decode(errors="replace")
        except OSError:
            return False
    return True


def serve_state(env):
    entry = env.state().get("serve")
    return entry if server_alive(entry) else None


def stop_server(env):
    entry = serve_state(env)
    if entry:
        with contextlib.suppress(OSError):
            os.killpg(entry["pid"], signal.SIGTERM)
        for _ in range(20):
            if not pid_alive(entry["pid"]):
                break
            time.sleep(0.5)
    env.update_state(lambda state: state.pop("serve", None))
    return bool(entry)


def wait_http(url, seconds):
    deadline = time.time() + seconds
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as response:
                if response.status == 200:
                    return True
        except OSError:
            time.sleep(1)
    return False


def start_server(env, db, port=None):
    """Serve `db` with this project's server. A server started for another database, source or environment
    is restarted, so what it shows is what the project holds now; other projects' servers are left alone."""
    roots, project = discover_project(env.root, env.config)
    addons = env.addons_path(roots)
    identity = sha(json.dumps([db, addons, env.runtime_key(), module_ids(env.root, project)], sort_keys=True))[:16]
    running = serve_state(env)
    if running and running.get("db") == db and running.get("identity") == identity and (
            not port or running.get("port") == port):
        return running
    if running:
        stop_server(env)
    if port and not port_free(port):
        raise OhError(f"port {port} is in use; pick another --port or stop what listens there")
    if not port:
        port = 8069 if port_free(8069) else free_port()
    log = env.log_file("serve")
    argv = env.odoo_server(db, addons, f"--db-filter=^{db}$", port=port)
    with open(log, "w") as handle:
        process = subprocess.Popen([str(a) for a in argv], stdout=handle, stderr=subprocess.STDOUT,
                                   env=env.runtime_env(), start_new_session=True)
    entry = {"pid": process.pid, "db": db, "port": port, "log": str(log), "started": now_iso(), "identity": identity}
    env.update_state(lambda state: state.__setitem__("serve", entry))
    if not wait_http(f"http://127.0.0.1:{port}/web/login", 180):
        raise OhError(f"server did not answer on port {port}; log: {log}")
    return entry


# --------------------------------------------------------------------------- result records

def evidence_name(kind, labels):
    label = "+".join(sorted(labels)) or "none"
    if len(label) > 60:
        label = "+".join(sorted(labels)[:3]) + f"+{len(labels) - 3}-more-{sha(label)[:6]}"
    return f"{kind}-" + re.sub(r"[^A-Za-z0-9._+-]+", "-", label).strip("-")


def command_line(argv):
    words, hide = [], False
    for word in argv:
        words.append("***" if hide else word)
        hide = word == "--password"
    return "oh " + shlex.join(words)


def browser_digest(path):
    if not path:
        return None
    try:
        info = os.stat(path)
    except OSError:
        return None
    return sha(f"{os.path.realpath(path)} {info.st_size} {info.st_mtime_ns}")[:12]


def environment_record(env):
    """Everything outside the project source that shapes a result."""
    return {
        "odoo": {"ref": env.config.get("odoo_ref"), "commit": env.odoo_commit, "repository": env.odoo_url},
        "enterprise": ({"commit": env.enterprise_commit, "key": env.enterprise_state,
                        "source": env.config.get("enterprise_repo") or "local path"} if env.enterprise else None),
        "python": env.python_version, "venv": env.venv_key, "packages": env.packages,
        "packages_changed_by_hand": env.packages_changed, "postgres": env.pg_version,
        "browser": browser_digest(env.browser_bin()), "wkhtmltopdf": bool(shutil.which("wkhtmltopdf")),
        "rtlcss": bool(env.rtlcss_dir or shutil.which("rtlcss")), "languages": env.load_languages(),
    }


def keep_file(source, folder, name, role, compress=False):
    """Copy (gzip when `compress`) `source` to `folder/name`; return its entry for a record's `files`."""
    data = Path(source).read_bytes()
    entry = {"name": name, "role": role}
    if compress:
        entry["content_sha256"] = sha_bytes(data)
        data = gzip.compress(data, mtime=0)
    target = Path(folder) / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    return dict(entry, sha256=sha_bytes(data), bytes=len(data))


def file_problems(record, folder, root):
    """Missing or changed files of a record: `name` entries live in its folder, `path` ones in the project."""
    problems = []
    for entry in record.get("files") or []:
        where = Path(folder) / entry["name"] if entry.get("name") else Path(root) / str(entry.get("path"))
        label = entry.get("name") or entry.get("path")
        if not where.is_file():
            problems.append(f"missing file {label}")
        elif sha_bytes(where.read_bytes()) != entry.get("sha256"):
            problems.append(f"changed file {label} (its sha256 differs from the record)")
    return problems


def save_record(env, name, record, to_project, retained=(), reuse_folder=None):
    """Keep a record and its files in this project's cache, and copy both into the project unless told not to.

    A record `<name>.json` has its files in the folder `<name>/` next to it (the Odoo log, screenshots),
    each listed in `files` with its sha256; `oh evidence` checks them. `retained` is a list of
    (source path, name in the folder, role, gzip?). Files kept elsewhere in the project are listed by `path`.
    """
    runs = env.home / "runs"
    stem = f"{time.strftime('%Y%m%d-%H%M%S')}-{time.time_ns() % 10**9:09d}-{os.getpid()}-{name}"  # sorts by time
    folder = runs / stem
    files = [f for f in record.get("files") or [] if not f.get("name")]
    if reuse_folder:
        shutil.copytree(reuse_folder, folder)
        files += [f for f in record.get("files") or [] if f.get("name")]
    for source, file_name, role, compress in retained:
        files.append(keep_file(source, folder, file_name, role, compress))
    record = json.loads(json.dumps(dict(record, files=files), default=str))
    write_json(runs / f"{stem}.json", record)
    env.last_run = runs / f"{stem}.json"
    for stale in sorted(runs.glob("*.json"))[:-KEEP_RECORDS]:
        stale.unlink(missing_ok=True)
        shutil.rmtree(stale.with_suffix(""), ignore_errors=True)
    if not to_project:
        return None
    target = env.root / EVIDENCE / f"{name}.json"
    shutil.rmtree(target.with_suffix(""), ignore_errors=True)
    if folder.is_dir():
        shutil.copytree(folder, target.with_suffix(""))
    write_json(target, record)
    return target.relative_to(env.root)


def find_reusable(env, identity):
    """(record, folder) of the newest run with this identity, when it passed less than REUSE_SECONDS ago
    and the log it retained is still intact; otherwise None. Only this machine's own runs count."""
    if not identity:
        return None
    for path in sorted((env.home / "runs").glob("*.json"), reverse=True):
        record = read_json(path)
        if not isinstance(record, dict) or record.get("identity") != identity:
            continue
        folder = path.with_suffix("")
        usable = (record.get("status") == "passed" and time.time() - record.get("finished_ts", 0) < REUSE_SECONDS
                  and any(f.get("role") == "log" for f in record.get("files") or [])
                  and not file_problems(record, folder, env.root))
        return (record, folder) if usable else None
    return None


