<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        U2 operator UI: the Orders branch, plus the customer-matching entry
        that belongs under the Catalog &amp; Matching branch the product
        module owns.

        Placement: Orders at sequence 15, directly under Dashboard (10) and
        above Stores (20) — the master specification puts Orders second
        because order-first merchants open it before anything else.

        Customer Matching parents into `shopify_connector_product`'s Catalog
        branch rather than creating a second matching home. That cross-module
        parent is safe: `shopify_connector_sale` depends on
        `shopify_connector_product`, so the parent menu is always loaded
        first.

        VISIBILITY vs AUTHORIZATION: as everywhere else in this UI, `groups=`
        here hides a menu and nothing more. The server enforces every ACL and
        every action guard independently.
    -->

    <menuitem id="menu_shopify_connector_orders"
              name="Orders"
              parent="shopify_connector_core.menu_shopify_connector_operations"
              sequence="10"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_order_workspace"
              name="All Orders"
              parent="menu_shopify_connector_orders"
              action="action_shopify_connector_order_workspace"
              sequence="10"/>

    <menuitem id="menu_shopify_connector_cod_reconciliation"
              name="COD Reconciliation"
              parent="menu_shopify_connector_orders"
              action="action_shopify_connector_cod_reconciliation"
              sequence="20"/>

    <menuitem id="menu_shopify_connector_customer_binding"
              name="Customer Matching"
              parent="shopify_connector_product.menu_shopify_connector_catalog"
              action="action_shopify_connector_customer_binding"
              sequence="30"/>
</odoo>
