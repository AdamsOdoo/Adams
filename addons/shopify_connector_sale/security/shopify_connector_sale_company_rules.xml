<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            SEC-3 (issue #197) multi-company isolation.

            Ownership model (control-room MVP decision, 2026-07-25). A connector
            store belongs to exactly ONE Odoo company, recorded on
            `shopify.connector.store.company_id`; a company may own several
            stores; sharing one store across companies is outside the MVP.
            Every durable store-scoped row inherits that company through a
            stored related `company_id`, so company is decided in exactly one
            place and cannot drift.

            This SUPERSEDES the earlier model in which the store carried no
            company and each connector row borrowed the company of the business
            record it pointed at. That model left the entire control plane
            (store, credential, settings, location, job, job.log,
            mutation.attempt, call.lease) readable across companies, which did
            not satisfy #197. See
            docs/03-architecture/sec3-company-isolation-audit.md.

            `noupdate="0"` is deliberate: these are security rules, and a
            correction to a security rule must reach databases that already
            carry the old one on the next module update.

            Two rules apply to each row and BOTH must pass, because they close
            different holes:
              * the STORE rule — fail-closed, `('company_id', 'in',
                company_ids)`, with no NULL escape. A row whose ownership we
                cannot prove is shown to nobody.
              * the BUSINESS-RECORD rule — keeps the pre-existing guarantee
                that another company's record cannot be reached through a
                connector row, and correctly treats a genuinely company-neutral
                record as shared.

            `company_ids` is the reader's *activated* company set
            (odoo/odoo@19.0 30bde9ff, odoo/addons/base/models/ir_rule.py
            `_eval_context`), so an allowed-but-unselected company is excluded.

            Scope. Record rules constrain interactive access. Connector system
            code runs `sudo()` and bypasses them by design; the write-side
            authority is Odoo's native `_check_company` (opted into via
            `_check_company_auto` + `check_company=True` on the business
            relation) plus the fail-closed checks in the importers.
        -->

        <record id="customer_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Customer Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_customer_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="order_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Order Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_order_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('sale_order_id.company_id', '=', False), ('sale_order_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="tax_mapping_company_rule" model="ir.rule">
            <field name="name">Shopify Tax Mapping: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_tax_mapping"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('account_tax_id.company_id', '=', False), ('account_tax_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="customer_binding_store_company_rule" model="ir.rule">
            <field name="name">Shopify Customer Binding: owning store company</field>
            <field name="model_id" ref="model_shopify_connector_customer_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="order_binding_store_company_rule" model="ir.rule">
            <field name="name">Shopify Order Binding: owning store company</field>
            <field name="model_id" ref="model_shopify_connector_order_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="tax_mapping_store_company_rule" model="ir.rule">
            <field name="name">Shopify Tax Mapping: owning store company</field>
            <field name="model_id" ref="model_shopify_connector_tax_mapping"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
