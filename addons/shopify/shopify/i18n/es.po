msgstr ""
"Este pedido de Shopify ya ha sido cancelado y no se puede cancelar de nuevo."

#. module: shopify
#. odoo-python
#: code:addons/shopify/models/payout.py:0
msgid ""
"This bank transaction has been automatically validated using the shopify "
"payout auto reconcile process"
msgstr ""
"Esta transacción bancaria se ha validado automáticamente utilizando el "
"proceso de conciliación automática de pagos de Shopify"

#. module: shopify
