#. module: shopify
#. odoo-python
#: code:addons/shopify/models/shopify_metafield_mapping.py:0
#, python-format
msgid ""
"SHOPIFY METAFIELD CONFIGURATION: Cannot save metafield '%(record_name)s' on instance '%(instance_name)s'\n"
"\n"
"Issue: '%(field_description)s' (selected as '%(current_slot_label)s') is already used as '%(other_slot)s' by metafield '%(other_name)s' on instance '%(other_instance_name)s'\n"
"\n"
"How to fix: Pick a different Odoo field, or remove it from metafield '%(other_name)s' first."
msgstr ""
"SHOPIFY METAFELD-KONFIGURATION: Metafeld '%(record_name)s' kann auf Instanz "
"'%(instance_name)s' nicht gespeichert werden\\n\\nProblem: "
"'%(field_description)s' (ausgewählt als '%(current_slot_label)s') wird "
"bereits als '%(other_slot)s' vom Metafeld '%(other_name)s' auf Instanz "
"'%(other_instance_name)s' verwendet\\n\\nSo beheben Sie das Problem: Wählen "
"Sie ein anderes Odoo-Feld aus, oder entfernen Sie es zuerst aus dem Metafeld"
" '%(other_name)s'."

#. module: shopify
#. odoo-python
#: code:addons/shopify/models/shopify_metafield_mapping.py:0
#, python-format
msgid ""
"SHOPIFY METAFIELD CONFIGURATION: Cannot save metafield '%(record_name)s' on instance '%(instance_name)s'\n"
"\n"
"Issue: '%(field_description)s' is selected as both 'Odoo Field' and 'Alt Text Field'\n"
"\n"
"How to fix: Pick a different Odoo field for one of the two slots, or leave 'Alt Text Field' empty if not needed."
msgstr ""
"SHOPIFY METAFELD-KONFIGURATION: Metafeld '%(record_name)s' kann auf Instanz "
"'%(instance_name)s' nicht gespeichert werden\\n\\nProblem: "
"'%(field_description)s' ist sowohl als 'Odoo-Feld' als auch als 'Alt-Text-"
"Feld' ausgewählt\\n\\nSo beheben Sie das Problem: Wählen Sie für einen der "
"beiden Slots ein anderes Odoo-Feld aus, oder lassen Sie 'Alt-Text-Feld' "
"leer, falls nicht benötigt."

