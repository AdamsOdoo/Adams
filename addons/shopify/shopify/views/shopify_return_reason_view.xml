<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="shopify_return_reason_tree_view" model="ir.ui.view">
            <field name="name">shopify_return_reason_tree_view</field>
            <field name="model">shopify.return.reason.ts</field>
            <field name="arch" type="xml">
                <list string="Shopify Return Reasons" create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="handle"/>
                    <field name="mk_instance_id"/>
                    <field name="shopify_reason_definition_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="shopify_return_reason_search_view" model="ir.ui.view">
            <field name="name">shopify_return_reason_search_view</field>
            <field name="model">shopify.return.reason.ts</field>
            <field name="arch" type="xml">
                <search string="Return Reasons">
                    <field name="name"/>
                    <field name="handle"/>
                    <field name="mk_instance_id"/>
                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by': 'mk_instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_shopify_return_reason" model="ir.actions.act_window">
            <field name="name">Return Reasons</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shopify.return.reason.ts</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>