<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherit_shopify" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.base.shopify</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="after">
                    <div name="marketplace" class="badge rounded-pill float-end fs-6 text-white"
                         style="background-color: #95BF46; font-size: 1.08333333rem !important; border: 1px solid #95BF46 !important;"
                         groups="base_marketplace.group_base_marketplace"
                         invisible="marketplace != 'shopify'"><field name="marketplace" style="margin-bottom: auto;"/>
                    </div>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="is_shopify_return_picking" invisible="1"/><!-- always invisible: technical field required by view logic -->
                    <field name="shopify_return_id" invisible="1"/><!-- always invisible: technical field required by view logic -->
                    <button name="action_open_shopify_return" type="object" class="oe_stat_button" icon="fa-arrow-circle-o-left"
                            groups="base_marketplace.group_base_marketplace"
                            invisible="not shopify_return_id">
                        <span class="o_stat_text">Shopify Return</span>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <field name="has_shopify_returnable_qty" invisible="1"/><!-- always invisible: technical field required by view logic -->
                    <button name="action_open_shopify_return_export_wiz" type="object" string="Create Return in Shopify"
                            class="btn-secondary" icon="fa-undo"
                            invisible="marketplace != 'shopify' or state != 'done' or picking_type_code != 'outgoing' or shopify_return_id or not has_shopify_returnable_qty or not updated_in_marketplace or (sale_id_is_pickup_order and not is_picked_up_in_marketplace)"
                            help="Create a return in Shopify for the delivered items that are eligible for return."/>
                </xpath>
            </field>
        </record>

        <record id="view_move_form_inherit_shopify" model="ir.ui.view">
            <field name="name">stock.move.form.inherit.shopify</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="is_shopify_returnable_move" invisible="1"/>
                    <button name="action_open_shopify_return_export_wiz" type="object"
                            string="Create Return in Shopify" class="btn-secondary" icon="fa-undo"
                            invisible="not is_shopify_returnable_move"
                            help="Create a return in Shopify for the quantity delivered by this stock move."/>
                </xpath>
            </field>
        </record>

        <record id="action_shopify_delivery_dashboard" model="ir.actions.act_window">
            <field name="name">Shopify Delivery Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('mk_instance_id','=',active_id)]</field>
        </record>

        <record id="base_marketplace_picking_form_view_inherit" model="ir.ui.view">
            <field name="name">base.marketplace.stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="base_marketplace.view_picking_form_inherit_base_marketplace"/>
            <field name="arch" type="xml">
                <field name="scheduled_date" position="after">
                    <field name="is_picked_up_in_marketplace" invisible="1"/><!-- always invisible: technical field required by view logic -->
                    <field name="sale_id_is_pickup_order" invisible="1"/><!-- always invisible: technical field required by view logic -->
                </field>

                <xpath expr="//button[@name='update_order_status_to_marketplace']" position="attributes">
                    <attribute name="invisible">not mk_instance_id or is_fbm_order or updated_in_marketplace or is_marketplace_exception or state != 'done' or cancel_in_marketplace or picking_type_code != 'outgoing' or (marketplace == 'shopify' and sale_id_is_pickup_order)</attribute>
                </xpath>

                <xpath expr="//button[@name='update_order_status_to_marketplace']" position="after">
                    <button name="update_order_status_to_marketplace" string="Ready For Pickup" type="object" class="btn-primary" icon="fa-shopping-basket"
                            groups="base_marketplace.group_base_marketplace" invisible="marketplace != 'shopify' or not sale_id_is_pickup_order or updated_in_marketplace or state != 'done' or is_marketplace_exception"
                            confirm="This will mark the order as Ready for Pickup in Shopify. Do you want to proceed?"/>
                </xpath>

                <button name="update_order_status_to_marketplace" position="after">
                    <button name="action_already_picked_up" string="Mark as picked up" type="object" icon="fa-check-circle" class="oe_highlight"
                            groups="base_marketplace.group_base_marketplace"
                            invisible="marketplace != 'shopify' or not sale_id_is_pickup_order or is_picked_up_in_marketplace or state != 'done' or not updated_in_marketplace"
                            confirm="This will mark the order as Mark as picked up in Shopify. Do you want to proceed?"/>
                </button>
                <xpath expr="//div[@invisible='not updated_in_marketplace']" position="replace">
                    <div class="alert alert-success mb-0" role="alert" groups="base_marketplace.group_base_marketplace" invisible="not updated_in_marketplace or (sale_id_is_pickup_order and not is_picked_up_in_marketplace)">
                        <strong>
                            Order has been successfully updated/fulfilled in marketplace.
                        </strong>
                    </div>
                    <div class="alert alert-success mb-0" role="alert" groups="base_marketplace.group_base_marketplace" invisible="not sale_id_is_pickup_order or not updated_in_marketplace or is_picked_up_in_marketplace">
                        <strong>
                            Order has been successfully marked as Ready for Pickup in Shopify.
                        </strong>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
