<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="shopify_payout_form_view" model="ir.ui.view">
            <field name="name">shopify_payout_form_view</field>
            <field name="model">shopify.payout</field>
            <field name="arch" type="xml">
                <form string="Shopify Payout" duplicate="0" create="0" edit="0">
                    <header>
                        <button name="button_post" string="Post" invisible="state != 'draft'" class="oe_highlight" type="object"/>
                        <button string="Auto Reconcile" class="oe_highlight" name="button_reconcile" type="object"
                                invisible="all_lines_reconciled or not payout_line_ids or state != 'posted'"/>
                        <button string="Reconcile" name="button_manual_reconcile" type="object" invisible="all_lines_reconciled or not payout_line_ids or state != 'posted'" groups="account.group_account_basic"/>
                        <button string="Reset to New" name="button_reopen" type="object" invisible="state != 'posted'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name" string="Payout Name"/>
                            <h1>
                                <field name="name" placeholder="Payout Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="mk_instance_id" readonly="1"/>
                                <field name="report_id" readonly="1"/>
                                <field name="currency_id" readonly="1" groups="base.group_multi_currency"/>
                            </group>
                            <group>
                                <field name="payout_date" readonly="1"/>
                                <field name="amount" readonly="1"/>
                                <field name="bank_statement_id" readonly="1" />
                                <field name="all_lines_reconciled" invisible="1" /><!-- always invisible: technical field required by view logic -->
                            </group>
                        </group>
                        <notebook>
                            <page string="Payout Lines">
                                <field name="payout_line_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shopify_payout_tree_view" model="ir.ui.view">
            <field name="name">shopify_payout_tree_view</field>
            <field name="model">shopify.payout</field>
            <field name="arch" type="xml">
                <list string="Shopify Payout" create="0" edit="0">
                    <field name="name"/>
                    <field name="report_id"/>
                    <field name="mk_instance_id" readonly="1"/>
                    <field name="currency_id" groups="base.group_multi_currency" />
                    <field name="payout_date"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="shopify_payout_search_view" model="ir.ui.view">
            <field name="name">shopify.payout.search.view</field>
            <field name="model">shopify.payout</field>
            <field name="arch" type="xml">
                <search string="Payout Search">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('report_id', '=', self)]"/>
                    <field name="order_id" />
                    <field name="source_order_id" />
                    <field name="mk_instance_id"/>

                    <separator/>
                    <filter string="Draft" name="in_process" domain="[('state', '=', 'draft')]"/>
                    <filter string="In Process" name="in_process" domain="[('state', '=', 'posted')]"/>
                    <filter string="Validated" name="in_process" domain="[('state', '=', 'confirm')]"/>

                    <group>
                        <filter string="Instance" name="group_by_instance" context="{'group_by': 'mk_instance_id'}"/>
                    </group>
                    <searchpanel>
                        <field name="mk_instance_id" icon="fa-shopping-bag" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="shopify_payout_line_form_view" model="ir.ui.view">
            <field name="name">shopify.payout.line.form.view</field>
            <field name="model">shopify.payout.line</field>
            <field name="arch" type="xml">
                <form string="Shopify Payout Line" duplicate="0">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="transaction_id" string="Transaction Identification"/>
                            <h1>
                                <field name="transaction_id" placeholder="Transaction Identification"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="payout_id" />
                                <field name="order_id" />
                                <field name="source_order_id" />
                                <field name="transaction_type_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="processed_at" />
                                <field name="currency_id" invisible="1" /><!-- always invisible: technical field required by view logic -->
                            </group>
                            <group>
                                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                <field name="fee" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                <field name="net_amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                            </group>
                        </group>
                        <div class="text-center" invisible="not warn_message">
                            <p>
                                <strong>
                                    <field name="warn_message" class="text-warning"/>
                                </strong>
                            </p>
                        </div>
                        <div class="text-center" invisible="not error_message">
                            <p>
                                <strong>
                                    <field name="error_message" class="text-danger"/>
                                </strong>
                            </p>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shopify_payout_line_tree_view" model="ir.ui.view">
            <field name="name">shopify_payout_line_tree_view</field>
            <field name="model">shopify.payout.line</field>
            <field name="arch" type="xml">
                <list decoration-warning="warn_message != False" decoration-danger="error_message != False" decoration-muted="is_reconciled" limit="500" string="Shopify Payout Line">
                    <field name="processed_at"/>
                    <field name="order_id"/>
                    <field name="transaction_type_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="source_order_id" optional="hide"/>
                    <field name="transaction_id" optional="hide"/>
                    <field name="currency_id" column_invisible="True"/><!-- always invisible: technical field required by view logic -->
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Amount"/>
                    <field name="fee" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Fees"/>
                    <field name="net_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="bank_statement_line_id"/>
                    <field name="warn_message" column_invisible="True"/><!-- always invisible: technical field required by view logic -->
                    <field name="error_message" column_invisible="True"/><!-- always invisible: technical field required by view logic -->
                    <field name="is_reconciled" column_invisible="True"/><!-- always invisible: technical field required by view logic -->
                    <button class="btn btn-sm btn-secondary" title="Match" type="object" name="action_open_recon_payout_line" string="Match"
                            invisible="is_reconciled or not bank_statement_line_id" groups="account.group_account_basic"/>
                    <button name="button_undo_reconciliation" type="object" invisible="not is_reconciled" column_invisible="parent.state not in ['posted', 'confirm']" string="Revert reconciliation"
                            icon="fa-undo"/>
                </list>
            </field>
        </record>

        <record id="action_shopify_payout" model="ir.actions.act_window">
            <field name="name">Payouts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shopify.payout</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>
                </p>
            </field>
        </record>

        <record id="action_shopify_payout_dashboard" model="ir.actions.act_window">
            <field name="name">Payouts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shopify.payout</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('mk_instance_id', '=', active_id)]</field>
            <field name="help" type="html">
                <p>
                </p>
            </field>
        </record>
    </data>
</odoo>
