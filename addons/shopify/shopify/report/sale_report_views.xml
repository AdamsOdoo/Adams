<odoo>
    <data>
        <record id="view_marketplace_report_search_inherit_shopify" model="ir.ui.view">
            <field name="name">view.marketplace.report.search.inherit</field>
            <field name="model">sale.report</field>
            <field name="inherit_id" ref="base_marketplace.view_marketplace_report_search_inherit"/>
            <field name="arch" type="xml">
                <field name="marketplace_type" position="after">
                    <field name="shopify_order_source_name"/>
                </field>
                <xpath expr="//filter[@name='Sales']" position="after">
                    <separator/>
                    <filter name="shopify_order_source_name" string="Shopify Order Source" domain="[('shopify_order_source_name', '!=', False)]"/>
                </xpath>
                <xpath expr="//filter[@name='company']" position="after">
                    <filter string="Shopify Order Source" name="group_by_shopify_order_source_name" context="{'group_by':'shopify_order_source_name'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>