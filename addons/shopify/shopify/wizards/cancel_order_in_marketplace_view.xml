<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="cancel_in_shopify_form_view" model="ir.ui.view">
            <field name="name">mk.cancel.order.form.view</field>
            <field name="model">mk.cancel.order</field>
            <field name="arch" type="xml">
                <form string="Cancel In Shopify">
                    <group>
                        <group>
                            <field name="currency_id" invisible="1" force_save="1"/><!-- always invisible: technical field required by view logic -->
                            <field name="shopify_cancel_reason" required="1"/>
                            <field name="create_refund_option_visible" invisible="1"/><!-- always invisible: technical field required by view logic -->
                             <field name="invisible_shopify_is_refund_payments" invisible="1"/><!-- always invisible: technical field required by view logic -->
                            <field name="shopify_is_refund_payments"  invisible="not invisible_shopify_is_refund_payments"/>
                        </group>
                        <group>
                            <field name="shopify_is_notify_customer"/>
                            <field name="invisible_shopify_restock_inventory" invisible="1"/><!-- always invisible: technical field required by view logic -->
                            <field name="shopify_is_restock_inventory" invisible="not invisible_shopify_restock_inventory"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Cancel Order" class="oe_highlight" type="object" name="cancel_and_refund_in_shopify"/>
                        <button string="Keep Order" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="refund_in_shopify_form_view" model="ir.ui.view">
            <field name="name">mk.cancel.order.form.view</field>
            <field name="model">mk.cancel.order</field>
            <field name="arch" type="xml">
                <form string="Refund In Shopify">
                    <field name="duties_warning" invisible="1"/><!-- always invisible: technical field required by view logic -->
                    <div class="alert alert-info info_icon" role="alert" invisible="not duties_warning">
                        <span class="fa fa-lightbulb-o"/>
                        Duties amount will not be refunded from Odoo.
                    </div>
                    <div class="alert alert-info info_icon" role="alert" invisible="shopify_refund_payment_lines or not shopify_amount_total">
                        <span class="fa fa-lightbulb-o"/>
                        It seems all items are already refunded in shopify. You can refund remaining amount from here.
                    </div>
                    <div class="alert alert-info info_icon" role="alert" invisible="shopify_gift_card_amount or shopify_amount_total">
                        <span class="fa fa-lightbulb-o"/>
                        Gift card amount will not be refunded. You have to manually refund from the Shopify.
                    </div>
                    <div class="alert alert-info info_icon" role="alert" invisible="shopify_amount_total">
                        <span class="fa fa-lightbulb-o"/>
                        Gift card amount will not be refunded. You have to manually refund from the Shopify. You can mark this order as refunded in Odoo.
                    </div>
                    <group invisible="shopify_refund_payment_lines or not shopify_amount_total">
                        <group>
                            <field name="shopify_manual_refund_amount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="refund_description"/>
                        </group>
                        <group>
                            <field name="shopify_amount_total" widget='monetary' options="{'currency_field': 'currency_id'}" readonly="True" force_save="1"/>
                            <field name="shopify_is_notify_customer"/>
                        </group>
                    </group>
                    <group string="Refund payments" invisible="not shopify_refund_payment_lines">
                        <field name="shopify_refund_payment_lines" nolabel="1">
                            <list string="Refund Payments" editable="top" create="false" delete="false">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="available_qty" readonly="1" force_save="1"/>
                                <field name="price_unit" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="to_refund_qty"/>
                                <field name="refund_price_unit" widget="monetary" readonly="1" options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_tax" optional="hide"/>
                                <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" column_invisible="True" force_save="1"/><!-- always invisible: technical field required by view logic -->
                            </list>
                        </field>
                        <field name="shopify_remaining_shipping_amount" invisible="1"/><!-- always invisible: technical field required by view logic -->
                        <field name="currency_id" invisible="1" force_save="1"/><!-- always invisible: technical field required by view logic -->
                        <group class="oe_subtotal_footer float-end" colspan="2" name="refund_payment_total">
                            <field name="shopify_amount_subtotal" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="shopify_shipping_amount" widget='monetary' options="{'currency_field': 'currency_id'}" string="Shipping"/>
                            <field name="shopify_tax_amount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="shopify_gift_card_amount" widget='monetary' options="{'currency_field': 'currency_id'}" readonly="1" invisible="not shopify_gift_card_amount"/>
                            <field name="shopify_amount_total" widget='monetary' options="{'currency_field': 'currency_id'}" readonly="True" force_save="1"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="shopify_manual_refund_amount"/>
                            </div>
                            <field name="shopify_manual_refund_amount" nolabel="1" class="oe_subtotal_footer_separator" widget='monetary'
                                   options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                        </group>
                        <group colspan="4">
                        </group>
                        <div class="oe_clear"/>
                    </group>
                    <group invisible="not shopify_refund_payment_lines">
                        <group>
                            <field name="shopify_restock_type" required="shopify_amount_subtotal" invisible="not shopify_refund_payment_lines or not shopify_amount_subtotal"/>
                            <field name="create_refund_option_visible" invisible="1"/><!-- always invisible: technical field required by view logic -->
                            <field name="refund_description" required="is_create_refund"/>
                            <field name="shopify_is_notify_customer"/>
                            <field name="is_create_refund" string="Create Credit Note in Odoo"
                                   invisible="not shopify_refund_payment_lines or not create_refund_option_visible or not shopify_amount_subtotal"/>
                        </group>
                    </group>
                    <group string="Credit Note Info" invisible="not is_create_refund">
                        <group>
                            <field name="date_invoice" required="is_create_refund"/>
                        </group>
                        <group>
                            <field name="payment_journal_id" required="is_create_refund"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Refund Order" class="oe_highlight" type="object" name="do_refund_in_shopify" invisible="not shopify_amount_total"/>
                        <button string="Force Refund Order" context="{'force_refund': True}" class="oe_highlight" type="object" name="do_refund_in_shopify"
                                invisible="shopify_amount_total"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
