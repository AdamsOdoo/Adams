#: code:addons/shopify/models/shopify_metafield_mapping.py:0
#, python-format
msgid ""
"SHOPIFY METAFIELD CONFIGURATION: Cannot save metafield '%(record_name)s' on instance '%(instance_name)s'\n"
"\n"
"Issue: '%(field_description)s' (selected as '%(current_slot_label)s') is already used as '%(other_slot)s' by metafield '%(other_name)s' on instance '%(other_instance_name)s'\n"
"\n"
"How to fix: Pick a different Odoo field, or remove it from metafield '%(other_name)s' first."
msgstr ""
"SHOPIFY METAVELD CONFIGURATIE: Kan metaveld '%(record_name)s' niet opslaan op instantie '%(instance_name)s'\n"
"\n"
"Probleem: '%(field_description)s' (geselecteerd als '%(current_slot_label)s') wordt al gebruikt als '%(other_slot)s' door metaveld '%(other_name)s' op instantie '%(other_instance_name)s'\n"
"\n"
"Oplossing: Kies een ander Odoo-veld of verwijder het eerst uit metaveld '%(other_name)s'."

#. module: shopify
#. odoo-python
#: code:addons/shopify/models/shopify_metafield_mapping.py:0
#, python-format
msgid ""
"SHOPIFY METAFIELD CONFIGURATION: Cannot save metafield '%(record_name)s' on instance '%(instance_name)s'\n"
"\n"
"Issue: '%(field_description)s' is selected as both 'Odoo Field' and 'Alt Text Field'\n"
"\n"
"How to fix: Pick a different Odoo field for one of the two slots, or leave 'Alt Text Field' empty if not needed."
msgstr ""
"SHOPIFY METAVELD CONFIGURATIE: Kan metaveld '%(record_name)s' niet opslaan op instantie '%(instance_name)s'\n"
"\n"
"Probleem: '%(field_description)s' is geselecteerd als zowel 'Odoo-veld' als 'Alt-tekstveld'\n"
"\n"
"Oplossing: Kies een ander Odoo-veld voor een van de twee slots, of laat 'Alt-tekstveld' leeg als het niet nodig is."

