#. module: adams_stock_no_negative
#: model:ir.model.fields,help:adams_stock_no_negative.field_res_company__adams_pos_allow_negative_stock
#: model:ir.model.fields,help:adams_stock_no_negative.field_res_config_settings__adams_pos_allow_negative_stock
msgid ""
"Allow Point of Sale orders of this company to deliver products that are not "
"in stock."
msgstr ""
"السماح لطلبات نقطة البيع في هذه الشركة بتسليم منتجات غير متوفرة في المخزون."

#. module: adams_stock_no_negative
#: model:ir.model.fields,help:adams_stock_no_negative.field_res_config_settings__adams_pos_bypass_shown
msgid "Allow Point of Sale orders to deliver products that are not in stock."
msgstr "السماح لطلبات نقطة البيع بتسليم منتجات غير متوفرة في المخزون."

#. module: adams_stock_no_negative
#: model_terms:ir.ui.view,arch_db:adams_stock_no_negative.res_config_settings_view_form
msgid ""
"Allow Point of Sale orders to deliver products that are not in stock. "
"Included while the bypass for all stock operations is on."
msgstr ""
"السماح لطلبات نقطة البيع بتسليم منتجات غير متوفرة في المخزون. يكون مفعّلاً "
"تلقائياً ما دام التجاوز لجميع عمليات المخزون مفعّلاً."

#. module: adams_stock_no_negative
#: model:ir.model.fields,help:adams_stock_no_negative.field_res_company__adams_allow_negative_stock
#: model:ir.model.fields,help:adams_stock_no_negative.field_res_config_settings__adams_allow_negative_stock
msgid ""
"Allow stock operations of this company to take on-hand quantities below "
"zero."
msgstr "السماح لعمليات المخزون في هذه الشركة بجعل الكميات الفعلية أقل من صفر."

#. module: adams_stock_no_negative
#: model_terms:ir.ui.view,arch_db:adams_stock_no_negative.res_config_settings_view_form
msgid ""
"Allow stock operations to take on-hand quantities below zero. When off, they"
" are refused."
msgstr ""
"السماح لعمليات المخزون بجعل الكميات الفعلية أقل من صفر. عند إيقافه، تُرفض "
"هذه العمليات."

