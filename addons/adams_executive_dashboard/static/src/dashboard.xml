<templates xml:space="preserve">
    <t t-name="adams_executive_dashboard.Dashboard">
        <main class="o_adams_dashboard" t-ref="root">
            <header class="adams_header">
                <div><span class="adams_eyebrow">ADAMS · EXECUTIVE WORKSPACE</span>
                    <h1>Business overview</h1><p>Native reports. One clear view.</p></div>
                <span class="adams_preview">Development preview</span>
            </header>
            <div t-if="state.error" class="alert alert-warning" role="alert"><t t-esc="state.error"/></div>
            <t t-if="state.companies.length">
                <form class="adams_filters" t-on-submit.prevent="refresh">
                    <label>Company<select t-model="state.draft.company_id" class="form-select" required="required">
                        <option t-foreach="state.companies" t-as="company" t-key="company.id" t-att-value="company.id"><t t-esc="company.name"/></option>
                    </select></label>
                    <label>From<input class="form-control" type="date" t-model="state.draft.date_from" required="required"/></label>
                    <label>To<input class="form-control" type="date" t-model="state.draft.date_to" required="required"/></label>
                    <label>Balance as of<input class="form-control" type="date" t-model="state.draft.as_of" required="required"/></label>
                    <button class="btn btn-primary" type="submit">Apply filters</button>
                </form>
                <p class="adams_scope" t-if="state.applied">
                    Applied period: <bdi t-esc="state.applied.date_from"/> — <bdi t-esc="state.applied.date_to"/>
                    <span> · Balance cutoff: <bdi t-esc="state.applied.as_of"/></span>
                </p>
                <nav class="adams_nav" aria-label="Dashboard sections">
                    <a t-foreach="sections" t-as="section" t-key="section.key" t-att-href="'#adams-' + section.key"><t t-esc="section.name"/></a>
                </nav>
                <t t-if="state.detail">
                    <t t-set="detail" t-value="state.detail"/>
                    <section class="adams_analysis" aria-labelledby="adams-analysis-title" aria-live="polite">
                        <div class="adams_analysis_heading"><h2 id="adams-analysis-title" t-esc="labels[detail.key]"/>
                            <button class="btn btn-outline-secondary" t-on-click="closeDetail">Close analysis</button></div>
                        <label>Group by <select class="form-select" t-on-change="(event) => this.inspect(detail.key, event.target.value)">
                            <option t-foreach="dimensions[detail.key]" t-as="dimension" t-key="dimension" t-att-value="dimension" t-att-selected="dimension === detail.dimension" t-esc="dimensionLabels[dimension]"/>
                        </select></label>
                        <p t-if="detail.status === 'loading'" role="status">Loading native reports…</p>
                        <p t-elif="detail.status === 'error'" role="alert">Analysis unavailable. Check your access and retry.</p>
                        <t t-else="">
                            <p t-if="!detail.rows.length">No matching records</p>
                            <div class="adams_analysis_columns">
                                <div class="adams_table_wrap"><table class="table">
                                    <caption>Native grouped values. Pages do not define the headline total.</caption>
                                    <thead><tr><th scope="col" t-esc="dimensionLabels[detail.dimension]"/><th scope="col">Value</th></tr></thead>
                                    <tbody><tr t-foreach="detail.rows" t-as="row" t-key="row.id || 'unassigned'">
                                        <td><button class="btn btn-link" t-on-click="() => this.openReport(detail.key, detail.dimension, row.id)" t-esc="row.label"/></td>
                                        <td><bdi t-esc="formatted({value: row.value, key: detail.key}, detail)"/> <t t-esc="detail.unit === 'currency' ? detail.currency : detail.unit"/></td>
                                    </tr></tbody>
                                </table>
                                <div class="adams_page_controls">
                                    <button class="btn btn-outline-secondary" t-att-disabled="detail.offset === 0" t-on-click="() => this.inspect(detail.key, detail.dimension, detail.offset - 25)">Previous</button>
                                    <button class="btn btn-outline-secondary" t-att-disabled="!detail.has_more" t-on-click="() => this.inspect(detail.key, detail.dimension, detail.offset + 25)">Next</button>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.exporting" t-on-click="exportDetail">Export all groups</button>
                                </div></div>
                                <div class="adams_table_wrap"><table class="table adams_trend">
                                    <caption>Monthly native values. Bar length shows magnitude; negative amounts retain their sign. Months without records are omitted.</caption>
                                    <thead><tr><th scope="col">Month</th><th scope="col">Value</th></tr></thead>
                                    <tbody><tr t-foreach="detail.trend" t-as="row" t-key="row.label">
                                        <th scope="row"><bdi t-esc="row.label"/></th>
                                        <td><bdi t-esc="formatted({value: row.value, key: detail.key}, detail)"/>
                                            <div class="adams_bar_track" aria-hidden="true"><span t-att-class="{'negative': row.value &lt; 0}" t-att-style="'width:' + barWidth(row.value, detail.trend)"/></div></td>
                                    </tr></tbody>
                                </table></div>
                            </div>
                            <details t-if="detail.provenance"><summary>Source and scope</summary>
                                <p><code t-esc="detail.provenance.model"/> · <code t-esc="detail.provenance.measure"/></p>
                                <p>Scope fingerprint: <code t-esc="detail.provenance.fingerprint"/></p>
                            </details>
                        </t>
                    </section>
                </t>
                <section t-foreach="sections" t-as="section" t-key="section.key" t-att-id="'adams-' + section.key" class="adams_section" t-att-aria-labelledby="'title-' + section.key">
                    <h2 t-att-id="'title-' + section.key"><button class="adams_section_toggle" t-att-aria-expanded="!state.collapsed[section.key]" t-on-click="() => this.toggleSection(section.key)"><t t-esc="section.name"/> <span aria-hidden="true" t-esc="state.collapsed[section.key] ? '+' : '−'"/></button></h2>
                    <p t-esc="section.description"/>
                    <t t-if="!state.collapsed[section.key]">
                    <t t-set="result" t-value="state.sections[section.key]"/>
                    <div t-if="!result || result.status === 'loading'" class="adams_message" role="status">Loading native reports…</div>
                    <div t-elif="result.status === 'error'" class="adams_message" role="alert">
                        This section could not be loaded. Check the filters and your access, then apply filters to retry.
                    </div>
                    <div t-else="" class="adams_grid">
                        <t t-foreach="result.items" t-as="item" t-key="item.key">
                        <h3 t-if="groupHeadings[item.key]" class="adams_group_heading" t-esc="groupHeadings[item.key]"/>
                        <article class="adams_card" t-att-class="{ 'adams_available': item.status === 'ready' }">
                            <h3 t-esc="labels[item.key]"/>
                            <div class="adams_value" t-esc="formatted(item, result)"/>
                            <span t-if="item.value !== null &amp;&amp; item.unit === 'currency'" class="adams_currency" t-esc="result.currency"/>
                            <span t-if="item.value !== null &amp;&amp; item.unit === 'hours'" class="adams_currency">hours</span>
                            <span t-if="item.value !== null &amp;&amp; item.unit === 'percentage'" class="adams_currency">%</span>
                            <p t-if="item.status === 'not_configured'" class="adams_hint">Native report mapping awaits verification.</p>
                            <p t-if="item.has_warnings" class="adams_hint" role="status">The native report has warnings. Open it before interpreting this result.</p>
                            <p t-if="item.key === 'invoiced_sales'" class="adams_hint">Posted customer invoices less credit notes, untaxed. Invoice date; distinct from accounting revenue.</p>
                            <p t-if="item.key === 'confirmed_sales' || item.key === 'orders'" class="adams_hint">Confirmed orders by order date. Untaxed amounts; this is not delivered or invoiced sales.</p>
                            <p t-if="item.key === 'quotations'" class="adams_hint">Draft and sent quotations by native order date, untaxed. Expired quotations remain included while their native state is draft or sent.</p>
                            <p t-if="item.key === 'purchases'" class="adams_hint">Confirmed purchase orders by order date, untaxed. This is not an outstanding balance.</p>
                            <p t-if="item.key === 'crm'" class="adams_hint">Active open opportunities created in the period. Native probability-weighted revenue, not a cash forecast. Company-unassigned opportunities are excluded.</p>
                            <p t-if="item.key === 'hr'" class="adams_hint">Approved requests starting in the period, for active employees. Native report hours are negative for leave taken. Not period-prorated capacity.</p>
                            <footer t-if="item.source">
                                <details><summary>Source and scope</summary>
                                    <p t-esc="item.source"/><code t-esc="item.measure"/>
                                    <p t-if="item.source_line" t-esc="item.source_line"/>
                                    <p t-if="item.definition" t-esc="item.definition"/>
                                    <p>Date basis: <code t-esc="item.date_field"/></p>
                                    <p>One company · native report currency · current access rules</p>
                                </details>
                                <button t-if="item.drilldown" type="button" class="btn btn-link" t-att-disabled="state.opening" t-on-click="() => this.openReport(item.key)">Open native report <span aria-hidden="true">↗</span></button>
                                <button t-if="dimensions[item.key]" type="button" class="btn btn-link" t-on-click="() => this.inspect(item.key)">Explore breakdown and trend</button>
                            </footer>
                        </article>
                        </t>
                    </div>
                    <p t-if="result &amp;&amp; result.generated_at" class="adams_scope">Fetched at <bdi t-esc="result.generated_at"/> UTC. Source completeness has not been assessed.</p>
                    <t t-if="section.key === 'finance'">
                        <button class="btn btn-outline-secondary mt-3" t-on-click="() => this.loadDirectory('cash')">Discover bank and cash accounts</button>
                        <div t-if="state.directory" class="adams_analysis">
                            <h3>Bank and cash directory</h3>
                            <p>Configuration only. Native financial balances are not connected yet. Archived accounts are included; credit-card liabilities are excluded.</p>
                            <p t-if="state.directory.status === 'loading'" role="status">Loading…</p>
                            <p t-if="state.directory.status === 'error'" role="alert">Directory unavailable. Check your access and retry.</p>
                            <p t-if="state.directory.status === 'empty'">No matching records</p>
                            <div class="adams_table_wrap"><table t-if="state.directory.rows.length" class="table">
                                <thead><tr><th scope="col">Account</th><th scope="col">Journals</th><th scope="col">Currency</th><th scope="col">Balance</th></tr></thead>
                                <tbody><tr t-foreach="state.directory.rows" t-as="row" t-key="row.id">
                                    <td><bdi t-esc="row.code"/> · <t t-esc="row.name"/> <span t-if="!row.active">(Archived)</span></td>
                                    <td><t t-esc="row.journals.join(', ')"/><span t-if="!row.journals.length">No linked journal</span></td>
                                    <td t-esc="row.currency"/><td>Not configured</td>
                                </tr></tbody>
                            </table></div>
                            <div class="adams_page_controls"><button class="btn btn-outline-secondary" t-att-disabled="state.directory.offset === 0" t-on-click="() => this.loadDirectory('cash', state.directory.offset - 25)">Previous</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!state.directory.has_more" t-on-click="() => this.loadDirectory('cash', state.directory.offset + 25)">Next</button></div>
                        </div>
                    </t>
                    <t t-if="section.key === 'sales'">
                        <div class="adams_page_controls mt-3">
                            <button class="btn btn-outline-secondary" t-on-click="() => this.loadRecent('orders')">Recent orders</button>
                            <button class="btn btn-outline-secondary" t-on-click="() => this.loadRecent('quotations')">Recent quotations</button>
                        </div>
                        <section t-if="state.recent" class="adams_analysis" aria-live="polite">
                            <t t-set="recent" t-value="state.recent"/>
                            <h3 t-if="recent.kind === 'orders'">Recent orders</h3><h3 t-else="">Recent quotations</h3>
                            <p>Selected period, newest first. Native order date is the confirmation date for orders and creation date for quotations. Untaxed values use each document's currency; no mixed-currency total.</p>
                            <p t-if="recent.timezone">Dates shown in <bdi t-esc="recent.timezone"/></p>
                            <p t-if="recent.status === 'loading'" role="status">Loading…</p>
                            <p t-elif="recent.status === 'error'" role="alert">Sales list unavailable. Check your access and retry.</p>
                            <p t-elif="recent.status === 'not_installed'">App not installed</p>
                            <p t-elif="recent.status === 'empty'">No matching records</p>
                            <div class="adams_table_wrap"><table t-if="recent.rows.length" class="table">
                                <thead><tr><th scope="col">Reference</th><th scope="col">Customer</th><th scope="col">Order date</th><th scope="col">Status</th><th scope="col">Expiration</th><th scope="col">Untaxed amount</th></tr></thead>
                                <tbody><tr t-foreach="recent.rows" t-as="row" t-key="row.id">
                                    <td><button class="btn btn-link" t-att-disabled="state.opening" t-on-click="() => this.openRecent(row.id)" t-esc="row.name"/></td>
                                    <td t-esc="row.partner_id[1]"/><td><bdi t-esc="row.date_label"/></td><td t-esc="row.state_label"/>
                                    <td><bdi t-esc="row.validity_date || '—'"/></td><td><bdi t-esc="formatted({value: row.amount_untaxed}, row)"/> <bdi t-esc="row.currency"/></td>
                                </tr></tbody>
                            </table></div>
                            <div class="adams_page_controls">
                                <button class="btn btn-outline-secondary" t-att-disabled="recent.offset === 0 || recent.status === 'loading'" t-on-click="() => this.loadRecent(recent.kind, recent.offset - 25)">Previous</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!recent.has_more" t-on-click="() => this.loadRecent(recent.kind, recent.offset + 25)">Next</button>
                                <button t-if="recent.status === 'ready' || recent.status === 'empty'" class="btn btn-outline-primary" t-att-disabled="state.opening" t-on-click="() => this.openRecent()">Open native list</button>
                            </div>
                        </section>
                    </t>
                    <section t-if="section.key === 'sales'" class="adams_analysis">
                        <h3>Fulfillment</h3>
                        <p>Current native ordered, delivered and remaining quantities for confirmed orders in the selected order-date period. The balance cutoff does not apply. Each product uses its own unit. Signed values are retained; quantities are not combined across units.</p>
                        <button class="btn btn-outline-secondary" t-on-click="() => this.loadDirectory('fulfillment')">Explore delivery quantities</button>
                        <p class="adams_hint">Backlog value and on-time completion are not configured. Partial deliveries, returns and commitment-date rules require verified definitions.</p>
                        <t t-if="state.fulfillment">
                            <t t-set="delivery" t-value="state.fulfillment"/>
                            <p t-if="delivery.status === 'loading'" role="status">Loading…</p>
                            <p t-elif="delivery.status === 'error'" role="alert">Delivery quantities unavailable. Check your access and retry.</p>
                            <p t-elif="delivery.status === 'not_installed'">App not installed</p>
                            <p t-elif="delivery.status === 'empty'">No matching records</p>
                            <div class="adams_table_wrap"><table t-if="delivery.rows.length" class="table">
                                <thead><tr><th scope="col">Product</th><th scope="col">Unit</th><th scope="col">Ordered</th><th scope="col">Delivered</th><th scope="col">Remaining</th></tr></thead>
                                <tbody><tr t-foreach="delivery.rows" t-as="row" t-key="row.id">
                                    <td t-esc="row.name"/><td t-esc="row.unit"/><td><bdi t-esc="row.ordered"/></td><td><bdi t-esc="row.delivered"/></td><td><bdi t-esc="row.remaining"/></td>
                                </tr></tbody>
                            </table></div>
                            <div class="adams_page_controls">
                                <button class="btn btn-outline-secondary" t-att-disabled="delivery.offset === 0 || delivery.status === 'loading'" t-on-click="() => this.loadDirectory('fulfillment', delivery.offset - 25)">Previous</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!delivery.has_more" t-on-click="() => this.loadDirectory('fulfillment', delivery.offset + 25)">Next</button>
                                <button t-if="delivery.status === 'ready' || delivery.status === 'empty'" class="btn btn-outline-primary" t-att-disabled="state.opening" t-on-click="() => this.openReport('fulfillment')">Open native report</button>
                            </div>
                        </t>
                    </section>
                    <t t-if="section.key === 'operations'">
                        <button class="btn btn-outline-secondary mt-3" t-on-click="() => this.loadDirectory('inventory')">Explore current stock</button>
                        <div t-if="state.inventory" class="adams_analysis">
                            <h3>Current stock by product</h3><p>Current native Stock report quantities, in each product's unit. Period and balance cutoff do not apply. Quantities are not added across different units.</p>
                            <p t-if="state.inventory.status === 'loading'" role="status">Loading…</p>
                            <p t-if="state.inventory.status === 'error'" role="alert">Inventory unavailable. Check your access and retry.</p>
                            <p t-if="state.inventory.status === 'not_installed'">App not installed</p>
                            <p t-if="state.inventory.status === 'empty'">No matching records</p>
                            <div class="adams_table_wrap"><table t-if="state.inventory.rows.length" class="table">
                                <thead><tr><th scope="col">Product</th><th scope="col">Unit</th><th scope="col">On hand</th><th scope="col">Free to use</th><th scope="col">Forecasted</th></tr></thead>
                                <tbody><tr t-foreach="state.inventory.rows" t-as="row" t-key="row.id">
                                    <td t-esc="row.display_name"/><td t-esc="row.uom_id[1]"/><td t-esc="row.qty_available"/><td t-esc="row.free_qty"/><td t-esc="row.virtual_available"/>
                                </tr></tbody>
                            </table></div>
                            <div class="adams_page_controls"><button class="btn btn-outline-secondary" t-att-disabled="state.inventory.offset === 0" t-on-click="() => this.loadDirectory('inventory', state.inventory.offset - 25)">Previous</button>
                                <button class="btn btn-outline-secondary" t-att-disabled="!state.inventory.has_more" t-on-click="() => this.loadDirectory('inventory', state.inventory.offset + 25)">Next</button>
                                <button t-if="state.inventory.status === 'ready' || state.inventory.status === 'empty'" class="btn btn-outline-primary" t-on-click="() => this.openReport('inventory')">Open native report</button></div>
                        </div>
                    </t>
                    </t>
                </section>
                <p class="adams_scope">Financial integrations and browser acceptance are pending. No financial totals are estimated.</p>
            </t>
        </main>
    </t>
</templates>
