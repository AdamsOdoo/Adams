<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Approved Sales markup, using the existing workspace services and state. -->
    <t t-name="adams_executive_dashboard.SalesWorkspace">
        <div class="adams_sales_workspace adams_sales_reference">
            <header class="adams_group_heading"><h3>Sales rankings</h3><label class="adams_sales_show">Show<select t-model.number="state.rankLimit" t-on-change="refreshRankings"><option value="5">Top 5</option><option value="10">Top 10</option></select></label></header>
            <div class="adams_sales_rank_toolbar"><div class="adams_rank_tabs" t-on-keydown="switchTabs" role="group" aria-label="Invoice ranking measure"><button t-att-class="{'active': !state.ranking || state.ranking.key === 'invoiced_sales'}" t-on-click="() =&gt; this.loadRanking('invoiced_sales')">Invoiced sales</button><button t-att-class="{'active': state.ranking?.key === 'invoiced_margin'}" t-on-click="() =&gt; this.loadRanking('invoiced_margin')">Commercial margin</button></div><span class="adams_hint">Rankings follow the selected period</span></div>
            <div class="adams_sales_equal">
                <t t-call="adams_executive_dashboard.SalesRanking"><t t-set="ranking" t-value="state.ranking"/><t t-set="rankClass" t-value="'adams_rank_panel'"/><t t-set="rankType" t-value="'invoice'"/></t>
                <t t-call="adams_executive_dashboard.SalesRanking"><t t-set="ranking" t-value="state.orderRanking"/><t t-set="rankClass" t-value="'adams_order_ranking'"/><t t-set="rankType" t-value="'order'"/></t>
            </div>
            <header class="adams_group_heading adams_products_heading"><h3>Products &amp; customers</h3><div class="adams_product_measure adams_rank_tabs" role="group" aria-label="Product ranking measure"><button t-att-class="{'active': state.productMeasure === 'value'}" t-att-aria-pressed="state.productMeasure === 'value' ? 'true' : 'false'" t-on-click="() =&gt; { state.productMeasure = 'value'; this.loadProducts(); }">Sales value</button><button t-att-class="{'active': state.productMeasure === 'quantity'}" t-att-aria-pressed="state.productMeasure === 'quantity' ? 'true' : 'false'" t-on-click="() =&gt; { state.productMeasure = 'quantity'; this.loadProducts(); }">Quantity</button></div><label t-if="state.productMeasure === 'quantity' &amp;&amp; state.products?.units?.length" class="adams_sales_show">Unit<select t-model="state.productUnit" t-on-change="loadProducts"><option t-foreach="state.products.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-esc="unit.name"/></select></label></header>
            <div class="adams_sales_equal">
                <t t-call="adams_executive_dashboard.SalesRanking"><t t-set="ranking" t-value="state.products"/><t t-set="rankClass" t-value="'adams_product_ranking'"/><t t-set="rankType" t-value="'product'"/></t>
                <t t-call="adams_executive_dashboard.SalesRanking"><t t-set="ranking" t-value="state.customers"/><t t-set="rankClass" t-value="'adams_customers_panel'"/><t t-set="rankType" t-value="'customer'"/></t>
            </div>
            <header class="adams_group_heading"><h3>Recent documents</h3><button class="btn btn-link" t-att-disabled="state.opening || !state.recent" t-on-click="() =&gt; this.openRecent()"><span>View report</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header>
            <section class="adams_panel adams_recent_panel">
                <div class="adams_sales_toolbar"><div class="adams_recent_tabs adams_rank_tabs" t-on-keydown="switchTabs"><button t-att-class="{'active': !state.recent || state.recent.kind === 'orders'}" t-on-click="() =&gt; this.loadRecent('orders')">Orders</button><button t-att-class="{'active': state.recent?.kind === 'quotations'}" t-on-click="() =&gt; this.loadRecent('quotations')">Quotations</button><button t-att-class="{'active': state.recent?.kind === 'invoices'}" t-on-click="() =&gt; this.loadRecent('invoices')">Invoices</button></div><span class="adams_hint" t-att-title="state.recent?.scope_label"><span>Untaxed values</span><t t-if="state.recent?.timezone"> · <bdi t-esc="state.recent.timezone"/></t></span></div>
                <t t-set="recent" t-value="state.recent"/>
                <p t-if="!recent || recent.status === 'loading'" class="adams_empty_note" role="status">Loading…</p>
                <div t-elif="recent.status === 'error'" class="adams_empty_note" role="alert"><p>Sales list unavailable. Check your access and retry.</p><button class="btn" t-on-click="() =&gt; this.loadRecent(recent.kind, recent.offset)">Retry</button></div>
                <p t-elif="recent.status !== 'ready'" class="adams_empty_note" t-esc="statusLabels[recent.status]"/>
                <div t-else="" class="adams_table_wrap" tabindex="0"><table class="table"><thead><tr><th scope="col">Document / date</th><th scope="col">Partner / salesperson</th><th scope="col" class="adams_numeric">Amount<t t-if="commonRowValue(recent.rows, 'currency')"> · <bdi t-esc="commonRowValue(recent.rows, 'currency')"/></t></th><th scope="col">Status</th></tr></thead><tbody><tr t-foreach="recent.rows" t-as="row" t-key="row.id"><td><button class="btn btn-link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openRecent(row.id)" t-esc="row.name"/><small t-att-title="row.date_label"><bdi t-esc="recentDate(row)"/></small></td><td><span t-esc="row.partner_id[1]"/><small t-esc="row.user_id ? row.user_id[1] : '—'"/></td><td class="adams_numeric"><bdi dir="ltr"><t t-if="!commonRowValue(recent.rows, 'currency')"><t t-esc="row.currency"/> </t><t t-esc="formatted({value:row.amount_untaxed}, row)"/></bdi></td><td><span class="adams_state_badge" t-att-class="{'green': row.state === 'posted' || row.delivery_status === 'full', 'amber': recent.kind === 'orders' &amp;&amp; row.delivery_status === 'pending'}" t-esc="row.delivery_label || row.state_label"/><small t-if="recent.kind === 'quotations' &amp;&amp; row.validity_date">Expires <bdi t-esc="row.validity_date"/></small></td></tr></tbody></table></div>
                <div t-if="recent &amp;&amp; ['ready','empty'].includes(recent.status)" class="adams_sales_table_footer"><span t-esc="recentPageCaption(recent)"/><div class="adams_page_controls"><button class="btn" aria-label="Previous page" t-att-disabled="recent.offset === 0" t-on-click="() =&gt; this.loadRecent(recent.kind, recent.offset - recent.page_size)"><svg class="adams_icon adams_action_arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6"/></svg></button><t t-foreach="compactPages(recent)" t-as="page" t-key="page.key"><span t-if="!page.number">…</span><button t-else="" class="btn adams_page_number" t-att-class="{'active': page.number === currentPage(recent)}" t-att-aria-current="page.number === currentPage(recent) ? 'page' : undefined" t-on-click="() =&gt; this.loadRecent(recent.kind, (page.number - 1) * recent.page_size)" t-esc="page.number"/></t><button class="btn" aria-label="Next page" t-att-disabled="!recent.has_more" t-on-click="() =&gt; this.loadRecent(recent.kind, recent.offset + recent.page_size)"><t t-call="adams_executive_dashboard.SalesArrow"/></button></div></div>
            </section>
            <header class="adams_group_heading"><h3>Delivery status</h3><span class="adams_period_chip">Confirmed orders in the selected period</span></header>
            <section class="adams_panel adams_fulfillment_panel"><t t-set="delivery" t-value="state.fulfillment"/>
                <p t-if="!delivery || delivery.status === 'loading'" class="adams_empty_note" role="status">Loading…</p><div t-elif="delivery.status === 'error'" class="adams_empty_note" role="alert"><p>Delivery quantities unavailable. Check your access and retry.</p><button class="btn" t-on-click="() =&gt; this.loadDirectory('fulfillment', delivery.offset || 0)">Retry</button></div><p t-elif="delivery.status !== 'ready'" class="adams_empty_note" t-esc="statusLabels[delivery.status]"/>
                <div t-else="" class="adams_table_wrap" tabindex="0"><table class="table"><thead><tr><th scope="col">Product</th><th scope="col" class="adams_numeric">Ordered<t t-if="commonRowValue(delivery.rows, 'unit')"> · <bdi t-esc="commonRowValue(delivery.rows, 'unit')"/></t></th><th scope="col" class="adams_numeric">Delivered<t t-if="commonRowValue(delivery.rows, 'unit')"> · <bdi t-esc="commonRowValue(delivery.rows, 'unit')"/></t></th><th scope="col" class="adams_numeric">Remaining<t t-if="commonRowValue(delivery.rows, 'unit')"> · <bdi t-esc="commonRowValue(delivery.rows, 'unit')"/></t></th><th scope="col"><span class="visually-hidden">View report</span></th></tr></thead><tbody><tr t-foreach="delivery.rows" t-as="row" t-key="row.id + ':' + row.unit_id"><td t-esc="row.name"/><td class="adams_numeric"><bdi t-esc="row.ordered"/> <small t-if="!commonRowValue(delivery.rows, 'unit')" class="adams_inline_unit" t-esc="row.unit"/></td><td class="adams_numeric"><bdi t-esc="row.delivered"/> <small t-if="!commonRowValue(delivery.rows, 'unit')" class="adams_inline_unit" t-esc="row.unit"/></td><td class="adams_numeric"><bdi t-esc="row.remaining"/> <small t-if="!commonRowValue(delivery.rows, 'unit')" class="adams_inline_unit" t-esc="row.unit"/></td><td><button class="btn btn-link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openReport('fulfillment', row.unit_id, row.id)"><span>View report</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></td></tr></tbody></table></div>
                <div t-if="delivery &amp;&amp; (delivery.offset || delivery.has_more)" class="adams_sales_table_footer"><span t-esc="recentPageCaption(delivery)"/><div class="adams_page_controls"><button class="btn" t-att-disabled="delivery.offset === 0 || delivery.status === 'loading'" t-on-click="() =&gt; this.loadDirectory('fulfillment', delivery.offset - 25)">Previous</button><button class="btn" t-att-disabled="!delivery.has_more || delivery.status === 'loading'" t-on-click="() =&gt; this.loadDirectory('fulfillment', delivery.offset + 25)">Next</button></div></div>
            </section>
        </div>
    </t>
    <t t-name="adams_executive_dashboard.SalesArrow"><svg class="adams_icon adams_action_arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></t>
    <t t-name="adams_executive_dashboard.SalesRanking">
        <section class="adams_panel" t-att-class="rankClass"><header class="adams_panel_head"><div><h3><t t-if="rankType === 'invoice'">Top salespeople · invoices</t><t t-elif="rankType === 'order'">Top salespeople · orders</t><t t-elif="rankType === 'product'">Top products</t><t t-else="">Top customers</t></h3><p><t t-if="rankType === 'invoice'"><t t-if="state.ranking?.key === 'invoiced_margin'">Commercial margin · current product cost</t><t t-else="">Posted invoiced sales · <bdi t-esc="ranking?.currency || result?.currency"/></t></t><t t-elif="rankType === 'order'">Confirmed sales orders · Untaxed value · <bdi t-esc="ranking?.currency || result?.currency"/></t><t t-elif="rankType === 'product' &amp;&amp; state.productMeasure === 'quantity'">Net invoiced quantity · <bdi t-esc="salesQuantityUnit"/> only</t><t t-else="">Net invoiced sales · <bdi t-esc="ranking?.currency || result?.currency"/></t></p></div><button class="btn btn-link" t-on-click="() =&gt; this.openSalesRanking(rankType)"><span>View all</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header>
        <p t-if="!ranking || ranking.status === 'loading'" class="adams_empty_note" role="status">Loading…</p><div t-elif="ranking.status === 'error'" class="adams_empty_note" role="alert"><p>Analysis unavailable. Check your access and retry.</p><button class="btn" t-on-click="() =&gt; this.retrySalesRanking(rankType)">Retry</button></div><p t-elif="ranking.status !== 'ready' || !ranking.rows.length" class="adams_empty_note" t-esc="statusLabels[ranking.status] || statusLabels.empty"/>
        <div t-else="" class="adams_rank_list"><button t-foreach="ranking.rows" t-as="row" t-key="row.id || 'unassigned'" class="adams_rank_row" t-att-disabled="state.opening" t-on-click="() =&gt; this.openSalesRanking(rankType, row.id)"><span class="adams_rank_index" t-esc="row_index + 1"/><span class="adams_rank_avatar" t-esc="rankingInitials(row.label)"/><span class="adams_rank_person"><span t-esc="row.label"/><span class="adams_rank_track"><span t-att-style="'width:' + barWidth(row.value, ranking.rows)" t-att-class="{'negative': row.value &lt; 0}"/></span></span><bdi class="adams_rank_value" dir="ltr"><t t-esc="rankType === 'product' &amp;&amp; state.productMeasure === 'quantity' ? quantity(row.value) : headline({value:row.value}, ranking, true)"/><small t-if="rankType === 'product' &amp;&amp; state.productMeasure === 'quantity'"> <t t-esc="salesQuantityUnit"/></small></bdi></button></div>
        </section>
    </t>
</templates>
