<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="adams_executive_dashboard.HRWorkspace">
    <form class="adams_hr_period" t-on-submit.prevent="applyHRPeriod">
        <span class="adams_hr_company_scope">Company <strong t-esc="companyIdentity.name"/></span>
        <label>From<input type="date" name="date_from" class="form-control" t-att-value="state.hrPeriodDraft.date_from" t-on-change="onHRDateChange" t-att-disabled="hrLoading" required="required"/></label>
        <label>To<input type="date" name="date_to" class="form-control" t-att-value="state.hrPeriodDraft.date_to" t-on-change="onHRDateChange" t-att-disabled="hrLoading" required="required"/></label>
        <button type="submit" class="btn btn-primary" t-att-disabled="hrLoading || !hrPeriodDirty">Apply period</button>
        <span t-if="state.hrData?.timezone" class="adams_hr_timezone" t-esc="state.hrData.timezone"/>
        <p t-if="state.hrPeriodError" class="adams_hr_period_error" role="alert" t-esc="state.hrPeriodError"/>
    </form>
    <nav class="adams_hr_tabs" role="tablist" aria-label="HR views" t-on-keydown="switchTabs">
        <button role="tab" t-att-aria-selected="state.hrTab === 'overview'" t-att-class="{'active': state.hrTab === 'overview'}" t-on-click="() =&gt; this.loadHR('overview')">Overview</button>
        <button role="tab" t-att-aria-selected="state.hrTab === 'attendance'" t-att-class="{'active': state.hrTab === 'attendance'}" t-on-click="() =&gt; this.loadHR('attendance')">Attendance</button>
        <button role="tab" t-att-aria-selected="state.hrTab === 'time_off'" t-att-class="{'active': state.hrTab === 'time_off'}" t-on-click="() =&gt; this.loadHR('time_off')">Time off</button>
        <button role="tab" t-att-aria-selected="state.hrTab === 'shifts'" t-att-class="{'active': state.hrTab === 'shifts'}" t-on-click="() =&gt; this.loadHR('shifts')">Shifts</button>
        <button role="tab" t-att-aria-selected="state.hrTab === 'employees'" t-att-class="{'active': state.hrTab === 'employees'}" t-on-click="() =&gt; this.loadHR('employees')">Employees</button>
    </nav>
    <t t-set="hr" t-value="state.hrData"/>
    <div t-if="!hr || hr.status === 'loading'" class="adams_message" role="status">Loading people information…</div>
    <div t-elif="hr.status === 'error'" class="adams_message" role="alert"><p>This information could not be loaded. Your other departments remain available.</p><button class="btn" t-on-click="() =&gt; this.loadHR()">Retry</button></div>
    <div t-elif="hr.status === 'not_installed'" class="adams_message"><p t-esc="hr.message || statusLabels[hr.status]"/></div>
    <div t-elif="hr.status === 'restricted'" class="adams_message"><p>Access to this information is restricted. Dashboard access does not grant access to employee records.</p></div>
    <t t-elif="state.hrTab === 'overview'">
        <header class="adams_group_heading"><h3>People at a glance</h3><span class="adams_period_chip"><span>Snapshot</span> · <bdi t-esc="hrSnapshotLabel"/></span></header>
        <div class="adams_grid adams_hr_kpis">
            <article t-foreach="hr.metrics || []" t-as="metric" t-key="metric.key" class="adams_card adams_hr_kpi" t-att-class="{'adams_available': metric.status === 'ready'}">
                <div class="adams_card_top"><h3 t-esc="hrMetricLabel(metric.key)"/><t t-call="adams_executive_dashboard.Icon"><t t-set="iconName" t-value="'reference_hr'"/></t></div>
                <button t-if="metric.status === 'ready'" class="adams_value" t-on-click="() =&gt; this.loadHROverviewMetric(metric)"><bdi dir="ltr" t-esc="headline(metric, hr,true)"/></button>
                <div t-else="" class="adams_empty_note" t-esc="statusLabels[metric.status]"/>
                <p class="adams_margin_note"><span t-if="metric.key === 'employees'">Current workforce</span><span t-elif="metric.key === 'checked_in'">Open attendance records</span><span t-elif="metric.key === 'time_off'">Overlaps today</span><span t-else="">Published · selected period</span></p>
                <footer class="adams_hr_kpi_footer"><span class="adams_hr_kpi_scope"><t t-if="metric.key === 'employees'">Current employees</t><bdi t-elif="metric.key === 'checked_in'" t-esc="hrSnapshotLabel"/><bdi t-elif="metric.key === 'time_off'" t-esc="hrDate(hr.today)"/><t t-else=""><bdi t-esc="hrDate(hr.date_from)"/> – <bdi t-esc="hrDate(hr.date_to)"/></t></span><button t-if="metric.status === 'ready'" class="adams_hr_text_button" t-on-click="() =&gt; this.loadHROverviewMetric(metric)"><span>View details</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></footer>
            </article>
        </div>
        <div class="adams_hr_grid adams_hr_snapshot_grid"><section class="adams_panel adams_hr_attendance_panel"><header class="adams_panel_head"><div><h3>Today’s attendance</h3><p><bdi t-esc="hrSnapshotLabel"/></p></div><button class="adams_hr_text_button" t-on-click="() =&gt; this.loadHR('attendance')"><span>View attendance</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header><div class="adams_panel_body"><div class="adams_hr_mini_metrics"><div><span>Checked in</span><t t-set="currentAttendance" t-value="hr.metrics.find(metric =&gt; metric.key === 'checked_in')"/><button t-if="currentAttendance?.status === 'ready'" class="adams_hr_mini_value" t-on-click="() =&gt; this.loadHROverviewMetric(currentAttendance)"><bdi dir="ltr" t-esc="headline(currentAttendance, hr,true)"/></button><strong t-else="" class="adams_hr_unavailable" t-esc="statusLabels[currentAttendance?.status] || '—'"/></div><div><span>Approved time off</span><t t-set="todayLeave" t-value="hr.metrics.find(metric =&gt; metric.key === 'time_off')"/><button t-if="todayLeave?.status === 'ready'" class="adams_hr_mini_value" t-on-click="() =&gt; this.loadHROverviewMetric(todayLeave)"><bdi dir="ltr" t-esc="headline(todayLeave, hr,true)"/></button><strong t-else="" class="adams_hr_unavailable" t-esc="statusLabels[todayLeave?.status] || '—'"/></div><div><span>No check-in today</span><t t-set="noCheckIn" t-value="hr.attendance_summary?.no_check_in_today"/><button t-if="noCheckIn?.status === 'ready'" class="adams_hr_mini_value" t-on-click="() =&gt; this.loadHROverviewMetric(noCheckIn)"><bdi dir="ltr" t-esc="headline(noCheckIn, hr,true)"/></button><strong t-else="" class="adams_hr_unavailable" t-esc="statusLabels[noCheckIn?.status] || '—'"/></div></div><p class="adams_hr_snapshot_note">No check-in is not an absence decision. Check schedules and approved time off.</p></div></section><section class="adams_panel adams_hr_department_panel"><header class="adams_panel_head"><div><h3>Team by department</h3><p>Active employees</p></div><button class="btn btn-link adams_hr_text_button" t-on-click="() =&gt; this.loadHR('employees')"><span>View employees</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header><div class="adams_panel_body adams_hr_department_list"><div t-foreach="hr.departments || []" t-as="department" t-key="department.id || 'unassigned'" class="adams_hr_summary_row"><button class="btn btn-link adams_hr_text_button" t-on-click="() =&gt; this.loadHRDepartment(department.id)" t-esc="department.name"/><bdi t-esc="department.count"/></div><p t-if="!(hr.departments || []).length" class="adams_empty_note">No department records available for this view.</p></div></section>
            </div><header t-if="hr.previews" class="adams_group_heading adams_hr_upcoming_heading"><h3>Time off &amp; upcoming shifts</h3><span class="adams_period_chip"><bdi t-esc="hrDate(hr.date_from)"/> – <bdi t-esc="hrDate(hr.date_to)"/></span></header><div class="adams_hr_grid" t-if="hr.previews"><section class="adams_panel" t-foreach="['requests','published']" t-as="kind" t-key="kind"><t t-set="preview" t-value="hr.previews[kind]"/><header class="adams_panel_head"><div><h3 t-if="kind === 'requests'">Time off requests</h3><h3 t-else="">Published shifts</h3><p t-if="kind === 'requests'">Approved and awaiting approval</p><p t-else="">Assigned and open coverage</p></div><button class="adams_hr_text_button" t-on-click="() =&gt; this.loadHR(kind === 'requests' ? 'time_off' : 'shifts',0,preview?.filters || {})"><span t-if="kind === 'requests'">View all</span><span t-else="">View shifts</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header><div class="adams_panel_body"><p t-if="!preview || !['ready','empty'].includes(preview.status)" class="adams_empty_note" t-esc="statusLabels[preview?.status]"/><p t-elif="!preview.rows.length" class="adams_empty_note"><span t-if="kind === 'requests'">No requests in this period</span><span t-else="">No shifts</span></p><div t-else="" t-foreach="preview.rows" t-as="row" t-key="row.id" class="adams_hr_summary_row"><div><button t-if="kind === 'requests' &amp;&amp; row.employee_id" class="adams_hr_person" t-on-click="() =&gt; this.openEmployeeProfile(row.employee_id[0])"><span class="adams_hr_avatar" t-esc="employeeInitials(row.employee_id[1])"/><span><strong t-esc="row.employee_id[1]"/><small t-if="row.job_id"><t t-if="row.department_id"><t t-esc="row.department_id[1]"/> · </t><t t-esc="row.job_id[1]"/></small></span></button><strong t-else="" t-esc="row.employee_id ? row.employee_id[1] : hrUnassignedLabel"/><small t-if="kind === 'requests'"><bdi t-esc="hrDate(row.date_from_label)"/> – <bdi t-esc="hrDate(row.date_to_label)"/></small><small t-else=""><bdi t-esc="hrDate(row.start_datetime_label)"/> · <bdi><t t-esc="hrTime(row.start_datetime_label)"/> – <t t-esc="hrTime(row.end_datetime_label)"/></bdi></small></div><button class="adams_hr_text_button" t-on-click="() =&gt; this.openHRSource(row.id,false,kind === 'requests' ? 'time_off' : 'shifts',preview?.filters || {})"><span t-if="kind === 'requests'" class="adams_state_badge" t-att-class="hrBadgeClass(row)" t-esc="row.state_label"/><t t-else=""><span>View shift</span><t t-call="adams_executive_dashboard.SalesArrow"/></t></button></div></div></section></div></t>
    <t t-else="">
        <header class="adams_group_heading"><div><h3 t-if="state.hrTab === 'attendance'">Attendance records</h3><h3 t-elif="state.hrTab === 'time_off'">Time off requests</h3><h3 t-elif="state.hrTab === 'shifts'">Shift schedule</h3><h3 t-else="">Employee directory</h3><p t-if="state.hrTab === 'employees' &amp;&amp; hr.filters?.scope === 'no_check_in_today'">Current employees without a check-in today in the standard latest check-in snapshot.</p><p t-elif="state.hrTab === 'employees'">Current work profiles</p><p t-elif="hr.date_basis === 'current'">Current open attendance sessions · <bdi t-esc="hr.timezone"/></p><p t-elif="hr.date_basis === 'today'">Today · <bdi t-esc="hrDate(hr.date_from)"/></p><p t-else=""><bdi t-esc="hrDate(hr.date_from)"/> – <bdi t-esc="hrDate(hr.date_to)"/> · <bdi t-esc="hr.timezone"/></p></div><div class="adams_header_actions"><div t-if="state.hrTab === 'shifts'" class="adams_rank_tabs"><button t-att-class="{'active': state.hrFilters.view === 'week'}" t-on-click="() =&gt; this.setHRView('week')">Week</button><button t-att-class="{'active': state.hrFilters.view === 'list'}" t-on-click="() =&gt; this.setHRView('list')">List</button></div><button class="btn btn-link adams_hr_text_button" t-on-click="() =&gt; this.openHRSource()"><span t-esc="hrSourceLabel(state.hrTab)"/><t t-call="adams_executive_dashboard.SalesArrow"/></button></div></header>
        <section class="adams_panel">
            <form class="adams_hr_filters" t-on-submit.prevent="applyHRFilters">
                <label>Employee or role<input type="search" class="form-control" t-model="state.hrFilters.search" maxlength="100" placeholder="Search employees…"/></label>
                <label>Department<select class="form-select" t-on-change="changeHRDepartment"><option value="" t-att-selected="hrDepartmentSelection === ''">All departments</option><option value="unassigned" t-att-selected="hrDepartmentSelection === 'unassigned'">Unassigned</option><t t-foreach="hrDepartments" t-as="department" t-key="department.id || 'unassigned'"><option t-if="department.id" t-att-value="department.id" t-att-selected="hrDepartmentSelection === ('' + department.id)" t-esc="department.name"/></t></select></label>
                <label>Status<select class="form-select" t-on-change="changeHRStatus"><option value="all" t-att-selected="!hrStatusSelection || hrStatusSelection === 'all'">All statuses</option><option t-foreach="hrStatusOptions" t-as="option" t-key="option.value" t-att-value="option.value" t-att-selected="hrStatusSelection === option.value" t-esc="option.label"/></select></label>

                <label t-if="state.hrTab === 'employees'" class="adams_check"><input type="checkbox" t-model="state.hrFilters.include_archived"/>Include archived</label>
                <div class="adams_hr_filter_actions"><button class="btn" type="button" t-on-click="clearHRFilters">Clear</button><button class="btn btn-primary" type="submit">Apply filters</button></div>
            </form>
            <p t-if="hr.status === 'empty' || !hr.rows.length" class="adams_empty_note">No results for this selection. Try another period or clear the employee filters.</p>
            <div t-elif="state.hrTab === 'shifts' &amp;&amp; hr.filters?.view === 'week'" class="adams_hr_week" tabindex="0" aria-label="Shift week"><div class="adams_hr_week_grid"><section class="adams_hr_day" t-foreach="hrWeekDays" t-as="day" t-key="day.date"><header><strong t-esc="day.label"/><bdi t-esc="hrDate(day.date,true)"/></header><button class="adams_shift_card" t-foreach="day.rows" t-as="row" t-key="row.id" t-att-class="{'unassigned': !row.assigned}" t-on-click="() =&gt; this.openHRSource(row.id)"><bdi><t t-esc="hrTime(row.start_datetime_label)"/> – <t t-esc="hrTime(row.end_datetime_label)"/></bdi><small t-if="row.continuation"><span>Continues from</span> <bdi t-esc="hrDate(row.start_datetime_label)"/></small><strong t-esc="row.employee_id ? row.employee_id[1] : row.resource_id ? row.resource_id[1] : hrUnassignedLabel"/><small t-esc="row.role_id ? row.role_id[1] : ''"/><small><t t-esc="row.state_label"/><t t-if="row.end_datetime_label.slice(0,10) !== day.date"> · <span>Overnight</span></t></small></button><p t-if="!day.rows.length" class="adams_empty_note"><span t-if="hr.has_more">No shifts in loaded records</span><span t-else="">No shifts</span></p></section></div></div>
            <div t-else="" class="adams_table_wrap adams_hr_table" tabindex="0" aria-label="Employee work records">
                <table class="table"><thead><tr><th><t t-if="state.hrTab === 'shifts'">Employee / role</t><t t-else="">Employee</t></th><t t-if="state.hrTab === 'employees'"><th>Department</th><th>Work location</th><th>Manager</th><th>Status</th></t><t t-elif="state.hrTab === 'attendance'"><th>Date</th><th>Check-in</th><th>Check-out</th><th>Recorded hours</th><th>Status</th></t><t t-elif="state.hrTab === 'time_off'"><th>Time off type</th><th>Dates</th><th>Request duration</th><th>Status</th><th>Action</th></t><t t-else=""><th>Shift</th><th>Work location</th><th>Allocated hours</th><th>Status</th></t></tr></thead>
                <tbody><tr t-foreach="hr.rows" t-as="row" t-key="row.id"><td><t t-set="employeeId" t-value="state.hrTab === 'employees' ? row.id : row.employee_id &amp;&amp; row.employee_id[0]"/><t t-set="employeeName" t-value="state.hrTab === 'employees' ? row.name : row.employee_id ? row.employee_id[1] : row.resource_id ? row.resource_id[1] : ''"/><button t-if="employeeId" class="btn btn-link adams_hr_person adams_hr_text_button" t-on-click="() =&gt; this.openEmployeeProfile(employeeId)"><span class="adams_hr_avatar" t-esc="employeeInitials(employeeName)"/><span><strong t-esc="employeeName"/><small t-if="row.job_id"><t t-if="row.department_id"><t t-esc="row.department_id[1]"/> · </t><t t-esc="row.job_id[1]"/></small></span></button><span t-else="" class="adams_state_badge amber"><t t-if="employeeName" t-esc="employeeName"/><t t-else="">Unassigned</t></span><small t-if="state.hrTab === 'shifts' &amp;&amp; row.role_id" t-esc="row.role_id[1]"/></td>
                <t t-if="state.hrTab === 'employees'"><td t-esc="row.department_id ? row.department_id[1] : '—'"/><td t-esc="row.work_location_id ? row.work_location_id[1] : '—'"/><td t-esc="row.parent_id ? row.parent_id[1] : '—'"/><td><span class="adams_state_badge" t-att-class="hrBadgeClass(row)"><t t-if="row.active">Active</t><t t-else="">Archived</t></span></td></t>
                <t t-elif="state.hrTab === 'attendance'"><td><button class="adams_row_link" t-on-click="() =&gt; this.openHRSource(row.id)"><bdi t-esc="hrDate(row.check_in_label)"/></button></td><td class="adams_numeric"><bdi t-esc="hrTime(row.check_in_label)"/></td><td class="adams_numeric"><bdi t-esc="hrTime(row.check_out_label)"/><small t-if="row.check_out_label &amp;&amp; row.check_out_label.slice(0,10) !== row.check_in_label.slice(0,10)"><bdi t-esc="hrDate(row.check_out_label)"/></small></td><td class="adams_numeric"><bdi dir="ltr" t-esc="row.worked_hours === null ? '—' : formatted({value: row.worked_hours}, {digits:2})"/></td><td><span class="adams_state_badge" t-att-class="hrBadgeClass(row)"><t t-if="row.status === 'open'">Checked in</t><t t-else="">Checked out</t></span></td></t>
                <t t-elif="state.hrTab === 'time_off'"><td t-esc="row.holiday_status_id ? row.holiday_status_id[1] : '—'"/><td><bdi t-esc="hrDate(row.date_from_label)"/><small t-if="row.date_from_label.slice(0,10) !== row.date_to_label.slice(0,10)"><span>to</span> <bdi t-esc="hrDate(row.date_to_label)"/></small></td><td class="adams_numeric"><bdi dir="ltr" t-esc="formatted({value: row.duration},{digits:1})"/> <span t-if="row.duration_unit === 'hours'">hours</span><span t-else="">days</span></td><td><span class="adams_state_badge" t-att-class="hrBadgeClass(row)" t-esc="row.state_label"/></td><td><button class="adams_hr_text_button" t-on-click="() =&gt; this.openHRSource(row.id)"><span t-if="['confirm','validate1'].includes(row.state)">Review request</span><span t-else="">View request</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></td></t>
                <t t-else=""><td><button class="adams_row_link" t-on-click="() =&gt; this.openHRSource(row.id)"><bdi t-esc="hrDate(row.start_datetime_label)"/></button><small><bdi><t t-esc="hrTime(row.start_datetime_label)"/> – <t t-esc="hrTime(row.end_datetime_label)"/></bdi><t t-if="row.start_datetime_label.slice(0,10) !== row.end_datetime_label.slice(0,10)"><br/><span>Ends</span> <bdi t-esc="hrDate(row.end_datetime_label)"/></t></small></td><td t-esc="row.work_location_id ? row.work_location_id[1] : '—'"/><td class="adams_numeric"><bdi dir="ltr" t-esc="formatted({value: row.allocated_hours},{digits:1})"/></td><td><span class="adams_state_badge" t-att-class="hrBadgeClass(row)" t-esc="row.state_label"/></td></t></tr></tbody></table>
            </div>
            <div class="adams_sales_table_footer" t-if="state.hrTab !== 'shifts' || hr.filters?.view !== 'week'"><span t-esc="recentPageCaption(hr)"/><div class="adams_page_controls"><button class="btn" aria-label="Previous page" t-att-disabled="!hr.offset" t-on-click="() =&gt; this.loadHR(state.hrTab, hr.offset - hr.page_size)"><svg class="adams_icon adams_action_arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6"/></svg></button><t t-foreach="compactPages(hr)" t-as="page" t-key="page.key"><span t-if="!page.number">…</span><button t-else="" class="btn adams_page_number" t-att-class="{'active':page.number === currentPage(hr)}" t-att-aria-current="page.number === currentPage(hr) ? 'page' : undefined" t-on-click="() =&gt; this.loadHR(state.hrTab, (page.number-1)*hr.page_size)" t-esc="page.number"/></t><button class="btn" aria-label="Next page" t-att-disabled="!hr.has_more" t-on-click="() =&gt; this.loadHR(state.hrTab, hr.offset + hr.page_size)"><t t-call="adams_executive_dashboard.SalesArrow"/></button></div></div>
            <div t-elif="hr.has_more || hr.load_more_error" class="adams_page_controls adams_hr_week_progress"><span class="adams_page_context"><span>Shifts loaded:</span> <bdi t-esc="hr.rows.length"/> / <bdi t-esc="hr.total"/></span><button t-if="hr.has_more" class="btn" t-att-disabled="hr.loading_more" t-on-click="loadMoreHRShifts"><span t-if="hr.loading_more">Loading…</span><span t-else="">Load more shifts</span></button><span t-elif="['ready', 'empty'].includes(hr.status)">All matching shifts for this week are loaded.</span><p t-if="hr.load_more_error" role="alert">More shifts could not be loaded. The shifts already loaded remain available. Try Load more shifts again.</p></div><p class="adams_hint adams_hr_scope_note" t-if="state.hrTab === 'attendance'">One row per check-in. Open check-ins have no final recorded hours.</p><p class="adams_hint adams_hr_scope_note" t-elif="state.hrTab === 'time_off'">Requests overlap the selected period. Duration is for the full request; days and hours stay separate.</p><p class="adams_hint adams_hr_scope_note" t-elif="state.hrTab === 'shifts'"><t t-if="hr.filters?.view === 'week'"><span>First seven days of the selected period. Use List for all matching shifts.</span> <span>Times shown in</span> <bdi t-esc="hr.timezone"/>.</t><t t-else="">Allocated hours follow Planning. Draft shifts are not published to employees.</t></p><p class="adams_hint adams_hr_scope_note" t-else="">Work profiles only. Additional information follows your HR access rights.</p>
        </section>
    </t>
</t>
<t t-name="adams_executive_dashboard.EmployeeProfile">
<dialog class="adams_source_dialog adams_employee_dialog adams_finance_source" t-ref="employeeDialog" t-on-cancel.prevent="closeEmployeeProfile" aria-labelledby="adams-employee-title">
    <t t-if="state.employeeProfile">
        <t t-set="profile" t-value="state.employeeProfile"/>
        <header class="adams_panel_head"><div><p t-esc="companyIdentity.name"/><h2 t-if="profile.status === 'ready'" id="adams-employee-title" t-esc="profile.employee.name"/><h2 t-else="" id="adams-employee-title">Employee work profile</h2></div><button class="adams_drawer_close adams_hr_profile_close" t-on-click="closeEmployeeProfile" aria-label="Close" title="Close" autofocus="autofocus"><svg class="adams_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
        <div class="adams_source_body">
            <p t-if="profile.status === 'loading'" role="status">Loading employee…</p><p t-elif="profile.status !== 'ready'" t-esc="statusLabels[profile.status]"/>
            <t t-else=""><t t-set="employee" t-value="profile.employee"/>
                <div class="adams_hr_profile_head"><span class="adams_hr_avatar" t-esc="employeeInitials(employee.name)"/><div><h3 t-if="employee.job_id" t-esc="employee.job_id[1]"/><h3 t-else="">Employee work profile</h3><p><t t-if="employee.department_id"><t t-esc="employee.department_id[1]"/> · </t><t t-esc="companyIdentity.name"/></p><span t-if="employee.active !== undefined" class="adams_hr_profile_status" t-att-class="{'archived': employee.active === false}"><t t-if="employee.active">Active</t><t t-else="">Archived</t></span></div></div>
                <dl class="adams_hr_profile_fields"><div t-if="employee.work_location_id"><dt>Work location</dt><dd t-esc="employee.work_location_id[1]"/></div><div t-if="employee.parent_id"><dt>Manager</dt><dd t-esc="employee.parent_id[1]"/></div><div t-if="employee.work_email"><dt>Work email</dt><dd t-esc="employee.work_email"/></div><div t-if="employee.work_phone"><dt>Work phone</dt><dd t-esc="employee.work_phone"/></div><div t-if="employee.resource_calendar_id"><dt>Working schedule</dt><dd t-esc="employee.resource_calendar_id[1]"/></div><div t-foreach="['attendance','shifts','time_off']" t-as="kind" t-key="kind"><t t-set="snapshot" t-value="profile.snapshots?.[kind]"/><dt><span t-if="kind === 'attendance'">Attendance today</span><span t-elif="kind === 'shifts'">Current or next shift</span><span t-else="">Approved upcoming time off</span></dt><dd><t t-if="snapshot?.status === 'ready'"><t t-if="kind === 'attendance'"><span>Checked in</span> · <bdi t-esc="hrTime(snapshot.rows[0].check_in_label)"/><small t-if="snapshot.rows[0].check_in_label.slice(0,10) !== profile.today"><bdi t-esc="hrDate(snapshot.rows[0].check_in_label)"/></small></t><t t-elif="kind === 'shifts'"><bdi t-esc="hrDate(snapshot.rows[0].start_datetime_label)"/> · <bdi><t t-esc="hrTime(snapshot.rows[0].start_datetime_label)"/> – <t t-esc="hrTime(snapshot.rows[0].end_datetime_label)"/></bdi></t><t t-else=""><span t-foreach="snapshot.rows" t-as="request" t-key="request.id"><bdi t-esc="hrDate(request.date_from_label)"/> – <bdi t-esc="hrDate(request.date_to_label)"/><t t-if="!request_last">, </t></span><small t-if="snapshot.total &gt; snapshot.rows.length">More requests are available in Time Off.</small></t></t><t t-elif="snapshot?.status === 'empty'"><span t-if="kind === 'attendance'">No open check-in</span><span t-elif="kind === 'shifts'">No upcoming shift</span><span t-else="">None</span></t><span t-else="" t-esc="statusLabels[snapshot?.status] || '—'"/></dd></div></dl>
                <h3>Employee records</h3><div class="adams_hr_profile_actions"><div t-foreach="profile.summaries || []" t-as="summary" t-key="summary.tab"><button class="btn btn-outline-secondary" t-att-disabled="summary.status !== 'ready'" t-on-click="() =&gt; this.openEmployeeRecords(summary.tab)"><span t-if="summary.tab === 'attendance'">Attendance</span><span t-elif="summary.tab === 'time_off'">Time off</span><span t-else="">Shifts</span><svg class="adams_directional_arrow adams_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></button><small t-if="summary.status !== 'ready'" t-esc="statusLabels[summary.status]"/></div></div>
            </t>
        </div>
        <footer t-if="profile.status === 'ready'" class="adams_hr_profile_footer"><button class="btn btn-outline-secondary" t-on-click="closeEmployeeProfile">Back to dashboard</button><button class="btn btn-primary" t-on-click="openEmployeeRecord">Open employee profile <svg class="adams_directional_arrow adams_icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></button></footer>
    </t>
</dialog>
</t>
</templates>
