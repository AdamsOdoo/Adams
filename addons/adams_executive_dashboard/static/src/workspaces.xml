<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="adams_executive_dashboard.WorkspaceDetails">
    <t t-set="details" t-value="state.workspaceDetails[section.key]"/>
    <div t-if="!details || details.status === 'loading'" class="adams_message" role="status">Loading records…</div>
    <div t-elif="details.status === 'error'" class="adams_message" role="alert"><p>Records could not be loaded.</p><button class="btn" t-on-click="() =&gt; this.loadWorkspaceDetails(section.key)">Retry</button></div>
    <p t-elif="!['ready','empty'].includes(details.status)" class="adams_message" t-esc="statusLabels[details.status]"/>
    <div t-else="" class="adams_workspace_reference">
        <header class="adams_group_heading"><h3 t-if="section.key === 'procurement'">Purchasing overview</h3><h3 t-else="">Pipeline overview</h3><span class="adams_period_chip" t-if="section.key === 'procurement'">Purchases follow the period; worklists show current items</span><bdi t-else="" class="adams_period_chip" t-esc="financePeriodLabel({date_field:'period'})"/></header>
        <div class="adams_workspace_kpis" t-att-class="{'adams_workspace_kpis_three': section.key === 'procurement'}">
            <t t-set="primary" t-value="result.items.find(item =&gt; item.key === (section.key === 'procurement' ? 'purchases' : 'crm'))"/>
            <t t-if="primary" t-call="adams_executive_dashboard.WorkspaceMetric"><t t-set="item" t-value="primary"/><t t-set="note" t-value="section.key === 'procurement' ? purchaseNote : pipelineNote"/></t>
            <t t-if="section.key === 'crm'" t-call="adams_executive_dashboard.WorkspaceMetric"><t t-set="item" t-value="workspaceMetric('crm',details)"/><t t-set="note" t-value="pipelineUnweightedNote"/></t>
            <t t-else="" t-foreach="['approvals','late']" t-as="kind" t-key="kind"><t t-set="worklist" t-value="details[kind]"/>
                <article class="adams_card" t-att-class="{'adams_available':['ready','empty'].includes(worklist?.status)}"><div class="adams_card_top"><h3 t-if="kind === 'approvals'">Awaiting approval</h3><h3 t-else="">Late receipts</h3><button class="adams_metric_info" aria-label="View source worklist" t-on-click="() =&gt; this.openProcurementWorklist(kind)" t-att-disabled="state.opening"><t t-call="adams_executive_dashboard.WorkspaceInfo"/></button></div><div class="adams_amount"><button t-if="['ready','empty'].includes(worklist?.status)" class="adams_value" t-att-disabled="state.opening" t-on-click="() =&gt; this.openProcurementWorklist(kind)"><bdi t-esc="worklist.total"/></button><span t-else="" class="adams_value" t-esc="statusLabels[worklist?.status]"/></div><p class="adams_margin_note"><span>Purchase orders</span> · <span t-if="kind === 'approvals'">Current worklist</span><span t-else="">Overdue now</span></p><footer class="adams_metric_foot"><span class="adams_card_date">Current worklist</span><button class="adams_source_button" t-att-disabled="state.opening" t-on-click="() =&gt; this.openProcurementWorklist(kind)">View worklist</button></footer></article>
            </t>
        </div>
        <div t-if="section.key === 'procurement' &amp;&amp; details.late?.status === 'ready' &amp;&amp; details.late.total" class="adams_procurement_alert" role="status"><t t-call="adams_executive_dashboard.Icon"><t t-set="iconName" t-value="'alert'"/></t><p><b><bdi t-esc="details.late.total"/> <span>purchase orders need delivery follow-up.</span></b> <span>Check their expected dates with your suppliers.</span></p><button class="btn btn-link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openProcurementWorklist('late')"><span>View report</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></div>
        <t t-set="records" t-value="section.key === 'procurement' ? details.recent : details"/>
        <div class="adams_workspace_panels" t-att-class="{'adams_procurement_panels':section.key === 'procurement'}">
            <section class="adams_panel adams_workspace_records"><header class="adams_panel_head"><div><h3 t-if="section.key === 'procurement'">Recent purchase orders</h3><h3 t-else="">Open opportunities</h3><p t-if="section.key === 'procurement'"><span>Untaxed values</span><t t-if="commonRowValue(records?.rows,'currency')"> · <bdi t-esc="commonRowValue(records.rows,'currency')"/></t></p><p t-else="">Inspect stages, probability and next actions in the standard pipeline.</p></div><button class="btn btn-link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openWorkspaceRecord(section.key)"><span t-if="section.key === 'procurement'">View all</span><span t-else="">View report</span><t t-call="adams_executive_dashboard.SalesArrow"/></button></header>
                <div t-if="records?.status === 'error'" class="adams_empty_note" role="alert"><p>Records could not be loaded.</p><button class="btn" t-on-click="() =&gt; this.loadWorkspaceDetails(section.key)">Retry</button></div><p t-elif="!records || !['ready','empty'].includes(records.status)" class="adams_empty_note" t-esc="statusLabels[records?.status]"/><p t-elif="!records.rows.length" class="adams_empty_note">No matching records</p>
                <div t-else="" class="adams_table_wrap" tabindex="0"><table class="table"><thead><tr><th><t t-if="section.key === 'procurement'">Order / supplier</t><t t-else="">Opportunity / customer</t></th><th t-if="section.key === 'crm'">Stage</th><th class="adams_numeric"><t t-if="section.key === 'procurement'">Value</t><t t-else="">Expected revenue · <bdi t-esc="details.currency"/></t></th><th><t t-if="section.key === 'procurement'">Status</t><t t-else="">Probability</t></th></tr></thead><tbody><tr t-foreach="records.rows" t-as="row" t-key="row.id"><td><button class="btn btn-link adams_row_link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openWorkspaceRecord(section.key,row.id)" t-esc="row.name"/><small t-esc="row.partner_id ? row.partner_id[1] : '—'"/></td><td t-if="section.key === 'crm'"><span class="adams_state_badge brand" t-esc="row.stage_id ? row.stage_id[1] : '—'"/></td><td class="adams_numeric"><bdi t-if="section.key === 'procurement'" dir="ltr"><t t-if="!commonRowValue(records.rows,'currency')"><t t-esc="row.currency"/> </t><t t-esc="formatted({value:row.amount_untaxed},row)"/></bdi><bdi t-else="" dir="ltr" t-esc="headline({value:row.expected_revenue},details,true)"/></td><td><span t-if="section.key === 'procurement'" class="adams_state_badge" t-att-class="{'green':row.receipt_status === 'full','amber':row.receipt_status === 'pending' || row.receipt_status === 'partial'}" t-esc="row.receipt_label || row.state_label"/><bdi t-else="" dir="ltr"><t t-esc="headline({value:row.probability,unit:'percentage',digits:2},{digits:2},true)"/>%</bdi></td></tr></tbody></table></div>
                <div t-if="records &amp;&amp; ['ready','empty'].includes(records.status) &amp;&amp; records.total &gt; records.page_size" class="adams_sales_table_footer"><span t-esc="recentPageCaption({...records,total_count:records.total})"/><div class="adams_page_controls"><button class="btn" aria-label="Previous page" t-att-disabled="!records.offset" t-on-click="() =&gt; this.loadWorkspaceDetails(section.key,records.offset-records.page_size)"><svg class="adams_icon adams_action_arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6"/></svg></button><t t-foreach="compactPages({...records,total_count:records.total})" t-as="page" t-key="page.key"><span t-if="!page.number">…</span><button t-else="" class="btn adams_page_number" t-att-class="{'active':page.number === currentPage(records)}" t-att-aria-current="page.number === currentPage(records) ? 'page' : undefined" t-on-click="() =&gt; this.loadWorkspaceDetails(section.key,(page.number-1)*records.page_size)" t-esc="page.number"/></t><button class="btn" aria-label="Next page" t-att-disabled="!records.has_more" t-on-click="() =&gt; this.loadWorkspaceDetails(section.key,records.offset+records.page_size)"><t t-call="adams_executive_dashboard.SalesArrow"/></button></div></div>
            </section>
            <section t-if="section.key === 'procurement'" class="adams_panel adams_procurement_payments"><div class="adams_panel_body"><h3>Supplier payments</h3><p class="adams_payment_scope">Outstanding bill instalments at <bdi t-esc="metricPeriodLabel({date_field:'as_of'})"/>.</p><t t-set="windows" t-value="state.sections.finance?.supplier_windows || []"/><p t-if="!windows.length" class="adams_empty_note" t-esc="supplierStatus"/><div t-foreach="windows" t-as="payment" t-key="payment.key" class="adams_payment_row"><span t-esc="supplierWindowLabel(payment)"/><button t-if="payment.status === 'ready' &amp;&amp; payment.drilldown" class="btn btn-link" t-att-disabled="state.opening" t-on-click="() =&gt; this.openReport(payment.key)"><bdi dir="ltr"><t t-esc="state.sections.finance.currency"/> <t t-esc="formatted(payment,state.sections.finance)"/></bdi></button><span t-else="" t-esc="statusLabels[payment.status]"/></div></div></section>
        </div>
    </div>
</t>
<t t-name="adams_executive_dashboard.WorkspaceInfo"><svg class="adams_icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg></t>
<t t-name="adams_executive_dashboard.WorkspaceMetric">
    <article class="adams_card" t-att-class="{'adams_available':item.status === 'ready'}"><div class="adams_card_top"><h3 t-esc="labels[item.key]"/><button class="adams_metric_info" aria-label="Source &amp; definition" t-on-click="() =&gt; this.openSource(item,details)"><t t-call="adams_executive_dashboard.WorkspaceInfo"/></button></div><div class="adams_amount"><span t-if="item.value !== null &amp;&amp; item.value !== undefined" class="adams_currency" t-esc="details.currency"/><button t-if="item.drilldown" class="adams_value" t-att-disabled="state.opening" t-on-click="() =&gt; this.openReport(item.key)"><bdi dir="ltr" t-esc="headline(item,details,true)"/></button><span t-else="" class="adams_value" t-esc="item.status === 'ready' ? headline(item,details,true) : statusLabels[item.status]"/></div><p class="adams_margin_note" t-esc="note"/><footer class="adams_metric_foot"><bdi class="adams_card_date" t-esc="financePeriodLabel(item)"/><button class="adams_source_button" t-on-click="() =&gt; this.openSource(item,details)">Source &amp; definition</button></footer></article>
</t>
</templates>
