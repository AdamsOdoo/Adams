<odoo>
    <record id="view_dashboard_settings" model="ir.ui.view">
        <field name="name">res.config.settings.adams.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Executive Dashboard" name="adams_executive_dashboard" groups="base.group_system">
                    <block title="Visible dashboard sections" name="adams_dashboard_sections">
                        <div class="text-muted mb-3">Choose the sections shown for the selected company. Reload the dashboard after saving. Visibility does not grant or revoke native application permissions.</div>
                        <setting id="adams_dashboard_finance" string="Accounting &amp; Finance" company_dependent="1"><field name="adams_dashboard_finance"/></setting>
                        <setting id="adams_dashboard_sales" string="Sales" company_dependent="1"><field name="adams_dashboard_sales"/></setting>
                        <setting id="adams_dashboard_crm" string="CRM" company_dependent="1"><field name="adams_dashboard_crm"/></setting>
                        <setting id="adams_dashboard_inventory" string="Inventory" company_dependent="1"><field name="adams_dashboard_inventory"/></setting>
                        <setting id="adams_dashboard_procurement" string="Procurement" company_dependent="1"><field name="adams_dashboard_procurement"/></setting>
                        <setting id="adams_dashboard_hr" string="Human Resources" company_dependent="1"><field name="adams_dashboard_hr"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_dashboard_settings" model="ir.actions.act_window">
        <field name="name">Dashboard Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'adams_executive_dashboard'}</field>
    </record>
</odoo>
