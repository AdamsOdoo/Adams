<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- C1: routine inventory work is Operations; policy and mappings are
         Administrator-only Configuration. -->

    <menuitem id="menu_shopify_connector_inventory"
              name="Inventory"
              parent="shopify_connector_core.menu_shopify_connector_operations"
              action="action_shopify_connector_inventory_workspace"
              sequence="30"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_inventory_workspace"
              name="Inventory Workspace"
              parent="menu_shopify_connector_inventory"
              action="action_shopify_connector_inventory_workspace"
              sequence="10"
              active="False"/>

    <menuitem id="menu_shopify_connector_inventory_first_push"
              name="Inventory Safeguards"
              parent="shopify_connector_core.menu_shopify_connector_store_settings"
              action="action_shopify_connector_inventory_first_push"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="20"/>

    <menuitem id="menu_shopify_connector_location_mapping"
              name="Location Mappings"
              parent="shopify_connector_product.menu_shopify_connector_catalog"
              action="action_shopify_connector_location_mapping"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="30"/>

    <!--
        WAVE 5 — the two governed routes the Location Mapping list was
        missing. It carries `create="false"` (correctly: the binding mixin
        refuses a generic create of protected identity fields) and told the
        operator a mapping "is created" without offering anywhere to create
        one. These are that route.

        C2 puts both navigation routes inside Administrator-only
        Configuration. The existing server capability guards remain intact;
        menu visibility is not their authorization boundary. Remap lives on
        the mapping form beside the record it changes.
    -->
    <menuitem id="menu_shopify_connector_location_refresh"
              name="Refresh Shopify Locations"
              parent="shopify_connector_product.menu_shopify_connector_catalog"
              action="action_shopify_connector_location_refresh_wizard"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="40"/>

    <menuitem id="menu_shopify_connector_location_map"
              name="Map a Shopify Location"
              parent="shopify_connector_product.menu_shopify_connector_catalog"
              action="action_shopify_connector_location_map_wizard"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="50"/>
</odoo>
