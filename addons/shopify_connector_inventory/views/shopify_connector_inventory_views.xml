<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        U2 operator UI — S10 location mapping, S11 first-push guard and
        S19/S12 inventory workspace (premium UX master specification §3).

        WHAT THIS SURFACE IS. A face over the merged inventory models. Every
        button wires to a sanctioned server action that Wave 3 shipped:
        `action_confirm_first_push`, `action_recheck_inventory_pair`,
        `action_set_push_enabled`. No quantity is computed, compared or
        decided here — the view shows what the service already recorded.

        THE FIRST-PUSH GUARD IS NOT A ROUTINE SCREEN (RA-008). S11 is
        deliberately a separate, differently-toned surface from the routine
        S19 queue: pushing stock to a live storefront for the first time is a
        one-way ceremony, and burying its confirmation among ordinary rows is
        how blind first pushes happen. It is therefore its own action, its own
        filter and its own consequence copy.
    -->

    <!-- ============================================================== -->
    <!-- S10 — Location mapping                                          -->
    <!-- ============================================================== -->

    <record id="view_shopify_connector_location_mapping_search"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.mapping.search</field>
        <field name="model">shopify.connector.location.mapping</field>
        <field name="arch" type="xml">
            <search string="Location Mapping">
                <field name="shopify_location_name_snapshot"/>
                <field name="odoo_location_id"/>
                <field name="store_id"/>
                <filter name="filter_push_disabled" string="Push Disabled"
                        domain="[('push_enabled', '=', False)]"/>
                <separator/>
                <filter name="filter_quarantined" string="Scope Quarantined"
                        domain="[('sec3_scope_quarantined', '=', True)]"/>
                <group>
                    <filter name="group_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shopify_connector_location_mapping_list"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.mapping.list</field>
        <field name="model">shopify.connector.location.mapping</field>
        <field name="arch" type="xml">
            <list string="Location Mapping" create="false" delete="false">
                <field name="shopify_location_name_snapshot"/>
                <field name="odoo_location_id"/>
                <field name="store_id" optional="show"/>
                <field name="push_enabled" widget="boolean_toggle"
                       readonly="1"/>
                <field name="status"
                       decoration-warning="status == 'review'"
                       decoration-muted="status == 'inactive'"/>
                <field name="sec3_scope_quarantined" string="Quarantined"
                       widget="boolean_toggle" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_connector_location_mapping_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.mapping.form</field>
        <field name="model">shopify.connector.location.mapping</field>
        <field name="arch" type="xml">
            <form string="Location Mapping" create="false" delete="false">
                <header>
                    <!--
                        GROUP GATING IS DERIVED FROM THE SERVER, NOT FROM THE
                        role matrix. `action_set_push_enabled` admits
                        Operator OR Administrator (see the method's own
                        guard), and the ACL gives Reviewer write on this
                        model, so the button and the editable field carry
                        exactly those groups. The premium UX master
                        specification §2.4 lists this screen as
                        "User: read, Administrator: act", which disagrees with
                        the merged server guard; the view follows the SERVER,
                        because a view that hides a permitted capability is a
                        UI defect and a view that shows a denied one is worse.
                        The discrepancy is recorded for the control room
                        rather than resolved by silently changing either side.

                        `action_set_push_enabled(enabled)` takes a REQUIRED
                        argument, and an Odoo object button passes none, so
                        the button opens a wizard that collects it and
                        delegates. The server still owns what enabling a
                        location means, and still audits it; the view never
                        writes `push_enabled` itself.
                    -->
                    <button name="%(action_shopify_connector_location_push_toggle_wizard)d"
                            type="action" string="Change Push"
                            class="btn-primary"
                            groups="shopify_connector_core.group_shopify_connector_operator"/>
                    <!--
                        WAVE 5 — REMAP.

                        `action_override_binding` on the shared binding mixin
                        can already move a bound Many2one, and it is
                        deliberately NOT wired here. It admits Reviewer OR
                        Administrator, and it proves nothing about whether an
                        inventory remap is operationally safe: moving the Odoo
                        location under a pair whose first push is already
                        previewed or confirmed silently changes which
                        warehouse's stock is about to reach a live storefront,
                        and doing it while inventory work is in flight changes
                        the target under a job that already read the old one.

                        So the button opens a dialog that delegates to
                        `remap_location_mapping`, an Administrator-only
                        inventory service that performs those additional
                        checks and THEN calls the mixin. The mixin is neither
                        weakened nor bypassed; it is reached through a gate
                        that knows what this domain needs.

                        The group here is Administrator, matching that server
                        guard exactly. Showing a control to a role the server
                        refuses is a UI defect the packet names as a test
                        failure.
                    -->
                    <button name="%(action_shopify_connector_location_remap_wizard)d"
                            type="action" string="Remap"
                            groups="shopify_connector_core.group_shopify_connector_admin"/>
                    <!--
                        Refresh, on the form as well as on the menu, because
                        an operator who has just discovered a mapping is
                        stale is already here.
                    -->
                    <button name="%(action_shopify_connector_location_refresh_wizard)d"
                            type="action" string="Refresh Shopify Locations"
                            groups="shopify_connector_core.group_shopify_connector_operator"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="not sec3_scope_quarantined">
                        <strong>Excluded from synchronisation.</strong>
                        This mapping's company no longer agrees with its
                        store's. Inventory for this location is paused until
                        an administrator releases it.
                    </div>
                    <div class="oe_title">
                        <h1><field name="shopify_location_name_snapshot"
                                   readonly="1"
                                   placeholder="Unnamed Shopify location"/></h1>
                    </div>
                    <group>
                        <group string="Mapping">
                            <field name="odoo_location_id"
                                   groups="shopify_connector_core.group_shopify_connector_reviewer"/>
                            <field name="push_enabled" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="Shopify">
                            <field name="store_id" readonly="1"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="match_key" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_location_mapping"
            model="ir.actions.act_window">
        <field name="name">Location Mapping</field>
        <field name="res_model">shopify.connector.location.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_shopify_connector_location_mapping_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No locations mapped yet.
            </p>
            <p>
                Start with <b>Refresh Shopify Locations</b> to read this
                store's location list, then <b>Map a Shopify Location</b> to
                pair one with an Odoo location. Both are in the Inventory
                menu beside this one.
            </p>
            <p>
                Until a pair exists, inventory for that Shopify location stays
                paused. An unmapped location is not synchronised.
            </p>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- S19 / S12 — Inventory workspace, and S11 — first-push guard     -->
    <!-- ============================================================== -->

    <record id="view_shopify_connector_inventory_level_binding_search"
            model="ir.ui.view">
        <field name="name">shopify.connector.inventory.level.binding.search</field>
        <field name="model">shopify.connector.inventory.level.binding</field>
        <field name="arch" type="xml">
            <search string="Inventory Levels">
                <field name="product_variant_binding_id"/>
                <field name="location_mapping_id"/>
                <field name="store_id"/>
                <field name="shopify_inventory_item_gid"/>
                <filter name="filter_needs_attention"
                        string="Needs Attention"
                        domain="['|', '|',
                                 ('first_push_state', 'in',
                                  ['pending', 'previewed']),
                                 ('status', '=', 'review'),
                                 ('sec3_scope_quarantined', '=', True)]"/>
                <separator/>
                <filter name="filter_first_push_pending"
                        string="First Push Pending"
                        domain="[('first_push_state', '=', 'pending')]"/>
                <!-- The rows a reviewer can actually act on: previewed, so
                     the confirm control is on screen. -->
                <filter name="filter_first_push_awaiting_confirmation"
                        string="Awaiting First-Push Confirmation"
                        domain="[('first_push_state', '=', 'previewed')]"/>
                <filter name="filter_never_pushed" string="Never Pushed"
                        domain="[('last_pushed_at', '=', False)]"/>
                <separator/>
                <filter name="filter_quarantined" string="Scope Quarantined"
                        domain="[('sec3_scope_quarantined', '=', True)]"/>
                <group>
                    <filter name="group_location" string="Location"
                            context="{'group_by': 'location_mapping_id'}"/>
                    <filter name="group_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_first_push" string="First-Push State"
                            context="{'group_by': 'first_push_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shopify_connector_inventory_level_binding_list"
            model="ir.ui.view">
        <field name="name">shopify.connector.inventory.level.binding.list</field>
        <field name="model">shopify.connector.inventory.level.binding</field>
        <field name="arch" type="xml">
            <list string="Inventory Levels" create="false" delete="false">
                <field name="product_variant_binding_id"/>
                <field name="location_mapping_id" optional="show"/>
                <field name="pending_target_available" string="Odoo Target"/>
                <field name="last_known_shopify_available"
                       string="Shopify (last known)"/>
                <field name="last_pushed_available" optional="hide"/>
                <field name="last_pushed_at" optional="show"/>
                <field name="first_push_state"
                       decoration-warning="first_push_state == 'pending'"
                       decoration-success="first_push_state == 'confirmed'"/>
                <field name="status" optional="hide"/>
                <field name="sec3_scope_quarantined" string="Quarantined"
                       widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="store_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_connector_inventory_level_binding_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.inventory.level.binding.form</field>
        <field name="model">shopify.connector.inventory.level.binding</field>
        <field name="arch" type="xml">
            <form string="Inventory Level" create="false" delete="false">
                <header>
                    <!--
                        The first-push ceremony (RA-008). The confirm text
                        names the consequence in words and is deliberately
                        heavier than any routine action in this module.
                    -->
                    <!--
                        VISIBLE IN `previewed`, NOT `pending`. The state
                        machine is pending -> previewed (the preview job
                        records the quantity, service
                        `_handle_inventory_first_push_preview`) -> confirmed
                        (this button). `action_confirm_first_push` refuses
                        anything that is not `previewed`:
                        "A first push can only be confirmed after its preview
                        has run."

                        This originally read `!= 'pending'`, which showed the
                        button in exactly the state the server refuses and hid
                        it in the one state the server accepts — so the only
                        click the shipped UI allowed could never succeed, and
                        the sanctioned confirmation was unreachable. Found by
                        driving the control in a browser; a server-side test
                        that writes `first_push_state='previewed'` itself
                        cannot see it. Keep this predicate identical to the
                        server guard.
                    -->
                    <button name="action_confirm_first_push" type="object"
                            string="Confirm First Push" class="btn-primary"
                            invisible="first_push_state != 'previewed'"
                            groups="shopify_connector_core.group_shopify_connector_reviewer"
                            confirm="This is the FIRST stock push for this
                                     product and location. Shopify's quantity
                                     will be replaced by Odoo's. This cannot
                                     be undone from here. Confirm?"/>
                    <!--
                        `action_recheck_inventory_pair(reason)` also takes a
                        required argument; same wizard-and-delegate shape.
                        The reason is mandatory because it lands on the
                        verification job's audit trail.

                        REVIEWER, not operator. The service guard is
                        "Only a Shopify Connector Reviewer or Administrator
                        may release a blocked inventory pair"; gating the
                        button on Operator showed a control to a role the
                        server refuses, which the packet's §3 rule names as a
                        test failure — UI and ACL must agree.
                    -->
                    <button name="%(action_shopify_connector_inventory_recheck_wizard)d"
                            type="action" string="Verify Now"
                            groups="shopify_connector_core.group_shopify_connector_reviewer"/>
                    <field name="first_push_state" widget="statusbar"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="not sec3_scope_quarantined">
                        <strong>Excluded from synchronisation.</strong>
                        This level's company no longer agrees with its store's.
                        No push or verification job will process it until an
                        administrator releases it.
                    </div>
                    <!--
                        Two waiting states, two different sentences, because
                        they need two different things from the reader. In
                        `pending` there is nothing to review yet and no
                        control to press; in `previewed` there is a quantity
                        on screen and a decision to make.
                    -->
                    <div class="alert alert-warning" role="alert"
                         invisible="first_push_state != 'pending'">
                        <strong>Waiting for a first-push preview.</strong>
                        Nothing has been pushed for this product and location
                        yet, and the quantity to send has not been computed.
                        The preview runs on the next scheduled pass; the
                        confirmation control appears once it has.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="first_push_state != 'previewed'">
                        <strong>Waiting for a first-push confirmation.</strong>
                        Nothing has been pushed for this product and location
                        yet. Review the quantities below, then confirm.
                    </div>
                    <group>
                        <group string="Pair">
                            <field name="product_variant_binding_id"
                                   readonly="1"/>
                            <field name="location_mapping_id" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="Quantities">
                            <!--
                                Three distinct quantities, never merged into
                                one "delta" number: what Odoo wants pushed,
                                what Shopify last reported, and what this
                                connector last actually pushed. Collapsing
                                them would hide whether a difference is drift
                                or an unpushed change.
                            -->
                            <field name="pending_target_available"
                                   string="Odoo target" readonly="1"/>
                            <field name="last_known_shopify_available"
                                   string="Shopify last known" readonly="1"/>
                            <field name="last_pushed_available"
                                   string="Last pushed by connector"
                                   readonly="1"/>
                            <field name="last_pushed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="First-Push Guard">
                        <group>
                            <field name="first_push_state" readonly="1"/>
                            <field name="first_push_preview_qty" readonly="1"/>
                        </group>
                        <group invisible="not first_push_confirmed_by_uid">
                            <field name="first_push_confirmed_by_uid"
                                   readonly="1"/>
                            <field name="first_push_confirmed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Identity">
                        <field name="shopify_inventory_item_gid" readonly="1"/>
                        <field name="shopify_gid" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="match_key" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_inventory_workspace"
            model="ir.actions.act_window">
        <field name="name">Inventory Workspace</field>
        <field name="res_model">shopify.connector.inventory.level.binding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_shopify_connector_inventory_level_binding_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending inventory changes.
            </p>
            <p>
                Inventory levels appear here once products and locations are
                mapped.
            </p>
        </field>
    </record>

    <record id="action_shopify_connector_inventory_first_push"
            model="ir.actions.act_window">
        <field name="name">First-Push Guard</field>
        <field name="res_model">shopify.connector.inventory.level.binding</field>
        <field name="view_mode">list,form</field>
        <!--
            BOTH waiting states. Scoping this queue to `pending` alone meant
            the guard listed only rows whose confirm control is not yet
            available and hid every row actually awaiting a decision, so a
            reviewer working the queue could never reach the confirmation.
        -->
        <field name="domain">[('first_push_state', 'in',
                              ['pending', 'previewed'])]</field>
        <field name="search_view_id"
               ref="view_shopify_connector_inventory_level_binding_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing is waiting for a first push.
            </p>
            <p>
                The first stock push for each product and location needs an
                explicit confirmation. Pairs waiting for one appear here.
            </p>
        </field>
    </record>
</odoo>
