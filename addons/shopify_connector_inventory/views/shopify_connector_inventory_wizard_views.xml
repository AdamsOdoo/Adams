<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        U2 wizard forms for the inventory operator surfaces. Loaded BEFORE the
        views that reference their actions, so every `%(...)d` reference
        resolves at install time.

        Both dialogs carry `role="dialog"` and `aria-modal="true"`: Odoo
        renders them in a modal, and a screen reader needs the boundary
        announced (design system §12).
    -->

    <record id="view_shopify_connector_location_push_toggle_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.push.toggle.wizard.form</field>
        <field name="model">shopify.connector.location.push.toggle.wizard</field>
        <field name="arch" type="xml">
            <form string="Change inventory push" role="dialog"
                  aria-modal="true">
                <div class="alert alert-info" role="status"
                     invisible="not target_enabled">
                    Inventory for <field name="location_name" readonly="1"
                                         nolabel="1" class="oe_inline"/>
                    will start pushing to Shopify on the next scheduled run.
                </div>
                <div class="alert alert-info" role="status"
                     invisible="target_enabled">
                    Inventory for <field name="location_name" readonly="1"
                                         nolabel="1" class="oe_inline"/>
                    will stop pushing. Quantities already on Shopify are left
                    exactly as they are.
                </div>
                <group>
                    <field name="mapping_id" invisible="1"/>
                    <field name="odoo_location_id" readonly="1"/>
                    <field name="currently_enabled" readonly="1"
                           string="Currently enabled"/>
                    <field name="target_enabled"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_location_push_toggle_wizard"
            model="ir.actions.act_window">
        <field name="name">Change inventory push</field>
        <field name="res_model">shopify.connector.location.push.toggle.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shopify_connector_inventory_recheck_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.inventory.recheck.wizard.form</field>
        <field name="model">shopify.connector.inventory.recheck.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify inventory now" role="dialog"
                  aria-modal="true">
                <div class="alert alert-info" role="status">
                    This queues a read-only verification of what Shopify
                    currently holds for this pair. It changes no quantity on
                    either side.
                </div>
                <group>
                    <field name="binding_id" invisible="1"/>
                    <field name="variant_binding_id" readonly="1"/>
                    <field name="location_mapping_id" readonly="1"/>
                    <field name="pending_target_available" readonly="1"
                           string="Odoo target"/>
                    <field name="last_known_shopify_available" readonly="1"
                           string="Shopify last known"/>
                    <field name="reason"
                           placeholder="Why is this being re-checked?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Queue verification" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_inventory_recheck_wizard"
            model="ir.actions.act_window">
        <field name="name">Verify inventory now</field>
        <field name="res_model">shopify.connector.inventory.recheck.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==============================================================
         Wave 5 — the three governed Location Mapping workspace actions.

         WHY THESE ARE WIZARDS AND NOT LIST/FORM CONTROLS. The mapping
         model inherits the protected binding mixin, so a generic create or
         write of its identity fields is refused by the server — correctly.
         `create="false"` on the list and form is therefore right, and what
         was missing was a governed route, not a relaxation. Each dialog
         collects the arguments the sanctioned service method requires and
         calls it; the server owns every check and re-runs all of them as
         the calling user.
         ============================================================== -->

    <record id="view_shopify_connector_location_refresh_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.refresh.wizard.form</field>
        <field name="model">shopify.connector.location.refresh.wizard</field>
        <field name="arch" type="xml">
            <form string="Refresh Shopify locations" role="dialog"
                  aria-modal="true">
                <div class="alert alert-info" role="status">
                    This asks Shopify for the store's list of locations and
                    updates the cached list Odoo maps against. It runs in the
                    background as an ordinary connector job, reads only, and
                    changes nothing on Shopify.
                </div>
                <group>
                    <field name="store_id"/>
                    <field name="refresh_state" readonly="1"
                           string="Current refresh"
                           invisible="not store_id"/>
                    <field name="refresh_job_id" readonly="1"
                           invisible="not refresh_job_id"/>
                </group>
                <!-- A refresh already in flight is NOT an error and is not
                     silently duplicated: the server coalesces onto the job
                     that exists, and this says so before the click. -->
                <div class="alert alert-warning" role="status"
                     invisible="refresh_state not in ('waiting', 'running')">
                    A refresh for this store is already in progress.
                    Confirming shows you that job rather than starting a
                    second one.
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="refresh_state != 'failed'">
                    The last refresh did not finish. Until one succeeds, an
                    empty location list is not evidence that this Shopify
                    store has no locations.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Refresh locations" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_location_refresh_wizard"
            model="ir.actions.act_window">
        <field name="name">Refresh Shopify locations</field>
        <field name="res_model">shopify.connector.location.refresh.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shopify_connector_location_map_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.map.wizard.form</field>
        <field name="model">shopify.connector.location.map.wizard</field>
        <field name="arch" type="xml">
            <form string="Map a Shopify location" role="dialog"
                  aria-modal="true">
                <div class="alert alert-info" role="status">
                    Pair one Shopify location with one Odoo internal
                    location. The Shopify side is chosen from this store's
                    refreshed list — it is never matched by name, and never
                    typed in by hand.
                </div>
                <group>
                    <field name="store_id"/>
                    <field name="shopify_location_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="odoo_location_id"
                           options="{'no_create': True}"/>
                    <field name="push_enabled"/>
                </group>
                <div class="alert alert-warning" role="status">
                    Mapping a location does not push any stock. The first
                    push for each product and location still waits for its
                    own explicit confirmation.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Create mapping" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_location_map_wizard"
            model="ir.actions.act_window">
        <field name="name">Map a Shopify location</field>
        <field name="res_model">shopify.connector.location.map.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shopify_connector_location_remap_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.location.remap.wizard.form</field>
        <field name="model">shopify.connector.location.remap.wizard</field>
        <field name="arch" type="xml">
            <form string="Remap this Shopify location" role="dialog"
                  aria-modal="true">
                <div class="alert alert-warning" role="alert">
                    <strong>This changes which Odoo location's stock this
                    Shopify location reflects.</strong>
                    The Shopify location itself is unchanged, and the mapping
                    is never deleted and recreated. Administrator only, and
                    the reason below is recorded on the audit trail.
                </div>
                <group>
                    <field name="mapping_id" invisible="1"/>
                    <field name="location_name" readonly="1"/>
                    <field name="current_location_id" readonly="1"/>
                    <field name="new_location_id"
                           options="{'no_create': True}"/>
                    <field name="reason"
                           placeholder="Why is this being remapped?"/>
                    <field name="confirmed"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Remap location" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_location_remap_wizard"
            model="ir.actions.act_window">
        <field name="name">Remap this Shopify location</field>
        <field name="res_model">shopify.connector.location.remap.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shopify_connector_first_push_withdraw_wizard_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.first.push.withdraw.wizard.form</field>
        <field name="model">shopify.connector.first.push.withdraw.wizard</field>
        <field name="arch" type="xml">
            <form string="Withdraw this first-push decision" role="dialog"
                  aria-modal="true">
                <div class="alert alert-warning" role="alert">
                    <strong>This withdraws the pair's first-push decision.</strong>
                    The pair returns to Pending: no stock can be pushed for
                    this product and location until a new preview is run and
                    explicitly confirmed. The old confirmation is never
                    reused. Administrator only, and the reason below is
                    recorded on the audit trail.
                </div>
                <div class="alert alert-info" role="note">
                    Use this when the mapped Odoo location must change — for
                    example after a physical warehouse move. Once every pair
                    of a Shopify location is back to Pending, the
                    Administrator remap on its location mapping becomes
                    possible.
                </div>
                <!--
                    Two different worlds, said explicitly: a pair that has
                    never pushed leaves Shopify untouched by definition; a
                    pair that HAS pushed leaves its last pushed quantity live
                    on the storefront until the new ceremony completes.
                -->
                <div class="alert alert-info" role="status"
                     invisible="has_pushed_before">
                    Nothing has ever been pushed for this pair, so Shopify is
                    not affected by withdrawing the decision.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not has_pushed_before">
                    Stock <strong>has</strong> been pushed for this pair
                    before. Shopify keeps the last pushed quantity until a
                    new first push is previewed, confirmed and applied — no
                    quantity is changed or removed by withdrawing the
                    decision.
                </div>
                <group>
                    <field name="binding_id" invisible="1"/>
                    <field name="expected_state" invisible="1"/>
                    <field name="has_pushed_before" invisible="1"/>
                    <field name="shopify_location_name" readonly="1"/>
                    <field name="odoo_location_id" readonly="1"/>
                    <field name="first_push_state" readonly="1"/>
                    <field name="reason"
                           placeholder="Why is this decision being withdrawn?"/>
                    <field name="confirmed"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Withdraw first push" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_first_push_withdraw_wizard"
            model="ir.actions.act_window">
        <field name="name">Withdraw this first-push decision</field>
        <field name="res_model">shopify.connector.first.push.withdraw.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

        <!-- Wave 5 / Batch 1 correction: the mapping-level first-push
             withdrawal. The single-pair route stays for focused recovery; this
             is the route for the case TD-020 was raised about, where a
             warehouse moved and every pair under one Shopify location has to
             return to Pending before the remap guard will allow a re-point. -->
        <record id="view_shopify_connector_location_withdraw_all_wizard_form"
                model="ir.ui.view">
            <field name="name">shopify.connector.location.withdraw.all.wizard.form</field>
            <field name="model">shopify.connector.location.withdraw.all.wizard</field>
            <field name="arch" type="xml">
                <form string="Withdraw every first-push decision for this location"
                      role="dialog" aria-modal="true">
                    <div class="alert alert-warning" role="alert">
                        <strong>This withdraws the first-push decision of every
                        pair under this Shopify location.</strong>
                        Each affected pair returns to Pending: no stock can be
                        pushed for it until a new preview is run and explicitly
                        confirmed, and the old confirmation is never reused.
                        Administrator only, and the reason below is recorded on
                        the audit trail against this location and against every
                        pair it touches.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not pairs_live_on_shopify">
                        <strong>Shopify is not changed by this.</strong>
                        <field name="pairs_live_on_shopify" readonly="1"
                               class="oe_inline"/> of the affected pairs have a
                        quantity this connector pushed that is live on the
                        storefront right now. Those quantities STAY as they are
                        until a new first push is previewed, confirmed and
                        applied. Nothing here removes or zeroes them, and no
                        Shopify request is made.
                    </div>
                    <div class="alert alert-info" role="status">
                        Once every pair of this Shopify location is back to
                        Pending, the Administrator remap on its location mapping
                        becomes possible. The remap guard itself is unchanged:
                        this is the governed route to the state it requires, not
                        a way around it.
                    </div>
                    <group>
                        <group string="Location">
                            <field name="mapping_id" invisible="1"/>
                            <field name="expected_signature" invisible="1"/>
                            <field name="shopify_location" readonly="1"/>
                            <field name="odoo_location" readonly="1"/>
                        </group>
                        <group string="Pairs affected">
                            <field name="total_pairs" readonly="1"/>
                            <field name="affected_pairs" readonly="1"/>
                            <field name="previewed_pairs" readonly="1"/>
                            <field name="confirmed_pairs" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"
                               placeholder="Why is every first-push decision for this location being withdrawn?"/>
                        <field name="confirmed"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object"
                                string="Withdraw all first-push decisions"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary"
                                special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_shopify_connector_location_withdraw_all_wizard"
                model="ir.actions.act_window">
            <field name="name">Withdraw every first-push decision</field>
            <field name="res_model">shopify.connector.location.withdraw.all.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

</odoo>
