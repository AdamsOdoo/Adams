<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_gift_card_view_list" model="ir.ui.view">
        <field name="name">shopify.gift.card.list</field>
        <field name="model">shopify.gift.card</field>
        <field name="arch" type="xml">
            <list string="Gift Cards">
                <field name="backend_id"/>
                <field name="code_masked"/>
                <field name="initial_amount"/>
                <field name="balance"/>
                <field name="currency_code"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-danger="status == 'disabled'"/>
                <field name="expires_on"/>
            </list>
        </field>
    </record>

    <record id="shopify_gift_card_view_form" model="ir.ui.view">
        <field name="name">shopify.gift.card.form</field>
        <field name="model">shopify.gift.card</field>
        <field name="arch" type="xml">
            <form string="Gift Card">
                <sheet>
                    <group>
                        <group string="Gift Card">
                            <field name="backend_id"/>
                            <field name="shopify_id"/>
                            <field name="code_masked"/>
                            <field name="status"/>
                        </group>
                        <group string="Amounts">
                            <field name="initial_amount"/>
                            <field name="balance"/>
                            <field name="currency_code"/>
                            <field name="expires_on"/>
                        </group>
                    </group>
                    <group>
                        <field name="customer_binding_id"/>
                        <field name="order_binding_id"/>
                    </group>
                    <group string="Sync">
                        <field name="sync_status"/>
                        <field name="last_sync_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_gift_card_view_search" model="ir.ui.view">
        <field name="name">shopify.gift.card.search</field>
        <field name="model">shopify.gift.card</field>
        <field name="arch" type="xml">
            <search string="Gift Cards">
                <field name="code_masked"/>
                <filter name="enabled" string="Enabled"
                        domain="[('status', '=', 'enabled')]"/>
                <filter name="disabled" string="Disabled"
                        domain="[('status', '=', 'disabled')]"/>
                <group>
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_gift_card_action" model="ir.actions.act_window">
        <field name="name">Gift Cards</field>
        <field name="res_model">shopify.gift.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('backend_id.enable_gift_cards', '=', True)]</field>
    </record>

</odoo>
