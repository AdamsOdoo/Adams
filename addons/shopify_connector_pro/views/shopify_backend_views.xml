<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend Tree View -->
    <record id="shopify_backend_view_tree" model="ir.ui.view">
        <field name="name">shopify.backend.tree</field>
        <field name="model">shopify.backend</field>
        <field name="arch" type="xml">
            <list string="Shopify Stores">
                <field name="name"/>
                <field name="shop_url"/>
                <field name="shop_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="last_sync_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Backend Form View -->
    <record id="shopify_backend_view_form" model="ir.ui.view">
        <field name="name">shopify.backend.form</field>
        <field name="model">shopify.backend</field>
        <field name="arch" type="xml">
            <form string="Shopify Store">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="oe_highlight"
                            invisible="state == 'connected'"/>
                    <button name="action_test_connection" type="object"
                            string="Re-test Connection"
                            invisible="state != 'connected'"/>
                    <button name="action_register_webhooks" type="object"
                            string="Register Webhooks"
                            invisible="state != 'connected'"
                            groups="shopify_connector_pro.group_shopify_user"/>
                    <button name="action_import_locations" type="object"
                            string="Import Locations"
                            invisible="state != 'connected'"
                            groups="shopify_connector_pro.group_shopify_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product_bindings" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="product_bind_count" widget="statinfo"
                                   string="Products"/>
                        </button>
                        <button name="action_open_customer_bindings" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="customer_bind_count" widget="statinfo"
                                   string="Customers"/>
                        </button>
                        <button name="action_open_order_bindings" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_bind_count" widget="statinfo"
                                   string="Orders"/>
                        </button>
                        <button name="action_open_inventory_bindings" type="object"
                                class="oe_stat_button" icon="fa-warehouse">
                            <field name="inventory_bind_count" widget="statinfo"
                                   string="Inventory"/>
                        </button>
                        <button name="action_open_sync_logs" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <span class="o_stat_text">Sync Logs</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Store Name"/>
                        </h1>
                    </div>
                    <notebook>
                        <!-- Tab 1: Connection -->
                        <page string="Connection" name="connection">
                            <group>
                                <group string="Shopify Credentials">
                                    <field name="shop_url" placeholder="my-store.myshopify.com"/>
                                    <field name="access_token" password="True"/>
                                    <field name="api_version"/>
                                    <field name="webhook_secret" password="True"/>
                                </group>
                                <group string="Odoo Settings">
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="warehouse_id"/>
                                    <field name="pricelist_id"/>
                                    <field name="shopify_location_id"/>
                                </group>
                            </group>
                            <group string="Shop Info" invisible="state != 'connected'">
                                <field name="shop_name"/>
                                <field name="shop_plan"/>
                            </group>
                        </page>

                        <!-- Tab 2: Sync Settings -->
                        <page string="Sync Settings" name="sync_settings">
                            <group>
                                <group string="Products">
                                    <field name="auto_sync_products"/>
                                    <field name="product_sync_direction"
                                           invisible="not auto_sync_products"/>
                                    <field name="product_sync_interval"
                                           invisible="not auto_sync_products"/>
                                    <field name="auto_export_on_change"
                                           invisible="not auto_sync_products"/>
                                </group>
                                <group string="Customers">
                                    <field name="auto_sync_customers"/>
                                    <field name="customer_sync_direction"
                                           invisible="not auto_sync_customers"/>
                                    <field name="customer_sync_interval"
                                           invisible="not auto_sync_customers"/>
                                    <field name="customer_dedup_field"
                                           invisible="not auto_sync_customers"/>
                                </group>
                            </group>
                            <group>
                                <group string="Orders">
                                    <field name="auto_sync_orders"/>
                                    <field name="order_sync_interval"
                                           invisible="not auto_sync_orders"/>
                                    <field name="auto_create_invoice"
                                           invisible="not auto_sync_orders"/>
                                    <field name="import_currency_mode"
                                           invisible="not auto_sync_orders"/>
                                </group>
                                <group string="Inventory">
                                    <field name="auto_sync_inventory"/>
                                    <field name="inventory_sync_interval"
                                           invisible="not auto_sync_inventory"/>
                                    <field name="inventory_quantity_field"
                                           invisible="not auto_sync_inventory"/>
                                </group>
                            </group>
                            <group>
                                <group string="Collections">
                                    <field name="auto_sync_collections"/>
                                </group>
                                <group string="General">
                                    <field name="batch_size"/>
                                    <field name="shipping_product_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Abandoned Carts">
                                    <field name="auto_sync_abandoned_carts"/>
                                    <field name="auto_create_abandoned_quotation"
                                           invisible="not auto_sync_abandoned_carts"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Status Sync -->
                        <page string="Status Sync" name="status_sync">
                            <group>
                                <group string="Fulfillment (Shopify → Odoo)">
                                    <field name="external_fulfillment_handling"/>
                                </group>
                                <group string="Payment Transitions">
                                    <field name="auto_handle_payment_transitions"/>
                                </group>
                            </group>
                            <group>
                                <group string="Reverse Sync (Odoo → Shopify)">
                                    <field name="reverse_sync_payment"/>
                                    <field name="reverse_sync_refund"/>
                                </group>
                                <group string="Reconciliation">
                                    <field name="reconciliation_order_days"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 4: Field Mapping -->
                        <page string="Field Mapping" name="field_mapping"
                              groups="shopify_connector_pro.group_shopify_user">
                            <div class="mb-3">
                                <button name="action_init_field_mappings" type="object"
                                        string="Load Default Mappings"
                                        class="btn-secondary"
                                        invisible="field_mapping_ids"/>
                            </div>
                            <field name="field_mapping_ids" nolabel="1"
                                   context="{'default_backend_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="entity"/>
                                    <field name="odoo_field"/>
                                    <field name="shopify_field"/>
                                    <field name="direction"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Tax Mapping -->
                        <page string="Tax Mapping" name="tax_mapping"
                              groups="shopify_connector_pro.group_shopify_user">
                            <field name="tax_mapping_ids" nolabel="1"
                                   context="{'default_backend_id': id}">
                                <list editable="bottom">
                                    <field name="shopify_tax_name"/>
                                    <field name="shopify_tax_rate"/>
                                    <field name="odoo_tax_id"/>
                                    <field name="fiscal_position_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 5: Metafield Mapping -->
                        <page string="Metafield Mapping" name="metafield_mapping"
                              groups="shopify_connector_pro.group_shopify_user">
                            <field name="metafield_mapping_ids" nolabel="1"
                                   context="{'default_backend_id': id}">
                                <list editable="bottom">
                                    <field name="owner_type"/>
                                    <field name="shopify_namespace"/>
                                    <field name="shopify_key"/>
                                    <field name="shopify_type"/>
                                    <field name="odoo_field"/>
                                    <field name="direction"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 6: Webhooks -->
                        <page string="Webhooks" name="webhooks"
                              invisible="state != 'connected'"
                              groups="shopify_connector_pro.group_shopify_user">
                            <div class="mb-3">
                                <button name="action_register_webhooks" type="object"
                                        string="Register All Webhooks"
                                        class="btn-primary me-2"
                                        groups="shopify_connector_pro.group_shopify_user"/>
                                <button name="action_check_webhook_status" type="object"
                                        string="Check Status"
                                        class="btn-secondary me-2"
                                        groups="shopify_connector_pro.group_shopify_user"/>
                                <button name="action_unregister_webhooks" type="object"
                                        string="Unregister All"
                                        class="btn-outline-danger me-2"
                                        groups="shopify_connector_pro.group_shopify_user"
                                        confirm="This will remove all webhook registrations from Shopify. Are you sure?"/>
                                <button name="action_open_webhook_logs" type="object"
                                        string="View Webhook Logs"
                                        class="btn-secondary"/>
                            </div>
                            <group string="Webhook Configuration">
                                <field name="webhook_secret" password="True"
                                       groups="shopify_connector_pro.group_shopify_admin"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Registered webhook topics:</strong>
                                PRODUCTS_CREATE, PRODUCTS_UPDATE, PRODUCTS_DELETE,
                                ORDERS_CREATE, ORDERS_UPDATED, ORDERS_CANCELLED,
                                CUSTOMERS_CREATE, CUSTOMERS_UPDATE,
                                INVENTORY_LEVELS_UPDATE, FULFILLMENTS_CREATE,
                                APP_UNINSTALLED
                            </div>
                            <div class="alert alert-warning" role="alert">
                                <strong>Requirements:</strong> Your Odoo instance must be publicly
                                accessible via HTTPS for webhooks to work. Set the
                                <code>web.base.url</code> system parameter correctly.
                                For development, use a tunnel service like ngrok.
                            </div>
                        </page>

                        <!-- Tab 7: Health Dashboard -->
                        <page string="Health Dashboard" name="health_dashboard">
                            <!-- Overall Health Banner -->
                            <field name="sync_health_pct" invisible="1"/>
                            <div class="alert alert-success" role="alert"
                                 invisible="sync_health_pct &lt; 90">
                                <strong>Integration Healthy</strong> —
                                <field name="sync_health_pct" class="d-inline"/>% of bindings synced successfully.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="sync_health_pct &lt; 70 or sync_health_pct &gt;= 90">
                                <strong>Attention Needed</strong> —
                                <field name="sync_health_pct" class="d-inline"/>% sync health. Review errors below.
                            </div>
                            <div class="alert alert-danger" role="alert"
                                 invisible="sync_health_pct &gt;= 70">
                                <strong>Sync Issues Detected</strong> —
                                <field name="sync_health_pct" class="d-inline"/>% sync health. Immediate attention required.
                            </div>

                            <!-- Connection & Overall Status -->
                            <group string="Connection &amp; Sync Status">
                                <group>
                                    <field name="state" readonly="1"/>
                                    <field name="shop_name" readonly="1"/>
                                    <field name="last_sync_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="sync_health_pct" widget="progressbar"/>
                                    <field name="sync_log_today_count" string="Sync Operations Today" readonly="1"/>
                                </group>
                            </group>

                            <!-- Per-Entity Last Sync -->
                            <group string="Last Sync Per Entity">
                                <group>
                                    <field name="last_product_sync" readonly="1"/>
                                    <field name="last_customer_sync" readonly="1"/>
                                    <field name="last_order_sync" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_inventory_sync" readonly="1"/>
                                    <field name="last_fulfillment_sync" readonly="1"/>
                                    <field name="last_collection_sync" readonly="1"/>
                                </group>
                            </group>

                            <!-- Sync Counts -->
                            <group string="Binding Counts">
                                <group>
                                    <field name="product_bind_count" string="Products (synced)" readonly="1"/>
                                    <field name="product_error_count" string="Product Errors" readonly="1"/>
                                    <field name="customer_bind_count" string="Customers (synced)" readonly="1"/>
                                    <field name="customer_error_count" string="Customer Errors" readonly="1"/>
                                </group>
                                <group>
                                    <field name="order_bind_count" string="Orders (synced)" readonly="1"/>
                                    <field name="order_error_count" string="Order Errors" readonly="1"/>
                                    <field name="inventory_bind_count" string="Inventory (synced)" readonly="1"/>
                                    <field name="inventory_error_count" string="Inventory Errors" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="collection_bind_count" string="Collections" readonly="1"/>
                                    <field name="refund_bind_count" string="Refunds" readonly="1"/>
                                </group>
                                <group>
                                    <field name="payout_count" string="Payouts" readonly="1"/>
                                    <field name="abandoned_cart_count" string="Abandoned Carts" readonly="1"/>
                                </group>
                            </group>

                            <!-- Data Integrity Alerts -->
                            <group string="Data Integrity"
                                   invisible="payment_mismatch_count == 0 and fulfillment_mismatch_count == 0 and permanent_error_count == 0">
                                <group>
                                    <field name="payment_mismatch_count" string="Payment Mismatches"
                                           readonly="1" help="Orders paid on Shopify but missing posted invoice in Odoo"/>
                                    <field name="fulfillment_mismatch_count" string="Fulfillment Mismatches"
                                           readonly="1" help="Orders fulfilled on Shopify but with pending deliveries in Odoo"/>
                                    <field name="permanent_error_count" string="Permanent Errors"
                                           readonly="1" help="Bindings that exhausted all retry attempts"/>
                                </group>
                            </group>

                            <!-- Webhook Queue -->
                            <group string="Webhook Queue" invisible="state != 'connected'">
                                <group>
                                    <field name="webhook_pending_count" string="Pending Webhooks" readonly="1"/>
                                    <field name="webhook_dead_letter_count" string="Dead Letters" readonly="1"/>
                                </group>
                            </group>

                            <!-- Error Summary -->
                            <group string="Error Totals">
                                <group>
                                    <field name="total_error_count" string="Total Errors" readonly="1"/>
                                    <field name="total_pending_count" string="Total Pending" readonly="1"/>
                                </group>
                            </group>

                            <!-- Quick Actions -->
                            <div class="mt-3 mb-3" invisible="state != 'connected'">
                                <button name="action_test_connection" type="object"
                                        string="Test Connection" class="btn-secondary me-2"/>
                                <button name="action_retry_all_errors" type="object"
                                        string="Retry All Errors" class="btn-warning me-2"
                                        invisible="total_error_count == 0"
                                        confirm="This will reset all errored bindings to pending for retry. Continue?"/>
                                <button name="action_open_sync_logs" type="object"
                                        string="View Sync Logs" class="btn-secondary me-2"/>
                                <button name="action_open_error_bindings" type="object"
                                        string="View Error Details" class="btn-outline-danger me-2"
                                        invisible="total_error_count == 0"/>
                                <button name="action_open_payment_mismatches" type="object"
                                        string="Payment Mismatches" class="btn-outline-warning me-2"
                                        invisible="payment_mismatch_count == 0"/>
                                <button name="action_open_fulfillment_mismatches" type="object"
                                        string="Fulfillment Mismatches" class="btn-outline-warning me-2"
                                        invisible="fulfillment_mismatch_count == 0"/>
                                <button name="action_run_reconciliation" type="object"
                                        string="Run Reconciliation" class="btn-secondary"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Backend Action -->
    <record id="shopify_backend_action" model="ir.actions.act_window">
        <field name="name">Shopify Stores</field>
        <field name="res_model">shopify.backend</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect your first Shopify store
            </p>
            <p>
                Add your Shopify store credentials to start syncing
                products, orders, customers, and inventory.
            </p>
        </field>
    </record>

</odoo>
