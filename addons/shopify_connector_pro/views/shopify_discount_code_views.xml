<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Discount Code Tree View -->
    <record id="shopify_discount_code_view_tree" model="ir.ui.view">
        <field name="name">shopify.discount.code.tree</field>
        <field name="model">shopify.discount.code</field>
        <field name="arch" type="xml">
            <list string="Discount Codes">
                <field name="code"/>
                <field name="promoter_id"/>
                <field name="backend_id"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="usage_count"/>
                <field name="total_order_revenue"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-warning="sync_status == 'pending'"
                       decoration-danger="sync_status == 'error'"/>
            </list>
        </field>
    </record>

    <!-- Discount Code Form View -->
    <record id="shopify_discount_code_view_form" model="ir.ui.view">
        <field name="name">shopify.discount.code.form</field>
        <field name="model">shopify.discount.code</field>
        <field name="arch" type="xml">
            <form string="Discount Code">
                <header>
                    <button name="action_push_to_shopify" type="object"
                            string="Push to Shopify" class="oe_highlight"
                            invisible="sync_status == 'synced'"/>
                    <button name="action_push_to_shopify" type="object"
                            string="Re-push to Shopify"
                            invisible="sync_status != 'synced'"/>
                    <button name="action_retry_sync" type="object"
                            string="Retry"
                            invisible="sync_status not in ('error', 'permanent_error')"/>
                    <field name="sync_status" widget="statusbar"
                           statusbar_visible="pending,synced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" placeholder="DISCOUNT10"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Discount Details">
                            <field name="promoter_id"/>
                            <field name="backend_id"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="minimum_order_amount"/>
                        </group>
                        <group string="Limits &amp; Dates">
                            <field name="usage_limit"/>
                            <field name="one_per_customer"/>
                            <field name="starts_at"/>
                            <field name="ends_at"/>
                            <field name="active_on_shopify"/>
                        </group>
                    </group>
                    <group string="Sync Info">
                        <field name="shopify_id"/>
                        <field name="last_sync_date"/>
                        <field name="sync_error" invisible="not sync_error"/>
                    </group>
                    <group string="Usage Statistics">
                        <field name="usage_count"/>
                        <field name="total_discount_amount"/>
                        <field name="total_order_revenue"/>
                    </group>
                    <notebook>
                        <page string="Usage History" name="usage_history">
                            <field name="usage_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="sale_order_id"/>
                                    <field name="discount_amount"/>
                                    <field name="order_total"/>
                                    <field name="commission_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Discount Code Search View -->
    <record id="shopify_discount_code_view_search" model="ir.ui.view">
        <field name="name">shopify.discount.code.search</field>
        <field name="model">shopify.discount.code</field>
        <field name="arch" type="xml">
            <search string="Search Discount Codes">
                <field name="code"/>
                <field name="promoter_id"/>
                <filter name="percentage" string="Percentage"
                        domain="[('discount_type', '=', 'percentage')]"/>
                <filter name="fixed_amount" string="Fixed Amount"
                        domain="[('discount_type', '=', 'fixed_amount')]"/>
                <filter name="free_shipping" string="Free Shipping"
                        domain="[('discount_type', '=', 'free_shipping')]"/>
                <separator/>
                <filter name="synced" string="Synced"
                        domain="[('sync_status', '=', 'synced')]"/>
                <filter name="errors" string="Errors"
                        domain="[('sync_status', 'in', ('error', 'permanent_error'))]"/>
                <separator/>
                <group>
                    <filter name="group_promoter" string="Promoter"
                            context="{'group_by': 'promoter_id'}"/>
                    <filter name="group_type" string="Discount Type"
                            context="{'group_by': 'discount_type'}"/>
                    <filter name="group_status" string="Sync Status"
                            context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Discount Code Action -->
    <record id="shopify_discount_code_action" model="ir.actions.act_window">
        <field name="name">Discount Codes</field>
        <field name="res_model">shopify.discount.code</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('backend_id.enable_promoters', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a discount code
            </p>
            <p>
                Create discount codes for your promoters and push them to Shopify.
            </p>
        </field>
    </record>

</odoo>
