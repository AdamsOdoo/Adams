<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_sync_log_view_tree" model="ir.ui.view">
        <field name="name">shopify.sync.log.tree</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'partial'"
                  decoration-info="state == 'running'">
                <field name="create_date" string="Date/Time"/>
                <field name="backend_id" string="Store"/>
                <field name="entity"/>
                <field name="operation"/>
                <field name="total_records" string="Records"/>
                <field name="success_count" string="Success"/>
                <field name="error_count" string="Errors"/>
                <field name="skipped_count" string="Skipped"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'partial'"
                       decoration-info="state == 'running'"/>
                <field name="duration" string="Duration (s)" widget="float_time"/>
                <field name="error_summary" optional="show"/>
            </list>
        </field>
    </record>

    <record id="shopify_sync_log_view_form" model="ir.ui.view">
        <field name="name">shopify.sync.log.form</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log Detail">
                <header>
                    <button name="action_open_error_bindings" type="object"
                            string="View Failed Records"
                            invisible="error_count == 0"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group string="Operation">
                            <field name="backend_id"/>
                            <field name="entity"/>
                            <field name="operation"/>
                            <field name="state"/>
                        </group>
                        <group string="Timing">
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Results">
                        <field name="total_records"/>
                        <field name="success_count"/>
                        <field name="error_count"/>
                        <field name="skipped_count"/>
                    </group>
                    <group string="Error Details" invisible="not error_details">
                        <field name="error_details" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_sync_log_view_search" model="ir.ui.view">
        <field name="name">shopify.sync.log.search</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="backend_id"/>
                <field name="entity"/>
                <filter name="errors" string="With Errors"
                        domain="[('state', 'in', ['error', 'partial'])]"/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_entity" string="Entity"
                            context="{'group_by': 'entity'}"/>
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_sync_log_action" model="ir.actions.act_window">
        <field name="name">Sync Log</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

</odoo>
