<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top-level App Menu — visible to all Shopify users -->
    <menuitem id="menu_shopify_root"
              name="Shopify"
              web_icon="shopify_connector_pro,static/description/icon.png"
              groups="shopify_connector_pro.group_shopify_user"
              sequence="50"/>

    <!-- Dashboard (built-in sync overview) -->
    <menuitem id="menu_shopify_dashboard"
              name="Store Overview"
              parent="menu_shopify_root"
              action="shopify_dashboard_action"
              sequence="10"/>

    <!-- Manager Dashboard (KPIs, charts, analytics) -->
    <menuitem id="menu_shopify_manager_dashboard"
              name="Manager Dashboard"
              parent="menu_shopify_root"
              action="action_manager_dashboard"
              sequence="15"/>

    <!-- Configuration (Admin only) -->
    <menuitem id="menu_shopify_configuration"
              name="Configuration"
              parent="menu_shopify_root"
              groups="shopify_connector_pro.group_shopify_admin"
              sequence="20"/>

    <menuitem id="menu_shopify_stores"
              name="Shopify Stores"
              parent="menu_shopify_configuration"
              action="shopify_backend_action"
              sequence="10"/>

    <menuitem id="menu_shopify_setup_wizard"
              name="Setup Wizard"
              parent="menu_shopify_configuration"
              action="shopify_onboarding_wizard_action"
              sequence="20"/>

    <menuitem id="menu_shopify_payment_gateways"
              name="Payment Gateways"
              parent="menu_shopify_configuration"
              action="shopify_payment_gateway_action"
              sequence="30"/>

    <menuitem id="menu_shopify_tax_mappings"
              name="Tax Mappings"
              parent="menu_shopify_configuration"
              action="shopify_tax_mapping_action"
              sequence="40"/>

    <menuitem id="menu_shopify_metafield_mappings"
              name="Metafield Mappings"
              parent="menu_shopify_configuration"
              action="shopify_metafield_mapping_action"
              sequence="50"/>

    <!-- Operations (Admin only) -->
    <menuitem id="menu_shopify_operations"
              name="Operations"
              parent="menu_shopify_root"
              groups="shopify_connector_pro.group_shopify_admin"
              sequence="30"/>

    <menuitem id="menu_shopify_sync_now"
              name="Sync Now"
              parent="menu_shopify_operations"
              action="shopify_sync_wizard_action"
              sequence="10"/>

    <menuitem id="menu_shopify_import_data"
              name="Import Data"
              parent="menu_shopify_operations"
              action="shopify_import_wizard_action"
              sequence="20"/>

    <menuitem id="menu_shopify_bulk_retry"
              name="Retry Failed Records"
              parent="menu_shopify_operations"
              action="shopify_bulk_retry_wizard_action"
