              sequence="90"/>

    <!-- Sync Status -->
    <menuitem id="menu_shopify_sync_status"
              name="Sync Status"
              parent="menu_shopify_root"
              sequence="40"/>

    <menuitem id="menu_shopify_products"
              name="Products"
              parent="menu_shopify_sync_status"
              action="shopify_product_binding_action"
              sequence="10"/>

    <menuitem id="menu_shopify_customers"
              name="Customers"
              parent="menu_shopify_sync_status"
              action="shopify_customer_binding_action"
              sequence="20"/>

    <menuitem id="menu_shopify_orders"
              name="Orders"
              parent="menu_shopify_sync_status"
