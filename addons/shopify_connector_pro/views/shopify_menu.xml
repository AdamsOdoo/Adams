              sequence="30"/>

    <menuitem id="menu_shopify_gift_cards"
              name="Gift Cards"
              parent="menu_shopify_sync_additional"
              action="shopify_gift_card_action"
              sequence="40"/>

    <menuitem id="menu_shopify_customer_tags"
              name="Customer Tags"
              parent="menu_shopify_sync_additional"
              action="shopify_customer_tag_action"
              sequence="50"/>

    <menuitem id="menu_shopify_metafields"
              name="Metafields"
              parent="menu_shopify_sync_additional"
              action="shopify_metafield_action"
              sequence="60"/>

    <!-- Promoters -->
    <menuitem id="menu_shopify_promoters_section"
              name="Promoters"
              parent="menu_shopify_root"
              sequence="45"/>

    <menuitem id="menu_shopify_promoters"
              name="Promoters"
              parent="menu_shopify_promoters_section"
              action="shopify_promoter_action"
              sequence="10"/>

    <menuitem id="menu_shopify_discount_codes"
              name="Discount Codes"
              parent="menu_shopify_promoters_section"
              action="shopify_discount_code_action"
              sequence="20"/>

    <menuitem id="menu_shopify_discount_usage"
              name="Discount Usage"
              parent="menu_shopify_promoters_section"
              action="shopify_discount_usage_action"
              sequence="30"/>

    <!-- Logs -->
    <menuitem id="menu_shopify_logs"
              name="Logs"
              parent="menu_shopify_root"
              sequence="50"/>

    <menuitem id="menu_shopify_sync_log"
              name="Sync Log"
              parent="menu_shopify_logs"
              action="shopify_sync_log_action"
              sequence="10"/>

    <menuitem id="menu_shopify_webhook_log"
