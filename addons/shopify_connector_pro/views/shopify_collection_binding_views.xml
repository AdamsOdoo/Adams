<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_collection_binding_view_tree" model="ir.ui.view">
        <field name="name">shopify.collection.binding.list</field>
        <field name="model">shopify.collection.binding</field>
        <field name="arch" type="xml">
            <list string="Shopify Collections"
                  decoration-danger="sync_status == 'error'"
                  decoration-warning="sync_status == 'pending'"
                  decoration-muted="sync_status == 'permanent_error'">
                <field name="backend_id"/>
                <field name="odoo_id"/>
                <field name="shopify_title"/>
                <field name="shopify_handle"/>
                <field name="product_count"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="shopify_collection_binding_view_form" model="ir.ui.view">
        <field name="name">shopify.collection.binding.form</field>
        <field name="model">shopify.collection.binding</field>
        <field name="arch" type="xml">
            <form string="Shopify Collection Binding">
                <header>
                    <button name="action_retry_sync" type="object"
                            string="Retry Sync"
                            invisible="sync_status not in ('error', 'permanent_error')"
                            class="oe_highlight"/>
                </header>
                <div class="alert alert-warning" role="alert"
                     invisible="sync_status != 'permanent_error'">
                    <strong>Permanent Error:</strong> This record will not be retried
                    automatically. Common causes: deleted from Shopify, invalid data,
                    or permission issue. Review the error below, fix the underlying
                    issue, then click <b>Retry Sync</b>.
                </div>
                <sheet>
                    <group>
                        <group string="Binding">
                            <field name="backend_id"/>
                            <field name="odoo_id"/>
                            <field name="shopify_id"/>
                            <field name="shopify_title"/>
                            <field name="shopify_handle"/>
                            <field name="product_count"/>
                        </group>
                        <group string="Sync Status">
                            <field name="sync_status"/>
                            <field name="last_sync_date"/>
                            <field name="sync_checksum"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not sync_error">
                        <field name="sync_error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_collection_binding_view_search" model="ir.ui.view">
        <field name="name">shopify.collection.binding.search</field>
        <field name="model">shopify.collection.binding</field>
        <field name="arch" type="xml">
            <search string="Shopify Collections">
                <field name="odoo_id"/>
                <field name="shopify_title"/>
                <filter name="synced" string="Synced"
                        domain="[('sync_status', '=', 'synced')]"/>
                <filter name="errors" string="Errors"
                        domain="[('sync_status', 'in', ['error', 'permanent_error'])]"/>
                <group>
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_collection_binding_action" model="ir.actions.act_window">
        <field name="name">Shopify Collections</field>
        <field name="res_model">shopify.collection.binding</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
