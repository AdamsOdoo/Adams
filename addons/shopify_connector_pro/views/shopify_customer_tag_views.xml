<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_customer_tag_view_list" model="ir.ui.view">
        <field name="name">shopify.customer.tag.list</field>
        <field name="model">shopify.customer.tag</field>
        <field name="arch" type="xml">
            <list string="Customer Tags">
                <field name="name"/>
                <field name="backend_id"/>
                <field name="partner_count"/>
            </list>
        </field>
    </record>

    <record id="shopify_customer_tag_view_form" model="ir.ui.view">
        <field name="name">shopify.customer.tag.form</field>
        <field name="model">shopify.customer.tag</field>
        <field name="arch" type="xml">
            <form string="Customer Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="backend_id"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <group string="Tagged Customers">
                        <field name="partner_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_customer_tag_action" model="ir.actions.act_window">
        <field name="name">Customer Tags</field>
        <field name="res_model">shopify.customer.tag</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('backend_id.enable_customer_tags', '=', True)]</field>
    </record>

</odoo>
