<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Webhooks accelerate evidence; this bounded read-only pass is the
             mandatory loss/delay/ordering recovery path. -->
        <record id="ir_cron_shopify_connector_inventory_observation" model="ir.cron">
            <field name="name">Shopify Connector: Inventory Observation Reconciliation</field>
            <field name="model_id" ref="model_shopify_connector_inventory_observation"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._run_scheduled_observation_fallback(limit=20)</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="priority">7</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
