<?xml version="1.0" encoding="UTF-8" ?>
<!-- Part of the Shopify Connector (Store 360 dashboard; U0 foundation
     preserved: same template name, same root classes, same empty-state
     setup entry). Data comes exclusively from get_store_360_data; every
     drill-down uses a SERVER-BUILT target. -->
<templates xml:space="preserve">

    <t t-name="shopify_connector_core.Dashboard">
        <div class="o_sc_dashboard" t-att-dir="direction">
            <div class="o_sc_dashboard__inner">

                <!-- ============ LOADING ============ -->
                <t t-if="state.status === 'loading'">
                    <div class="sc-skeleton sc-skeleton--band" aria-hidden="true"/>
                    <div class="sc-skeleton sc-skeleton--line" aria-hidden="true"/>
                    <p role="status">Loading your dashboard…</p>
                </t>

                <!-- ============ ERROR ============ -->
                <t t-elif="state.status === 'error'">
                    <div class="sc-band sc-band--danger" role="alert">
                        <i class="fa fa-exclamation-triangle sc-band__icon" aria-hidden="true"/>
                        <div class="sc-band__body">
                            <div class="sc-band__text">We couldn't load the dashboard</div>
                            <div class="sc-band__hint" t-esc="state.errorMessage"/>
                        </div>
                    </div>
                    <div>
                        <button class="sc-btn" t-on-click="() => this.refresh()">
                            <i class="fa fa-rotate-right" aria-hidden="true"/>
                            <span>Try again</span>
                        </button>
                    </div>
                </t>

                <!-- ============ READY ============ -->
                <t t-else="">
                    <t t-set="data" t-value="state.data"/>

                    <!-- first-run / empty (S1 entry preserved verbatim) -->
                    <t t-if="data.health.state === 'empty'">
                        <div t-att-class="bandClass(data.health.lead.severity)" aria-live="polite">
                            <i class="fa sc-band__icon" t-att-class="data.health.lead.icon" aria-hidden="true"/>
                            <div class="sc-band__body">
                                <div class="sc-band__text" t-esc="data.health.lead.text"/>
                                <div class="sc-band__hint" t-esc="data.health.lead.hint"/>
                            </div>
                        </div>
                        <div class="sc-empty">
                            <div class="sc-section__title">Get started</div>
                            <p>Connect your Shopify store to begin syncing. Here's what happens next:</p>
                            <ol class="sc-empty__steps">
                                <li>Add your store and its Shopify credential.</li>
                                <li>Run a test connection and a readiness check.</li>
                                <li>Activate the store — syncing and this dashboard come to life.</li>
                            </ol>
                            <!-- S1 entry route 1 of 3. The guided setup walks
                                 these three lines rather than leaving an
                                 operator to find the pieces. -->
                            <div t-if="data.setup_available" class="sc-empty__action">
                                <button class="sc-btn sc_dashboard_setup"
                                        t-on-click="() => this.openSetup()">
                                    <i class="fa fa-magic" aria-hidden="true"/>
                                    <span>Set up your store</span>
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- ============ STORE 360 ============ -->
                    <t t-else="">

                        <!-- Header: filters + the two DISTINCT timestamps -->
                        <header class="sc360-header">
                            <div class="sc360-header__row">
                                <div>
                                    <p class="sc360-eyebrow">Overview</p>
                                    <h1 class="sc360-title" t-esc="storeHeading(data.meta)"/>
                                </div>
                                <div class="sc360-filters">
                                    <label class="sc360-filter" t-if="data.meta.stores.length &gt; 1">
                                        <span class="sc360-filter__label">Store</span>
                                        <select class="sc360-store-select"
                                                t-on-change="onStoreChange">
                                            <option value="" t-att-selected="!state.storeId ? 'selected' : undefined">All stores</option>
                                            <t t-foreach="data.meta.stores" t-as="candidate" t-key="candidate.id">
                                                <option t-att-value="candidate.id"
                                                        t-att-selected="state.storeId === candidate.id ? 'selected' : undefined"
                                                        t-esc="candidate.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <div class="sc360-period" role="group" aria-label="Reporting period">
                                        <t t-foreach="data.meta.periods" t-as="periodKey" t-key="periodKey">
                                            <button t-att-class="'sc-btn sc360-period__btn' + (state.period === periodKey ? ' sc360-period__btn--active' : '')"
                                                    t-att-aria-pressed="state.period === periodKey ? 'true' : 'false'"
                                                    t-on-click="() => this.setPeriod(periodKey)">
                                                <t t-esc="periodLabel(periodKey)"/>
                                            </button>
                                        </t>
                                    </div>
                                    <button class="sc-btn sc360-refresh" t-on-click="() => this.refresh()">
                                        <i class="fa fa-rotate-right" aria-hidden="true"/>
                                        <span>Refresh</span>
                                    </button>
                                </div>
                            </div>
                            <div class="sc360-timestamps">
                                <span class="sc360-ts sc360-ts-page">
                                    Page updated <bdi t-esc="formatInstant(data.generated_at)"/>
                                </span>
                                <span class="sc360-ts sc360-ts-source" t-if="data.bridge and data.bridge.available">
                                    Shopify order data synchronized through
                                    <bdi t-esc="formatInstant(data.bridge.synced_through)"/>
                                </span>
                            </div>
                        </header>

                        <!-- B1: critical status band -->
                        <t t-if="data.critical and data.critical.active">
                            <div t-att-class="bandClass(data.critical.severity) + ' sc360-critical'"
                                 role="alert">
                                <i class="fa sc-band__icon"
                                   t-att-class="data.critical.severity === 'danger' ? 'fa-exclamation-triangle' : 'fa-clock-o'"
                                   aria-hidden="true"/>
                                <div class="sc-band__body">
                                    <div class="sc-band__text" t-esc="data.critical.title"/>
                                    <t t-foreach="data.critical.causes" t-as="cause" t-key="cause.id">
                                        <div class="sc360-critical__cause">
                                            <span class="sc-band__hint" t-esc="cause.text"/>
                                            <button class="sc-btn sc-btn--inverse"
                                                    t-on-click="() => this.openTarget(cause.target)">
                                                <span t-esc="cause.action_label"/>
                                            </button>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Region 1: lead answer band (health severity model) -->
                        <div t-if="!data.critical or !data.critical.active"
                             t-att-class="bandClass(data.health.lead.severity)" aria-live="polite">
                            <i class="fa sc-band__icon" t-att-class="data.health.lead.icon" aria-hidden="true"/>
                            <div class="sc-band__body">
                                <div class="sc-band__text" t-esc="data.health.lead.text"/>
                                <div class="sc-band__hint" t-esc="data.health.lead.hint"/>
                            </div>
                        </div>

                        <!-- Commercial: C1–C4 + C∆ -->
                        <section class="sc360-section sc360-commercial" aria-label="Imported Shopify sales">
                            <h2 class="sc-section__title">Imported Shopify sales
                                <span class="sc360-scope-note">stored in Odoo · <t t-esc="periodLabel(state.period)"/></span>
                            </h2>
                            <t t-if="!data.commercial.available">
                                <div class="sc360-no-permission" role="note" t-if="data.commercial.reason === 'no_permission'">
                                    Your role can't read sales amounts — connector health is unaffected.
                                </div>
                            </t>
                            <t t-else="">
                                <t t-set="primary" t-value="data.commercial.blocks.length ? data.commercial.blocks[0] : false"/>
                                <div class="sc360-kpis">
                                    <div class="sc360-kpi" t-att-data-kpi="'sales'">
                                        <div class="sc360-kpi__label">Imported Shopify sales</div>
                                        <t t-if="primary">
                                            <div class="sc360-kpi__value">
                                                <bdi t-esc="formatMoney(primary.currency, primary.sales)"/>
                                            </div>
                                            <t t-set="delta" t-value="deltaInfo(primary.sales, primary.previous.sales)"/>
                                            <div t-att-class="'sc360-kpi__delta' + (delta.available ? ' sc360-kpi__delta--' + delta.tone : '')">
                                                <bdi t-esc="delta.text"/> <span class="sc360-kpi__delta-caption">vs previous period</span>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="sc360-kpi__value">—</div>
                                            <div class="sc360-kpi__delta">No sales in this period</div>
                                        </t>
                                    </div>
                                    <button t-if="data.commercial.orders_total &gt; 0"
                                            class="sc360-kpi sc360-kpi--action" t-att-data-kpi="'orders'"
                                            t-on-click="() => this.openTarget(data.commercial.orders_target)">
                                        <div class="sc360-kpi__label">Imported orders</div>
                                        <div class="sc360-kpi__value"><bdi t-esc="formatNumber(data.commercial.orders_total)"/></div>
                                        <t t-if="primary">
                                            <t t-set="delta" t-value="deltaInfo(primary.orders, primary.previous.orders)"/>
                                            <div t-att-class="'sc360-kpi__delta' + (delta.available ? ' sc360-kpi__delta--' + delta.tone : '')">
                                                <bdi t-esc="delta.text"/> <span class="sc360-kpi__delta-caption">vs previous period</span>
                                            </div>
                                        </t>
                                        <div class="sc360-kpi__hint">Open the orders</div>
                                    </button>
                                    <div t-else="" class="sc360-kpi sc360-kpi--empty" t-att-data-kpi="'orders'">
                                        <div class="sc360-kpi__label">Imported orders</div>
                                        <div class="sc360-kpi__value">0</div>
                                        <div class="sc360-kpi__delta">No imported orders in this period</div>
                                    </div>
                                    <div class="sc360-kpi" t-att-data-kpi="'aov'">
                                        <div class="sc360-kpi__label">Average imported order value</div>
                                        <div class="sc360-kpi__value">
                                            <bdi t-esc="primary ? formatMoney(primary.currency, primary.aov) : '—'"/>
                                        </div>
                                        <t t-if="primary and primary.previous.aov">
                                            <t t-set="delta" t-value="deltaInfo(primary.aov, primary.previous.aov)"/>
                                            <div t-att-class="'sc360-kpi__delta' + (delta.available ? ' sc360-kpi__delta--' + delta.tone : '')">
                                                <bdi t-esc="delta.text"/> <span class="sc360-kpi__delta-caption">vs previous period</span>
                                            </div>
                                        </t>
                                    </div>
                                    <button t-if="data.commercial.units &gt; 0"
                                            class="sc360-kpi sc360-kpi--action" t-att-data-kpi="'units'"
                                            t-on-click="() => this.openTarget(data.commercial.units_target)">
                                        <div class="sc360-kpi__label">Units sold (imported)</div>
                                        <div class="sc360-kpi__value"><bdi t-esc="formatNumber(data.commercial.units)"/></div>
                                        <t t-set="delta" t-value="deltaInfo(data.commercial.units, data.commercial.previous_units)"/>
                                        <div t-att-class="'sc360-kpi__delta' + (delta.available ? ' sc360-kpi__delta--' + delta.tone : '')">
                                            <bdi t-esc="delta.text"/> <span class="sc360-kpi__delta-caption">vs previous period</span>
                                        </div>
                                        <div class="sc360-kpi__hint">Open the order lines</div>
                                    </button>
                                    <div t-else="" class="sc360-kpi sc360-kpi--empty" t-att-data-kpi="'units'">
                                        <div class="sc360-kpi__label">Units sold (imported)</div>
                                        <div class="sc360-kpi__value">0</div>
                                        <div class="sc360-kpi__delta">No imported units in this period</div>
                                    </div>
                                </div>
                                <div class="sc360-currency-note" t-if="data.commercial.blocks.length &gt; 1">
                                    Multiple currencies in this scope — figures are shown per currency, never combined:
                                    <ul class="sc360-currency-list">
                                        <t t-foreach="data.commercial.blocks" t-as="block" t-key="block.currency.id">
                                            <li>
                                                <bdi t-esc="formatMoney(block.currency, block.sales)"/> ·
                                                <t t-esc="formatNumber(block.orders)"/> orders
                                                (<t t-esc="block.currency.name"/>)
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </t>
                        </section>

                        <!-- Bridge: completeness / freshness -->
                        <t t-if="data.bridge and data.bridge.available">
                            <section t-att-class="bridgeClass(data.bridge.state)" aria-label="Data completeness">
                                <div class="sc-bridge__dot" aria-hidden="true"/>
                                <div class="sc-bridge__body">
                                    <span class="sc-bridge__state" t-esc="bridgeLabel(data.bridge.state)"/>
                                    <span class="sc-bridge__text" t-esc="data.bridge.text"/>
                                    <span class="sc-bridge__meta">
                                        <t t-if="data.bridge.g2 &gt; 0">
                                            <button class="sc-link" t-on-click="() => this.openTarget(data.bridge.g2_target)">
                                                <t t-esc="data.bridge.g2"/> awaiting import
                                            </button>
                                        </t>
                                        <t t-if="data.bridge.g3 &gt; 0">
                                            <button class="sc-link sc-link--danger" t-on-click="() => this.openTarget(data.bridge.g3_target)">
                                                <t t-esc="data.bridge.g3"/> needing attention
                                            </button>
                                        </t>
                                    </span>
                                </div>
                            </section>
                        </t>

                        <!-- D1: sales trend + accessible table -->
                        <t t-if="data.commercial.available and data.commercial.trend and data.commercial.trend.available">
                            <section class="sc360-section sc360-trend" aria-label="Sales trend">
                                <h2 class="sc-section__title">Sales trend
                                    <span class="sc360-scope-note">buckets in <t t-esc="data.commercial.trend.tz"/> time</span>
                                </h2>
                                <div class="sc360-chart" role="img"
                                     t-att-aria-label="'Sales trend for ' + periodLabel(state.period)">
                                    <t t-foreach="data.commercial.trend.buckets" t-as="bucket" t-key="bucket_index">
                                        <div class="sc360-chart__col">
                                            <div class="sc360-chart__prev" t-att-style="barHeight(bucket.previous, trendMax)" aria-hidden="true"/>
                                            <div class="sc360-chart__bar" t-att-style="barHeight(bucket.value, trendMax)" aria-hidden="true"/>
                                        </div>
                                    </t>
                                </div>
                                <!-- Axis endpoints as ordinary HTML text (≥ the caption
                                     size at every width — no sub-11px SVG type exists on
                                     this chart; exact values live in the table below). -->
                                <div class="sc360-chart__axis" aria-hidden="true">
                                    <span t-esc="data.commercial.trend.buckets.length ? data.commercial.trend.buckets[0].label : ''"/>
                                    <span t-esc="data.commercial.trend.buckets.length ? data.commercial.trend.buckets[data.commercial.trend.buckets.length - 1].label : ''"/>
                                </div>
                                <div class="sc360-chart__legend">
                                    <span class="sc360-legend__item"><span class="sc360-legend__swatch sc360-legend__swatch--bar" aria-hidden="true"/> This period</span>
                                    <span class="sc360-legend__item"><span class="sc360-legend__swatch sc360-legend__swatch--prev" aria-hidden="true"/> Previous period</span>
                                </div>
                                <details class="sc360-chart-table">
                                    <summary>Data table for this chart</summary>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th scope="col">Bucket</th>
                                                <th scope="col">Sales</th>
                                                <th scope="col">Orders</th>
                                                <th scope="col">Previous period</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="data.commercial.trend.buckets" t-as="bucket" t-key="bucket_index">
                                                <tr>
                                                    <th scope="row" t-esc="bucket.label"/>
                                                    <td><bdi t-esc="formatMoney(data.commercial.trend.currency, bucket.value)"/></td>
                                                    <td t-esc="formatNumber(bucket.orders)"/>
                                                    <td><bdi t-esc="formatMoney(data.commercial.trend.currency, bucket.previous)"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </details>
                            </section>
                        </t>

                        <!-- E1/E2: top products -->
                        <t t-if="data.commercial.available and data.commercial.products and data.commercial.products.available">
                            <section class="sc360-section sc360-products" aria-label="Top products">
                                <h2 class="sc-section__title">Top products</h2>
                                <table class="sc360-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Product</th>
                                            <th scope="col" class="sc360-table__num">Value</th>
                                            <th scope="col" class="sc360-table__num">Units</th>
                                            <th scope="col" class="sc360-table__num">Share of goods subtotal</th>
                                            <th scope="col"><span class="sc-visually-hidden">Open</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="data.commercial.products.rows" t-as="row" t-key="row.product_id">
                                            <tr>
                                                <th scope="row" t-esc="row.name"/>
                                                <td class="sc360-table__num"><bdi t-esc="formatMoney(data.commercial.products.currency, row.value)"/></td>
                                                <td class="sc360-table__num"><bdi t-esc="formatNumber(row.units)"/></td>
                                                <td class="sc360-table__num">
                                                    <bdi t-esc="formatShare(row.share)"/>
                                                </td>
                                                <td>
                                                    <button class="sc-btn sc-btn--small" t-on-click="() => this.openTarget(row.target)">
                                                        <span>Lines</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <p class="sc360-basis-note">Share basis: total eligible goods subtotal
                                    (<bdi t-esc="formatMoney(data.commercial.products.currency, data.commercial.products.goods_subtotal_total)"/>),
                                    excluding taxes and shipping.</p>
                            </section>
                        </t>

                        <!-- Order lifecycle: payment / COD / fulfillment / dispatch -->
                        <t t-if="data.lifecycle">
                            <section class="sc360-section sc360-lifecycle" aria-label="Order lifecycle">
                                <h2 class="sc-section__title">Order lifecycle</h2>
                                <t t-if="!data.lifecycle.available">
                                    <div class="sc360-no-permission" role="note" t-if="data.lifecycle.reason === 'no_permission'">
                                        Your role can't read order lifecycle details — connector health is unaffected.
                                    </div>
                                </t>
                                <t t-else="">
                                    <div t-if="data.commercial and data.commercial.available and data.commercial.orders_total === 0"
                                         class="sc360-inline-empty" role="status">
                                        No imported orders are available to classify yet. Lifecycle
                                        stages will appear after the first successful order import.
                                    </div>
                                    <div t-else="" class="sc360-strips">
                                        <div class="sc360-strip" data-strip="payment">
                                            <h3 class="sc360-strip__title">Payment
                                                <span class="sc360-scope-note">Shopify status observed through
                                                    <bdi t-esc="formatInstant(data.lifecycle.evidence_refreshed_oldest)"/></span>
                                            </h3>
                                            <div class="sc360-strip__items">
                                                <t t-foreach="data.lifecycle.payment.buckets" t-as="bucket" t-key="bucket.id">
                                                    <button class="sc360-count"
                                                            t-att-disabled="bucket.count &lt;= 0"
                                                            t-on-click="() => this.openTarget(bucket.target)">
                                                        <span class="sc360-count__value" t-esc="formatNumber(bucket.count)"/>
                                                        <span class="sc360-count__label" t-esc="bucket.label"/>
                                                    </button>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="sc360-strip" data-strip="cod" t-if="data.lifecycle.cod.total &gt; 0">
                                            <h3 class="sc360-strip__title">Cash on delivery</h3>
                                            <div class="sc360-strip__items">
                                                <button class="sc360-count"
                                                        t-att-disabled="data.lifecycle.cod.approval_pending &lt;= 0"
                                                        t-on-click="() => this.openTarget(data.lifecycle.cod.approval_pending_target)">
                                                    <span class="sc360-count__value" t-esc="formatNumber(data.lifecycle.cod.approval_pending)"/>
                                                    <span class="sc360-count__label">Awaiting approval</span>
                                                </button>
                                                <button class="sc360-count"
                                                        t-att-disabled="data.lifecycle.cod.quotation &lt;= 0"
                                                        t-on-click="() => this.openTarget(data.lifecycle.cod.quotation_target)">
                                                    <span class="sc360-count__value" t-esc="formatNumber(data.lifecycle.cod.quotation)"/>
                                                    <span class="sc360-count__label">Quotation</span>
                                                </button>
                                                <button class="sc360-count"
                                                        t-att-disabled="data.lifecycle.cod.confirmed &lt;= 0"
                                                        t-on-click="() => this.openTarget(data.lifecycle.cod.confirmed_target)">
                                                    <span class="sc360-count__value" t-esc="formatNumber(data.lifecycle.cod.confirmed)"/>
                                                    <span class="sc360-count__label">Confirmed</span>
                                                </button>
                                                <t t-foreach="data.lifecycle.cod.collection" t-as="bucket" t-key="bucket.id">
                                                    <button class="sc360-count"
                                                            t-att-disabled="bucket.count &lt;= 0"
                                                            t-on-click="() => this.openTarget(bucket.target)">
                                                        <span class="sc360-count__value" t-esc="formatNumber(bucket.count)"/>
                                                        <span class="sc360-count__label" t-esc="bucket.label"/>
                                                    </button>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="sc360-strip" data-strip="fulfillment">
                                            <h3 class="sc360-strip__title">Shopify fulfillment
                                                <span class="sc360-scope-note">snapshot at import + evidence refresh — not a live carrier feed</span>
                                            </h3>
                                            <div class="sc360-strip__items">
                                                <t t-foreach="data.lifecycle.fulfillment_progress.buckets" t-as="bucket" t-key="bucket.id">
                                                    <button class="sc360-count"
                                                            t-att-disabled="bucket.count &lt;= 0"
                                                            t-on-click="() => this.openTarget(bucket.target)">
                                                        <span class="sc360-count__value" t-esc="formatNumber(bucket.count)"/>
                                                        <span class="sc360-count__label" t-esc="bucket.label"/>
                                                    </button>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="sc360-strip" data-strip="dispatch" t-if="data.dispatch">
                                            <h3 class="sc360-strip__title">Odoo warehouse dispatch
                                                <span class="sc360-scope-note" t-if="data.dispatch.available" t-esc="data.dispatch.scope_note"/>
                                            </h3>
                                            <t t-if="!data.dispatch.available">
                                                <div class="sc360-no-permission" role="note">
                                                    Your role can't read delivery orders.
                                                </div>
                                            </t>
                                            <div class="sc360-strip__items" t-else="">
                                                <t t-foreach="data.dispatch.buckets" t-as="bucket" t-key="bucket.id">
                                                    <button class="sc360-count"
                                                            t-att-disabled="bucket.count &lt;= 0"
                                                            t-on-click="() => this.openTarget(bucket.target)">
                                                        <span class="sc360-count__value" t-esc="formatNumber(bucket.count)"/>
                                                        <span class="sc360-count__label" t-esc="bucket.label"/>
                                                    </button>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="sc360-oldest" t-if="data.lifecycle.oldest_paid_unfulfilled">
                                        Oldest paid, unfulfilled order:
                                        <bdi t-esc="data.lifecycle.oldest_paid_unfulfilled.age_relative"/>
                                        <button class="sc-link" t-on-click="() => this.openTarget(data.lifecycle.oldest_paid_unfulfilled.target)">
                                            open the orders
                                        </button>
                                    </p>
                                    <t t-if="data.lifecycle.exceptions.length">
                                        <div class="sc360-lifecycle-exceptions">
                                            <h3 class="sc360-strip__title">Lifecycle exceptions</h3>
                                            <t t-foreach="data.lifecycle.exceptions" t-as="exc" t-key="exc.id">
                                                <div t-att-class="exceptionClass(exc.severity)">
                                                    <div class="sc-exception__main">
                                                        <span class="sc-owner-chip" t-esc="exc.owner"/>
                                                        <span class="sc-exception__title" t-esc="exc.title"/>
                                                        <span class="sc-exception__count" t-esc="formatNumber(exc.count)"/>
                                                        <div class="sc-exception__why" t-esc="exc.why"/>
                                                    </div>
                                                    <button class="sc-btn" t-on-click="() => this.openTarget(exc.target)">
                                                        <span>Review</span>
                                                    </button>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                            </section>
                        </t>

                        <!-- Connector health -->
                        <section class="sc360-section sc360-health" aria-label="Connector health">
                            <h2 class="sc-section__title">Connector health</h2>
                            <t t-if="data.health.exceptions.length">
                                <t t-foreach="data.health.exceptions" t-as="exc" t-key="exc.id">
                                    <div t-att-class="exceptionClass(exc.severity)">
                                        <div class="sc-exception__main">
                                            <span class="sc-owner-chip" t-esc="exc.owner"/>
                                            <span class="sc-exception__title" t-esc="exc.title"/>
                                            <span class="sc-exception__count" t-esc="formatNumber(exc.count)"/>
                                            <div class="sc-exception__why" t-esc="exc.why"/>
                                        </div>
                                        <button class="sc-btn" t-on-click="() => this.openException(exc)">
                                            <span>Review</span>
                                        </button>
                                    </div>
                                </t>
                            </t>
                            <t t-elif="!data.critical or !data.critical.active">
                                <div class="sc-affirm">All clear — nothing needs your attention right now.</div>
                            </t>
                            <t t-else="">
                                <div class="sc-status-note">
                                    Job processing is clear. Data freshness still needs attention above.
                                </div>
                            </t>

                            <table class="sc360-table sc360-flows">
                                <caption class="sc-visually-hidden">Flow health by domain</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Flow</th>
                                        <th scope="col" class="sc360-table__num">Backlog</th>
                                        <th scope="col" class="sc360-table__num">Failures</th>
                                        <th scope="col">Last success</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data.flows" t-as="flow" t-key="flow.id">
                                        <tr t-att-data-flow="flow.id">
                                            <th scope="row" t-esc="flow.label"/>
                                            <td class="sc360-table__num" t-esc="formatNumber(flow.backlog)"/>
                                            <td t-att-class="'sc360-table__num' + (flow.failures ? ' sc360-table__num--danger' : '')"
                                                t-esc="formatNumber(flow.failures)"/>
                                            <td>
                                                <t t-if="flow.last_success_relative">
                                                    <bdi t-esc="flow.last_success_relative"/>
                                                </t>
                                                <t t-else="">No activity yet</t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="sc360-week" t-if="data.health.week">
                                Last 7 days: <bdi t-esc="formatNumber(data.health.week.succeeded)"/> succeeded,
                                <bdi t-esc="formatNumber(data.health.week.failed)"/> failed.
                                <t t-if="data.health.oldest_waiting">
                                    Oldest waiting item: <bdi t-esc="data.health.oldest_waiting"/>.
                                </t>
                            </div>

                            <section class="sc360-activity" aria-label="Recent activity" t-if="data.health.activity.length">
                                <h3 class="sc360-strip__title">Recent activity</h3>
                                <ul class="sc-activity">
                                    <t t-foreach="data.health.activity" t-as="act" t-key="act.id">
                                        <li class="sc-activity__item">
                                            <span t-att-class="badgeClass(act.tone)" t-esc="act.state_label"/>
                                            <span class="sc-activity__label" t-esc="act.job_label"/>
                                            <span class="sc-activity__meta">
                                                <t t-esc="act.source_label"/>
                                                <t t-if="act.store"> · <t t-esc="act.store"/></t>
                                                · <bdi t-esc="act.relative"/>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                            </section>
                        </section>

                        <!-- H1: multi-store table -->
                        <t t-if="data.stores_region.available">
                            <section class="sc360-section sc360-stores" aria-label="Stores">
                                <h2 class="sc-section__title">Stores</h2>
                                <table class="sc360-table sc360-stores-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Store</th>
                                            <th scope="col">Status</th>
                                            <th scope="col" class="sc360-table__num">Sales (period)</th>
                                            <th scope="col" class="sc360-table__num">Backlog</th>
                                            <th scope="col" class="sc360-table__num">Attention</th>
                                            <th scope="col">Last activity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="data.stores_region.rows" t-as="row" t-key="row.id">
                                            <tr t-att-data-store="row.id">
                                                <th scope="row" t-esc="row.name"/>
                                                <td t-esc="storeStateLabel(row.state)"/>
                                                <td class="sc360-table__num">
                                                    <t t-if="row.sales and row.sales.available">
                                                        <t t-if="row.sales.blocks.length">
                                                            <t t-foreach="row.sales.blocks" t-as="block" t-key="block.currency.id">
                                                                <div><bdi t-esc="formatMoney(block.currency, block.sales)"/></div>
                                                            </t>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </t>
                                                    <t t-else="">n/a</t>
                                                </td>
                                                <td class="sc360-table__num" t-esc="formatNumber(row.backlog)"/>
                                                <td t-att-class="'sc360-table__num' + (row.attention ? ' sc360-table__num--danger' : '')"
                                                    t-esc="formatNumber(row.attention)"/>
                                                <td>
                                                    <t t-if="row.last_activity_relative"><bdi t-esc="row.last_activity_relative"/></t>
                                                    <t t-else="">—</t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </section>
                        </t>

                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
