<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Part of the Shopify Connector (S1 guided setup).

    One decision per step. Every status carries text, never colour alone. Every
    control is a real focusable element with a visible focus ring, and the step
    heading is focusable so focus can land on it after each advance.

    EVERY BRANCH COMPARES A STEP KEY, NEVER A POSITION. `state.stepKey === 'credential'`
    reads as what it is; `state.step === 3` reads as nothing and silently means
    something different the moment a step is inserted â€” which Wave 5 did. The
    ordinal in the heading comes from the server's own ordered step list.

    No decoration on the credential or readiness steps: those are the two
    moments an operator most needs to read carefully, and an animation there
    would be a distraction dressed as delight.
-->
<templates xml:space="preserve">

    <t t-name="shopify_connector_core.SetupWizard">
        <div class="o_sc_setup" t-att-dir="direction"
             t-att-data-store-id="store.id || 'new'">
            <div class="o_sc_setup__inner">

                <!-- ============ LOADING ============ -->
                <t t-if="state.status === 'loading'">
                    <div class="sc-skeleton sc-skeleton--band" aria-hidden="true"/>
                    <p role="status">Loading setupâ€¦</p>
                </t>

                <!-- ============ ERROR ============ -->
                <t t-elif="state.status === 'error'">
                    <div class="sc-band sc-band--danger" role="alert">
                        <i class="fa fa-exclamation-triangle sc-band__icon" aria-hidden="true"/>
                        <div class="sc-band__body">
                            <div class="sc-band__text">Setup could not be loaded</div>
                            <div class="sc-band__hint" t-esc="state.errorMessage"/>
                        </div>
                    </div>
                </t>

                <!-- ============ READY ============ -->
                <t t-else="">

                    <!-- Five merchant phases over the unchanged twelve durable
                         step keys. Both levels keep text labels, so neither
                         progress nor completion is conveyed by colour alone. -->
                    <nav class="sc_setup__steps" aria-label="Setup steps">
                        <ol>
                            <t t-foreach="phases" t-as="phase" t-key="phase.key">
                                <li t-att-class="phaseClass(phase)"
                                    t-att-aria-current="phase.key === currentPhase.key ? 'step' : false">
                                    <div class="sc_setup_phase__heading">
                                        <span class="sc_setup_phase__index" t-esc="phase.index"/>
                                        <span class="sc_setup_phase__label" t-esc="phase.label"/>
                                    </div>
                                    <ol class="sc_setup_phase__steps">
                                        <t t-foreach="phaseSteps(phase)" t-as="step" t-key="step.key">
                                            <li t-att-class="stepClass(step)"
                                                t-att-data-step-key="step.key"
                                                t-att-aria-current="step.key === state.stepKey ? 'step' : false">
                                                <span class="sc_setup_step__index" t-esc="step.index"/>
                                                <span class="sc_setup_step__label" t-esc="step.label"/>
                                                <span t-if="step.applicable === false"
                                                      class="sc-badge sc-badge--neutral">Not required</span>
                                            </li>
                                        </t>
                                    </ol>
                                </li>
                            </t>
                        </ol>
                    </nav>

                    <div class="sc_setup__workspace">
                    <!-- The panel is the owned scrolling region. The action
                         row is a separate grid row, so it remains reachable
                         without ever covering a field. -->
                    <section class="sc_setup__panel" aria-live="polite" t-ref="panel">
                        <div t-if="state.data and state.data.stores.length and store.id"
                             class="sc_setup__store_actions"
                             role="group" aria-label="Store setup options">
                            <button class="sc-btn sc-btn--secondary sc_setup_new_store"
                                    t-att-disabled="state.busy"
                                    t-on-click="() => this.startNewStore()">
                                Set up another store
                            </button>
                        </div>
                        <h1 class="sc_setup__heading" tabindex="-1" t-ref="heading">
                            <span class="sc_setup__heading-count">
                                Phase <t t-esc="currentPhase.index"/> of <t t-esc="state.data.phase_count"/>
                                Â· Step <t t-esc="currentStep.index"/> of <t t-esc="state.data.step_count"/>
                            </span>
                            <span t-esc="currentStep.label"/>
                        </h1>

                        <!-- A refusal the server made. Never swallowed, never
                             turned into a silent no-op. -->
                        <div t-if="state.errorMessage"
                             class="sc-band sc-band--danger sc_setup__error"
                             role="alert" id="sc_setup_error">
                            <i class="fa fa-exclamation-triangle sc-band__icon" aria-hidden="true"/>
                            <div class="sc-band__body">
                                <div class="sc-band__text" t-esc="state.errorMessage"/>
                            </div>
                        </div>

                        <!-- Optional domain hand-off state.  Core-only setup
                             keeps this empty; an installed domain addon may
                             defer completion to a durable post-activation
                             proof without making the connector look ready. -->
                        <div t-if="store.setup_completion_state === 'pending'"
                             class="sc-band sc-band--info sc_setup__completion_pending"
                             role="status">
                            <i class="fa fa-clock-o sc-band__icon" aria-hidden="true"/>
                            <div class="sc-band__body">
                                <div class="sc-band__text">Setup is waiting for verification</div>
                                <div class="sc-band__hint" t-esc="store.setup_completion_message"/>
                                <div t-if="state.activationFollowStillRunning"
                                     class="sc-band__hint">
                                    Verification is continuing safely in the background.
                                    Use Check status below; you do not need to restart setup.
                                </div>
                            </div>
                        </div>
                        <div t-if="store.setup_completion_state === 'action_required'"
                             class="sc-band sc-band--warning sc_setup__completion_action"
                             role="alert">
                            <i class="fa fa-exclamation-triangle sc-band__icon" aria-hidden="true"/>
                            <div class="sc-band__body">
                                <div class="sc-band__text">Setup needs an operator action</div>
                                <div class="sc-band__hint" t-esc="store.setup_completion_message"/>
                                <button t-if="store.setup_completion_action_xmlid"
                                        type="button"
                                        class="btn btn-sm btn-outline-primary mt-2 sc_setup__completion_action_button"
                                        t-on-click="openSetupCompletionAction">
                                    <t t-esc="store.setup_completion_action_label"/>
                                </button>
                            </div>
                        </div>

                        <!-- ===== welcome ===== -->
                        <t t-if="state.stepKey === 'welcome'">
                            <p class="sc_setup__lead">
                                This connects one Shopify store to this Odoo database. It
                                takes about ten minutes, and <strong>nothing synchronizes
                                and nothing is written to Shopify until you finish and
                                say so</strong>.
                            </p>
                            <h2 class="sc_setup__subheading">What you'll need</h2>
                            <ul class="sc_setup__list">
                                <li>Admin access to your Shopify organization, so you can create an app for this store in the Dev Dashboard and copy its Client ID and Client secret â€” or an Admin API access token you already hold from an app created the older way. Either path works; the credential step explains both.</li>
                                <li>About ten minutes. You can stop at any point and pick up where you left off.</li>
                            </ul>
                            <div class="sc-band sc-band--info" role="note">
                                <i class="fa fa-info-circle sc-band__icon" aria-hidden="true"/>
                                <div class="sc-band__body">
                                    <div class="sc-band__text">This connector needs Odoo.sh or on-premise hosting</div>
                                    <div class="sc-band__hint">
                                        Odoo Online (SaaS) cannot run it, because the connector
                                        needs background workers and outbound calls that Odoo
                                        Online does not provide. Better to know now than at the
                                        last step.
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- ===== identity ===== -->
                        <t t-if="state.stepKey === 'identity'">
                            <p class="sc_setup__lead">
                                Name this store so you recognise it later, and point it at
                                the right Shopify shop.
                            </p>
                            <div class="sc_setup__field">
                                <label for="sc_setup_name">Store name</label>
                                <input id="sc_setup_name" type="text" class="o_input"
                                       t-model="state.form.name"
                                       aria-describedby="sc_setup_name_help"/>
                                <small id="sc_setup_name_help">
                                    Anything you'll recognise â€” "Main storefront", "EU shop".
                                </small>
                            </div>
                            <div class="sc_setup__field">
                                <label for="sc_setup_domain">Shopify domain</label>
                                <input id="sc_setup_domain" type="text" class="o_input"
                                       t-model="state.form.shopDomain"
                                       placeholder="acme-supplies.myshopify.com"
                                       aria-describedby="sc_setup_domain_help"/>
                                <small id="sc_setup_domain_help">
                                    Your store's permanent address, ending in .myshopify.com.
                                    Find it in Shopify under Settings â†’ Domains. We confirm it
                                    against Shopify at the readiness step â€” we don't take it on
                                    trust here.
                                </small>
                            </div>
                            <p class="sc_setup__note">
                                One Shopify store per setup. Connecting a second shop means a
                                second store here.
                            </p>
                        </t>

                        <!-- ===== credential ===== -->
                        <t t-if="state.stepKey === 'credential'">
                            <p class="sc_setup__lead">
                                Choose how this store authenticates with Shopify, then
                                enter that path's credentials. If a credential is already
                                on record, leave the fields blank to keep it.
                            </p>
                            <!--
                                TWO REAL PATHS, STATED AS WHAT THE MERCHANT HAS.

                                Shopify's current app-creation flow (the Dev
                                Dashboard) does not show a permanent Admin API
                                token to copy: the app exchanges its Client ID
                                and Client secret for a 24-hour token, and the
                                connector does that exchange and renewal itself.
                                A merchant who created their app the older way,
                                or was handed a long-lived token, still has that
                                token and it still works. The chooser asks which
                                of those two things the merchant actually holds,
                                because no error message downstream can tell
                                them which one they should have pasted.
