<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_connector_store_settings_v2_migration"
            model="ir.ui.view">
        <field name="name">shopify.connector.store.settings.v2.migration</field>
        <field name="model">shopify.connector.store.settings</field>
        <field name="inherit_id"
               ref="view_shopify_connector_store_settings_canonical_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="V2 Migration" name="v2_migration"
                      groups="shopify_connector_core.group_shopify_connector_admin">
                    <group>
                        <field name="v2_ui_mode" readonly="1"/>
                        <field name="v2_gateway_mode" readonly="1"/>
                        <field name="v2_runtime_mode" readonly="1"/>
                        <field name="configuration_generation" readonly="1"/>
                    </group>
                    <div class="text-muted" role="note">
                        These audited coexistence controls are changed through
                        the connector migration action, never by editing this
                        record directly. They do not weaken safety checks.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_shopify_connector_run_search" model="ir.ui.view">
        <field name="name">shopify.connector.run.search</field>
        <field name="model">shopify.connector.run</field>
        <field name="arch" type="xml">
            <search string="Connector Runs">
                <field name="name"/>
                <field name="store_id"/>
                <field name="workflow"/>
                <field name="operation"/>
                <field name="state"/>
                <filter name="active" string="Active"
                        domain="[('state', 'not in', ('succeeded', 'partially_succeeded', 'failed_terminal', 'cancelled'))]"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="[('state', 'in', ('failed_retryable', 'blocked_manual_review', 'failed_terminal'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_workflow" string="Workflow" context="{'group_by': 'workflow'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shopify_connector_run_list" model="ir.ui.view">
        <field name="name">shopify.connector.run.list</field>
        <field name="model">shopify.connector.run</field>
        <field name="arch" type="xml">
            <list string="Connector Runs" create="0" edit="0" delete="0"
                  default_order="requested_at desc, id desc"
                  decoration-success="state == 'succeeded'"
                  decoration-warning="state in ('waiting', 'failed_retryable', 'blocked_manual_review')"
                  decoration-danger="state == 'failed_terminal'">
                <field name="name"/>
                <field name="store_id"/>
                <field name="workflow"/>
                <field name="operation"/>
                <field name="trigger"/>
                <field name="state" widget="badge"/>
                <field name="requested_at"/>
                <field name="finished_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_connector_run_form" model="ir.ui.view">
        <field name="name">shopify.connector.run.form</field>
        <field name="model">shopify.connector.run</field>
        <field name="arch" type="xml">
            <form string="Connector Run" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="workflow"/>
                            <field name="operation"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="trigger"/>
                            <field name="actor_uid"/>
                            <field name="requested_at"/>
                            <field name="admitted_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group string="Scope and evidence">
                        <field name="scope_summary"/>
                        <field name="result_summary"/>
                        <field name="correlation_id" groups="shopify_connector_core.group_shopify_connector_admin"/>
                        <field name="expected_connection_generation" groups="shopify_connector_core.group_shopify_connector_admin"/>
                    </group>
                    <group string="Cancellation" invisible="not cancel_requested_at">
                        <field name="cancel_requested_at"/>
                        <field name="cancel_requested_by"/>
                        <field name="cancel_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_run" model="ir.actions.act_window">
        <field name="name">Connector Runs</field>
        <field name="res_model">shopify.connector.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_run_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No V2 connector runs yet.</p>
            <p>Legacy jobs remain available in Runs &amp; Recovery.</p>
        </field>
    </record>

    <record id="view_shopify_connector_job_attempt_list" model="ir.ui.view">
        <field name="name">shopify.connector.job.attempt.list</field>
        <field name="model">shopify.connector.job.attempt</field>
        <field name="arch" type="xml">
            <list string="Execution Attempts" create="0" edit="0" delete="0"
                  default_order="claimed_at desc, id desc"
                  decoration-success="outcome == 'succeeded'"
                  decoration-warning="outcome in ('retry_scheduled', 'verification_required', 'manual_review', 'owner_lost')"
                  decoration-danger="outcome == 'failed_terminal'">
                <field name="job_id"/>
                <field name="run_id" optional="show"/>
                <field name="store_id"/>
                <field name="attempt_no"/>
                <field name="outcome" widget="badge"/>
                <field name="claimed_at"/>
                <field name="finished_at" optional="show"/>
                <field name="actual_cost" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_connector_job_attempt_form" model="ir.ui.view">
        <field name="name">shopify.connector.job.attempt.form</field>
        <field name="model">shopify.connector.job.attempt</field>
        <field name="arch" type="xml">
            <form string="Execution Attempt" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="run_id"/>
                            <field name="store_id"/>
                            <field name="attempt_no"/>
                            <field name="outcome" widget="badge"/>
                        </group>
                        <group>
                            <field name="claimed_at"/>
                            <field name="started_at"/>
                            <field name="heartbeat_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group string="Outcome">
                        <field name="safe_message"/>
                        <field name="error_class"/>
                        <field name="error_code"/>
                        <field name="retry_decision"/>
                        <field name="next_retry_at"/>
                    </group>
                    <group string="Shopify observations"
                           groups="shopify_connector_core.group_shopify_connector_admin">
                        <field name="shopify_request_id"/>
                        <field name="requested_cost"/>
                        <field name="actual_cost"/>
                        <field name="budget_available"/>
                        <field name="throttle_delay_ms"/>
                        <field name="request_digest"/>
                        <field name="response_digest"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_connector_job_attempt" model="ir.actions.act_window">
        <field name="name">Execution Attempts</field>
        <field name="res_model">shopify.connector.job.attempt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
