<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Batch 2 checkpoint 1: the canonical per-store configuration surface.

        Shopify Connector -> Configuration -> Store Settings.

        WHAT THIS IS, AND WHAT IT IS NOT. It is the one place a merchant can
        reach the store-scoped configuration that until now existed only as
        fields nothing rendered &#8212; the sync-domain switches, the product-import
        policies, the whole order-import policy block, and the two scheduled-
        sync flags. It is NOT a second setup wizard: it collects no consent,
        runs no readiness check, drives no lifecycle transition, and creates
        no store. And it is NOT a third settings screen competing with the two
        that already own their own subjects &#8212; Export Settings owns
        `price_source_of_truth`, `media_source_of_truth` and the export domain
        flag; Fulfillment Settings owns the operating mode, its switching
        state and the notification confirmation. Neither is duplicated here.

        FIELD ORDER IS OWNERSHIP, NOT LAYOUT. Everything on this form is
        either a decision an Administrator may take here, or an observation
        rendered `readonly="1"` because its authoritative route is somewhere
        else and saying so on screen is cheaper than a support ticket.
    -->

    <record id="view_shopify_connector_store_settings_canonical_list"
            model="ir.ui.view">
        <!--
            NAME, NOT JUST LABEL. `default_view()` orders by
            `priority,name,id`, and `shopify_connector_product_export`'s
            binding test pins which view an UNBOUND action would fall back to,
            as its proof that binding is load-bearing. A name sorting before
            `...fulfillment.list` would silently become that fallback and
            break another module's evidence about its own action. `store`
            sorts after both existing lists, so the recorded ordering is
            unchanged — and it describes this surface better than internal
            jargon would.
        -->
        <field name="name">shopify.connector.store.settings.store.list</field>
        <field name="model">shopify.connector.store.settings</field>
        <field name="arch" type="xml">
            <!--
                No `editable` attribute, deliberately. An inline-editable list
                would write through the same constraints as the form but
                without the help text and the read-only markers that explain
                which of these are decisions and which are observations, so a
                merchant would be toggling a domain switch with none of the
                context the form gives them.
            -->
            <list string="Sync Rules" create="false" delete="false">
                <field name="store_id"/>
                <field name="company_id" optional="show"/>
                <field name="product_domain_enabled" widget="boolean_toggle"/>
                <field name="sale_domain_enabled" widget="boolean_toggle"/>
                <field name="inventory_domain_enabled" widget="boolean_toggle"/>
                <field name="fulfillment_domain_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_connector_store_settings_canonical_form"
            model="ir.ui.view">
        <field name="name">shopify.connector.store.settings.store.form</field>
        <field name="model">shopify.connector.store.settings</field>
        <field name="arch" type="xml">
            <form string="Sync Rules" create="false" delete="false">
                <!--
                    `o_sc_store_settings` (2026-07-31) IS INERT and exists to
                    be MEASURED. No connector stylesheet selects it and none
                    is added for it. The rendered clipping/RTL instrument
                    names its measured roots explicitly rather than by class
                    prefix, and before this class it knew only the three Owl
                    surfaces and a generic modal body — so this form, which
                    is the canonical per-store configuration screen, produced
                    no connector-owned measurement at any width or in either
                    direction while the campaign counted it as covered.
                -->
                <sheet class="o_sc_store_settings">
                    <group>
                        <group string="Store" name="canonical_store">
                            <field name="store_id" readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="company_id" readonly="1"
                                   options="{'no_open': True}"/>
                        </group>
                        <group string="Sync domains" name="canonical_domains">
                            <field name="product_domain_enabled"/>
                            <field name="sale_domain_enabled"/>
                            <field name="inventory_domain_enabled"/>
                            <field name="fulfillment_domain_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Core" name="canonical_core">
                            <group string="Onboarding decisions"
                                   name="canonical_onboarding">
                                <field name="product_first_sync_source"
                                       readonly="1"/>
                                <field name="notification_default_enabled"
                                       readonly="1"/>
                            </group>
                            <div class="text-muted" role="note">
                                <p>
                                    <strong>Customer delivery notifications</strong>
                                    are shown here for reference only. Turning
                                    them on means Shopify emails your customers
                                    when a delivery is fulfilled, so opting in
                                    stays where the explicit confirmation lives
                                    — the guided Setup Wizard's notification
                                    step. This screen deliberately offers no
                                    second way to switch them on.
                                </p>
                                <p>
                                    <strong>First sync direction</strong> was
                                    decided during onboarding and is shown
                                    read-only. Changing the direction of a
                                    store that has already synchronized is not
                                    a settings edit, and is not offered here.
                                </p>
                            </div>
                            <group string="Log and evidence retention"
                                   name="canonical_retention">
                                <field name="log_redaction_retention_days"/>
                            </group>
                        </page>
                        <!--
                            Domain modules add their own page here, via
                            `inherit_id` + an xpath on this notebook. Core
                            cannot reference a domain field directly: the
                            column does not exist when only core is installed,
                            and the view would fail to parse.
                        -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_connector_store_settings_canonical_search"
            model="ir.ui.view">
        <field name="name">shopify.connector.store.settings.store.search</field>
        <field name="model">shopify.connector.store.settings</field>
        <field name="arch" type="xml">
            <search string="Sync Rules">
                <field name="store_id"/>
                <field name="company_id"/>
                <group>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--
        `view_ids` is bound explicitly. Four surfaces now share
        `shopify.connector.store.settings` &#8212; this one, Export Settings,
        Fulfillment Settings, and the setup wizard's store form &#8212; and an
        action with no view reference falls back to `default_view()`, which
        orders by `priority,name,id`. Every view here sits at the default
        priority, so the tie breaks on NAME. That is precisely the accident
        that made "Export Settings" render the fulfillment list until it was
        corrected; binding the views is what stops this action from joining it.
    -->
    <record id="action_shopify_connector_store_settings_canonical"
            model="ir.actions.act_window">
        <field name="name">Sync Rules</field>
        <field name="res_model">shopify.connector.store.settings</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_shopify_connector_store_settings_canonical_search"/>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list', 'sequence': 10,
                              'view_id': ref('view_shopify_connector_store_settings_canonical_list')}),
                      (0, 0, {'view_mode': 'form', 'sequence': 20,
                              'view_id': ref('view_shopify_connector_store_settings_canonical_form')})]"/>
        <!--
            `group_ids` is the Odoo 19 field name on `ir.actions.act_window`
            (`odoo/addons/base/models/ir_actions.py`, verified at the pinned
            commit). It is a visibility control only; the server-side role
            assertion in `action_open_canonical_store_settings` is the
            authorization.
        -->
        <field name="group_ids"
               eval="[(4, ref('shopify_connector_core.group_shopify_connector_admin'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No store is configured yet.
            </p>
            <p>
                Sync rules appear here once a Shopify store exists. Each
                store carries its own configuration, and only a Shopify
                Connector Administrator may change it.
            </p>
        </field>
    </record>

    <!--
        The menu opens a server action rather than the window action directly,
        so that reaching the screen also ensures the structural settings row
        exists for the stores the caller can already see. The server action
        returns the window action above; it is the same action either way.
    -->
    <record id="action_shopify_connector_store_settings_open"
            model="ir.actions.server">
        <field name="name">Sync Rules</field>
        <field name="model_id"
               ref="shopify_connector_core.model_shopify_connector_store_settings"/>
        <field name="state">code</field>
        <field name="group_ids"
               eval="[(4, ref('shopify_connector_core.group_shopify_connector_admin'))]"/>
        <field name="code">action = model.action_open_canonical_store_settings()</field>
    </record>

    <menuitem id="menu_shopify_connector_store_settings"
              name="Sync Rules"
              parent="shopify_connector_core.menu_shopify_connector_configuration"
              action="action_shopify_connector_store_settings_open"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="20"/>
</odoo>
