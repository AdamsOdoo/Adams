<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Batch E operator UI: distinct Runs & Recovery and human-owned Needs
        Attention projections over the existing shopify.connector.job model.

        All roles read (job ACL is read for all four). Action buttons target
        ONLY existing sanctioned methods and are gated to match the server's
        exact role + state matrix:
          * action_manual_retry  -> Operator/Admin for failed/skipped;
                                    Reviewer/Admin for blocked_manual_review;
                                    hidden on mutation-evidence-linked jobs.
          * action_cancel(reason) -> Operator/Admin, via the cancel wizard;
                                    hidden on mutation-evidence-linked jobs.
          * action_resolve_manual_review -> Reviewer/Admin, blocked jobs only,
                                    non-mutation.
        Button visibility approximates preconditions; the server method is the
        final authority (a hidden button is never the security control).
    -->

    <!-- Search -->
    <record id="view_shopify_connector_job_search" model="ir.ui.view">
        <field name="name">shopify.connector.job.search</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <search string="Sync runs">
                <field name="store_id"/>
                <field name="job_type" string="Run type"/>
                <field name="error_class"/>
                <filter name="filter_needs_attention" string="Needs attention"
                        domain="[('state', 'in', ('blocked_manual_review', 'failed_final', 'failed_retryable')), ('superseded_by_job_id', '=', False)]"/>
                <separator/>
                <filter name="filter_queued_running" string="Queued / running"
                        domain="[('state', 'in', ('queued', 'running'))]"/>
                <filter name="filter_retry_waiting" string="Waiting to retry"
                        domain="[('state', '=', 'retry_waiting')]"/>
                <filter name="filter_blocked_review" string="Waiting on a decision"
                        domain="[('state', '=', 'blocked_manual_review')]"/>
                <filter name="filter_failed_retryable" string="Needs a fix"
                        domain="[('state', '=', 'failed_retryable')]"/>
                <filter name="filter_failed_final" string="Failed (final)"
                        domain="[('state', '=', 'failed_final')]"/>
                <filter name="filter_succeeded" string="Done"
                        domain="[('state', '=', 'succeeded')]"/>
                <filter name="filter_skipped" string="Skipped"
                        domain="[('state', '=', 'skipped')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_has_evidence" string="Has Shopify write evidence"
                        domain="[('mutation_attempt_id', '!=', False)]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_job_type" string="Run type" context="{'group_by': 'job_type'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'job_source'}"/>
                    <filter name="group_error_class" string="Error class" context="{'group_by': 'error_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List (server-paginated Odoo-native; state as word + colour) -->
    <record id="view_shopify_connector_job_list" model="ir.ui.view">
        <field name="name">shopify.connector.job.list</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <list string="Runs &amp; Recovery" default_order="create_date desc, id desc"
                  decoration-danger="state in ('failed_final', 'failed_retryable', 'blocked_manual_review')"
                  decoration-warning="state == 'retry_waiting'"
                  decoration-info="state in ('queued', 'running')"
                  decoration-success="state == 'succeeded'"
                  decoration-muted="state in ('skipped', 'cancelled')"
                  create="false" delete="false" edit="false">
                <field name="store_id"/>
                <field name="job_type" string="Run type"/>
                <field name="job_source" string="Source" optional="show"/>
                <field name="state" string="State" decoration-bf="1"/>
                <field name="merchant_write_status" string="Shopify acknowledgement"
                       optional="show"/>
                <field name="recovery_owner" string="Owner" optional="show"/>
                <field name="recovery_next_action" string="Next action" optional="show"/>
                <field name="error_class" string="Recorded reason" optional="hide"/>
                <field name="retry_count" string="Retries" optional="show"/>
                <field name="next_retry_at" string="Next retry" optional="show"/>
                <field name="mutation_attempt_id" string="Shopify write evidence" optional="show" widget="many2one"/>
                <field name="operator_has_mutation_evidence" column_invisible="True"/>
                <field name="res_model" optional="hide"/>
                <field name="started_at" string="Started" optional="hide"/>
                <field name="finished_at" string="Finished" optional="show"/>
                <button name="action_open_recovery_evidence" type="object"
                        string="Review evidence" icon="fa-shield"
                        invisible="not operator_has_mutation_evidence"
                        help="Open preserved Shopify write evidence. This only reads evidence; it does not retry or change Shopify."/>
            </list>
        </field>
    </record>

    <!-- Human-owned cases only. Priority is a stored projection of the
         existing state: decision blockers, then final failures, then
         retryable failures. Automatic retry waiting remains in Runs &
         Recovery and never inflates this inbox. -->
    <record id="view_shopify_connector_attention_list" model="ir.ui.view">
        <field name="name">shopify.connector.job.attention.list</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <list string="Needs Attention"
                  default_order="attention_priority desc, create_date asc, id asc"
                  decoration-danger="state in ('blocked_manual_review', 'failed_final')"
                  decoration-warning="state == 'failed_retryable'"
                  create="false" delete="false" edit="false">
                <field name="attention_priority" string="Priority" optional="hide"/>
                <field name="store_id"/>
                <field name="job_type" string="Run type"/>
                <field name="attention_reason" string="Reason"/>
                <field name="attention_business_object" string="Affected object"/>
                <field name="attention_owner" string="Owner"/>
                <field name="attention_next_action" string="Next action"/>
                <field name="state" string="Case state"/>
                <field name="merchant_write_status" string="Shopify acknowledgement"
                       optional="show"/>
                <field name="create_date" string="Opened"/>
                <button name="action_open_attention_case" type="object"
                        string="Open case" icon="fa-external-link"
                        help="Open the preserved evidence or affected record for this exact case. Opening it changes nothing."/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shopify_connector_job_form" model="ir.ui.view">
        <field name="name">shopify.connector.job.form</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <form string="Sync run" create="false" delete="false" edit="false">
                <header>
                    <!-- Ordinary retry: Operator/Admin, non-mutation. -->
                    <button name="action_manual_retry" type="object"
                            string="Retry" class="btn-primary"
                            groups="shopify_connector_core.group_shopify_connector_operator,shopify_connector_core.group_shopify_connector_admin"
                            invisible="state not in ('failed_retryable', 'failed_final', 'skipped') or operator_has_mutation_evidence"
                            confirm="Retry queues a new background run in Odoo. It does not run immediately and is not proof that Shopify accepted a write. Continue?"
                            help="Queues local background work; it does not run immediately."/>
                    <!-- Blocked-review retry / release: Administrator-only privileged recovery. -->
                    <button name="action_manual_retry" type="object"
                            string="Release for retry"
                            groups="shopify_connector_core.group_shopify_connector_admin"
                            invisible="state != 'blocked_manual_review' or operator_has_mutation_evidence"
                            confirm="Release queues this reviewed run again. It does not run immediately. Continue?"
                            help="Queues a reviewed run after the decision is complete."/>
                    <button name="action_resolve_manual_review" type="object"
                            string="Resolve review" class="btn-primary"
                            groups="shopify_connector_core.group_shopify_connector_admin"
                            invisible="state != 'blocked_manual_review' or operator_has_mutation_evidence"
                            help="Mark the review resolved and re-queue the run."/>
                    <button name="action_open_attention_case" type="object"
                            string="Open case"
                            invisible="state not in ('blocked_manual_review', 'failed_final', 'failed_retryable')"
                            help="Open the preserved evidence or affected record. Opening it changes nothing."/>
                    <button name="action_open_recovery_evidence" type="object"
                            string="Review Shopify evidence"
                            invisible="not operator_has_mutation_evidence"
                            help="Reads preserved mutation evidence only; it does not retry, reconcile, or change Shopify."/>
                    <!-- Cancel with a reason: Operator/Admin, non-mutation, cancellable states. -->
                    <button name="%(action_shopify_connector_job_cancel_wizard)d" type="action"
                            string="Cancel run"
                            groups="shopify_connector_core.group_shopify_connector_operator,shopify_connector_core.group_shopify_connector_admin"
                            invisible="state not in ('draft', 'queued', 'running', 'retry_waiting') or operator_has_mutation_evidence"
                            help="Cancel this run. A reason is required and recorded."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,queued,running,succeeded"/>
                </header>
                <sheet>
                    <field name="operator_has_mutation_evidence" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" name="%(action_shopify_connector_job_log)d"
                                class="oe_stat_button" icon="fa-file-text-o"
                                string="Log entries"
                                context="{'search_default_job_id': id}"/>
                    </div>
                    <widget name="web_ribbon" title="Shopify write evidence"
                            bg_color="text-bg-warning"
                            invisible="not operator_has_mutation_evidence"/>
                    <group>
                        <group string="What">
                            <field name="job_type" string="Run type" readonly="1"/>
                            <field name="job_source" string="Source" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="merchant_write_status" readonly="1"
                                   invisible="not merchant_write_status"/>
                        </group>
                        <group string="Why">
                            <field name="error_class" readonly="1" invisible="not error_class"/>
                            <field name="manual_review_subreason" readonly="1"
                                   invisible="not manual_review_subreason"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="next_retry_at" readonly="1" invisible="not next_retry_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Target">
                            <field name="res_model" readonly="1" invisible="not res_model"/>
                            <field name="res_id" readonly="1" invisible="not res_id"/>
                            <field name="mutation_attempt_id" readonly="1"
                                   invisible="not mutation_attempt_id"/>
                        </group>
                        <group string="Timing">
                            <field name="create_date" string="Created" readonly="1"/>
                            <field name="started_at" readonly="1" invisible="not started_at"/>
                            <field name="finished_at" readonly="1" invisible="not finished_at"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="not cancel_reason">
                        <field name="cancel_reason" readonly="1"/>
                    </group>
                    <group string="Business context"
                           invisible="state not in ('blocked_manual_review', 'failed_final', 'failed_retryable')">
                        <group>
                            <field name="attention_business_object" readonly="1"/>
                            <field name="attention_event" readonly="1"/>
                            <field name="attention_shopify_state" readonly="1"/>
                            <field name="attention_odoo_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="attention_effect" readonly="1"/>
                            <field name="attention_next_action" readonly="1"/>
                            <field name="attention_consequence" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted"
                         invisible="not operator_has_mutation_evidence">
                        This run carries Shopify write evidence. It is resolved only through the
                        administrator mutation-attempt review — the generic retry and cancel
                        actions do not apply.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Runs & Recovery: every run, including system-owned retry waiting. -->
    <record id="action_shopify_connector_sync_center" model="ir.actions.act_window">
        <field name="name">Runs &amp; Recovery</field>
        <field name="res_model">shopify.connector.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_job_search"/>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list', 'sequence': 10,
                              'view_id': ref('view_shopify_connector_job_list')}),
                      (0, 0, {'view_mode': 'form', 'sequence': 20,
                              'view_id': ref('view_shopify_connector_job_form')})]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No runs yet</p>
            <p>Every queued, running, retrying and completed connector run appears here. Retry queues local background work; cancel records a reason; Shopify write evidence opens read-only before any administrator decision.</p>
        </field>
    </record>

    <!-- Needs Attention: prioritized human-owned cases only. -->
    <record id="action_shopify_connector_error_center" model="ir.actions.act_window">
        <field name="name">Needs Attention</field>
        <field name="res_model">shopify.connector.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_job_search"/>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list', 'sequence': 10,
                              'view_id': ref('view_shopify_connector_attention_list')}),
                      (0, 0, {'view_mode': 'form', 'sequence': 20,
                              'view_id': ref('view_shopify_connector_job_form')})]"/>
        <field name="domain">[('state', 'in', ('blocked_manual_review', 'failed_final', 'failed_retryable')), ('superseded_by_job_id', '=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No one needs to act</p>
            <p>Human decisions and failures needing a fix appear here. Automatic retries stay in Runs &amp; Recovery until a person actually owns the next step.</p>
        </field>
    </record>
</odoo>
