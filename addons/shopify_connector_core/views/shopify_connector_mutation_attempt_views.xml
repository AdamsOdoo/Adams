<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        U0 operator UI: Mutation-attempt evidence over the existing
        shopify.connector.mutation.attempt model.

        Read-only for every role (attempt ACL is read-only for all four,
        including Admin; the model blocks direct create/write/unlink in code).
        The ONLY change path is the existing sanctioned Administrator method
        action_resolve_mutation_attempt(disposition, reason), reached through
        the resolution wizard. The raw Json evidence fields
        (remote_mutation_intent, preconditions_snapshot, remote_evidence_refs)
        are NEVER displayed.
    -->

    <!-- Search -->
    <record id="view_shopify_connector_mutation_attempt_search" model="ir.ui.view">
        <field name="name">shopify.connector.mutation.attempt.search</field>
        <field name="model">shopify.connector.mutation.attempt</field>
        <field name="arch" type="xml">
            <search string="Mutation evidence">
                <field name="store_id"/>
                <field name="mutation_domain"/>
                <field name="job_id"/>
                <filter name="filter_uncertain" string="Waiting on a decision"
                        domain="[('observed_outcome', '=', 'uncertain'), ('resolution_disposition', '=', False)]"/>
                <filter name="filter_resolved" string="Resolved"
                        domain="[('resolution_disposition', '!=', False)]"/>
                <filter name="filter_succeeded" string="Confirmed applied"
                        domain="[('observed_outcome', '=', 'succeeded')]"/>
                <filter name="filter_failed_clean" string="Confirmed not applied"
                        domain="[('observed_outcome', '=', 'failed_clean')]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_outcome" string="Outcome" context="{'group_by': 'observed_outcome'}"/>
                    <filter name="group_domain" string="Domain" context="{'group_by': 'mutation_domain'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List (no raw Json evidence columns) -->
    <record id="view_shopify_connector_mutation_attempt_list" model="ir.ui.view">
        <field name="name">shopify.connector.mutation.attempt.list</field>
        <field name="model">shopify.connector.mutation.attempt</field>
        <field name="arch" type="xml">
            <list string="Mutation evidence" default_order="created_at desc"
                  decoration-danger="observed_outcome == 'uncertain' and not resolution_disposition"
                  decoration-success="observed_outcome == 'succeeded' or resolution_disposition == 'applied'"
                  decoration-muted="observed_outcome == 'failed_clean' or resolution_disposition == 'not_applied'"
                  create="false" delete="false" edit="false">
                <field name="created_at" string="When"/>
                <field name="mutation_domain" string="Domain"/>
                <field name="store_id"/>
                <field name="observed_outcome" string="Outcome"/>
                <field name="resolution_disposition" string="Decision" optional="show"/>
                <field name="transport_attempted" optional="hide"/>
                <field name="inconclusive_reconciliation_count" string="Reconcile tries" optional="hide"/>
                <field name="job_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shopify_connector_mutation_attempt_form" model="ir.ui.view">
        <field name="name">shopify.connector.mutation.attempt.form</field>
        <field name="model">shopify.connector.mutation.attempt</field>
        <field name="arch" type="xml">
            <form string="Mutation evidence" create="false" delete="false" edit="false">
                <header>
                    <button name="%(action_shopify_connector_mutation_resolution_wizard)d" type="action"
                            string="Resolve" class="btn-primary"
                            groups="shopify_connector_core.group_shopify_connector_admin"
                            invisible="observed_outcome != 'uncertain' or resolution_disposition"
                            help="Record an administrator decision. This is audited and cannot be undone."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Waiting on a decision"
                            bg_color="text-bg-danger"
                            invisible="observed_outcome != 'uncertain' or resolution_disposition"/>
                    <widget name="web_ribbon" title="Resolved"
                            bg_color="text-bg-success"
                            invisible="not resolution_disposition"/>
                    <group>
                        <group string="What changed">
                            <field name="mutation_domain" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="observed_outcome" readonly="1"/>
                            <field name="transport_attempted" readonly="1"/>
                        </group>
                        <group string="Decision">
                            <field name="resolution_disposition" readonly="1"
                                   invisible="not resolution_disposition"/>
                            <field name="resolution_source" readonly="1"
                                   invisible="not resolution_source"/>
                            <field name="resolution_reason" readonly="1"
                                   invisible="not resolution_reason"/>
                            <field name="resolution_uid" readonly="1"
                                   invisible="not resolution_uid"/>
                            <field name="resolution_at" readonly="1"
                                   invisible="not resolution_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Evidence lineage">
                            <field name="shopify_idempotency_key" readonly="1"/>
                            <field name="business_intent_fingerprint" readonly="1"/>
                            <field name="exact_request_fingerprint" readonly="1"/>
                            <field name="inconclusive_reconciliation_count" readonly="1"/>
                        </group>
                        <group string="Timing">
                            <field name="created_at" readonly="1"/>
                            <field name="transport_at" readonly="1" invisible="not transport_at"/>
                            <field name="idempotency_valid_until" readonly="1"
                                   invisible="not idempotency_valid_until"/>
                            <field name="resolved_at" readonly="1" invisible="not resolved_at"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        This is immutable audit evidence. Raw request and response contents are not shown.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shopify_connector_mutation_attempt" model="ir.actions.act_window">
        <field name="name">Mutation Evidence</field>
        <field name="res_model">shopify.connector.mutation.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_mutation_attempt_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No mutation evidence</p>
            <p>When a change to Shopify needs an audited decision, its evidence appears here.</p>
        </field>
    </record>
</odoo>
