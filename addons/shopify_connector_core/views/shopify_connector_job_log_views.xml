<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        U0 operator UI: Logs over the existing shopify.connector.job.log model.

        Fully read-only for every role (log ACL is read-only for all four; no
        group holds create/write/unlink by design). Every stored text field
        (message / technical_detail / payload_snapshot) is redacted at write by
        the model's single sanctioned append path, so nothing raw is surfaced.
        The general list never shows the payload snapshot; it appears only in a
        clearly-labelled, immutable audit-evidence section on the record form.
    -->

    <!-- Search -->
    <record id="view_shopify_connector_job_log_search" model="ir.ui.view">
        <field name="name">shopify.connector.job.log.search</field>
        <field name="model">shopify.connector.job.log</field>
        <field name="arch" type="xml">
            <search string="Logs">
                <field name="job_id" string="Run"/>
                <field name="store_id"/>
                <field name="event_type"/>
                <filter name="filter_manual_action" string="Manual actions"
                        domain="[('event_type', '=', 'manual_action')]"/>
                <filter name="filter_state_change" string="State changes"
                        domain="[('event_type', '=', 'state_change')]"/>
                <filter name="filter_attempt" string="Attempts"
                        domain="[('event_type', '=', 'attempt')]"/>
                <group>
                    <filter name="group_job" string="Run" context="{'group_by': 'job_id'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_event" string="Event type" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List (no payload snapshot column) -->
    <record id="view_shopify_connector_job_log_list" model="ir.ui.view">
        <field name="name">shopify.connector.job.log.list</field>
        <field name="model">shopify.connector.job.log</field>
        <field name="arch" type="xml">
            <list string="Logs" default_order="occurred_at desc"
                  create="false" delete="false" edit="false">
                <field name="occurred_at" string="When"/>
                <field name="event_type"/>
                <field name="from_state" optional="show"/>
                <field name="to_state" optional="show"/>
                <field name="message"/>
                <field name="actor_uid" string="By" optional="show"/>
                <field name="store_id" optional="hide"/>
                <field name="job_id" string="Run" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shopify_connector_job_log_form" model="ir.ui.view">
        <field name="name">shopify.connector.job.log.form</field>
        <field name="model">shopify.connector.job.log</field>
        <field name="arch" type="xml">
            <form string="Log entry" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="occurred_at" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="actor_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="job_id" string="Run" readonly="1"/>
                            <field name="store_id" readonly="1"/>
                            <field name="from_state" readonly="1"/>
                            <field name="to_state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Technical detail (redacted)" invisible="not technical_detail">
                        <field name="technical_detail" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Immutable audit evidence (redacted)" invisible="not payload_snapshot">
                        <div class="text-muted" colspan="2">
                            Recorded, redacted evidence kept for audit. It cannot be edited or deleted.
                        </div>
                        <field name="payload_snapshot" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shopify_connector_job_log" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">shopify.connector.job.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_job_log_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No log activity yet</p>
            <p>When syncing runs, every step is recorded here — read-only and redacted.</p>
        </field>
    </record>
</odoo>
