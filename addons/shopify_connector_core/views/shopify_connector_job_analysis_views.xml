<?xml version="1.0" encoding="utf-8"?>
<!--
  Sync Operations Analysis (Store 360 slice, task §4.C).

  Genuinely zero-schema: list/graph/pivot over `shopify.connector.job`
  exactly as it stands, under its native ACLs (every connector role reads
  jobs) and its global fail-closed company/quarantine record rule
  (`job_company_rule`). No sudo, no parallel reporting model, no server
  action: the standard views aggregate as the current user, so a
  rule-restricted caller analyses exactly the jobs their Sync Center shows.
-->
<odoo>
    <record id="view_shopify_connector_job_analysis_search" model="ir.ui.view">
        <field name="name">shopify.connector.job.analysis.search</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <search string="Sync Performance">
                <field name="store_id"/>
                <field name="job_type" string="Run type"/>
                <field name="state"/>
                <field name="job_source"/>
                <field name="error_class"/>
                <filter name="filter_failed" string="Failures"
                        domain="[('state', 'in', ('failed_retryable', 'failed_final', 'blocked_manual_review'))]"/>
                <filter name="filter_backlog" string="Backlog"
                        domain="[('state', 'in', ('queued', 'running', 'retry_waiting'))]"/>
                <filter name="filter_succeeded" string="Succeeded"
                        domain="[('state', '=', 'succeeded')]"/>
                <separator/>
                <filter name="filter_last_7_days" string="Last 7 Days"
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-7), datetime.time(0, 0, 0)))]"/>
                <filter name="filter_last_30_days" string="Last 30 Days"
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-30), datetime.time(0, 0, 0)))]"/>
                <group>
                    <filter name="group_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_job_type" string="Flow"
                            context="{'group_by': 'job_type'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'job_source'}"/>
                    <filter name="group_error_class" string="Error Class"
                            context="{'group_by': 'error_class'}"/>
                    <filter name="group_created_day" string="Created (Day)"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter name="group_created_week" string="Created (Week)"
                            context="{'group_by': 'create_date:week'}"/>
                    <filter name="group_created_month" string="Created (Month)"
                            context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shopify_connector_job_analysis_graph" model="ir.ui.view">
        <field name="name">shopify.connector.job.analysis.graph</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <graph string="Sync Performance" sample="0">
                <field name="create_date" interval="day"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_shopify_connector_job_analysis_pivot" model="ir.ui.view">
        <field name="name">shopify.connector.job.analysis.pivot</field>
        <field name="model">shopify.connector.job</field>
        <field name="arch" type="xml">
            <pivot string="Sync Performance" sample="0">
                <field name="store_id" type="row"/>
                <field name="job_type" string="Run type" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_shopify_connector_sync_analysis" model="ir.actions.act_window">
        <field name="name">Sync Performance</field>
        <field name="res_model">shopify.connector.job</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="view_shopify_connector_job_analysis_search"/>
        <field name="context">{'search_default_group_job_type': 1, 'search_default_group_state': 1, 'search_default_filter_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No synchronization activity yet
            </p>
            <p>
                Once the connector starts working, analyse throughput,
                failures and delays here by store, flow, state, source and
                period.
            </p>
        </field>
    </record>
</odoo>
