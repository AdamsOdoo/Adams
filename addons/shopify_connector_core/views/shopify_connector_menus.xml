<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        C1/C2 information architecture. The root has exactly four visible
        pillars. Existing destination IDs are re-parented below so bookmarks
        and references survive the restructure; the domain addons add their
        own children to these pillars.

        Menus are visibility only. Existing ACLs, record rules and hidden
        capability groups remain the authorization boundary.
    -->
    <menuitem id="menu_shopify_connector_root"
              name="Shopify Connector"
              sequence="50"
              groups="shopify_connector_core.group_shopify_connector_auditor"/>

    <menuitem id="menu_shopify_connector_dashboard"
              name="Dashboard"
              parent="menu_shopify_connector_root"
              sequence="10"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_connector_health"
              name="Connector Health"
              parent="menu_shopify_connector_dashboard"
              action="action_shopify_connector_health"
              sequence="20"/>

    <menuitem id="menu_shopify_connector_operations"
              name="Operations"
              parent="menu_shopify_connector_root"
              sequence="20"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_sync_center"
              name="Runs &amp; Recovery"
              parent="menu_shopify_connector_operations"
              action="action_shopify_connector_sync_center"
              sequence="50"/>

    <menuitem id="menu_shopify_connector_error_center"
              name="Needs Attention"
              parent="menu_shopify_connector_operations"
              action="action_shopify_connector_error_center"
              sequence="60"/>

    <!-- Evidence is a contextual drill-down, never a navigation concept. -->
    <menuitem id="menu_shopify_connector_mutation_evidence"
              name="Mutation Evidence"
              parent="menu_shopify_connector_error_center"
              action="action_shopify_connector_mutation_attempt"
              sequence="10"
              active="False"/>

    <menuitem id="menu_shopify_connector_reporting"
              name="Reporting"
              parent="menu_shopify_connector_root"
              sequence="30"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_sync_analysis"
              name="Sync Performance"
              parent="menu_shopify_connector_reporting"
              action="action_shopify_connector_sync_analysis"
              sequence="20"/>

    <menuitem id="menu_shopify_connector_logs"
              name="Audit Trail"
              parent="menu_shopify_connector_reporting"
              action="action_shopify_connector_job_log"
              sequence="30"/>

    <menuitem id="menu_shopify_connector_configuration"
              name="Configuration"
              parent="menu_shopify_connector_root"
              sequence="40"
              groups="shopify_connector_core.group_shopify_connector_admin"/>

    <!-- Stable store ID, moved under the Administrator-only Configuration
         pillar. -->
    <menuitem id="menu_shopify_connector_stores"
              name="Stores &amp; Onboarding"
              parent="menu_shopify_connector_configuration"
              action="action_shopify_connector_store"
              sequence="10"
              groups="shopify_connector_core.group_shopify_connector_admin"/>
</odoo>
