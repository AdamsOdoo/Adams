<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        C7: two separate client actions backed by separate bounded RPC
        projections. The original action ID becomes Sales Dashboard so
        existing references survive; Connector Health gets its own action.
    -->
    <record id="action_shopify_connector_dashboard" model="ir.actions.client">
        <field name="name">Sales Dashboard</field>
        <field name="tag">shopify_connector_sales_dashboard</field>
    </record>

    <record id="action_shopify_connector_health" model="ir.actions.client">
        <field name="name">Connector Health</field>
        <field name="tag">shopify_connector_health</field>
    </record>
</odoo>
