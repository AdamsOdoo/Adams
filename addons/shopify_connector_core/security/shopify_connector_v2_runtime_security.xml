<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- P09 runtime evidence is store-rooted and fail-closed.  These are
             global rules, so a future permissive group rule cannot reopen a
             different active company or a quarantined cross-store row. -->
        <record id="run_company_rule" model="ir.rule">
            <field name="name">Shopify run: own company only</field>
            <field name="model_id" ref="model_shopify_connector_run"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="job_attempt_company_rule" model="ir.rule">
            <field name="name">Shopify execution attempt: own company only</field>
            <field name="model_id" ref="model_shopify_connector_job_attempt"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
