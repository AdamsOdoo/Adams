<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            SEC-3 (#197) store-rooted multi-company isolation.

            Every rule below is GLOBAL (no `groups`), so Odoo AND-s it with
            every other rule on the model (`ir_rule.py` `_compute_global`).
            A permissive group rule can therefore never re-open what these
            close.

            The domain is deliberately `('company_id', 'in', company_ids)`
            and NOT the usual Odoo
            `['|', ('company_id', '=', False), ...]` shape. That standard
            shape means "a NULL company is shared with everyone", which is
            right for a neutral price list and wrong for connector
            control-plane data: a store, credential or job with no company
            is a record whose ownership we could not prove, and the safe
            reading of "unknown owner" is "nobody sees it", not "everybody
            does". These rules are therefore fail-closed by construction.

            `company_ids` is `env.companies.ids` — the user's *activated*
            companies, described in `ir_rule.py::_eval_context` as
            "filtered and trusted". A user switched into company A alone
            does not see company B's stores even if allowed in both.

            Historic stores with no company are invisible here by design;
            `shopify.connector.store.action_assign_company` is the
            administrative remediation path.

            SECOND LEAF — `sec3_scope_quarantined`. Company alone cannot
            express same-STORE agreement, because one company may own
            several stores: a job log in store A pointing at a job in
            store B passes every company check while mixing two shops'
            records. A record-rule domain cannot compare two of a
            record's own fields, so there is no
            `('store_id', '=', 'job_id.store_id')` to write. Rows that
            disagree with a connector parent are therefore flagged by the
            upgrade sweep in `shopify.connector.scope.mixin` and excluded
            here. New rows of that shape are refused outright by
            `_check_sec3_parent_scope`; the flag exists for rows written
            before that constraint did. Nothing is ever re-homed
            automatically — see the mixin's module docstring for why
            guessing which half is wrong would be worse than hiding both.
        -->

        <record id="store_company_rule" model="ir.rule">
            <field name="name">Shopify store: own company only</field>
            <field name="model_id" ref="model_shopify_connector_store"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="store_credential_company_rule" model="ir.rule">
            <field name="name">Shopify store credential: own company only</field>
            <field name="model_id" ref="model_shopify_connector_store_credential"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- The cached 24-hour access token of the client-credentials mode.
             It carries no ACL row at all, so no group reaches it through RPC;
             this global rule exists anyway, because "unreachable today" is a
             property of the current ACL file and this is a property of the
             data. Both must hold. -->
        <record id="store_access_token_company_rule" model="ir.rule">
            <field name="name">Shopify store access token: own company only</field>
            <field name="model_id" ref="model_shopify_connector_store_access_token"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="store_settings_company_rule" model="ir.rule">
            <field name="name">Shopify store settings: own company only</field>
            <field name="model_id" ref="model_shopify_connector_store_settings"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="location_company_rule" model="ir.rule">
            <field name="name">Shopify location: own company only</field>
            <field name="model_id" ref="model_shopify_connector_location"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="job_company_rule" model="ir.rule">
            <field name="name">Shopify job: own company only</field>
            <field name="model_id" ref="model_shopify_connector_job"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="job_log_company_rule" model="ir.rule">
            <field name="name">Shopify job log: own company only</field>
            <field name="model_id" ref="model_shopify_connector_job_log"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="mutation_attempt_company_rule" model="ir.rule">
            <field name="name">Shopify mutation attempt: own company only</field>
            <field name="model_id" ref="model_shopify_connector_mutation_attempt"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="call_lease_company_rule" model="ir.rule">
            <field name="name">Shopify call lease: own company only</field>
            <field name="model_id" ref="model_shopify_connector_call_lease"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="command_result_company_rule" model="ir.rule">
            <field name="name">Shopify command result: own company only</field>
            <field name="model_id" ref="model_shopify_connector_command_result"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
