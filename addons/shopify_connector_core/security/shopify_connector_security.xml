<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_shopify_connector" model="ir.module.category">
            <field name="name">Shopify Connector</field>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_shopify_connector" model="res.groups.privilege">
            <field name="name">Shopify Connector</field>
            <field name="category_id" ref="module_category_shopify_connector"/>
        </record>

        <record id="group_shopify_connector_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
        </record>

        <record id="group_shopify_connector_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[(4, ref('group_shopify_connector_auditor'))]"/>
        </record>

        <record id="group_shopify_connector_reviewer" model="res.groups">
            <field name="name">Reviewer</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[(4, ref('group_shopify_connector_auditor'))]"/>
        </record>

        <record id="group_shopify_connector_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[(4, ref('group_shopify_connector_operator')), (4, ref('group_shopify_connector_reviewer'))]"/>
        </record>

    </data>
</odoo>
