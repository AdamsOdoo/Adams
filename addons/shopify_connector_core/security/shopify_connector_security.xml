<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_shopify_connector" model="ir.module.category">
            <field name="name">Shopify Connector</field>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_shopify_connector" model="res.groups.privilege">
            <field name="name">Shopify Connector</field>
            <field name="category_id" ref="module_category_shopify_connector"/>
        </record>

        <!--
            SEC-2 role layer. The four legacy capability groups remain hidden
            server-side primitives with stable XML IDs; the two groups carrying
            `privilege_id` are the only customer-facing choices.

            The implication graph is deliberately an exact replacement (not an
            additive update):

              User          -> Operator -> Auditor
              Administrator -> User + Reviewer -> Operator/Auditor

            User must not inherit Reviewer. Reviewer-gated confirmation,
            recovery, and review-resolution methods therefore remain unavailable
            to an ordinary Connector User even when called directly through RPC.
            Administrator explicitly retains Reviewer so the contract does not
            depend on the current contents of User's implication set.
        -->

        <record id="group_shopify_connector_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <!-- SEC-2: hidden capability primitive. Explicit False is required:
                 an update only writes fields present in the record, so omitting
                 the field would leave the old privilege in place. -->
            <field name="privilege_id" eval="False"/>
        </record>

        <record id="group_shopify_connector_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_shopify_connector_auditor'))]"/>
        </record>

        <record id="group_shopify_connector_reviewer" model="res.groups">
            <field name="name">Reviewer</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_shopify_connector_auditor'))]"/>
        </record>

        <!-- SEC-2 Connector User: routine operational execution only. Use an
             exact replacement so upgrades remove the historical Reviewer edge
             from this group rather than leaving it behind via additive commands. -->
        <record id="group_shopify_connector_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_shopify_connector_operator')])]"/>
        </record>

        <!-- SEC-2 Connector Administrator: the second customer-facing role.
             Keep Reviewer explicit so Administrator retains all privileged
             capabilities even if the User implication is changed later. -->
        <record id="group_shopify_connector_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_shopify_connector_user'), ref('group_shopify_connector_reviewer')])]"/>
        </record>

    </data>
</odoo>
