<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="webhook_secret_company_rule" model="ir.rule">
            <field name="name">Webhook secret: own company only</field>
            <field name="model_id" ref="model_shopify_connector_webhook_secret"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="webhook_delivery_company_rule" model="ir.rule">
            <field name="name">Webhook delivery: own company only</field>
            <field name="model_id" ref="model_shopify_connector_webhook_delivery"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="webhook_subscription_company_rule" model="ir.rule">
            <field name="name">Webhook subscription: own company only</field>
            <field name="model_id" ref="model_shopify_connector_webhook_subscription"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
