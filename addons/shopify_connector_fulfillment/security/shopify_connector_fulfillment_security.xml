<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for the fulfillment domain records. The
            connector store carries no company_id (company is threaded through
            the bound Odoo picking / sale order), so the fulfillment binding and
            inbound evidence are scoped to the company of their bound Odoo
            record. System code runs sudo() and bypasses these rules; they
            constrain interactive access only.
        -->
        <record id="fulfillment_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Fulfillment Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_fulfillment_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('picking_id.company_id', '=', False), ('picking_id.company_id', 'in', company_ids)]</field>
        </record>

        <!--
            The inbound-evidence rules intentionally live only in
            shopify_connector_fulfillment_company_rules.xml.  Older releases
            declared the same XML IDs in both files, first under noupdate=1 and
            later under noupdate=0.  That made upgrade behaviour depend on the
            existing ir.model.data noupdate flag.  Migration 19.0.1.11.0 repairs
            existing rows and clears that flag; keeping one declaration makes
            fresh-install and warm-update ownership unambiguous.
        -->

    </data>
</odoo>
