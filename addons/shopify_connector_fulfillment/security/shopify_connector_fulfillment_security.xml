<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for the fulfillment domain records. The
            connector store carries no company_id (company is threaded through
            the bound Odoo picking / sale order), so the fulfillment binding and
            inbound evidence are scoped to the company of their bound Odoo
            record. System code runs sudo() and bypasses these rules; they
            constrain interactive access only.
        -->
        <record id="fulfillment_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Fulfillment Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_fulfillment_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('picking_id.company_id', '=', False), ('picking_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="fulfillment_inbound_evidence_company_rule" model="ir.rule">
            <field name="name">Shopify Fulfillment Inbound Evidence: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_fulfillment_inbound_evidence"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('order_binding_id', '=', False), '|', ('order_binding_id.sale_order_id.company_id', '=', False), ('order_binding_id.sale_order_id.company_id', 'in', company_ids)]</field>
        </record>

        <!--
            SEC-3 (issue #197): the evidence LINE reaches company through its
            own sale line, which is not necessarily reachable from the parent
            evidence record's rule. Scoping it explicitly means no evidence line
            is readable across companies even when its parent is visible.
        -->
        <record id="fulfillment_inbound_evidence_line_company_rule" model="ir.rule">
            <field name="name">Shopify Fulfillment Inbound Evidence Line: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_fulfillment_inbound_evidence_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('sale_line_id', '=', False), '|', ('sale_line_id.company_id', '=', False), ('sale_line_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
