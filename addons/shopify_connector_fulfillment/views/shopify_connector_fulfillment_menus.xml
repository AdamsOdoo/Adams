<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- C1: fulfillment operations remain visible to Connector Users while
         settings and mode move to Administrator-only Configuration. -->

    <menuitem id="menu_shopify_connector_fulfillment"
              name="Fulfillments"
              parent="shopify_connector_core.menu_shopify_connector_operations"
              action="action_shopify_connector_fulfillment_binding"
              sequence="40"
              groups="shopify_connector_core.group_shopify_connector_user"/>

    <menuitem id="menu_shopify_connector_fulfillment_review"
              name="Review Workspace"
              parent="menu_shopify_connector_fulfillment"
              action="action_shopify_connector_fulfillment_review"
              sequence="10"
              active="False"/>

    <menuitem id="menu_shopify_connector_fulfillment_binding"
              name="Fulfillments"
              parent="menu_shopify_connector_fulfillment"
              action="action_shopify_connector_fulfillment_binding"
              sequence="20"
              active="False"/>

    <menuitem id="menu_shopify_connector_fulfillment_jobs"
              name="Fulfillment Runs"
              parent="menu_shopify_connector_fulfillment"
              action="action_shopify_connector_fulfillment_job"
              sequence="30"
              active="False"/>

    <!-- The operating-mode surface is Configuration and therefore
         Administrator-only at both menu and action layers. Python field
         security and the existing server guards remain the final boundary. -->
    <menuitem id="menu_shopify_connector_fulfillment_settings"
              name="Fulfillment Settings and Mode"
              parent="shopify_connector_core.menu_shopify_connector_configuration"
              action="action_shopify_connector_fulfillment_settings"
              groups="shopify_connector_core.group_shopify_connector_admin"
              sequence="50"/>
</odoo>
