<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_product_binding_view_tree" model="ir.ui.view">
        <field name="name">shopify.product.binding.tree</field>
        <field name="model">shopify.product.binding</field>
        <field name="arch" type="xml">
            <list string="Shopify Product Bindings"
                  decoration-danger="sync_status == 'error'"
                  decoration-warning="sync_status == 'pending'"
                  decoration-muted="sync_status == 'permanent_error'">
                <field name="backend_id"/>
                <field name="odoo_id"/>
                <field name="shopify_id"/>
                <field name="shopify_status"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"
                       decoration-warning="sync_status == 'pending'"
                       decoration-muted="sync_status == 'permanent_error'"/>
                <field name="last_sync_date"/>
                <field name="sync_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="shopify_product_binding_view_form" model="ir.ui.view">
        <field name="name">shopify.product.binding.form</field>
        <field name="model">shopify.product.binding</field>
        <field name="arch" type="xml">
            <form string="Shopify Product Binding">
                <header>
                    <button name="action_retry_sync" type="object"
                            string="Retry Sync"
                            invisible="sync_status not in ('error', 'permanent_error')"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group string="Binding">
                            <field name="backend_id"/>
                            <field name="odoo_id"/>
                            <field name="shopify_id"/>
                            <field name="shopify_handle"/>
                            <field name="shopify_status"/>
                            <field name="no_sync"/>
                        </group>
                        <group string="Sync Status">
                            <field name="sync_status"/>
                            <field name="last_sync_date"/>
                            <field name="sync_checksum"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not sync_error">
                        <field name="sync_error" readonly="1"/>
                    </group>
                    <group string="Variant Bindings">
                        <field name="variant_binding_ids" nolabel="1">
                            <list>
                                <field name="odoo_id"/>
                                <field name="shopify_id"/>
                                <field name="shopify_sku"/>
                                <field name="sync_status" widget="badge"
                                       decoration-success="sync_status == 'synced'"
                                       decoration-danger="sync_status == 'error'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_product_binding_view_search" model="ir.ui.view">
        <field name="name">shopify.product.binding.search</field>
        <field name="model">shopify.product.binding</field>
        <field name="arch" type="xml">
            <search string="Shopify Products">
                <field name="odoo_id"/>
                <field name="shopify_id"/>
                <field name="backend_id"/>
                <filter name="synced" string="Synced"
                        domain="[('sync_status', '=', 'synced')]"/>
                <filter name="pending" string="Pending"
                        domain="[('sync_status', '=', 'pending')]"/>
                <filter name="errors" string="Errors"
                        domain="[('sync_status', 'in', ['error', 'permanent_error'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_product_binding_action" model="ir.actions.act_window">
        <field name="name">Shopify Products</field>
        <field name="res_model">shopify.product.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 0}</field>
    </record>

</odoo>
