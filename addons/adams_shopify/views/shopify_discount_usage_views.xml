<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Discount Usage Tree View -->
    <record id="shopify_discount_usage_view_tree" model="ir.ui.view">
        <field name="name">shopify.discount.usage.tree</field>
        <field name="model">shopify.discount.usage</field>
        <field name="arch" type="xml">
            <list string="Discount Usage" create="0" edit="0">
                <field name="date"/>
                <field name="discount_code_id"/>
                <field name="promoter_id"/>
                <field name="sale_order_id"/>
                <field name="discount_amount"/>
                <field name="order_total"/>
                <field name="commission_amount"/>
            </list>
        </field>
    </record>

    <!-- Discount Usage Search View -->
    <record id="shopify_discount_usage_view_search" model="ir.ui.view">
        <field name="name">shopify.discount.usage.search</field>
        <field name="model">shopify.discount.usage</field>
        <field name="arch" type="xml">
            <search string="Search Discount Usage">
                <field name="discount_code_id"/>
                <field name="promoter_id"/>
                <field name="sale_order_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Last Month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_promoter" string="Promoter"
                            context="{'group_by': 'promoter_id'}"/>
                    <filter name="group_code" string="Discount Code"
                            context="{'group_by': 'discount_code_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Discount Usage Action -->
    <record id="shopify_discount_usage_action" model="ir.actions.act_window">
        <field name="name">Discount Usage</field>
        <field name="res_model">shopify.discount.usage</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No discount usage recorded yet
            </p>
            <p>
                Usage records are created automatically when orders
                with promoter discount codes are imported from Shopify.
            </p>
        </field>
    </record>

</odoo>
