<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Shopify tab to product.template form -->
    <record id="product_template_form_shopify" model="ir.ui.view">
        <field name="name">product.template.form.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify_tab"
                      groups="adams_shopify.group_shopify_user">
                    <group>
                        <field name="shopify_no_sync"/>
                    </group>
                    <field name="shopify_bind_ids" nolabel="1" readonly="1">
                        <tree string="Shopify Bindings" create="false" delete="false">
                            <field name="backend_id" string="Store"/>
                            <field name="shopify_id"/>
                            <field name="shopify_status"/>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'synced'"
                                   decoration-danger="sync_status == 'error'"
                                   decoration-warning="sync_status == 'pending'"/>
                            <field name="last_sync_date"/>
                            <button name="action_retry_sync" type="object"
                                    string="Retry" icon="fa-refresh"
                                    invisible="sync_status != 'error'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
