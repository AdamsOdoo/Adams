<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Shopify tab to res.partner form -->
    <record id="res_partner_form_shopify" model="ir.ui.view">
        <field name="name">res.partner.form.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify_tab"
                      groups="adams_shopify.group_shopify_user">
                    <group>
                        <field name="is_shopify_customer"/>
                    </group>
                    <field name="shopify_bind_ids" nolabel="1" readonly="1">
                        <list string="Shopify Bindings" create="false" delete="false">
                            <field name="backend_id" string="Store"/>
                            <field name="shopify_id"/>
                            <field name="shopify_email"/>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'synced'"
                                   decoration-danger="sync_status == 'error'"
                                   decoration-warning="sync_status == 'pending'"/>
                            <field name="last_sync_date"/>
                            <button name="action_retry_sync" type="object"
                                    string="Retry" icon="fa-refresh"
                                    invisible="sync_status != 'error'"/>
                            <button name="action_view_on_shopify" type="object"
                                    string="View on Shopify" icon="fa-external-link"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
