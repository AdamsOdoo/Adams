<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_webhook_log_view_tree" model="ir.ui.view">
        <field name="name">shopify.webhook.log.tree</field>
        <field name="model">shopify.webhook.log</field>
        <field name="arch" type="xml">
            <tree string="Webhook Logs"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'skipped'"
                  decoration-info="state == 'pending'">
                <field name="received_at"/>
                <field name="backend_id" string="Store"/>
                <field name="topic"/>
                <field name="shopify_id" string="Resource ID"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state in ('pending', 'processing')"
                       decoration-muted="state == 'skipped'"/>
                <field name="processed_at"/>
                <field name="error_message" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="shopify_webhook_log_view_form" model="ir.ui.view">
        <field name="name">shopify.webhook.log.form</field>
        <field name="model">shopify.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="webhook_id"/>
                            <field name="topic"/>
                            <field name="shopify_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_webhook_log_view_search" model="ir.ui.view">
        <field name="name">shopify.webhook.log.search</field>
        <field name="model">shopify.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="topic"/>
                <field name="shopify_id"/>
                <field name="backend_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="errors" string="Errors"
                        domain="[('state', '=', 'error')]"/>
                <filter name="today" string="Today"
                        domain="[('received_at', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_topic" string="Topic"
                            context="{'group_by': 'topic'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_webhook_log_action" model="ir.actions.act_window">
        <field name="name">Webhook Log</field>
        <field name="res_model">shopify.webhook.log</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
