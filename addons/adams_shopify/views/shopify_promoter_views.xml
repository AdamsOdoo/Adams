<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Promoter Tree View -->
    <record id="shopify_promoter_view_tree" model="ir.ui.view">
        <field name="name">shopify.promoter.tree</field>
        <field name="model">shopify.promoter</field>
        <field name="arch" type="xml">
            <tree string="Promoters">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="commission_type"/>
                <field name="commission_rate"/>
                <field name="total_orders"/>
                <field name="total_revenue" widget="monetary"/>
                <field name="total_commission" widget="monetary"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-muted="status == 'inactive'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Promoter Form View -->
    <record id="shopify_promoter_view_form" model="ir.ui.view">
        <field name="name">shopify.promoter.form</field>
        <field name="model">shopify.promoter</field>
        <field name="arch" type="xml">
            <form string="Promoter">
                <header>
                    <button name="%(adams_shopify.shopify_promoter_action)d"
                            type="action" string="Set Active"
                            invisible="status == 'active'"
                            class="d-none"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-shopping-cart"
                                type="object" name="action_view_orders">
                            <field name="total_orders" widget="statinfo"
                                   string="Orders"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money"
                                type="object" name="action_view_revenue">
                            <field name="total_revenue" widget="statinfo"
                                   string="Revenue"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-tag"
                                type="object" name="action_view_discounts">
                            <field name="total_discount_given" widget="statinfo"
                                   string="Discounts"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-percent"
                                type="object" name="action_view_commission">
                            <field name="total_commission" widget="statinfo"
                                   string="Commission"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Promoter Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="partner_id"/>
                            <field name="code_prefix"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Commission">
                            <field name="commission_type"/>
                            <field name="commission_rate"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Discount Codes" name="discount_codes">
                            <field name="discount_code_ids" nolabel="1"
                                   context="{'default_promoter_id': active_id}">
                                <tree editable="bottom">
                                    <field name="backend_id"/>
                                    <field name="code"/>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                    <field name="usage_count"/>
                                    <field name="sync_status" widget="badge"
                                           decoration-success="sync_status == 'synced'"
                                           decoration-warning="sync_status == 'pending'"
                                           decoration-danger="sync_status == 'error'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Performance" name="performance">
                            <field name="discount_code_ids" invisible="1"/>
                            <button type="object" name="action_view_all_usages"
                                    string="View All Usages" class="btn-link mb-2"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this promoter..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Promoter Search View -->
    <record id="shopify_promoter_view_search" model="ir.ui.view">
        <field name="name">shopify.promoter.search</field>
        <field name="model">shopify.promoter</field>
        <field name="arch" type="xml">
            <search string="Search Promoters">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="active_promoters" string="Active"
                        domain="[('status', '=', 'active')]"/>
                <filter name="inactive_promoters" string="Inactive"
                        domain="[('status', '=', 'inactive')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_commission_type" string="Commission Type"
                            context="{'group_by': 'commission_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Promoter Action -->
    <record id="shopify_promoter_action" model="ir.actions.act_window">
        <field name="name">Promoters</field>
        <field name="res_model">shopify.promoter</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_promoters': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first promoter
            </p>
            <p>
                Manage promoters and their discount codes for Shopify.
                Track usage, revenue, and commissions.
            </p>
        </field>
    </record>

</odoo>
