<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_customer_binding_view_tree" model="ir.ui.view">
        <field name="name">shopify.customer.binding.tree</field>
        <field name="model">shopify.customer.binding</field>
        <field name="arch" type="xml">
            <tree string="Shopify Customer Bindings"
                  decoration-danger="sync_status == 'error'"
                  decoration-warning="sync_status == 'pending'">
                <field name="backend_id"/>
                <field name="odoo_id"/>
                <field name="shopify_id"/>
                <field name="shopify_email"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"
                       decoration-warning="sync_status == 'pending'"/>
                <field name="last_sync_date"/>
            </tree>
        </field>
    </record>

    <record id="shopify_customer_binding_view_form" model="ir.ui.view">
        <field name="name">shopify.customer.binding.form</field>
        <field name="model">shopify.customer.binding</field>
        <field name="arch" type="xml">
            <form string="Shopify Customer Binding">
                <header>
                    <button name="action_retry_sync" type="object"
                            string="Retry Sync"
                            invisible="sync_status not in ('error', 'permanent_error')"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id"/>
                            <field name="odoo_id"/>
                            <field name="shopify_id"/>
                            <field name="shopify_email"/>
                            <field name="shopify_tags"/>
                        </group>
                        <group>
                            <field name="sync_status"/>
                            <field name="last_sync_date"/>
                            <field name="sync_checksum"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not sync_error">
                        <field name="sync_error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_customer_binding_view_search" model="ir.ui.view">
        <field name="name">shopify.customer.binding.search</field>
        <field name="model">shopify.customer.binding</field>
        <field name="arch" type="xml">
            <search string="Shopify Customers">
                <field name="odoo_id"/>
                <field name="shopify_id"/>
                <field name="shopify_email"/>
                <filter name="synced" string="Synced"
                        domain="[('sync_status', '=', 'synced')]"/>
                <filter name="errors" string="Errors"
                        domain="[('sync_status', 'in', ['error', 'permanent_error'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_customer_binding_action" model="ir.actions.act_window">
        <field name="name">Shopify Customers</field>
        <field name="res_model">shopify.customer.binding</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
