<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="shopify_abandoned_cart_view_list" model="ir.ui.view">
        <field name="name">shopify.abandoned.cart.list</field>
        <field name="model">shopify.abandoned.cart</field>
        <field name="arch" type="xml">
            <list string="Abandoned Carts"
                  decoration-success="recovered == True"
                  decoration-warning="recovered == False and sale_order_id"
                  decoration-muted="sync_status == 'permanent_error'">
                <field name="display_name" string="Cart"/>
                <field name="customer_email"/>
                <field name="customer_name"/>
                <field name="total_price" string="Total"/>
                <field name="currency_code"/>
                <field name="line_item_count" string="Items"/>
                <field name="abandoned_at"/>
                <field name="recovered"/>
                <field name="sale_order_id" optional="show"/>
                <field name="recovered_order_binding_id" optional="hide"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"
                       decoration-info="sync_status == 'pending'"/>
                <field name="backend_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="shopify_abandoned_cart_view_form" model="ir.ui.view">
        <field name="name">shopify.abandoned.cart.form</field>
        <field name="model">shopify.abandoned.cart</field>
        <field name="arch" type="xml">
            <form string="Abandoned Cart">
                <header>
                    <button name="action_create_quotation"
                            string="Create Quotation"
                            type="object"
                            class="btn-primary"
                            invisible="sale_order_id or recovered"/>
                    <button name="action_open_recovery_url"
                            string="Open Recovery URL"
                            type="object"
                            class="btn-secondary"
                            invisible="not recovery_url"/>
                    <button name="action_mark_recovered"
                            string="Mark Recovered"
                            type="object"
                            invisible="recovered"/>
                    <field name="sync_status" widget="statusbar"
                           statusbar_visible="pending,synced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="partner_id"/>
                            <field name="shopify_customer_id"/>
                        </group>
                        <group string="Cart Details">
                            <field name="total_price"/>
                            <field name="subtotal_price"/>
                            <field name="currency_code"/>
                            <field name="line_item_count"/>
                            <field name="abandoned_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recovery">
                            <field name="recovered"/>
                            <field name="recovered_order_binding_id"/>
                            <field name="sale_order_id"/>
                            <field name="recovery_url" widget="url"/>
                            <field name="recovery_email_sent"/>
                        </group>
                        <group string="Sync Info">
                            <field name="backend_id"/>
                            <field name="shopify_id"/>
                            <field name="last_sync_date"/>
                            <field name="sync_checksum" invisible="1"/>
                            <field name="sync_error"
                                   invisible="sync_status not in ('error', 'permanent_error')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items" name="line_items">
                            <field name="line_items_json" widget="text"
                                   readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="shopify_abandoned_cart_view_search" model="ir.ui.view">
        <field name="name">shopify.abandoned.cart.search</field>
        <field name="model">shopify.abandoned.cart</field>
        <field name="arch" type="xml">
            <search string="Abandoned Carts">
                <field name="customer_email"/>
                <field name="customer_name"/>
                <field name="shopify_id"/>
                <filter name="not_recovered" string="Not Recovered"
                        domain="[('recovered', '=', False)]"/>
                <filter name="recovered" string="Recovered"
                        domain="[('recovered', '=', True)]"/>
                <filter name="with_quotation" string="Has Quotation"
                        domain="[('sale_order_id', '!=', False)]"/>
                <filter name="no_quotation" string="No Quotation"
                        domain="[('sale_order_id', '=', False), ('recovered', '=', False)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('abandoned_at', '>=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('abandoned_at', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_backend" string="Backend"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_recovered" string="Recovered"
                            context="{'group_by': 'recovered'}"/>
                    <filter name="group_date" string="Abandoned Date"
                            context="{'group_by': 'abandoned_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="shopify_abandoned_cart_action" model="ir.actions.act_window">
        <field name="name">Abandoned Carts</field>
        <field name="res_model">shopify.abandoned.cart</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_recovered': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No abandoned carts synced yet
            </p>
            <p>
                Abandoned carts from Shopify will appear here once the sync runs.
                You can create draft quotations to help recover lost sales.
            </p>
        </field>
    </record>

</odoo>
