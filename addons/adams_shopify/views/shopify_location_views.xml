<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_location_view_list" model="ir.ui.view">
        <field name="name">shopify.location.list</field>
        <field name="model">shopify.location</field>
        <field name="arch" type="xml">
            <list string="Shopify Locations">
                <field name="backend_id"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_code"/>
                <field name="is_active" widget="boolean"/>
                <field name="is_primary" widget="boolean"/>
                <field name="warehouse_id"/>
            </list>
        </field>
    </record>

    <record id="shopify_location_view_form" model="ir.ui.view">
        <field name="name">shopify.location.form</field>
        <field name="model">shopify.location</field>
        <field name="arch" type="xml">
            <form string="Shopify Location">
                <sheet>
                    <group>
                        <group string="Shopify">
                            <field name="backend_id"/>
                            <field name="shopify_location_id"/>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="city"/>
                            <field name="country_code"/>
                        </group>
                        <group string="Configuration">
                            <field name="is_active"/>
                            <field name="is_primary"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shopify_location_view_search" model="ir.ui.view">
        <field name="name">shopify.location.search</field>
        <field name="model">shopify.location</field>
        <field name="arch" type="xml">
            <search string="Shopify Locations">
                <field name="name"/>
                <field name="backend_id"/>
                <filter name="active_locations" string="Active"
                        domain="[('is_active', '=', True)]"/>
                <filter name="primary" string="Primary"
                        domain="[('is_primary', '=', True)]"/>
                <group>
                    <filter name="group_backend" string="Store"
                            context="{'group_by': 'backend_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shopify_location_action" model="ir.actions.act_window">
        <field name="name">Shopify Locations</field>
        <field name="res_model">shopify.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
