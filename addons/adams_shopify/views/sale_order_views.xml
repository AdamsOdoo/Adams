<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Shopify tab to sale.order form -->
    <record id="sale_order_form_shopify" model="ir.ui.view">
        <field name="name">sale.order.form.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify_tab"
                      groups="adams_shopify.group_shopify_user">
                    <group>
                        <group>
                            <field name="shopify_order_name"/>
                            <field name="shopify_financial_status"/>
                            <field name="shopify_fulfillment_status"/>
                        </group>
                    </group>
                    <field name="shopify_bind_ids" nolabel="1" readonly="1">
                        <tree string="Shopify Bindings" create="false" delete="false">
                            <field name="backend_id" string="Store"/>
                            <field name="shopify_id"/>
                            <field name="shopify_order_name"/>
                            <field name="shopify_financial_status"/>
                            <field name="shopify_fulfillment_status"/>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'synced'"
                                   decoration-danger="sync_status == 'error'"/>
                            <field name="last_sync_date"/>
                            <button name="action_view_on_shopify" type="object"
                                    string="View on Shopify" icon="fa-external-link"
                                    class="btn-link"/>
                            <button name="action_retry_sync" type="object"
                                    string="Retry" icon="fa-refresh"
                                    invisible="sync_status not in ('error', 'permanent_error')"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
