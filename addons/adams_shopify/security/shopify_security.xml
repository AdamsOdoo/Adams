<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_shopify" model="ir.module.category">
        <field name="name">Shopify</field>
        <field name="sequence">100</field>
    </record>

    <!-- Privilege (Odoo 19: replaces direct category_id on res.groups) -->
    <record id="privilege_shopify" model="res.groups.privilege">
        <field name="name">Shopify</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="module_category_shopify"/>
    </record>

    <!-- Groups -->
    <record id="group_shopify_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_shopify"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
    </record>

    <!-- Record Rules: Multi-Company -->
    <record id="shopify_backend_company_rule" model="ir.rule">
        <field name="name">Shopify Backend: multi-company</field>
        <field name="model_id" ref="model_shopify_backend"/>
        <field name="domain_force">[
            '|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="shopify_product_binding_company_rule" model="ir.rule">
        <field name="name">Shopify Product Binding: multi-company</field>
        <field name="model_id" ref="model_shopify_product_binding"/>
        <field name="domain_force">[
            '|', ('backend_id.company_id', '=', False),
            ('backend_id.company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="shopify_variant_binding_company_rule" model="ir.rule">
        <field name="name">Shopify Variant Binding: multi-company</field>
        <field name="model_id" ref="model_shopify_variant_binding"/>
        <field name="domain_force">[
            '|', ('backend_id.company_id', '=', False),
            ('backend_id.company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="shopify_customer_binding_company_rule" model="ir.rule">
        <field name="name">Shopify Customer Binding: multi-company</field>
        <field name="model_id" ref="model_shopify_customer_binding"/>
        <field name="domain_force">[
            '|', ('backend_id.company_id', '=', False),
            ('backend_id.company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="shopify_order_binding_company_rule" model="ir.rule">
        <field name="name">Shopify Order Binding: multi-company</field>
        <field name="model_id" ref="model_shopify_order_binding"/>
        <field name="domain_force">[
            '|', ('backend_id.company_id', '=', False),
            ('backend_id.company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="shopify_inventory_binding_company_rule" model="ir.rule">
        <field name="name">Shopify Inventory Binding: multi-company</field>
        <field name="model_id" ref="model_shopify_inventory_binding"/>
        <field name="domain_force">[
            '|', ('backend_id.company_id', '=', False),
            ('backend_id.company_id', 'in', company_ids)
        ]</field>
    </record>


</odoo>
