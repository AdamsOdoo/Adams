<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopify_bulk_retry_wizard_view_form" model="ir.ui.view">
        <field name="name">shopify.bulk.retry.wizard.form</field>
        <field name="model">shopify.bulk.retry.wizard</field>
        <field name="arch" type="xml">
            <form string="Retry Failed Records">
                <group>
                    <field name="backend_id"/>
                    <field name="entity"/>
                    <field name="include_permanent"/>
                </group>
                <footer>
                    <button name="action_retry" type="object" string="Retry All" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="shopify_bulk_retry_wizard_action" model="ir.actions.act_window">
        <field name="name">Retry Failed Records</field>
        <field name="res_model">shopify.bulk.retry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
