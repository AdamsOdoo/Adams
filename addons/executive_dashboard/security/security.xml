<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_executive_dashboard" model="res.groups.privilege">
        <field name="name">Executive Dashboard</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_executive_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Opens the dashboard. Each section still shows only the data the user may read in its app.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_executive_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Opens the dashboard and its settings menu.</field>
    </record>
</odoo>
