<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">executive_dashboard.dashboard</field>
        <field name="path">executive</field>
    </record>

    <menuitem id="menu_root" name="Executive Dashboard" sequence="14"
              action="action_dashboard"
              web_icon="executive_dashboard,static/description/icon.png"
              groups="group_user"/>
    <menuitem id="menu_dashboard" name="Dashboard" parent="menu_root" sequence="1"
              action="action_dashboard"/>
    <menuitem id="menu_settings" name="Settings" parent="menu_root" sequence="90"
              action="action_settings" groups="base.group_system"/>
</odoo>
