<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_pos_order_sales_report_list" model="ir.ui.view">
        <field name="name">report.pos.order.sales.report.list</field>
        <field name="model">report.pos.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Sales Report" js_class="pos_sales_report_list" create="0" edit="0" delete="0"
                  decoration-danger="is_refund">
                <field name="currency_id" column_invisible="True"/>
                <field name="is_refund" column_invisible="True"/>
                <field name="date" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="session_id" optional="hide"/>
                <field name="config_id" optional="hide"/>
                <field name="cashier" string="Employee" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="product_id" optional="show"/>
                <field name="product_categ_id" optional="hide"/>
                <field name="qty" optional="show" sum="Total"/>
                <field name="price_unit" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_discount" string="Discount" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="price_subtotal_excl" string="Net" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="tax_amount" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="price_total" string="Total" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="margin" optional="hide" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"
                       groups="point_of_sale.group_pos_manager"/>
            </list>
        </field>
    </record>

    <record id="report_pos_order_sales_report_search" model="ir.ui.view">
        <field name="name">report.pos.order.sales.report.search</field>
        <field name="model">report.pos.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Sales Report">
                <field name="product_id"/>
                <field name="cashier" string="Employee"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <field name="product_categ_id"/>
                <filter string="Order Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Exclude refunds" name="exclude_refunds" domain="[('is_refund', '=', False)]"/>
                <filter string="Refunds only" name="refunds_only" domain="[('is_refund', '=', True)]"/>
                <separator/>
                <filter string="With discount" name="with_discount" domain="[('total_discount', '!=', 0)]"/>
                <separator/>
                <filter string="Invoiced" name="invoiced" domain="[('invoiced', '=', True)]"/>
                <filter string="Not invoiced" name="not_invoiced" domain="[('invoiced', '=', False)]"/>
                <group>
                    <filter string="Employee" name="group_cashier" context="{'group_by': 'cashier'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="group_product_categ" context="{'group_by': 'product_categ_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Point of Sale" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Order Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_sales_report" model="ir.actions.act_window">
        <field name="name">Sales Report</field>
        <field name="res_model">report.pos.order</field>
        <field name="path">pos-sales-report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="report_pos_order_sales_report_list"/>
        <field name="search_view_id" ref="report_pos_order_sales_report_search"/>
        <!-- Sales only: draft and cancelled orders are left out. -->
        <field name="domain">[('state', 'in', ('paid', 'done'))]</field>
        <field name="context">{'search_default_filter_date': 1, 'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sales for these filters</p>
            <p>Paid and posted Point of Sale orders appear here, one row per sold line.</p>
        </field>
    </record>

    <menuitem id="menu_pos_sales_report"
        name="Sales Report"
        action="action_pos_sales_report"
        parent="point_of_sale.menu_point_rep"
        sequence="8"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
