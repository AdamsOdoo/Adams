<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            SEC-3 (issue #197) multi-company isolation.

            Ownership model (control-room MVP decision, 2026-07-25). A connector
            store belongs to exactly ONE Odoo company, recorded on
            `shopify.connector.store.company_id`; a company may own several
            stores; sharing one store across companies is outside the MVP.
            Every durable store-scoped row inherits that company through a
            stored related `company_id`, so company is decided in exactly one
            place and cannot drift.

            This SUPERSEDES the earlier model in which the store carried no
            company and each connector row borrowed the company of the business
            record it pointed at. That model left the entire control plane
            (store, credential, settings, location, job, job.log,
            mutation.attempt, call.lease) readable across companies, which did
            not satisfy #197. See
            docs/03-architecture/sec3-company-isolation-audit.md.

            `noupdate="0"` is deliberate: these are security rules, and a
            correction to a security rule must reach databases that already
            carry the old one on the next module update.

            Two rules apply to each binding and BOTH must pass, because they
            close different holes:
              * the STORE rule — fail-closed, `('company_id', 'in',
                company_ids)`, with no NULL escape. A row whose ownership we
                cannot prove is shown to nobody.
              * the BUSINESS-RECORD rule — keeps the pre-existing guarantee
                that another company's product cannot be reached through a
                binding, and correctly treats a genuinely company-neutral
                product as shared.

            `company_ids` is the reader's *activated* company set
            (odoo/odoo@19.0 30bde9ff, odoo/addons/base/models/ir_rule.py
            `_eval_context`), so an allowed-but-unselected company is excluded.

            Scope. Record rules constrain interactive access. Connector system
            code runs `sudo()` and bypasses them by design; the write-side
            authority is Odoo's native `_check_company` (opted into via
            `_check_company_auto` + `check_company=True` on each binding's
            business relation) plus the fail-closed checks in the importers.
        -->

        <record id="product_template_binding_store_company_rule" model="ir.rule">
            <field name="name">Shopify Product Template Binding: owning store company</field>
            <field name="model_id" ref="model_shopify_connector_product_template_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
        </record>

        <record id="product_variant_binding_store_company_rule" model="ir.rule">
            <field name="name">Shopify Product Variant Binding: owning store company</field>
            <field name="model_id" ref="model_shopify_connector_product_variant_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('sec3_scope_quarantined', '=', False)]</field>
        </record>

        <record id="product_template_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Product Template Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_product_template_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('product_template_id.company_id', '=', False), ('product_template_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="product_variant_binding_company_rule" model="ir.rule">
            <field name="name">Shopify Product Variant Binding: multi-company</field>
            <field name="model_id" ref="model_shopify_connector_product_variant_binding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('product_variant_id.company_id', '=', False), ('product_variant_id.company_id', 'in', company_ids)]</field>
        </record>

        <!--
            `shopify.connector.attribute.lock` intentionally has NO rule and no
            company. It is a single seeded row used only as a PostgreSQL mutex
            anchor (`_acquire_or_raise`, FOR UPDATE SKIP LOCKED). It holds no
            business data, is never created or written at runtime, and reveals
            nothing about any store or company. This is the one place in the
            connector where "company-neutral" is a proven fact rather than an
            unexamined default.
        -->

    </data>
</odoo>
