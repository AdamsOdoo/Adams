<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_simulator_user" model="res.groups">
        <field name="name">Shopify Simulator / User</field>
        <field name="comment">Internal QA group for Shopify Simulator access.</field>
    </record>

    <record id="group_simulator_admin" model="res.groups">
        <field name="name">Shopify Simulator / Admin</field>
        <field name="comment">Internal QA group for Shopify Simulator administration.</field>
        <field name="implied_ids" eval="[(4, ref('group_simulator_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
