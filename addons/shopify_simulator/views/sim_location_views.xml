<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_location_form" model="ir.ui.view">
        <field name="name">sim.shopify.location.form</field>
        <field name="model">sim.shopify.location</field>
        <field name="arch" type="xml">
            <form string="Simulated Location">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="name"/>
                            <field name="is_active"/>
                            <field name="is_primary"/>
                        </group>
                        <group>
                            <field name="address1"/>
                            <field name="city"/>
                            <field name="country_code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_location_tree" model="ir.ui.view">
        <field name="name">sim.shopify.location.tree</field>
        <field name="model">sim.shopify.location</field>
        <field name="arch" type="xml">
            <list string="Simulated Locations">
                <field name="shopify_gid"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_code"/>
                <field name="is_active"/>
                <field name="is_primary"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_locations" model="ir.actions.act_window">
        <field name="name">Sim Locations</field>
        <field name="res_model">sim.shopify.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
