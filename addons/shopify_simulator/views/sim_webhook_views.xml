<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_webhook_sub_form" model="ir.ui.view">
        <field name="name">sim.shopify.webhook.subscription.form</field>
        <field name="model">sim.shopify.webhook.subscription</field>
        <field name="arch" type="xml">
            <form string="Simulated Webhook Subscription">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="topic"/>
                            <field name="format"/>
                        </group>
                        <group>
                            <field name="callback_url" widget="url"/>
                            <field name="include_fields"/>
                            <field name="created_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_webhook_sub_tree" model="ir.ui.view">
        <field name="name">sim.shopify.webhook.subscription.tree</field>
        <field name="model">sim.shopify.webhook.subscription</field>
        <field name="arch" type="xml">
            <list string="Simulated Webhook Subscriptions">
                <field name="shopify_gid"/>
                <field name="topic"/>
                <field name="callback_url"/>
                <field name="format"/>
                <field name="created_at"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_webhooks" model="ir.actions.act_window">
        <field name="name">Sim Webhook Subscriptions</field>
        <field name="res_model">sim.shopify.webhook.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
