<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_refund_form" model="ir.ui.view">
        <field name="name">sim.shopify.refund.form</field>
        <field name="model">sim.shopify.refund</field>
        <field name="arch" type="xml">
            <form string="Simulated Refund">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="order_id"/>
                            <field name="created_at"/>
                        </group>
                        <group>
                            <field name="total_refunded"/>
                            <field name="currency_code"/>
                            <field name="presentment_currency_code"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Refund Lines">
                            <field name="refund_line_ids">
                                <list editable="bottom">
                                    <field name="line_item_gid"/>
                                    <field name="line_item_title"/>
                                    <field name="variant_gid" optional="hide"/>
                                    <field name="variant_sku"/>
                                    <field name="quantity"/>
                                    <field name="restock_type"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_refund_tree" model="ir.ui.view">
        <field name="name">sim.shopify.refund.tree</field>
        <field name="model">sim.shopify.refund</field>
        <field name="arch" type="xml">
            <list string="Simulated Refunds">
                <field name="shopify_gid"/>
                <field name="order_id"/>
                <field name="total_refunded"/>
                <field name="currency_code"/>
                <field name="created_at"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_refunds" model="ir.actions.act_window">
        <field name="name">Sim Refunds</field>
        <field name="res_model">sim.shopify.refund</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
