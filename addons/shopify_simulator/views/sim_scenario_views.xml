<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_scenario_form" model="ir.ui.view">
        <field name="name">sim.scenario.form</field>
        <field name="model">sim.scenario</field>
        <field name="arch" type="xml">
            <form string="Simulator Scenario">
                <header>
                    <button name="action_run" string="Run Scenario"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="key"/>
                        <field name="category"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_scenario_tree" model="ir.ui.view">
        <field name="name">sim.scenario.tree</field>
        <field name="model">sim.scenario</field>
        <field name="arch" type="xml">
            <list string="Scenario Library">
                <field name="category"/>
                <field name="name"/>
                <field name="description"/>
                <button name="action_run" string="Run" type="object"
                        icon="fa-play" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_sim_scenario" model="ir.actions.act_window">
        <field name="name">Scenario Library</field>
        <field name="res_model">sim.scenario</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
