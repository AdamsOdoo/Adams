<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_product_form" model="ir.ui.view">
        <field name="name">sim.shopify.product.form</field>
        <field name="model">sim.shopify.product</field>
        <field name="arch" type="xml">
            <form string="Simulated Product">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="title"/>
                            <field name="handle"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="vendor"/>
                            <field name="product_type"/>
                            <field name="tags"/>
                            <field name="created_at"/>
                            <field name="updated_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Variants">
                            <field name="variant_ids">
                                <list editable="bottom">
                                    <field name="shopify_gid" readonly="1" optional="hide"/>
                                    <field name="title"/>
                                    <field name="sku"/>
                                    <field name="price"/>
                                    <field name="barcode" optional="hide"/>
                                    <field name="inventory_quantity"/>
                                    <field name="option1_name" optional="show"/>
                                    <field name="option1_value" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description_html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_product_tree" model="ir.ui.view">
        <field name="name">sim.shopify.product.tree</field>
        <field name="model">sim.shopify.product</field>
        <field name="arch" type="xml">
            <list string="Simulated Products">
                <field name="shopify_gid"/>
                <field name="title"/>
                <field name="vendor"/>
                <field name="status"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_products" model="ir.actions.act_window">
        <field name="name">Sim Products</field>
        <field name="res_model">sim.shopify.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
