<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_inventory_form" model="ir.ui.view">
        <field name="name">sim.shopify.inventory.level.form</field>
        <field name="model">sim.shopify.inventory.level</field>
        <field name="arch" type="xml">
            <form string="Simulated Inventory Level">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="variant_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="available"/>
                            <field name="inventory_item_gid"/>
                            <field name="location_gid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_inventory_tree" model="ir.ui.view">
        <field name="name">sim.shopify.inventory.level.tree</field>
        <field name="model">sim.shopify.inventory.level</field>
        <field name="arch" type="xml">
            <list string="Simulated Inventory Levels" editable="bottom">
                <field name="variant_id"/>
                <field name="location_id"/>
                <field name="available"/>
                <field name="inventory_item_gid" optional="hide"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_inventory" model="ir.actions.act_window">
        <field name="name">Sim Inventory Levels</field>
        <field name="res_model">sim.shopify.inventory.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
