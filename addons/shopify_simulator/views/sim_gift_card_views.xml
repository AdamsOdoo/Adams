<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_gift_card_form" model="ir.ui.view">
        <field name="name">sim.shopify.gift.card.form</field>
        <field name="model">sim.shopify.gift.card</field>
        <field name="arch" type="xml">
            <form string="Simulated Gift Card">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="code_masked"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="initial_amount"/>
                            <field name="balance"/>
                            <field name="currency_code"/>
                            <field name="expires_on"/>
                        </group>
                    </group>
                    <group>
                        <field name="customer_gid"/>
                        <field name="order_gid"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_gift_card_tree" model="ir.ui.view">
        <field name="name">sim.shopify.gift.card.tree</field>
        <field name="model">sim.shopify.gift.card</field>
        <field name="arch" type="xml">
            <list string="Simulated Gift Cards">
                <field name="code_masked"/>
                <field name="initial_amount"/>
                <field name="balance"/>
                <field name="currency_code"/>
                <field name="status"/>
                <field name="expires_on"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_gift_cards" model="ir.actions.act_window">
        <field name="name">Sim Gift Cards</field>
        <field name="res_model">sim.shopify.gift.card</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
