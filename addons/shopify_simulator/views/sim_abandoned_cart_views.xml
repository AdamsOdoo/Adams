<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_abandoned_cart_form" model="ir.ui.view">
        <field name="name">sim.shopify.abandoned.cart.form</field>
        <field name="model">sim.shopify.abandoned.cart</field>
        <field name="arch" type="xml">
            <form string="Simulated Abandoned Cart">
                <sheet>
                    <group>
                        <group string="Checkout">
                            <field name="config_id"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="checkout_token" readonly="1"/>
                            <field name="abandoned_at"/>
                            <field name="recovered"/>
                            <field name="recovered_order_gid"
                                   invisible="not recovered"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="customer_gid"/>
                        </group>
                    </group>
                    <group>
                        <group string="Amounts">
                            <field name="total_price"/>
                            <field name="subtotal_price"/>
                            <field name="currency_code"/>
                        </group>
                        <group string="Links">
                            <field name="recovery_url" widget="url"/>
                            <field name="line_item_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items (JSON)">
                            <field name="line_items_json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_abandoned_cart_tree" model="ir.ui.view">
        <field name="name">sim.shopify.abandoned.cart.tree</field>
        <field name="model">sim.shopify.abandoned.cart</field>
        <field name="arch" type="xml">
            <list string="Simulated Abandoned Carts">
                <field name="display_name"/>
                <field name="customer_email"/>
                <field name="total_price"/>
                <field name="currency_code"/>
                <field name="abandoned_at"/>
                <field name="recovered"/>
                <field name="line_item_count"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_abandoned_carts" model="ir.actions.act_window">
        <field name="name">Sim Abandoned Carts</field>
        <field name="res_model">sim.shopify.abandoned.cart</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
