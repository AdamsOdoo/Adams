<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_order_form" model="ir.ui.view">
        <field name="name">sim.shopify.order.form</field>
        <field name="model">sim.shopify.order</field>
        <field name="arch" type="xml">
            <form string="Simulated Order">
                <header>
                    <button name="action_create_fulfillment_orders"
                            string="Create Fulfillment Orders"
                            type="object" class="btn-primary"
                            invisible="fulfillment_status == 'FULFILLED'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Order">
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="name"/>
                            <field name="financial_status"/>
                            <field name="fulfillment_status"/>
                            <field name="customer_id"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_code"/>
                            <field name="presentment_currency_code"/>
                            <field name="total_price"/>
                            <field name="subtotal_price"/>
                            <field name="total_shipping"/>
                            <field name="total_tax"/>
                            <field name="total_discounts"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="line_item_ids">
                                <list editable="bottom">
                                    <field name="shopify_gid" readonly="1" optional="hide"/>
                                    <field name="title"/>
                                    <field name="quantity"/>
                                    <field name="sku"/>
                                    <field name="unit_price"/>
                                    <field name="total_discount"/>
                                    <field name="tax_amount"/>
                                    <field name="variant_gid" optional="hide"/>
                                    <field name="product_gid" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shipping Lines">
                            <field name="shipping_line_ids">
                                <list editable="bottom">
                                    <field name="title"/>
                                    <field name="code"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shipping Address">
                            <group>
                                <group>
                                    <field name="ship_first_name"/>
                                    <field name="ship_last_name"/>
                                    <field name="ship_address1"/>
                                    <field name="ship_address2"/>
                                    <field name="ship_city"/>
                                </group>
                                <group>
                                    <field name="ship_province"/>
                                    <field name="ship_province_code"/>
                                    <field name="ship_country"/>
                                    <field name="ship_country_code"/>
                                    <field name="ship_zip"/>
                                    <field name="ship_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other">
                            <group>
                                <field name="note"/>
                                <field name="tags"/>
                                <field name="discount_codes_json"/>
                                <field name="created_at"/>
                                <field name="updated_at"/>
                                <field name="closed_at"/>
                                <field name="cancelled_at"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_order_tree" model="ir.ui.view">
        <field name="name">sim.shopify.order.tree</field>
        <field name="model">sim.shopify.order</field>
        <field name="arch" type="xml">
            <list string="Simulated Orders">
                <field name="shopify_gid"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="financial_status"/>
                <field name="fulfillment_status"/>
                <field name="total_price"/>
                <field name="currency_code"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_orders" model="ir.actions.act_window">
        <field name="name">Sim Orders</field>
        <field name="res_model">sim.shopify.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
