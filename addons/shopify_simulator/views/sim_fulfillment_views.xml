<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fulfillment -->
    <record id="sim_shopify_fulfillment_form" model="ir.ui.view">
        <field name="name">sim.shopify.fulfillment.form</field>
        <field name="model">sim.shopify.fulfillment</field>
        <field name="arch" type="xml">
            <form string="Simulated Fulfillment">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid"/>
                            <field name="order_id"/>
                            <field name="status"/>
                            <field name="created_at"/>
                        </group>
                        <group string="Tracking">
                            <field name="tracking_number"/>
                            <field name="tracking_company"/>
                            <field name="tracking_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Line Items (JSON)">
                        <field name="line_items_json" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_fulfillment_tree" model="ir.ui.view">
        <field name="name">sim.shopify.fulfillment.tree</field>
        <field name="model">sim.shopify.fulfillment</field>
        <field name="arch" type="xml">
            <list string="Simulated Fulfillments">
                <field name="shopify_gid"/>
                <field name="order_id"/>
                <field name="status"/>
                <field name="tracking_number"/>
                <field name="tracking_company"/>
                <field name="created_at"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_fulfillments" model="ir.actions.act_window">
        <field name="name">Sim Fulfillments</field>
        <field name="res_model">sim.shopify.fulfillment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
