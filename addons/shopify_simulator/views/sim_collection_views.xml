<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_collection_form" model="ir.ui.view">
        <field name="name">sim.shopify.collection.form</field>
        <field name="model">sim.shopify.collection</field>
        <field name="arch" type="xml">
            <form string="Simulated Collection">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="title"/>
                            <field name="handle"/>
                            <field name="collection_type"/>
                            <field name="sort_order"/>
                        </group>
                        <group>
                            <field name="published"/>
                            <field name="product_count"/>
                            <field name="image_url"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description_html"/>
                        </page>
                        <page string="Products">
                            <field name="product_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="vendor"/>
                                    <field name="status"/>
                                    <field name="shopify_gid"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_collection_tree" model="ir.ui.view">
        <field name="name">sim.shopify.collection.tree</field>
        <field name="model">sim.shopify.collection</field>
        <field name="arch" type="xml">
            <list string="Simulated Collections">
                <field name="title"/>
                <field name="handle"/>
                <field name="collection_type"/>
                <field name="product_count"/>
                <field name="published"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_collections" model="ir.actions.act_window">
        <field name="name">Sim Collections</field>
        <field name="res_model">sim.shopify.collection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
