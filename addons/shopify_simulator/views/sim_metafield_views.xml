<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_metafield_form" model="ir.ui.view">
        <field name="name">sim.shopify.metafield.form</field>
        <field name="model">sim.shopify.metafield</field>
        <field name="arch" type="xml">
            <form string="Simulated Metafield">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="owner_type"/>
                            <field name="owner_gid"/>
                        </group>
                        <group>
                            <field name="namespace"/>
                            <field name="key"/>
                            <field name="metafield_type"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Value">
                        <field name="value" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_metafield_tree" model="ir.ui.view">
        <field name="name">sim.shopify.metafield.tree</field>
        <field name="model">sim.shopify.metafield</field>
        <field name="arch" type="xml">
            <list string="Simulated Metafields" editable="bottom">
                <field name="owner_type"/>
                <field name="owner_gid"/>
                <field name="namespace"/>
                <field name="key"/>
                <field name="value"/>
                <field name="metafield_type"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_metafields" model="ir.actions.act_window">
        <field name="name">Sim Metafields</field>
        <field name="res_model">sim.shopify.metafield</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
