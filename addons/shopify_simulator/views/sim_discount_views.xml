<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_discount_form" model="ir.ui.view">
        <field name="name">sim.shopify.discount.code.form</field>
        <field name="model">sim.shopify.discount.code</field>
        <field name="arch" type="xml">
            <form string="Simulated Discount Code">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shopify_gid" readonly="1"/>
                            <field name="code"/>
                            <field name="title"/>
                            <field name="active_on_shopify"/>
                        </group>
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_value"
                                   invisible="discount_type == 'free_shipping'"/>
                            <field name="minimum_order_amount"/>
                            <field name="usage_limit"/>
                            <field name="one_per_customer"/>
                            <field name="usage_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="starts_at"/>
                        <field name="ends_at"/>
                    </group>
                    <notebook>
                        <page string="Usage Records">
                            <field name="usage_ids">
                                <list editable="bottom">
                                    <field name="order_gid"/>
                                    <field name="discount_amount"/>
                                    <field name="order_total"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_discount_tree" model="ir.ui.view">
        <field name="name">sim.shopify.discount.code.tree</field>
        <field name="model">sim.shopify.discount.code</field>
        <field name="arch" type="xml">
            <list string="Simulated Discount Codes">
                <field name="code"/>
                <field name="title"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="usage_count"/>
                <field name="active_on_shopify"/>
                <field name="starts_at"/>
                <field name="ends_at"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="action_sim_discounts" model="ir.actions.act_window">
        <field name="name">Sim Discount Codes</field>
        <field name="res_model">sim.shopify.discount.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
