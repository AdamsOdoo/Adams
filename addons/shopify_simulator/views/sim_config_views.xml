<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sim_shopify_config_form" model="ir.ui.view">
        <field name="name">sim.shopify.config.form</field>
        <field name="model">sim.shopify.config</field>
        <field name="arch" type="xml">
            <form string="Simulator Configuration">
                <sheet>
                    <group>
                        <group string="Connection">
                            <field name="backend_id"/>
                            <field name="access_token"/>
                        </group>
                        <group string="Shop Identity">
                            <field name="shop_name"/>
                            <field name="shop_email"/>
                            <field name="myshopify_domain"/>
                            <field name="plan_display_name"/>
                            <field name="currency_code"/>
                            <field name="timezone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Error Simulation">
                            <field name="error_mode"/>
                            <field name="error_rate_pct" invisible="error_mode != 'random_errors'"/>
                        </group>
                        <group string="Rate Limiting">
                            <field name="rate_limit_bucket_size"/>
                            <field name="rate_limit_available"/>
                            <field name="rate_limit_restore_rate"/>
                        </group>
                    </group>
                    <group string="Internal">
                        <field name="next_gid" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sim_shopify_config_tree" model="ir.ui.view">
        <field name="name">sim.shopify.config.tree</field>
        <field name="model">sim.shopify.config</field>
        <field name="arch" type="xml">
            <list string="Simulator Configurations">
                <field name="shop_name"/>
                <field name="backend_id"/>
                <field name="error_mode"/>
                <field name="currency_code"/>
            </list>
        </field>
    </record>

    <record id="action_sim_config" model="ir.actions.act_window">
        <field name="name">Simulator Configs</field>
        <field name="res_model">sim.shopify.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
